<%- include('partials/header') %>

<div style="border-bottom: 2px solid var(--border-color); padding-bottom: 10px; margin-bottom: 20px;">
    <h2>⚙️ <%= t('homepage_content.title') %></h2>
    <p style="font-size: 14px; color: var(--text-muted);"><%= t('homepage_content.description') %></p>
</div>

<div class="card">
    <h3>📝 <%= t('homepage_content.edit_blocks') %></h3>
    
    <!-- Language Selector Tabs for Homepage Content -->
    <div style="margin: 20px 0; border-bottom: 2px solid var(--border-color);">
        <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px; display: block;"><%= t('homepage_content.content_language_label') %></label>
        <button onclick="switchContentLanguage('en')" class="lang-tab <%= selectedLang === 'en' ? 'active' : '' %>" data-lang="en" style="padding: 10px 20px; border: none; background: <%= selectedLang === 'en' ? 'var(--safety-orange)' : 'var(--bg-light)' %>; color: <%= selectedLang === 'en' ? 'white' : 'var(--text-main)' %>; cursor: pointer; font-weight: <%= selectedLang === 'en' ? 'bold' : 'normal' %>; border-radius: 4px 4px 0 0; margin-right: 5px;">
            🇺🇸 <%= t('homepage_content.lang_english') %>
        </button>
        <button onclick="switchContentLanguage('da')" class="lang-tab <%= selectedLang === 'da' ? 'active' : '' %>" data-lang="da" style="padding: 10px 20px; border: none; background: <%= selectedLang === 'da' ? 'var(--safety-orange)' : 'var(--bg-light)' %>; color: <%= selectedLang === 'da' ? 'white' : 'var(--text-main)' %>; cursor: pointer; font-weight: <%= selectedLang === 'da' ? 'bold' : 'normal' %>; border-radius: 4px 4px 0 0; margin-right: 5px;">
            🇦🇫 <%= t('homepage_content.lang_dari') %>
        </button>
        <button onclick="switchContentLanguage('ps')" class="lang-tab <%= selectedLang === 'ps' ? 'active' : '' %>" data-lang="ps" style="padding: 10px 20px; border: none; background: <%= selectedLang === 'ps' ? 'var(--safety-orange)' : 'var(--bg-light)' %>; color: <%= selectedLang === 'ps' ? 'white' : 'var(--text-main)' %>; cursor: pointer; font-weight: <%= selectedLang === 'ps' ? 'bold' : 'normal' %>; border-radius: 4px 4px 0 0;">
            🇦🇫 <%= t('homepage_content.lang_pashto') %>
        </button>
    </div>
    
    <form action="/admin/homepage-control" method="POST" style="margin-top: 20px;">
        <input type="hidden" name="contentLang" value="<%= selectedLang || 'en' %>">
        <div class="form-group">
            <label><%= t('homepage_text.hero_headline_label') %></label>
            <input type="text" name="hero_headline" class="form-control" value="<%= content.hero_headline %>" required>
        </div>
        
        <div class="form-group">
            <label><%= t('homepage_text.hero_subtext_label') %></label>
            <textarea name="hero_subtext" class="form-control" rows="3" required><%= content.hero_subtext %></textarea>
        </div>
        
        <div class="form-group">
            <label><%= t('homepage_text.about_story_label') %></label>
            <textarea name="about_story" class="form-control" rows="4" required><%= content.about_story %></textarea>
        </div>
        
        <div class="grid" style="grid-template-columns: 1fr 1fr;">
            <div class="form-group">
                <label><%= t('homepage_text.company_mission_label') %></label>
                <textarea name="company_mission" class="form-control" rows="3" required><%= content.company_mission %></textarea>
            </div>
            <div class="form-group">
                <label><%= t('homepage_text.company_vision_label') %></label>
                <textarea name="company_vision" class="form-control" rows="3" required><%= content.company_vision %></textarea>
            </div>
        </div>

        <!-- Additional Waybill Header Contact Numbers -->
        <div class="grid" style="grid-template-columns: 1fr 1fr; margin-top: 15px;">
            <div class="form-group">
                <label><%= t('homepage_text.waybill_phone_1_label') %></label>
                <input type="text" name="waybill_phone_1" class="form-control" value="<%= content.waybill_phone_1 || '+93 700 000 000' %>" required>
            </div>
            <div class="form-group">
                <label><%= t('homepage_text.waybill_phone_2_label') %></label>
                <input type="text" name="waybill_phone_2" class="form-control" value="<%= content.waybill_phone_2 || '+93 780 000 000' %>" required>
            </div>
        </div>

        <!-- Footer Contact Information -->
        <div class="grid" style="grid-template-columns: 1fr 1fr 1fr; margin-top: 15px; padding-top: 15px; border-top: 2px solid var(--border-color);">
            <div class="form-group">
                <label><%= t('homepage_footer.address_label') %></label>
                <input type="text" name="footer_address" class="form-control" value="<%= content.footer_address || 'Kabul Agent Sub-Station Depot' %>" required>
            </div>
            <div class="form-group">
                <label><%= t('homepage_footer.phone_label') %></label>
                <input type="text" name="footer_phone" class="form-control" value="<%= content.footer_phone || '+93 (0) 799-XXXXXX' %>" required>
            </div>
            <div class="form-group">
                <label>Footer Email Address</label>
                <input type="email" name="footer_email" class="form-control" value="<%= content.footer_email || 'info@example.com' %>" required>
            </div>
        </div>

        <button type="submit" class="btn btn-primary" style="background-color: var(--safety-orange); border-color: var(--orange-hover); margin-top: 10px;">
            💾 <%= t('homepage_footer.save_button') %>
        </button>
    </form>
</div>

<!-- Homepage Media Management Section -->
<div class="card" style="margin-top: 25px;">
    <h3>🖼️ <%= t('homepage_media.title') %></h3>
    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 20px;"><%= t('homepage_media.description') %></p>
    
    <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
        
        <!-- Hero Background Image Card -->
        <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 15px;">
            <h4 style="margin: 0 0 15px 0; font-size: 16px;"><%= t('homepage_media.hero_background') %></h4>
            
            <div style="margin-bottom: 15px;">
                <% if (media.hero_background && typeof media.hero_background === 'string') { %>
                    <div id="hero-preview">
                        <img src="<%= media.hero_background %>" alt="Hero Background" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color);">
                    </div>
                    <p id="hero-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.current') %>:</strong> <%= media.hero_background.split('/').pop() %>
                    </p>
                <% } else { %>
                    <div id="hero-preview" style="width: 100%; height: 150px; background: var(--bg-light); border-radius: 4px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 13px;">
                        <%= t('homepage_media.using_default') %>
                    </div>
                    <p id="hero-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.status') %>:</strong> <%= t('homepage_media.default') %>
                    </p>
                <% } %>
            </div>
            
            <form id="hero-upload-form" action="/admin/homepage-control/media" method="POST" enctype="multipart/form-data" style="margin-bottom: 10px;">
                <input type="hidden" name="media_key" value="hero_background">
                <input type="file" id="hero-file-input" name="homepage_media" accept="image/jpeg,image/jpg,image/png,image/webp" class="form-control" style="margin-bottom: 10px;">
                <button type="submit" class="btn btn-primary" style="width: 100%; background-color: var(--safety-orange); border-color: var(--orange-hover);">
                    📤 <%= t('homepage_media.upload_hero') %>
                </button>
            </form>
            
            <% if (media.hero_background) { %>
            <form id="hero-delete-form" action="/admin/homepage-control/media/delete" method="POST">
                <input type="hidden" name="media_key" value="hero_background">
                <button type="submit" class="btn" style="width: 100%; background-color: var(--status-error); color: white; border: none;">
                    🗑️ <%= t('homepage_media.remove_custom') %>
                </button>
            </form>
            <% } %>
        </div>
        
        <!-- About Image Card -->
        <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 15px;">
            <h4 style="margin: 0 0 15px 0; font-size: 16px;"><%= t('homepage_media.about_image') %></h4>
            
            <div style="margin-bottom: 15px;">
                <% if (media.about_image && typeof media.about_image === 'string') { %>
                    <div id="about-preview">
                        <img src="<%= media.about_image %>" alt="About Image" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color);">
                    </div>
                    <p id="about-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.current') %>:</strong> <%= media.about_image.split('/').pop() %>
                    </p>
                <% } else { %>
                    <div id="about-preview" style="width: 100%; height: 150px; background: var(--bg-light); border-radius: 4px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 13px;">
                        <%= t('homepage_media.using_default') %>
                    </div>
                    <p id="about-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.status') %>:</strong> <%= t('homepage_media.default') %>
                    </p>
                <% } %>
            </div>
            
            <form id="about-upload-form" action="/admin/homepage-control/media" method="POST" enctype="multipart/form-data" style="margin-bottom: 10px;">
                <input type="hidden" name="media_key" value="about_image">
                <input type="file" id="about-file-input" name="homepage_media" accept="image/jpeg,image/jpg,image/png,image/webp" class="form-control" style="margin-bottom: 10px;">
                <button type="submit" class="btn btn-primary" style="width: 100%; background-color: var(--safety-orange); border-color: var(--orange-hover);">
                    📤 <%= t('homepage_media.upload_about') %>
                </button>
            </form>
            
            <% if (media.about_image) { %>
            <form id="about-delete-form" action="/admin/homepage-control/media/delete" method="POST">
                <input type="hidden" name="media_key" value="about_image">
                <button type="submit" class="btn" style="width: 100%; background-color: var(--status-error); color: white; border: none;">
                    🗑️ <%= t('homepage_media.remove_custom') %>
                </button>
            </form>
            <% } %>
        </div>
        
        <!-- Logo Card -->
        <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 15px;">
            <h4 style="margin: 0 0 15px 0; font-size: 16px;"><%= t('homepage_media.company_logo') %></h4>
            
            <div style="margin-bottom: 15px;">
                <% if (media.logo && typeof media.logo === 'string') { %>
                    <div id="logo-preview">
                        <img src="<%= media.logo %>" alt="Logo" style="max-width: 100%; height: 150px; object-fit: contain; border-radius: 4px; border: 1px solid var(--border-color); background: var(--card-bg);">
                    </div>
                    <p id="logo-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.current') %>:</strong> <%= media.logo.split('/').pop() %>
                    </p>
                <% } else { %>
                    <div id="logo-preview" style="width: 100%; height: 150px; background: var(--bg-light); border-radius: 4px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 13px;">
                        <%= t('homepage_media.using_default_logo') %>
                    </div>
                    <p id="logo-filename" style="font-size: 12px; color: var(--text-muted); margin-top: 8px;">
                        <strong><%= t('homepage_media.status') %>:</strong> <%= t('homepage_media.default_logo') %>
                    </p>
                <% } %>
            </div>
            
            <form id="logo-upload-form" action="/admin/homepage-control/media" method="POST" enctype="multipart/form-data" style="margin-bottom: 10px;">
                <input type="hidden" name="media_key" value="logo">
                <input type="file" id="logo-file-input" name="homepage_media" accept="image/jpeg,image/jpg,image/png,image/webp" class="form-control" style="margin-bottom: 10px;">
                <button type="submit" class="btn btn-primary" style="width: 100%; background-color: var(--safety-orange); border-color: var(--orange-hover);">
                    📤 <%= t('homepage_media.upload_logo') %>
                </button>
            </form>
            
            <% if (media.logo) { %>
            <form id="logo-delete-form" action="/admin/homepage-control/media/delete" method="POST">
                <input type="hidden" name="media_key" value="logo">
                <button type="submit" class="btn" style="width: 100%; background-color: var(--status-error); color: white; border: none;">
                    🗑️ <%= t('homepage_media.remove_custom_logo') %>
                </button>
            </form>
            <% } %>
        </div>
    </div>
</div>

<!-- Homepage Product Catalog Section -->
<div class="card" style="margin-top: 25px;">
    <h3>📦 <%= t('homepage_products.title') %></h3>
    <p style="font-size: 14px; color: var(--text-muted); margin-bottom: 20px;"><%= t('homepage_products.description_text') %></p>
    
    <!-- Add Product Form -->
    <div style="background: var(--bg-light); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; margin-bottom: 25px;">
        <h4 style="margin: 0 0 15px 0; font-size: 16px;"><%= t('homepage_products.add_new') %></h4>
        <form action="/admin/homepage-control/products" method="POST">
            <input type="hidden" name="contentLang" value="<%= selectedLang || 'en' %>">
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 15px;">
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.product_name') %></label>
                    <input type="text" name="name" class="form-control" required style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.description_field') %></label>
                    <input type="text" name="description" class="form-control" style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.specifications') %></label>
                    <input type="text" name="specifications" class="form-control" style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
                </div>
                <div>
                    <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.display_order') %></label>
                    <input type="number" name="display_order" class="form-control" required style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="background-color: var(--safety-orange); border-color: var(--orange-hover);">
                ➕ <%= t('homepage_products.add_product') %>
            </button>
        </form>
    </div>
    
    <!-- Products List -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 20px;">
        <% if (products && products.length > 0) { %>
            <% products.forEach(product => { %>
                <div style="border: 1px solid var(--border-color); border-radius: 8px; padding: 15px; background: var(--card-bg);">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                        <h4 style="margin: 0; font-size: 15px; flex: 1;">
                            <%= product.name || t('homepage_products.no_name') %>
                            <% if (product.is_active === 1) { %>
                                <span style="background: rgba(22, 163, 74, 0.2); color: var(--status-success); padding: 2px 8px; border-radius: 4px; font-size: 11px; margin-left: 8px;"><%= t('homepage_products.active') %></span>
                            <% } else { %>
                                <span style="background: rgba(220, 38, 38, 0.2); color: var(--status-error); padding: 2px 8px; border-radius: 4px; font-size: 11px; margin-left: 8px;"><%= t('homepage_products.inactive') %></span>
                            <% } %>
                        </h4>
                        <span style="font-size: 12px; color: var(--text-muted);"><%= t('homepage_content.order_label') %>: <%= product.display_order %></span>
                    </div>
                    
                    <% if (product.image_path) { %>
                        <div id="product-preview-<%= product.id %>">
                            <img src="<%= product.image_path %>" alt="Product" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid var(--border-color); margin-bottom: 10px;">
                        </div>
                    <% } else { %>
                        <div id="product-preview-<%= product.id %>" style="width: 100%; height: 120px; background: var(--bg-light); border-radius: 4px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 12px; margin-bottom: 10px;">
                            <%= t('homepage_products.no_image') %>
                        </div>
                    <% } %>
                    
                    <p style="font-size: 13px; color: var(--text-main); margin-bottom: 5px;"><%= product.description || '' %></p>
                    <p style="font-size: 12px; color: var(--text-muted); margin-bottom: 15px;"><strong><%= t('homepage_content.specs_label') %></strong> <%= product.specifications || '' %></p>
                    
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <form action="/admin/homepage-control/products/update" method="POST" style="flex: 1;">
                            <input type="hidden" name="product_id" value="<%= product.id %>">
                            <input type="hidden" name="contentLang" value="<%= selectedLang || 'en' %>">
                            <input type="hidden" name="name" value="<%= product.name || '' %>">
                            <input type="hidden" name="description" value="<%= product.description || '' %>">
                            <input type="hidden" name="specifications" value="<%= product.specifications || '' %>">
                            <input type="hidden" name="display_order" value="<%= product.display_order %>">
                            <button type="button" onclick="editProduct(<%= product.id %>, '<%= (product.name || '').replace(/'/g, "\\'") %>', '<%= (product.description || '').replace(/'/g, "\\'") %>', '<%= (product.specifications || '').replace(/'/g, "\\'") %>', <%= product.display_order %>)" class="btn" style="background: var(--accent-blue); color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer;">
                                ✏️ <%= t('homepage_products.edit') %>
                            </button>
                        </form>
                        
                        <form action="/admin/homepage-control/products/toggle" method="POST">
                            <input type="hidden" name="product_id" value="<%= product.id %>">
                            <button type="submit" class="btn" style="background: <%= product.is_active === 1 ? 'var(--safety-orange)' : 'var(--status-success)' %>; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer;">
                                <%= product.is_active === 1 ? '⏸️ ' + t('homepage_products.deactivate') : '▶️ ' + t('homepage_products.activate') %>
                            </button>
                        </form>
                        
                        <form id="product-image-delete-<%= product.id %>" action="/admin/homepage-control/products/image/delete" method="POST">
                            <input type="hidden" name="product_id" value="<%= product.id %>">
                            <% if (product.image_path) { %>
                                <button type="submit" class="btn" style="background: var(--text-muted); color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer;">
                                    🖼️ <%= t('homepage_products.remove_image') %>
                                </button>
                            <% } %>
                        </form>
                        
                        <form action="/admin/homepage-control/products/delete" method="POST" onsubmit="return confirm('<%= t('homepage_products.confirm_delete') %>');">
                            <input type="hidden" name="product_id" value="<%= product.id %>">
                            <button type="submit" class="btn" style="background: var(--status-error); color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer;">
                                🗑️ <%= t('homepage_products.delete') %>
                            </button>
                        </form>
                    </div>
                    
                    <form id="product-image-upload-<%= product.id %>" action="/admin/homepage-control/products/image" method="POST" enctype="multipart/form-data" style="margin-top: 10px;">
                        <input type="hidden" name="product_id" value="<%= product.id %>">
                        <input type="file" name="homepage_media" accept="image/jpeg,image/jpg,image/png,image/webp" class="form-control" style="padding: 6px; font-size: 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
                        <button type="submit" class="btn" style="background: #8b5cf6; color: white; border: none; padding: 6px 12px; border-radius: 4px; font-size: 12px; cursor: pointer; margin-top: 5px; width: 100%;">
                            📤 <%= t('homepage_products.upload_image') %>
                        </button>
                    </form>
                </div>
            <% }); %>
        <% } else { %>
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: var(--bg-light); border-radius: 8px; border: 1px solid var(--border-color);">
                <p style="color: var(--text-muted); font-size: 14px;"><%= t('homepage_products.no_products') %></p>
            </div>
        <% } %>
    </div>
</div>

<!-- Edit Product Modal -->
<div id="editProductModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: var(--modal-overlay); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: var(--modal-bg); border-radius: 8px; padding: 25px; max-width: 500px; width: 90%;">
        <h4 style="margin: 0 0 20px 0;"><%= t('homepage_products.edit') %></h4>
        <form action="/admin/homepage-control/products/update" method="POST">
            <input type="hidden" name="product_id" id="edit_product_id">
            <input type="hidden" name="contentLang" value="<%= selectedLang || 'en' %>">
            <div style="margin-bottom: 15px;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.product_name') %></label>
                <input type="text" name="name" id="edit_name" class="form-control" required style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
            </div>
            <div style="margin-bottom: 15px;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.description_field') %></label>
                <input type="text" name="description" id="edit_description" class="form-control" style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
            </div>
            <div style="margin-bottom: 15px;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.specifications') %></label>
                <input type="text" name="specifications" id="edit_specifications" class="form-control" style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
            </div>
            <div style="margin-bottom: 20px;">
                <label style="font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 5px; display: block;"><%= t('homepage_products.display_order') %></label>
                <input type="number" name="display_order" id="edit_display_order" class="form-control" required style="padding: 8px 12px; border: 1px solid var(--input-border); border-radius: 4px; width: 100%;">
            </div>
            <div style="display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary" style="background-color: var(--safety-orange); border-color: var(--orange-hover); flex: 1;">
                    💾 <%= t('homepage_products.save_changes') %>
                </button>
                <button type="button" onclick="closeEditModal()" class="btn" style="background: var(--text-muted); color: white; border: none; padding: 10px 20px; border-radius: 4px; cursor: pointer;">
                    <%= t('homepage_products.cancel') %>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function editProduct(id, name, description, specifications, displayOrder) {
    document.getElementById('edit_product_id').value = id;
    document.getElementById('edit_name').value = name;
    document.getElementById('edit_description').value = description;
    document.getElementById('edit_specifications').value = specifications;
    document.getElementById('edit_display_order').value = displayOrder;
    document.getElementById('editProductModal').style.display = 'flex';
}

function closeEditModal() {
    document.getElementById('editProductModal').style.display = 'none';
}

// Media upload AJAX handlers
function setupMediaUpload(formId, mediaKey, previewId, filenameId, deleteFormId) {
    const form = document.getElementById(formId);
    if (!form) return;
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const formData = new FormData(form);
        const fileInput = form.querySelector('input[type="file"]');
        
        if (!fileInput.files.length) {
            alert('<%= t("homepage_content.alert_select_file") %>');
            return;
        }
        
        const button = form.querySelector('button[type="submit"]');
        const originalText = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '⏳ <%= t("homepage_content.alert_uploading") %>';
        
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Update preview
                const previewContainer = document.getElementById(previewId);
                if (previewContainer) {
                    previewContainer.innerHTML = `<img src="${data.media.file_path}" alt="${mediaKey}" style="width: 100%; height: 150px; object-fit: cover; border-radius: 4px; border: 1px solid #e2e8f0;">`;
                }
                
                // Update filename
                const filenameContainer = document.getElementById(filenameId);
                if (filenameContainer) {
                    filenameContainer.innerHTML = `<strong><%= t('homepage_media.current') %>:</strong> ${data.media.file_path.split('/').pop()}`;
                }
                
                // Show delete button
                if (deleteFormId) {
                    const deleteForm = document.getElementById(deleteFormId);
                    if (deleteForm) {
                        deleteForm.style.display = 'block';
                    }
                }
                
                // Clear file input
                fileInput.value = '';
                
                alert(data.message);
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('<%= t("homepage_content.alert_upload_failed") %>');
        })
        .finally(() => {
            button.disabled = false;
            button.innerHTML = originalText;
        });
    });
}

function setupMediaDelete(formId, mediaKey, previewId, filenameId) {
    const form = document.getElementById(formId);
    if (!form) return;
    
    form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        if (!confirm('<%= t("homepage_content.alert_confirm_remove") %>')) {
            return;
        }
        
        const formData = new FormData(form);
        const button = form.querySelector('button[type="submit"]');
        const originalText = button.innerHTML;
        button.disabled = true;
        button.innerHTML = '⏳ <%= t("homepage_content.alert_removing") %>';
        
        fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                // Reset to default placeholder
                const previewContainer = document.getElementById(previewId);
                if (previewContainer) {
                    const defaultText = mediaKey === 'logo' ? '<%= t("homepage_media.using_default_logo") %>' : '<%= t("homepage_media.using_default") %>';
                    previewContainer.innerHTML = `<div style="width: 100%; height: 150px; background: var(--bg-light); border-radius: 4px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-muted); font-size: 13px;">${defaultText}</div>`;
                }
                
                // Reset filename
                const filenameContainer = document.getElementById(filenameId);
                if (filenameContainer) {
                    const defaultStatus = mediaKey === 'logo' ? '<%= t("homepage_media.default_logo") %>' : '<%= t("homepage_media.default") %>';
                    filenameContainer.innerHTML = `<strong><%= t("homepage_media.status") %>:</strong> ${defaultStatus}`;
                }
                
                // Hide delete form
                form.style.display = 'none';
                
                alert(data.message);
            } else {
                alert('Error: ' + data.message);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('<%= t("homepage_content.alert_remove_failed") %>');
        })
        .finally(() => {
            button.disabled = false;
            button.innerHTML = originalText;
        });
    });
}

// Setup media handlers on page load
document.addEventListener('DOMContentLoaded', function() {
    // Hero media
    setupMediaUpload('hero-upload-form', 'hero_background', 'hero-preview', 'hero-filename', 'hero-delete-form');
    setupMediaDelete('hero-delete-form', 'hero_background', 'hero-preview', 'hero-filename');
    
    // About media
    setupMediaUpload('about-upload-form', 'about_image', 'about-preview', 'about-filename', 'about-delete-form');
    setupMediaDelete('about-delete-form', 'about_image', 'about-preview', 'about-filename');
    
    // Logo media
    setupMediaUpload('logo-upload-form', 'logo', 'logo-preview', 'logo-filename', 'logo-delete-form');
    setupMediaDelete('logo-delete-form', 'logo', 'logo-preview', 'logo-filename');
    
    // Product image handlers
    document.querySelectorAll('[id^="product-image-upload-"]').forEach(form => {
        const productId = form.id.replace('product-image-upload-', '');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const formData = new FormData(form);
            const fileInput = form.querySelector('input[type="file"]');
            
            if (!fileInput.files.length) {
                alert('<%= t("homepage_content.alert_select_file") %>');
                return;
            }
            
            const button = form.querySelector('button[type="submit"]');
            const originalText = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '⏳ <%= t("homepage_content.alert_uploading_product") %>';
            
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update preview
                    const previewContainer = document.getElementById('product-preview-' + productId);
                    if (previewContainer) {
                        previewContainer.innerHTML = `<img src="${data.product.image_path}" alt="Product" style="width: 100%; height: 120px; object-fit: cover; border-radius: 4px; border: 1px solid #e2e8f0; margin-bottom: 10px;">`;
                    }
                    
                    // Show delete button
                    const deleteForm = document.getElementById('product-image-delete-' + productId);
                    if (deleteForm) {
                        deleteForm.style.display = 'block';
                        const deleteButton = deleteForm.querySelector('button');
                        if (deleteButton) {
                            deleteButton.style.display = 'inline-block';
                        }
                    }
                    
                    // Clear file input
                    fileInput.value = '';
                    
                    alert(data.message);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('<%= t("homepage_content.alert_upload_product_failed") %>');
            })
            .finally(() => {
                button.disabled = false;
                button.innerHTML = originalText;
            });
        });
    });
    
    // Product image delete handlers
    document.querySelectorAll('[id^="product-image-delete-"]').forEach(form => {
        const productId = form.id.replace('product-image-delete-', '');
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            if (!confirm('<%= t("homepage_content.alert_confirm_remove_product_image") %>')) {
                return;
            }
            
            const formData = new FormData(form);
            const button = form.querySelector('button[type="submit"]');
            const originalText = button.innerHTML;
            button.disabled = true;
            button.innerHTML = '⏳ <%= t("homepage_content.alert_removing") %>';
            
            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Reset to placeholder
                    const previewContainer = document.getElementById('product-preview-' + productId);
                    if (previewContainer) {
                        previewContainer.innerHTML = `<div style="width: 100%; height: 120px; background: #f1f5f9; border-radius: 4px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 12px; margin-bottom: 10px;"><%= t('homepage_products.no_image') %></div>`;
                    }
                    
                    // Hide delete button
                    button.style.display = 'none';
                    
                    alert(data.message);
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('<%= t("homepage_content.alert_delete_product_failed") %>');
            })
            .finally(() => {
                button.disabled = false;
                button.innerHTML = originalText;
            });
        });
    });
});
</script>

<!-- Cement Type Registration Section -->
<div class="card" style="background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-top: 25px; direction: rtl; text-align: right;">
    <div style="border-bottom: 2px solid var(--border-color); padding-bottom: 12px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h4 style="margin: 0; color: var(--text-main); font-weight: 800; font-size: 18px;">🏗️ ثبت و مدیریت انواع سمنت (Cement Registry)</h4>
            <p style="margin: 4px 0 0 0; font-size: 13px; color: var(--text-muted);">افزودن انواع جدید سمنت، منبع تولید و محل دیپو/تحویل‌دهی</p>
        </div>
    </div>

    <!-- Registration Form -->
    <form id="cementTypeForm" style="margin-bottom: 25px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 15px; align-items: flex-end;">
            
            <!-- 1. Cement Name -->
            <div>
                <label style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 6px; display: block;">
                    <%= t('homepage_content.cement_name_label') %>
                </label>
                <input type="text" id="cement_name" name="cement_name" class="form-control" placeholder="<%= t('homepage_content.cement_name_placeholder') %>" required style="padding: 9px 12px; font-size: 13px; border-radius: 6px; border: 1px solid var(--border-color); width: 100%;">
            </div>

            <!-- 2. Source / Origin -->
            <div>
                <label style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 6px; display: block;">
                    <%= t('homepage_content.source_origin_label') %>
                </label>
                <input type="text" id="source_origin" name="source_origin" class="form-control" placeholder="<%= t('homepage_content.source_origin_placeholder') %>" required style="padding: 9px 12px; font-size: 13px; border-radius: 6px; border: 1px solid var(--border-color); width: 100%;">
            </div>

            <!-- 3. Settlement / Storage Location -->
            <div>
                <label style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-bottom: 6px; display: block;">
                    <%= t('homepage_content.storage_destination_label') %>
                </label>
                <input type="text" id="storage_destination" name="storage_destination" class="form-control" placeholder="<%= t('homepage_content.storage_destination_placeholder') %>" required style="padding: 9px 12px; font-size: 13px; border-radius: 6px; border: 1px solid var(--border-color); width: 100%;">
            </div>

            <!-- Submit Button -->
            <div>
                <button type="submit" class="btn" style="background-color: var(--status-success); color: #ffffff; padding: 10px 20px; font-weight: 700; border-radius: 6px; width: 100%; border: none; cursor: pointer;">
                    <%= t('homepage_content.add_cement_type') %>
                </button>
            </div>
        </div>
    </form>

    <!-- Registered Cement Types Table -->
    <div style="overflow-x: auto; border: 1px solid #e2e8f0; border-radius: 8px;">
        <table style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: center;">
            <thead>
                <tr style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; color: #1e293b; font-weight: 700;">
                    <th style="padding: 12px;">#</th>
                    <th style="padding: 12px;">نام سمنت</th>
                    <th style="padding: 12px;">مبدأ / منبع تولید</th>
                    <th style="padding: 12px;">محل تخلیه / دیپو</th>
                    <th style="padding: 12px;">تاریخ ثبت</th>
                    <th style="padding: 12px;">عملیات</th>
                </tr>
            </thead>
            <tbody id="cementTypesTableBody">
                <!-- Dynamically populated via AJAX/Fetch -->
            </tbody>
        </table>
    </div>
</div>

<script>
// Homepage Content Language switching function
function switchContentLanguage(contentLang) {
    window.location.href = `/admin/homepage-control?contentLang=${contentLang}`;
}

// Submit New Cement Type
document.getElementById('cementTypeForm')?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const data = {
        cement_name: document.getElementById('cement_name').value,
        source_origin: document.getElementById('source_origin').value,
        storage_destination: document.getElementById('storage_destination').value
    };

    const res = await fetch('/api/config/cement-types', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });

    if (res.ok) {
        alert('نوع جدید سمنت با موفقیت ثبت شد!');
        document.getElementById('cementTypeForm').reset();
        loadCementTypes();
    } else {
        alert('خطا در ثبت اطلاعات.');
    }
});

// Load Cement Types into Table
async function loadCementTypes() {
    const res = await fetch('/api/config/cement-types');
    const items = await res.json();
    const tbody = document.getElementById('cementTypesTableBody');
    if (!tbody) return;

    if (items.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding: 15px; color: #64748b;">هیچ نوع سمنتی هنوز ثبت نشده است.</td></tr>`;
        return;
    }

    tbody.innerHTML = items.map((item, index) => `
        <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 10px;">${index + 1}</td>
            <td style="padding: 10px; font-weight: 700; color: #0f172a;">${item.cement_name}</td>
            <td style="padding: 10px;">${item.source_origin}</td>
            <td style="padding: 10px; color: #0284c7; font-weight: 600;">${item.storage_destination}</td>
            <td style="padding: 10px; color: #64748b;">${item.created_at ? item.created_at.split(' ')[0] : '-'}</td>
            <td style="padding: 10px;">
                <button onclick="deleteCementType(${item.id})" style="background: #dc2626; color: white; border: none; padding: 4px 10px; border-radius: 4px; font-size: 11px; cursor: pointer;">حذف</button>
            </td>
        </tr>
    `).join('');
}

// Delete Cement Type
async function deleteCementType(id) {
    if (confirm('آیا از حذف این نوع سمنت اطمینان دارید؟')) {
        await fetch(`/api/config/cement-types/${id}`, { method: 'DELETE' });
        loadCementTypes();
    }
}

// Initial Load
document.addEventListener('DOMContentLoaded', loadCementTypes);
</script>

