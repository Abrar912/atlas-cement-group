    // Make translations available globally
    window.translations = window.translations || {};
    Object.assign(window.translations, window.cementSummaryI18n);
    Object.assign(window.translations, window.customerSummaryI18n);
    
    // Centralized notification state
    let notificationState = {
        notifications: [],
        unreadCount: 0,
        hasMore: false
    };
    
    // Request version counter to prevent stale responses
    let notificationRequestVersion = 0;
    
    // Infinite-scroll paging settings
    const NOTIFICATION_PAGE_SIZE = 30;
    let notificationLoadingMore = false;
    
    // BroadcastChannel for cross-tab synchronization
    const notificationChannel = new BroadcastChannel('notifications');
    
    // Notification button click handler
    const notificationButton = document.getElementById('adminNotificationButton');
    const notificationDropdown = document.getElementById('adminNotificationDropdown');
    const notificationBadge = document.getElementById('adminNotificationBadge');
    const notificationUnreadChip = document.getElementById('adminNotificationUnreadChip');
    const notificationList = document.getElementById('adminNotificationList');
    const readAllButton = document.getElementById('adminNotificationReadAll');
    const clearAllButton = document.getElementById('adminNotificationClearAll');
    
    if (!notificationButton) {
        console.error('Notification button not found');
        return;
    }
    
    // Toggle dropdown (refresh from the server whenever it opens)
    notificationButton.addEventListener('click', function(event) {
        event.stopPropagation();
        const willOpen = !notificationDropdown.classList.contains('open');
        notificationDropdown.classList.toggle('open');
        if (willOpen) {
            loadNotifications();
        }
    });
    
    // Infinite scroll: fetch the next page when nearing the bottom of the list
    notificationList.addEventListener('scroll', function() {
        if (!notificationState.hasMore || notificationLoadingMore) {
            return;
        }
        if (notificationList.scrollTop + notificationList.clientHeight >= notificationList.scrollHeight - 60) {
            loadMoreNotifications();
        }
    });
    
    // Close dropdown when clicking outside
    document.addEventListener('click', function(event) {
        if (!event.target.closest('.admin-notification-wrapper')) {
            notificationDropdown.classList.remove('open');
        }
    });
    
    // Calculate unread count from notification list
    function calculateUnreadCount(notifications) {
        return notifications.filter(n => Number(n.is_read) === 0).length;
    }
    
    // Update badge count and header chip
    function updateBadge(count) {
        if (count > 0) {
            notificationBadge.textContent = count > 99 ? '99+' : count;
            notificationBadge.style.display = 'flex';
            if (notificationUnreadChip) {
                notificationUnreadChip.textContent = count > 99 ? '99+' : count;
                notificationUnreadChip.style.display = 'inline-flex';
            }
        } else {
            notificationBadge.style.display = 'none';
            if (notificationUnreadChip) {
                notificationUnreadChip.style.display = 'none';
            }
        }
    }
    
    // Apply server notification state - SINGLE SOURCE OF TRUTH
    function applyNotificationState(serverData, append) {
        const incoming = serverData.notifications || [];
        if (append) {
            notificationState.notifications = notificationState.notifications.concat(incoming);
        } else {
            notificationState.notifications = incoming;
        }
        // The badge uses the server-side unread count, which stays correct even
        // when unread notifications exist beyond the currently loaded pages.
        notificationState.unreadCount = Math.max(0, parseInt(serverData.unread_count, 10) || 0);
        notificationState.hasMore = !!serverData.has_more;
        updateBadge(notificationState.unreadCount);
        renderNotifications(notificationState.notifications);
    }
    
    // Load notifications from API (page 1; keeps already-loaded pages on refresh)
    function loadNotifications() {
        const loadedCount = notificationState.notifications.length;
        // Keep every page the user has already scrolled through when refreshing
        const limit = Math.max(NOTIFICATION_PAGE_SIZE, loadedCount);
        const requestVersion = ++notificationRequestVersion;
        
        if (loadedCount === 0) {
            notificationList.innerHTML = '<div class="admin-notification-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg><p>' + notificationI18n.loading + '</p></div>';
        }
        
        return fetch('/api/admin/notifications?limit=' + limit + '&offset=0', {
            cache: 'no-store'
        })
            .then(res => {
                if (!res.ok) {
                    throw new Error(`HTTP error! status: ${res.status}`);
                }
                return res.json();
            })
            .then(data => {
                // Only apply response if this is still the current request version
                if (requestVersion !== notificationRequestVersion) {
                    return;
                }
                applyNotificationState(data, false);
            })
            .catch(err => {
                console.error('Error loading notifications:', err);
                if (loadedCount === 0) {
                    notificationList.innerHTML = '<div class="admin-notification-empty"><p>' + notificationI18n.errorLoading + '</p></div>';
                }
            });
    }
    
    // Append the next page of notifications (infinite scroll)
    function loadMoreNotifications() {
        if (!notificationState.hasMore || notificationLoadingMore) {
            return;
        }
        notificationLoadingMore = true;
        updateMoreRow();
        
        const offset = notificationState.notifications.length;
        return fetch('/api/admin/notifications?limit=' + NOTIFICATION_PAGE_SIZE + '&offset=' + offset, {
            cache: 'no-store'
        })
            .then(res => {
                if (!res.ok) {
                    throw new Error(`HTTP error! status: ${res.status}`);
                }
                return res.json();
            })
            .then(data => {
                applyNotificationState(data, true);
            })
            .catch(err => console.error('Error loading more notifications:', err))
            .finally(() => {
                notificationLoadingMore = false;
                updateMoreRow();
            });
    }
    
    // "More content" indicator row: chevron while idle, spinner while loading
    function updateMoreRow() {
        const row = document.getElementById('adminNotificationMoreRow');
        if (!row) {
            return;
        }
        if (notificationState.hasMore) {
            row.style.display = 'flex';
            row.innerHTML = notificationLoadingMore
                ? '<span class="admin-notification-spinner"></span>'
                : '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>';
        } else {
            row.style.display = 'none';
            row.innerHTML = '';
        }
    }
    
    // Render notification list
    function renderNotifications(notifications) {
        if (!notifications || notifications.length === 0) {
            notificationList.innerHTML = '<div class="admin-notification-empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg><p>' + notificationI18n.noNotifications + '</p><small>' + notificationI18n.noNotificationsDesc + '</small></div>';
            return;
        }
        
        let html = '';
        notifications.forEach(notification => {
            const icon = getNotificationIcon(notification.type);
            const iconBgColor = getNotificationIconColor(notification.type);
            const time = formatTime(notification.created_at);
            const unreadClass = notification.is_read ? '' : 'unread';
            
            // Add download button for password recovery completed notifications
            const downloadButton = notification.type === 'password_recovery_completed' && notification.related_record_id
                ? `<button class="admin-notification-download-btn" data-key-id="${esc(notification.related_record_id)}">${notificationI18n.downloadRecoveryKey}</button>`
                : '';
            
            html += `
                <div class="admin-notification-item ${unreadClass}" data-id="${esc(notification.id)}" data-type="${esc(notification.type)}" data-record-id="${esc(notification.related_record_id)}">
                    <span class="admin-notification-dot"></span>
                    <div class="admin-notification-icon" style="background-color: ${iconBgColor};">
                        ${icon}
                    </div>
                    <div class="admin-notification-content">
                        <div class="admin-notification-message">${esc(notification.message)}</div>
                        <div class="admin-notification-time">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <span>${time}</span>
                        </div>
                        ${downloadButton}
                    </div>
                </div>
            `;
        });
        
        // Infinite-scroll indicator row (content filled by updateMoreRow)
        html += '<div class="admin-notification-more" id="adminNotificationMoreRow"></div>';
        
        notificationList.innerHTML = html;
        
        // Add click handlers to notification items
        notificationList.querySelectorAll('.admin-notification-item').forEach(item => {
            item.addEventListener('click', function() {
                const notificationId = this.dataset.id;
                const recordType = this.dataset.type;
                const recordId = this.dataset.recordId;
                const isRead = this.classList.contains('unread') ? false : true;
                handleNotificationClick(notificationId, recordType, recordId, isRead);
            });
        });
        
        // Add click handlers to download buttons (prevent notification item click)
        notificationList.querySelectorAll('.admin-notification-download-btn').forEach(btn => {
            btn.addEventListener('click', function(event) {
                event.stopPropagation();
                const keyId = this.dataset.keyId;
                window.location.href = '/api/recovery/download-key/' + keyId;
            });
        });
        
        updateMoreRow();
    }
    
