<script>
document.getElementById('nav-worker-cust').classList.add('active');

// Helper function to clean customer_id - extract only the code part (e.g., KAB-001)
function cleanCustomerId(rawId) {
    if (!rawId) return '';
    // Extract prefix and number matching pattern like KAB-001 or KAB-002
    const match = rawId.match(/^([A-Z]{3}-\d+)/i);
    return match ? match[1].toUpperCase() : rawId;
}

function handleCustomerTypeChange() {
    const customerType = document.getElementById('customerType').value;
    const orgNameField = document.getElementById('organizationNameField');
    
    if (customerType === 'Construction Company' || customerType === 'Government') {
        orgNameField.style.display = 'block';
        document.getElementById('organizationName').setAttribute('required', 'required');
    } else {
        orgNameField.style.display = 'none';
        document.getElementById('organizationName').removeAttribute('required');
        document.getElementById('organizationName').value = '';
    }
}

function handleEditCustomerTypeChange() {
    const customerType = document.getElementById('editCustomerType').value;
    const orgNameField = document.getElementById('editOrganizationNameField');
    
    if (customerType === 'Construction Company' || customerType === 'Government') {
        orgNameField.style.display = 'block';
    } else {
        orgNameField.style.display = 'none';
        document.getElementById('editOrganizationName').value = '';
    }
}

function openEditModal(button) {
    const id = button.getAttribute('data-id');
    const name = button.getAttribute('data-name');
    const customerType = button.getAttribute('data-customer_type');
    const organizationName = button.getAttribute('data-organization_name');
    const contactPersonPosition = button.getAttribute('data-contact_person_position');
    const province = button.getAttribute('data-province');
    const phone = button.getAttribute('data-phone');
    const alternativePhone = button.getAttribute('data-alternative_phone');
    const email = button.getAttribute('data-email');
    const address = button.getAttribute('data-address');
    
    document.getElementById('editId').value = id;
    document.getElementById('editName').value = name;
    document.getElementById('editCustomerType').value = customerType || 'Individual';
    document.getElementById('editOrganizationName').value = organizationName;
    document.getElementById('editContactPersonPosition').value = contactPersonPosition;
    document.getElementById('editProvince').value = province;
    document.getElementById('editAlternativePhone').value = alternativePhone;
    document.getElementById('editEmail').value = email;
    document.getElementById('editAddress').value = address;
    
    // Strip country code from phone number for display in edit modal
    let phoneDisplay = phone || '';
    if (phoneDisplay.startsWith('+93')) {
        phoneDisplay = phoneDisplay.substring(3);
    }
    document.getElementById('editPhone').value = phoneDisplay;
    
    // Trigger conditional field display
    handleEditCustomerTypeChange();
    
    document.getElementById('editForm').action = '/worker/edit-customer/' + id;
    
    document.getElementById('editModal').style.display = 'flex';
}

function closeEditModal() {
    document.getElementById('editModal').style.display = 'none';
}

// Initialize intl-tel-input for phone number fields
let phoneInput;

document.addEventListener('DOMContentLoaded', function() {
    // Initialize main phone input
    const phoneElement = document.getElementById('phone');
    if (phoneElement) {
        phoneInput = intlTelInput(phoneElement, {
            initialCountry: 'af',
            separateDialCode: true,
            utilsScript: 'https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js',
            rtl: true,
            nationalMode: true,
            formatOnDisplay: false
        });

        // Handle input to limit digits based on country
        phoneElement.addEventListener('input', function(e) {
            const countryData = phoneInput.getSelectedCountryData();
            const dialCode = countryData.dialCode;
            const maxLength = countryData.name === 'Afghanistan' ? 9 : 15;
            
            // Get current value and remove non-digits
            let value = e.target.value.replace(/\D/g, '');
            
            // Limit to max digits for the country
            if (value.length > maxLength) {
                value = value.substring(0, maxLength);
                e.target.value = value;
            }
            
            // Clear error while typing
            const errorElement = document.getElementById('phone-error');
            if (errorElement) {
                errorElement.style.display = 'none';
            }
        });

        // Handle paste to prevent duplicate country codes
        phoneElement.addEventListener('paste', function(e) {
            e.preventDefault();
            const pastedText = (e.clipboardData || window.clipboardData).getData('text');
            
            // Remove any existing country code from pasted text
            let cleanNumber = pastedText.replace(/\D/g, '');
            
            // If pasted number starts with country code, remove it
            const countryData = phoneInput.getSelectedCountryData();
            const dialCode = countryData.dialCode;
            if (cleanNumber.startsWith(dialCode)) {
                cleanNumber = cleanNumber.substring(dialCode.length);
            }
            
            // Limit to max digits for the country
            const maxLength = countryData.name === 'Afghanistan' ? 9 : 15;
            if (cleanNumber.length > maxLength) {
                cleanNumber = cleanNumber.substring(0, maxLength);
            }
            
            // Insert the cleaned number
            const start = e.target.selectionStart;
            const end = e.target.selectionEnd;
            const currentValue = e.target.value.replace(/\D/g, '');
            const newValue = currentValue.substring(0, start) + cleanNumber + currentValue.substring(end);
            
            e.target.value = newValue.substring(0, maxLength);
        });

        // Add validation on blur (when user leaves the field)
        phoneElement.addEventListener('blur', function() {
            validatePhone(phoneInput, 'phone-error', true);
        });
    }

    // Add form validation for main form
    const mainForm = document.querySelector('form[action="/worker/manage-customers"]');
    if (mainForm) {
        mainForm.addEventListener('submit', function(e) {
            if (!validatePhone(phoneInput, 'phone-error', false)) {
                e.preventDefault();
                return false;
            }
            // Set the international format value before submission
            if (phoneInput) {
                phoneElement.value = phoneInput.getNumber(intlTelInputUtils.numberFormat.E164);
            }
        });
    }

    // Add form validation for edit form (no intl-tel-input on edit modal)
    const editForm = document.getElementById('editForm');
    if (editForm) {
        editForm.addEventListener('submit', function(e) {
            const editPhoneElement = document.getElementById('editPhone');
            const phoneError = editForm.getAttribute('data-phone-error');
            // For edit modal, we don't have intl-tel-input initialized, so just do basic validation
            if (editPhoneElement && editPhoneElement.value) {
                const cleanPhone = editPhoneElement.value.trim();
                // Remove any non-digit characters
                const digitsOnly = cleanPhone.replace(/\D/g, '');
                
                // Validate Afghan phone number (9 digits)
                if (digitsOnly.length !== 9) {
                    alert(phoneError);
                    editPhoneElement.focus();
                    e.preventDefault();
                    return;
                }
                
                // Add country code for storage
                editPhoneElement.value = '+93' + digitsOnly;
            }
        });
    }
});

function validatePhone(iti, errorElementId, isBlur) {
    const errorElement = document.getElementById(errorElementId);
    if (!iti || !errorElement) return true;

    const phoneNumber = iti.getNumber(intlTelInputUtils.numberFormat.NATIONAL);
    
    // If field is empty
    if (!phoneNumber || phoneNumber.trim() === '') {
        errorElement.style.display = 'none';
        return false;
    }

    // Get country data for specific validation
    const countryData = iti.getSelectedCountryData();
    const currentLength = phoneNumber.replace(/\D/g, '').length;
    
    // Afghanistan-specific validation: exactly 9 digits
    if (countryData.name === 'Afghanistan') {
        if (currentLength === 9) {
            errorElement.style.display = 'none';
            return true;
        }
        
        // Only show error on blur or when called from save (isBlur = false means save)
        if (isBlur || !isBlur) {
            errorElement.style.display = 'block';
            errorElement.textContent = errorElement.getAttribute('data-error') || 'Phone number must be 9 digits';
            return false;
        }
    } else {
        // For other countries, use standard validation
        if (iti.isValidNumber()) {
            errorElement.style.display = 'none';
            return true;
        }
        
        // Only show error on blur or when called from save
        if (isBlur || !isBlur) {
            errorElement.style.display = 'block';
            errorElement.textContent = errorElement.getAttribute('data-invalid') || 'Invalid phone number';
            return false;
        }
    }

    // If typing and not at error condition, don't show error
    errorElement.style.display = 'none';
    return false;
}
</script>

