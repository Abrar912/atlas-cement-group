    cementSummaryCurrentPage = 1;
    renderCementSummaryTable();
}

function cementSummaryGoToPage(pageNum) {
    cementSummaryCurrentPage = pageNum;
    renderCementSummaryTable();
}

function cementSummaryGoToPrevPage() {
    if (cementSummaryCurrentPage > 1) {
        cementSummaryCurrentPage--;
        renderCementSummaryTable();
    }
}

function cementSummaryGoToNextPage() {
    const totalPages = Math.ceil(cementSummaryData.length / cementSummaryRowsPerPage);
    if (cementSummaryCurrentPage < totalPages) {
        cementSummaryCurrentPage++;
        renderCementSummaryTable();
    }
}

function renderCementSummaryTable() {
    const tbody = document.getElementById('cement-summary-table-body');
    const totalPages = Math.ceil(cementSummaryData.length / cementSummaryRowsPerPage) || 1;
    const startIndex = (cementSummaryCurrentPage - 1) * cementSummaryRowsPerPage;
    const endIndex = Math.min(startIndex + cementSummaryRowsPerPage, cementSummaryData.length);
    const paginatedData = cementSummaryData.slice(startIndex, endIndex);
    
    let html = '';
    paginatedData.forEach((row, index) => {
        html += `
            <tr style="background-color: var(--card-bg); border-bottom: 1px solid var(--border-color);">
                <td style="padding: 12px;">${esc(startIndex + index + 1)}</td>
                <td style="padding: 12px; font-weight: 600;">${esc(row.cement_type || '-')}</td>
                <td style="padding: 12px;">${esc((row.waybill_count || 0).toLocaleString())}</td>
                <td style="padding: 12px;">${esc((row.total_bags || 0).toLocaleString())}</td>
                <td style="padding: 12px;">${esc((row.total_tonnage || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                <td style="padding: 12px;">${esc((row.total_shortage || 0).toLocaleString())}</td>
                <td style="padding: 12px;">${esc((row.company_trucks_count || 0).toLocaleString())}</td>
                <td style="padding: 12px;">${esc((row.rental_trucks_count || 0).toLocaleString())}</td>
                <td style="padding: 12px;">${esc((row.total_freight || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                <td style="padding: 12px;">${esc((row.total_sales || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                <td style="padding: 12px; color: #16a34a;">${esc((row.total_net_cement || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
            </tr>
        `;
    });
    
    tbody.innerHTML = html;
    
    // Update pagination controls
    document.getElementById('cement-summary-page-start').textContent = cementSummaryData.length === 0 ? 0 : startIndex + 1;
    document.getElementById('cement-summary-page-end').textContent = endIndex;
    document.getElementById('cement-summary-total-count').textContent = cementSummaryData.length;
    document.getElementById('cement-summary-prev-btn').disabled = cementSummaryCurrentPage === 1;
    document.getElementById('cement-summary-next-btn').disabled = cementSummaryCurrentPage === totalPages;
    
    // Update page numbers
    const pageNumbersDiv = document.getElementById('cement-summary-page-numbers');
    let pageNumbersHtml = '';
    for (let i = 1; i <= totalPages; i++) {
        if (i === cementSummaryCurrentPage) {
            pageNumbersHtml += `<button onclick="cementSummaryGoToPage(${esc(i)})" style="background: var(--accent-blue); color: white; border: none; padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 13px;">${esc(i)}</button>`;
        } else if (i === 1 || i === totalPages || (i >= cementSummaryCurrentPage - 1 && i <= cementSummaryCurrentPage + 1)) {
            pageNumbersHtml += `<button onclick="cementSummaryGoToPage(${esc(i)})" style="background: var(--card-bg); color: var(--text-main); border: 1px solid var(--border-color); padding: 6px 10px; border-radius: 6px; cursor: pointer; font-size: 13px;">${esc(i)}</button>`;
        } else if (i === cementSummaryCurrentPage - 2 || i === cementSummaryCurrentPage + 2) {
            pageNumbersHtml += `<span style="color: var(--text-muted);">...</span>`;
        }
    }
    pageNumbersDiv.innerHTML = pageNumbersHtml;
}
</script>

