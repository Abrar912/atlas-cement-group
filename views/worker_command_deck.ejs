// Refresh financial metrics periodically
function refreshFinancialMetrics() {
    console.log('[DEBUG] Refreshing financial metrics...');
    fetch('/api/worker/financial-metrics', {
        headers: {
            'Cache-Control': 'no-cache, no-store',
            'Pragma': 'no-cache'
        }
    })
        .then(res => {
            if (res.redirected || res.status === 401 || res.status === 403) {
                // Session lost (requireRole redirects to /login) or denied: stop the
                // stream/poll so a stale tab stops emitting errors (Phase 2 403/401 fix).
                if (typeof stopMetricsStream === 'function') stopMetricsStream();
                if (res.redirected || res.status === 401) {
                    window.location.href = '/login';
                    return;
                }
                throw new Error(`HTTP error! status: ${res.status}`);
            }
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(applyFinancialMetrics)
        .catch(err => {
            console.error('[ERROR] Error refreshing financial metrics:', err);
        });
}

// Phase 6 — shared metrics renderer (SSE push, fallback fetch, visibility refresh)
function applyFinancialMetrics(data) {
            const metricReceivablesEl = document.getElementById('metric-receivables');
            const metricPayablesEl = document.getElementById('metric-payables');
            
            if (metricReceivablesEl) {
                // Preserve the span with translation, only update the numeric value
                const afsSpan = metricReceivablesEl.querySelector('span');
                const formattedValue = data.total_receivables.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1});
                if (afsSpan) {
                    metricReceivablesEl.childNodes[0].textContent = formattedValue + ' ';
                } else {
                    metricReceivablesEl.innerHTML = `${esc(formattedValue)} <span><%= t('worker_command_deck.afs') %></span>`;
                }
            }
            if (metricPayablesEl) {
                // Preserve the span with translation, only update the numeric value
                const afsSpan = metricPayablesEl.querySelector('span');
                const formattedValue = data.total_payables.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1});
                if (afsSpan) {
                    metricPayablesEl.childNodes[0].textContent = formattedValue + ' ';
                } else {
                    metricPayablesEl.innerHTML = `${esc(formattedValue)} <span><%= t('worker_command_deck.afs') %></span>`;
                }
            }
            
    console.log('[DEBUG] Financial metrics updated:', data);
}

// Phase 6 — server push (SSE) replaces the old 5s poll; stale-tab guarantees kept (stop + redirect)
var metricsStream = null;
function stopMetricsStream() {
    if (metricsStream) { metricsStream.close(); metricsStream = null; }
}
function startMetricsStream() {
    if (!window.EventSource) { refreshFinancialMetrics(); return; }
    stopMetricsStream();
    metricsStream = new EventSource('/api/worker/financial-metrics/stream');
    metricsStream.onmessage = function (e) {
        try { applyFinancialMetrics(JSON.parse(e.data)); } catch (err) { console.error('[ERROR] metrics parse:', err); }
    };
    metricsStream.addEventListener('session-lost', function () {
        stopMetricsStream();
        window.location.href = '/login';
    });
    metricsStream.onerror = function () {
        stopMetricsStream();
        // Mirror the Phase-2 guarantees: check the session once; redirect if gone, else retry later.
        fetch('/api/worker/financial-metrics', { headers: { 'Cache-Control': 'no-cache' } })
            .then(function (res) {
                if (res.redirected || res.status === 401) { window.location.href = '/login'; return; }
                if (res.status === 403) { return; }
                setTimeout(startMetricsStream, 10000);
            })
            .catch(function () { setTimeout(startMetricsStream, 10000); });
    };
}
startMetricsStream();

// Refresh metrics when page becomes visible again (tab switch)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
        refreshFinancialMetrics();
    }
});

// Refresh metrics when window gains focus
window.addEventListener('focus', function() {
    refreshFinancialMetrics();
});

