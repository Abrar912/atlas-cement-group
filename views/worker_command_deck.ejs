<script>
document.getElementById('nav-worker-command-deck').classList.add('active');

// Table Pagination State
let currentTableData = [];
let filteredTableData = [];
let currentPage = 1;
let rowsPerPage = 10; // Default dynamic rows count

// Load agent log submissions
function loadAgentLogSubmissions() {
    console.log('[DEBUG] Loading agent log submissions...');
    
    // Get current filter values
    const province = document.getElementById('filter_province').value;
    const balance = document.getElementById('filter_balance').value;
    const customerId = document.getElementById('filter_customer').value;
    const cement = document.getElementById('filter_cement').value;
    const truck = document.getElementById('filter_truck').value;
    const startDate = document.getElementById('filter_start_date').value;
    const endDate = document.getElementById('filter_end_date').value;
    const searchDriver = document.getElementById('search_driver').value;
    const searchWaybill = document.getElementById('search_waybill').value;
    
    // Build query URL with filter parameters (worker-scoped API)
    let queryUrl = `/api/worker/agent-log-submissions?province=${province}&balance=${balance}&customer_id=${customerId}&cement=${cement}&truck=${truck}&start_date=${startDate}&end_date=${endDate}&search_driver=${searchDriver}&search_waybill=${searchWaybill}`;
    
    fetch(queryUrl)
        .then(res => {
            console.log('[DEBUG] Response status:', res.status);
            if (!res.ok) {
                throw new Error(`HTTP error! status: ${res.status}`);
            }
            return res.json();
        })
        .then(data => {
            console.log('[DEBUG] Data received:', data);
            currentTableData = data.records || [];
            filteredTableData = [...currentTableData];
            renderAgentLogTable(filteredTableData);
        })
        .catch(err => {
            console.error('[ERROR] Error loading agent log submissions:', err);
            const pageData = document.querySelector('.dashboard-container');
            document.getElementById('agent-log-submissions-rows').innerHTML = `<tr><td colspan="16" style="text-align: center; color:#cf222e; padding:20px;">${esc(pageData.getAttribute('data-error-loading'))}: ${esc(err.message)}</td></tr>`;
        });
}

// Global customer balance cache
let customerBalancesCache = {};

// Fetch customer balances for status badges
function fetchCustomerBalances() {
    fetch('/api/reports/customer-balances')
        .then(res => res.json())
        .then(data => {
            customerBalancesCache = {};
            if (data.balances) {
                data.balances.forEach(bal => {
                    customerBalancesCache[bal.customer_id] = bal.net_balance;
                });
            }
            console.log('[DEBUG] Customer balances loaded:', customerBalancesCache);
        })
        .catch(err => {
            console.error('[ERROR] Error fetching customer balances:', err);
        });
}

// Render table with data and calculate totals
function renderAgentLogTable(records) {
    const rowsContainer = document.getElementById('agent-log-submissions-rows');
    let html = '';
    
    // Declare element references once at function level
    const totalBagsEl = document.getElementById('total-bags');
    const totalTonnageEl = document.getElementById('total-tonnage');
    const totalShortageEl = document.getElementById('total-shortage');
    const totalSalesEl = document.getElementById('total-sales');
    const totalFreightEl = document.getElementById('total-freight');
    const totalNetCementEl = document.getElementById('total-net-cement');
    
    if (!records || records.length === 0) {
        const pageData = document.querySelector('.dashboard-container');
        html = `
            <tr>
                <td colspan="19" class="empty-state-cell">
                    <div class="empty-state-content">
                        <span class="empty-state-icon">🔍</span>
                        <p class="empty-state-title">
                            ${esc(pageData.getAttribute('data-no-records'))}
                        </p>
                        <p class="empty-state-description">
                            ${esc(pageData.getAttribute('data-no-records-sub'))}
                        </p>
                    </div>
                </td>
            </tr>
        `;
        // Reset footer totals safely

        if (totalBagsEl) totalBagsEl.textContent = '0';
        if (totalTonnageEl) totalTonnageEl.textContent = '0';
        if (totalShortageEl) totalShortageEl.textContent = '0';
        if (totalSalesEl) totalSalesEl.textContent = '0';
        if (totalFreightEl) totalFreightEl.textContent = '0';
        if (totalNetCementEl) totalNetCementEl.textContent = '0';
        
        // Reset pagination display
        updatePaginationControls(0);
    } else {
        // Initialize totals
        let totalBags = 0;
        let totalTonnage = 0;
        let totalShortage = 0;
        let totalCost = 0;
        let totalSales = 0;
        let totalFreight = 0;
        let totalNetCement = 0;
        
        // Calculate pagination
        const totalPages = Math.ceil(records.length / rowsPerPage) || 1;
        const startIndex = (currentPage - 1) * rowsPerPage;
        const paginatedRecords = records.slice(startIndex, startIndex + rowsPerPage);
        
        paginatedRecords.forEach((row, index) => {
            // Auto-calculate dynamic fields
            const bagsCount = row.bags_count || 0;
            const unitPriceBag = row.unit_price_bag || 0;
            const tonnage = row.tonnage || 0;
            const freightPerTon = row.freight_per_ton || 0;
            const rowTotalFreight = row.total_freight || 0;
            
            // Determine truck type from the original waybill's truck_type field
            const pageData = document.querySelector('.dashboard-container');
            const truckType = row.truck_type ? row.truck_type : (row.is_company_car === 1 ? pageData.getAttribute('data-truck-company') : pageData.getAttribute('data-truck-rental'));
            
            // Calculate: جمله = تعداد کیسه × فی بوجی
            const calculatedCost = bagsCount * unitPriceBag;
            
            // Calculate: جمله فروش = تعداد کیسه × فی فروش (using total_sales_money / bags_count as sale price per bag)
            const salePricePerBag = bagsCount > 0 ? row.total_sales_money / bagsCount : 0;
            const calculatedTotalSales = row.total_sales_money || 0;
            
            // Calculate: جمله کرایه = تناژ × فی تن کرایه
            const calculatedTotalFreight = tonnage * freightPerTon;
            
            // Calculate: پول خالص سمنت = جمله فروش - جمله کرایه
            const calculatedNetCement = calculatedTotalSales - calculatedTotalFreight;
            
            // Update totals
            totalBags += bagsCount;
            totalTonnage += tonnage;
            totalShortage += (row.shortage || 0);
            totalCost += calculatedCost;
            totalSales += calculatedTotalSales;
            totalFreight += calculatedTotalFreight;
            totalNetCement += calculatedNetCement;
            
            html += `
                <tr style="border-bottom: 1px solid #eaeef2;">
                    <td class="table-row-number">${esc(startIndex + index + 1)}</td>
                    <td>${esc(row.loading_date || row.sale_date || '-')}</td>
                    <td>${esc(row.sale_date || '-')}</td>
                    <td style="font-weight: 600;">
                        <span style="color: #0969da; cursor: pointer;" onclick="openCustomerModal('${esc(row.customer_id)}')">
                            ${esc(row.customer_name || 'Unknown')}
                        </span>
                    </td>
                    <td>${esc(row.customer_province || '-')}</td>
                    <td>${esc(row.driver_name || '-')}</td>
                    <td style="direction: ltr;">${esc(row.driver_phone || '-')}</td>
                    <td>${esc(row.car_plate || '-')}</td>
                    <td>${esc(row.waybill_number || '-')}</td>
                    <td>${esc(row.cement_type || '-')}</td>
                    <td>${esc(truckType)}</td>
                    <td style="font-weight: 600;">${esc(bagsCount.toLocaleString())}</td>
                    <td>${esc(tonnage.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td>${esc((row.shortage || 0).toLocaleString())}</td>
                    <td>${esc(unitPriceBag.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td style="font-weight: 600;">${esc(calculatedTotalSales.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td>${esc(freightPerTon.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td style="font-weight: 600;">${esc(calculatedTotalFreight.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td style="font-weight: 700; color: #166534;">${esc(calculatedNetCement.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                </tr>
            `;
        });
        
        // Update footer totals safely
        if (totalBagsEl) totalBagsEl.textContent = totalBags.toLocaleString();
        if (totalTonnageEl) totalTonnageEl.textContent = totalTonnage.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        if (totalShortageEl) totalShortageEl.textContent = totalShortage.toLocaleString();
        if (totalSalesEl) totalSalesEl.textContent = totalSales.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        if (totalFreightEl) totalFreightEl.textContent = totalFreight.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        if (totalNetCementEl) totalNetCementEl.textContent = totalNetCement.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        
        // Update pagination controls
        updatePaginationControls(records.length);
    }
    
    rowsContainer.innerHTML = html;
}

// Update Pagination Counters & Buttons
function updatePaginationControls(totalRecords) {
    const totalPages = Math.ceil(totalRecords / rowsPerPage) || 1;
    const start = totalRecords === 0 ? 0 : (currentPage - 1) * rowsPerPage + 1;
    const end = Math.min(currentPage * rowsPerPage, totalRecords);

    if (document.getElementById('lbl_page_start')) document.getElementById('lbl_page_start').textContent = start.toLocaleString();
    if (document.getElementById('lbl_page_end')) document.getElementById('lbl_page_end').textContent = end.toLocaleString();
    if (document.getElementById('lbl_total_count')) document.getElementById('lbl_total_count').textContent = totalRecords.toLocaleString();
    const pageData = document.querySelector('.dashboard-container');
    const pageOfTemplate = pageData.getAttribute('data-page-of');
    if (document.getElementById('lbl_page_indicator')) document.getElementById('lbl_page_indicator').textContent = pageOfTemplate.replace('{current}', currentPage).replace('{total}', totalPages);

    if (document.getElementById('btn_page_prev')) document.getElementById('btn_page_prev').disabled = (currentPage === 1 || totalRecords === 0);
    if (document.getElementById('btn_page_next')) document.getElementById('btn_page_next').disabled = (currentPage === totalPages || totalRecords === 0);
}

