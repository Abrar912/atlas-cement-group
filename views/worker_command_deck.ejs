function applyCustomerSearch() {
    const customerId = document.getElementById('search_cust_id').value;
    const customerName = document.getElementById('search_cust_name').value;
    const province = document.getElementById('search_cust_province').value;
    const phone = document.getElementById('search_cust_phone').value;
    const address = document.getElementById('search_cust_address').value;
    
    // Build query parameters
    const queryParams = new URLSearchParams();
    if (customerId) queryParams.append('customer_id', customerId);
    if (customerName) queryParams.append('customer_name', customerName);
    if (province) queryParams.append('province', province);
    if (phone) queryParams.append('phone', phone);
    if (address) queryParams.append('address', address);
    
    // Call the API with search parameters
    fetch(`/api/agency/customers?${queryParams.toString()}`, {
        credentials: 'include'
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            console.error('[ERROR] Search error:', data.error);
            alert('Error: ' + data.error);
            return;
        }
        
        // Update the customer dropdown with search results
        const customerSelect = document.getElementById('filter_customer');
        if (customerSelect) {
            // Clear existing options except "All"
            customerSelect.innerHTML = '<option value="All">-- All Customers --</option>';
            
            // Add search results
            data.customers.forEach(customer => {
                const option = document.createElement('option');
                option.value = customer.id;
                option.textContent = `${customer.customer_id || customer.id} - ${customer.name}`;
                customerSelect.appendChild(option);
            });
            
            // Select the first customer if results exist
            if (data.customers.length > 0) {
                customerSelect.value = data.customers[0].id;
            }
        }
        
        // Close the modal
        closeCustomerSearchModal();
        
        // Apply filters to refresh the table with the selected customer
        applyFilters();
        
        // Show result count
        const resultCount = data.customers.length;
        if (resultCount === 0) {
            alert('No customers found matching your search criteria.');
        } else {
            console.log(`[DEBUG] Found ${resultCount} customer(s) matching search criteria.`);
        }
    })
    .catch(err => {
        console.error('[ERROR] Search failed:', err);
        alert('Error searching customers. Please try again.');
    });
}

