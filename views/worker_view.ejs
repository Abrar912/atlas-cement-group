<%- include('partials/header') %>

<style>
    /* ============================================================
       Worker Desk — Waybill Card Design (redesigned 2026-10-19)
       Visual language matches the official waybill (admin/local-waybill)
       ============================================================ */

    /* --- Buttons (explicit light/dark colors, kept from previous design) --- */
    :root:not([data-theme="dark"]) .worker-btn-danger { background-color: #DC2626 !important; color: #FFFFFF !important; border: 1px solid #DC2626 !important; }
    :root:not([data-theme="dark"]) .worker-btn-danger:hover { background-color: #B91C1C !important; border-color: #B91C1C !important; }
    :root:not([data-theme="dark"]) .worker-btn-success { background-color: #059669 !important; color: #FFFFFF !important; border: 1px solid #059669 !important; }
    :root:not([data-theme="dark"]) .worker-btn-success:hover { background-color: #047857 !important; border-color: #047857 !important; }
    :root:not([data-theme="dark"]) .worker-btn-primary { background-color: #2563EB !important; color: #FFFFFF !important; border: 1px solid #2563EB !important; }
    :root:not([data-theme="dark"]) .worker-btn-primary:hover { background-color: #1D4ED8 !important; border-color: #1D4ED8 !important; }
    [data-theme="dark"] .worker-btn-danger { background-color: #EF4444 !important; color: #FFFFFF !important; border: 1px solid #EF4444 !important; }
    [data-theme="dark"] .worker-btn-danger:hover { background-color: #DC2626 !important; border-color: #DC2626 !important; }
    [data-theme="dark"] .worker-btn-success { background-color: #10B981 !important; color: #FFFFFF !important; border: 1px solid #10B981 !important; }
    [data-theme="dark"] .worker-btn-success:hover { background-color: #059669 !important; border-color: #059669 !important; }
    [data-theme="dark"] .worker-btn-primary { background-color: #3B82F6 !important; color: #FFFFFF !important; border: 1px solid #3B82F6 !important; }
    [data-theme="dark"] .worker-btn-primary:hover { background-color: #2563EB !important; border-color: #2563EB !important; }

    .worker-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        border: none;
        line-height: 1.2;
    }
    .worker-btn svg { width: 16px; height: 16px; }
    .worker-btn-primary { background-color: var(--accent-blue) !important; color: white !important; box-shadow: 0 1px 3px rgba(37, 99, 235, 0.25); }
    .worker-btn-primary:hover { box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35); transform: translateY(-1px); }
    .worker-btn-success { background-color: var(--success-green) !important; color: white !important; box-shadow: 0 1px 3px rgba(5, 150, 105, 0.25); }
    .worker-btn-success:hover { box-shadow: 0 4px 12px rgba(5, 150, 105, 0.35); transform: translateY(-1px); }
    .worker-btn-danger { background-color: var(--danger-red) !important; color: white !important; box-shadow: 0 1px 3px rgba(220, 38, 38, 0.25); }
    .worker-btn-danger:hover { box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35); transform: translateY(-1px); }
    .worker-btn-secondary { background-color: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--border-color); }
    .worker-btn-secondary:hover { background-color: var(--bg-tertiary); }

    /* --- Page header --- */
    .worker-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        padding: 18px 22px;
        margin-bottom: 22px;
        border-radius: 14px;
        background: linear-gradient(135deg, rgba(207, 34, 46, 0.08), rgba(37, 99, 235, 0.08));
        border: 1px solid var(--border-color);
    }
    .worker-page-header h2 {
        margin: 0 0 4px 0;
        font-size: 22px;
        font-weight: 800;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .worker-page-header h2 svg { color: #cf222e; }
    .worker-page-header p { margin: 0; font-size: 13px; color: var(--text-muted); }
    .worker-station-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background-color: rgba(59, 130, 246, 0.1);
        color: var(--accent-blue);
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid rgba(59, 130, 246, 0.25);
    }
    .worker-station-badge svg { width: 15px; height: 15px; }

    /* --- Section headers --- */
    .worker-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 18px;
    }
    .worker-section-header .section-title-wrap { display: flex; align-items: center; gap: 12px; }
    .worker-section-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(207, 34, 46, 0.1);
        color: #cf222e;
        flex-shrink: 0;
    }
    .worker-section-icon svg { width: 20px; height: 20px; }
    .worker-section-header h3 { margin: 0 0 2px 0; font-size: 17px; font-weight: 700; color: var(--text-primary); }
    .worker-section-header p { margin: 0; font-size: 12.5px; color: var(--text-muted); }
    .worker-count-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 26px;
        height: 26px;
        padding: 0 8px;
        margin-inline-start: 8px;
        border-radius: 999px;
        background: #cf222e;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
        vertical-align: middle;
    }
    .worker-count-badge.zero { background: var(--bg-tertiary); color: var(--text-muted); }

    /* --- Waybill card grid --- */
    .waybill-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(305px, 1fr));
        gap: 18px;
    }

    /* --- Mini waybill card (paper look, works in both themes) --- */
    .wb-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
        animation: wbPop 0.25s ease both;
    }
    @keyframes wbPop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    .wb-card:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(0, 0, 0, 0.14); border-color: rgba(207, 34, 46, 0.45); }
    .wb-card.clickable { cursor: pointer; }

    .wb-band {
        background: #cf222e;
        color: #fff;
        padding: 9px 14px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
    }
    .wb-band .wb-company { font-size: 11px; font-weight: 600; opacity: 0.92; letter-spacing: 0.2px; }
    .wb-band .wb-serial { font-size: 16px; font-weight: 800; letter-spacing: 0.4px; }
    .wb-band .wb-date { font-size: 12px; font-weight: 600; opacity: 0.95; white-space: nowrap; }

    .wb-body { padding: 12px 14px; display: flex; flex-direction: column; gap: 9px; flex: 1; }
    .wb-row { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12.5px; }
    .wb-field { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .wb-field .wb-label { font-size: 10.5px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.3px; }
    .wb-field .wb-value { font-size: 13px; font-weight: 600; color: var(--text-primary); word-break: break-word; }
    .wb-divider { border: none; border-top: 1px dashed var(--border-color); margin: 2px 0; }
    .wb-tonnage { color: #0284c7; }
    .wb-freight { color: #166534; }
    .wb-net { color: #0284c7; font-weight: 800 !important; }
    .wb-remarks {
        font-size: 12px;
        color: var(--text-muted);
        background: var(--bg-light, var(--bg-secondary));
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 7px 10px;
    }
    .wb-route {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--text-primary);
    }
    .wb-route svg { width: 14px; height: 14px; color: #cf222e; flex-shrink: 0; }
    .wb-footer { padding: 0 14px 14px; display: flex; gap: 8px; }
    .wb-footer .worker-btn { flex: 1; }

    /* --- Empty / loading / error states --- */
    .worker-empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 44px 20px;
        color: var(--text-muted);
        border: 1.5px dashed var(--border-color);
        border-radius: 12px;
        background: var(--bg-secondary);
    }
    .worker-empty-state svg { width: 44px; height: 44px; margin-bottom: 10px; opacity: 0.55; }
    .worker-empty-state p { margin: 4px 0; font-size: 14px; }
    .worker-empty-state p:first-child { font-weight: 600; color: var(--text-primary); }

    /* --- Modal (shared shell: sale entry + dialogs) --- */
    .worker-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 18, 26, 0.55);
        backdrop-filter: blur(2px);
        z-index: 1500;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }
    .worker-modal {
        background: var(--modal-bg);
        border-radius: 14px;
        width: 100%;
        max-width: 640px;
        max-height: 92vh;
        overflow-y: auto;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        animation: wbModalIn 0.2s ease both;
    }
    @keyframes wbModalIn { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
    .worker-modal-band {
        background: #cf222e;
        color: #fff;
        padding: 13px 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        position: sticky;
        top: 0;
        z-index: 2;
    }
    .worker-modal-band .wbm-title { font-size: 15px; font-weight: 700; display: flex; align-items: center; gap: 8px; }
    .worker-modal-band .wbm-title svg { width: 18px; height: 18px; }
    .worker-modal-band .wbm-serial { font-size: 15px; font-weight: 800; background: rgba(255, 255, 255, 0.18); padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
    .worker-modal-close {
        background: rgba(255, 255, 255, 0.15);
        border: none;
        color: #fff;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        flex-shrink: 0;
        transition: background 0.15s ease;
    }
    .worker-modal-close:hover { background: rgba(255, 255, 255, 0.3); }
    .worker-modal-body { padding: 18px; }

    /* Selected waybill info panel inside the modal */
    .worker-waybill-info {
        background: var(--bg-light, var(--bg-secondary));
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 16px;
    }
    .worker-waybill-info h4 { margin: 0 0 10px 0; font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.4px; }
    .worker-info-grid { display: flex; flex-wrap: wrap; gap: 10px 20px; font-size: 13px; }
    .worker-info-item { display: flex; align-items: baseline; gap: 5px; }
    .worker-info-item strong { color: var(--text-muted); font-weight: 500; font-size: 12px; }
    .worker-info-item span { color: var(--text-primary); font-weight: 600; }

    /* Forms inside modal */
    .worker-form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .worker-form-grid .form-group { margin: 0; }
    .worker-form-grid .form-group label { display: block; margin-bottom: 5px; font-size: 12.5px; font-weight: 600; color: var(--text-primary); }
    .worker-form-grid .form-control { height: 38px; padding: 8px 12px; font-size: 13px; }
    .worker-readonly-field { background-color: var(--bg-light, var(--bg-secondary)) !important; color: var(--text-muted) !important; font-weight: 600; }
    .worker-calculated-field { background-color: rgba(2, 132, 199, 0.08) !important; border-color: rgba(2, 132, 199, 0.35) !important; color: #0284c7 !important; font-weight: 700; }

    /* --- App dialog (confirm / alert) --- */
    .worker-dialog-modal { max-width: 430px; }
    .worker-dialog-body { padding: 26px 24px 20px; text-align: center; }
    .worker-dialog-icon {
        width: 54px;
        height: 54px;
        margin: 0 auto 14px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .worker-dialog-icon svg { width: 26px; height: 26px; }
    .worker-dialog-icon.confirm { background: rgba(2, 132, 199, 0.12); color: #0284c7; }
    .worker-dialog-icon.success { background: rgba(5, 150, 105, 0.12); color: #059669; }
    .worker-dialog-icon.error { background: rgba(220, 38, 38, 0.12); color: #dc2626; }
    .worker-dialog-title { margin: 0 0 8px; font-size: 16px; font-weight: 700; color: var(--text-primary); }
    .worker-dialog-message { margin: 0; font-size: 13.5px; color: var(--text-muted); line-height: 1.55; }
    .worker-dialog-actions { display: flex; gap: 10px; justify-content: center; margin-top: 20px; }
    .worker-dialog-actions .worker-btn { min-width: 110px; }

    /* --- Responsive --- */
    @media (max-width: 640px) {
        .worker-page-header { padding: 14px 16px; }
        .worker-page-header h2 { font-size: 18px; }
        .worker-modal { max-width: 100%; }
        .wb-footer { flex-direction: column; }
    }

    /* --- Dark mode --- */
    html[data-theme="dark"] .worker-station-badge { background-color: rgba(59, 130, 246, 0.2); border-color: rgba(59, 130, 246, 0.3); }
    html[data-theme="dark"] .worker-section-icon { background: rgba(207, 34, 46, 0.22); }
    html[data-theme="dark"] .wb-card:hover { box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5); }
    html[data-theme="dark"] .worker-modal { box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7); }
</style>

<div class="worker-page-header">
    <div>
        <h2>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <%= t('worker.daily_logs_title') %>
        </h2>
        <p><%= t('worker.daily_logs_subtitle') %></p>
    </div>
    <span class="worker-station-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <%= t('worker.station') %>: <%= session.province %>
    </span>
</div>

<!-- STEP 1: Incoming Waybills (waybill cards) -->
<div class="card" style="margin-bottom: 20px; padding: 20px; border-radius: 14px;">
    <div class="worker-section-header">
        <div class="section-title-wrap">
            <span class="worker-section-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
            </span>
            <div>
                <h3><%= t('worker.incoming_waybills_title') %><span class="worker-count-badge zero" id="incoming-count">0</span></h3>
                <p><%= t('worker.incoming_waybills_subtitle') %></p>
            </div>
        </div>
        <button onclick="loadIncomingWaybills()" class="worker-btn worker-btn-primary">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            <%= t('worker.refresh_list') %>
        </button>
    </div>

    <div id="incoming-waybills-grid" class="waybill-grid">
        <div class="worker-empty-state">
            <p><%= t('worker.loading_waybills') %></p>
        </div>
    </div>
</div>

<!-- STEP 3: Sales Report Waiting Queue (waybill cards) -->
<div class="card" style="margin-bottom: 20px; padding: 20px; border-radius: 14px;">
    <div class="worker-section-header">
        <div class="section-title-wrap">
            <span class="worker-section-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                    <polyline points="14 2 14 8 20 8"></polyline>
                    <line x1="16" y1="13" x2="8" y2="13"></line>
                    <line x1="16" y1="17" x2="8" y2="17"></line>
                    <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
            </span>
            <div>
                <h3><%= t('worker.waiting_queue_title') %><span class="worker-count-badge zero" id="queue-count">0</span></h3>
                <p><%= t('worker.waiting_queue_subtitle') %></p>
            </div>
        </div>
        <button onclick="sendReportToAdmin()" class="worker-btn worker-btn-success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
            <%= t('worker.send_to_admin') %>
        </button>
    </div>

    <div id="waiting-queue-grid" class="waybill-grid">
        <div class="worker-empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <p><%= t('worker.js_no_entries') %></p>
        </div>
    </div>
</div>

<!-- STEP 2: Sale Entry Modal (opens when a waybill card is clicked) -->
<div id="sale-modal" class="worker-modal-overlay">
    <div class="worker-modal">
        <div class="worker-modal-band">
            <span class="wbm-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
                <%= t('worker.sale_entry_title') %>
            </span>
            <span class="wbm-serial" id="modal-waybill-serial">-</span>
            <button type="button" class="worker-modal-close" onclick="clearSelectedWaybill()" aria-label="<%= t('admin.close') %>">&times;</button>
        </div>
        <div class="worker-modal-body">
            <p style="margin: 0 0 14px; font-size: 12.5px; color: var(--text-muted);"><%= t('worker.sale_entry_subtitle') %></p>

            <!-- Selected Waybill Details (Read-only) -->
            <div class="worker-waybill-info">
                <h4><%= t('worker.waybill_info') %></h4>
                <div class="worker-info-grid">
                    <div class="worker-info-item"><strong><%= t('worker.serial_number') %></strong><span id="selected-waybill-serial">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.loading_date') %></strong><span id="selected-waybill-date">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.driver_name') %></strong><span id="selected-waybill-driver">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.plate_number') %></strong><span id="selected-waybill-plate">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.cement_type') %></strong><span id="selected-waybill-cement">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.bag_count') %></strong><span id="selected-waybill-bags">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.tonnage') %></strong><span id="selected-waybill-tonnage">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.truck_type') %></strong><span id="selected-waybill-truck-type">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.loading_location') %></strong><span id="selected-waybill-loading">-</span></div>
                    <div class="worker-info-item"><strong><%= t('worker.unloading_location') %></strong><span id="selected-waybill-unloading">-</span></div>
                </div>
            </div>

            <!-- Sale Entry Form -->
            <form id="sale-entry-form" onsubmit="addSaleToQueue(event)">
                <input type="hidden" id="selected-waybill-id">
                <div class="worker-form-grid">
                    <div class="form-group">
                        <label><%= t('worker.sale_date') %></label>
                        <input type="text" id="sale_date" class="form-control" data-datepicker="jalali" placeholder="1405/03/23" required>
                    </div>
                    <div class="form-group">
                        <label><%= t('worker.customer_account') %></label>
                        <select id="customer_id" class="form-control" required>
                            <option value=""><%= t('worker.choose_customer') %></option>
                            <% customers.forEach(function(customer) { %>
                                <%
                                    const cleanId = customer.customer_id ? customer.customer_id.match(/^([A-Z]{3}-\d+)/i) ? customer.customer_id.match(/^([A-Z]{3}-\d+)/i)[1].toUpperCase() : customer.customer_id : customer.id;
                                %>
                                <option value="<%= customer.id %>"><%= cleanId %> - <%= customer.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
