                    <div class="form-group">
                        <label><%= t('worker.total_sales') %></label>
                        <input type="number" step="0.1" id="total_sale_amount" class="form-control worker-readonly-field" readonly>
                    </div>
                    <div class="form-group">
                        <label><%= t('worker.total_freight') %></label>
                        <input type="number" step="0.1" id="total_freight" class="form-control worker-readonly-field" readonly>
                    </div>
                    <div class="form-group">
                        <label><%= t('worker.net_cement') %></label>
                        <input type="number" step="0.1" id="net_cement_money" class="form-control worker-calculated-field" readonly>
