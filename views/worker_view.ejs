                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTotalFreight)}</span>
                            <span class="wb-value wb-freight">${esc((entry.total_freight || 0).toLocaleString())}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsNetCement)}</span>
                            <span class="wb-value wb-net">${esc((entry.net_cement_money || 0).toLocaleString())}</span>
                        </div>
                    </div>
                </div>
                <div class="wb-footer">
                    <button onclick="editQueueEntry(${esc(idx)})" class="worker-btn worker-btn-primary" style="flex: 1;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        ${esc(i18nStrings.jsEdit)}
                    </button>
                    <button onclick="removeQueueEntry(${esc(idx)})" class="worker-btn worker-btn-danger" style="flex: 1;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 14px; height: 14px;">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        ${esc(i18nStrings.jsRemove)}
                    </button>
                </div>
            </div>`;
    });
    grid.innerHTML = html;
}

/* ============================================================
   Edit queue entry (modal, same behavior as before)
   ============================================================ */
function editQueueEntry(index) {
    const entry = waitingQueue[index];
    editingQueueIndex = index;

    const modalHtml = `
        <div id="edit-modal" class="worker-modal-overlay" style="display: flex;">
            <div class="worker-modal">
                <div class="worker-modal-band">
                    <span class="wbm-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        ${esc(i18nStrings.jsEditTitle)}
                    </span>
                    <span class="wbm-serial">${esc(entry.waybill_serial || '-')}</span>
                    <button type="button" class="worker-modal-close" onclick="closeEditModal()">&times;</button>
                </div>
                <div class="worker-modal-body">
                    <!-- Read-only Waybill Information -->
                    <div class="worker-waybill-info">
                        <h4>${esc(i18nStrings.jsWaybillReadonly)}</h4>
                        <div class="worker-info-grid">
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsWaybillSerial)}</strong><span>${esc(entry.waybill_serial)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsWaybillDate)}</strong><span>${esc(entry.waybill_date)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsDriverName)}</strong><span>${esc(entry.driver_name)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsDriverPhone)}</strong><span>${esc(entry.driver_phone || '-')}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsTruckPlate)}</strong><span>${esc(entry.truck_plate)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsCementType)}</strong><span>${esc(entry.cement_type)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsBagCount)}</strong><span>${esc(entry.total_bags)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsTonnage)}</strong><span>${esc(entry.tonnage)}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsTruckType)}</strong><span>${esc(entry.truck_type || '-')}</span></div>
                            <div class="worker-info-item"><strong>${esc(i18nStrings.jsFreightTotal)}</strong><span>${esc(entry.total_freight.toLocaleString())}</span></div>
                        </div>
                    </div>

                    <!-- Editable Sale Fields -->
                    <div class="worker-form-grid" style="grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsSaleDate)}</label>
                            <input type="text" id="edit_sale_date" class="form-control" value="${esc(entry.sale_date)}" data-datepicker="jalali">
                        </div>
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsCustomer)}</label>
                            <select id="edit_customer_id" class="form-control">
                                ${esc(customers.map(c => `<option value="${c.id}" ${c.id === entry.customer_id ? 'selected' : ''}>${c.name}</option>`).join(''))}
                            </select>
                        </div>
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsShortage)}</label>
                            <input type="number" id="edit_shortage_bags" class="form-control" value="${esc(entry.shortage_bags)}" oninput="calculateEditTotals()">
                        </div>
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsUnitPrice)}</label>
                            <input type="number" step="0.1" id="edit_sale_unit_price" class="form-control" value="${esc(entry.sale_unit_price)}" oninput="calculateEditTotals()">
                        </div>
                    </div>

                    <!-- Calculated Totals (Read-only) -->
                    <div class="worker-form-grid" style="grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 18px;">
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsTotalSales)}</label>
                            <input type="number" step="0.1" id="edit_total_sale_amount" class="form-control worker-readonly-field" readonly>
                        </div>
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsTotalFreight)}</label>
                            <input type="number" step="0.1" id="edit_total_freight" class="form-control worker-readonly-field" readonly value="${esc(entry.total_freight)}">
                        </div>
                        <div class="form-group">
                            <label>${esc(i18nStrings.jsNetCement)}</label>
                            <input type="number" step="0.1" id="edit_net_cement_money" class="form-control worker-calculated-field" readonly>
                        </div>
                    </div>

                    <div style="display: flex; gap: 10px;">
                        <button onclick="closeEditModal()" class="worker-btn worker-btn-secondary" style="flex: 1; padding: 11px;">${esc(i18nStrings.jsCancel)}</button>
                        <button onclick="saveEdit()" class="worker-btn worker-btn-success" style="flex: 2; padding: 11px;">${esc(i18nStrings.jsSave)}</button>
                    </div>
                </div>
            </div>
        </div>
    `;

    document.body.insertAdjacentHTML('beforeend', modalHtml);
    calculateEditTotals();
}

function calculateEditTotals() {
    const shortageBags = parseInt(document.getElementById('edit_shortage_bags').value) || 0;
    const unitPrice = parseFloat(document.getElementById('edit_sale_unit_price').value) || 0;

    const entry = waitingQueue[editingQueueIndex];
    const totalBags = entry.total_bags || 0;
    const soldBags = totalBags - shortageBags;

    const totalSales = soldBags * unitPrice;
    document.getElementById('edit_total_sale_amount').value = totalSales.toFixed(2);

    const totalFreight = entry.total_freight || 0;
    const netCement = totalSales - totalFreight;
    document.getElementById('edit_net_cement_money').value = netCement.toFixed(2);
}

function closeEditModal() {
    const modal = document.getElementById('edit-modal');
    if (modal) {
        modal.remove();
    }
    editingQueueIndex = null;
}

function saveEdit() {
    const entry = waitingQueue[editingQueueIndex];

    const saleDate = document.getElementById('edit_sale_date').value;
    const customerId = parseInt(document.getElementById('edit_customer_id').value);
    const customer = customers.find(c => c.id === customerId);
    const shortageBags = parseInt(document.getElementById('edit_shortage_bags').value) || 0;
    const saleUnitPrice = parseFloat(document.getElementById('edit_sale_unit_price').value) || 0;
    const totalSaleAmount = parseFloat(document.getElementById('edit_total_sale_amount').value) || 0;
    const netCementMoney = parseFloat(document.getElementById('edit_net_cement_money').value) || 0;

    entry.sale_date = saleDate;
    entry.customer_id = customerId;
    entry.customer_name = customer ? customer.name : 'Unknown';
    entry.shortage_bags = shortageBags;
    entry.sale_unit_price = saleUnitPrice;
    entry.total_sale_amount = totalSaleAmount;
    entry.net_cement_money = netCementMoney;

    renderWaitingQueue();
    closeEditModal();
}

/* ============================================================
   Remove from queue / send report (with in-app dialogs)
   ============================================================ */
async function removeQueueEntry(index) {
    const confirmed = await workerDialog({
        title: i18nStrings.jsRemove,
        message: i18nStrings.jsConfirmRemove,
        icon: 'error',
        confirmText: i18nStrings.jsRemove,
        confirmClass: 'worker-btn-danger'
    });
    if (!confirmed) return;

    const entry = waitingQueue[index];

    fetch('/api/worker/mark-waybill-available', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ waybill_id: entry.waybill_id })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            waitingQueue.splice(index, 1);
            renderWaitingQueue();
            loadIncomingWaybills();
        } else {
            workerDialog({ message: 'Error: ' + (data.error || 'Failed to remove from queue'), icon: 'error', showCancel: false });
        }
    })
    .catch(err => {
        console.error('Error marking waybill as available:', err);
        workerDialog({ message: 'Error: Failed to remove from queue', icon: 'error', showCancel: false });
    });
}

async function sendReportToAdmin() {
    if (waitingQueue.length === 0) {
        workerDialog({ message: i18nStrings.jsAlertEmptyQueue, icon: 'confirm', showCancel: false });
        return;
    }

    const confirmed = await workerDialog({
        title: '<%= t("worker.waiting_queue_title") %>',
        message: i18nStrings.jsConfirmSend.replace('{count}', waitingQueue.length),
        icon: 'confirm',
        confirmText: '<%= t("worker.send_to_admin") %>',
        confirmClass: 'worker-btn-success'
    });
    if (!confirmed) return;

    fetch('/api/worker/commit-waybill-sales-batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ salesBatch: waitingQueue })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            workerDialog({
                message: i18nStrings.jsAlertSuccess.replace('{count}', data.count),
                icon: 'success',
                showCancel: false
            });
            waitingQueue = [];
            renderWaitingQueue();
            loadIncomingWaybills();
        } else {
            workerDialog({ message: i18nStrings.jsAlertError + data.error, icon: 'error', showCancel: false });
        }
    })
    .catch(err => {
        workerDialog({ message: i18nStrings.jsAlertConnection, icon: 'error', showCancel: false });
    });
}

// Load data on page load
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
        loadIncomingWaybills();
        loadWaitingQueue();
    });
} else {
    loadIncomingWaybills();
    loadWaitingQueue();
}
</script>

