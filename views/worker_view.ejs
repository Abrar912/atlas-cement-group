    waitingQueue.forEach((entry, idx) => {
        html += `
            <div class="wb-card">
                <div class="wb-band">
                    <span class="wb-company">${esc(WB_COMPANY)}</span>
                    <span class="wb-serial">${esc(entry.waybill_serial || '-')}</span>
                    <span class="wb-date">${esc(entry.sale_date || '-')}</span>
                </div>
                <div class="wb-body">
                    <div class="wb-row">
                        <div class="wb-field" style="flex: 1;">
                            <span class="wb-label">${esc(i18nStrings.jsCustomer)}</span>
                            <span class="wb-value">${esc(entry.customer_name || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsSaleDate)}</span>
                            <span class="wb-value">${esc(entry.sale_date || '-')}</span>
                        </div>
                    </div>
                    <div class="wb-row">
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsDriverName)}</span>
                            <span class="wb-value">${esc(entry.driver_name || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsDriverPhone)}</span>
                            <span class="wb-value" dir="ltr">${esc(entry.driver_phone || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTruckPlate)}</span>
                            <span class="wb-value">${esc(entry.truck_plate || '-')}</span>
                        </div>
                    </div>
                    <hr class="wb-divider">
                    <div class="wb-row">
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsCementType)}</span>
                            <span class="wb-value">${esc(entry.cement_type || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsBagCount)}</span>
                            <span class="wb-value">${esc(entry.total_bags || '-')}${esc(entry.shortage_bags > 0 ? ' (-' + entry.shortage_bags + ')' : '')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTonnage)}</span>
                            <span class="wb-value wb-tonnage">${esc(entry.tonnage || '-')} Tons</span>
                        </div>
                    </div>
                    <hr class="wb-divider">
                    <div class="wb-row">
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsUnitPrice)}</span>
                            <span class="wb-value">${esc(entry.sale_unit_price || 0)}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTotalSales)}</span>
                            <span class="wb-value">${esc((entry.total_sale_amount || 0).toLocaleString())}</span>
