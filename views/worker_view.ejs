};

// Company name for the waybill card band (from the print key, same value in every language)
const WB_COMPANY = '<%= t("waybill.print_company_name") %>';

// Global state (unchanged)
let incomingWaybills = [];
let selectedWaybill = null;
let waitingQueue = [];
let editingQueueIndex = null;
let customers = <%- typeof customers !== 'undefined' ? jsonEmbed(customers) : '[]' %>;

const navWorkerSales = document.getElementById('nav-worker-sales');
if (navWorkerSales) {
    navWorkerSales.classList.add('active');
}

/* ============================================================
   App dialog helpers (replace browser confirm / alert)
   ============================================================ */
function workerDialog(opts) {
    return new Promise(resolve => {
        const overlay = document.getElementById('worker-dialog');
        const iconBox = document.getElementById('worker-dialog-icon');
        document.getElementById('worker-dialog-title').textContent = opts.title || '';
        document.getElementById('worker-dialog-message').textContent = opts.message || '';
        const confirmBtn = document.getElementById('worker-dialog-confirm');
        const cancelBtn = document.getElementById('worker-dialog-cancel');
        confirmBtn.textContent = opts.confirmText || jsClose;
        confirmBtn.className = 'worker-btn ' + (opts.confirmClass || 'worker-btn-primary');
        cancelBtn.textContent = opts.cancelText || jsCancelSafe();
        cancelBtn.style.display = opts.showCancel === false ? 'none' : '';
        iconBox.className = 'worker-dialog-icon ' + (opts.icon || 'confirm');
        overlay.style.display = 'flex';
        function done(v) {
            overlay.style.display = 'none';
            confirmBtn.onclick = null;
            cancelBtn.onclick = null;
            overlay.onclick = null;
            resolve(v);
        }
        confirmBtn.onclick = () => done(true);
        cancelBtn.onclick = () => done(false);
        overlay.onclick = (e) => { if (e.target === overlay) done(false); };
    });
}
function jsCancelSafe() { return i18nStrings.jsCancel; }
const jsClose = i18nStrings.jsClose;
const jsCancel = i18nStrings.jsCancel;

/* ============================================================
   Incoming waybills
   ============================================================ */
function loadIncomingWaybills() {
    const grid = document.getElementById('incoming-waybills-grid');
    grid.innerHTML = '<div class="worker-empty-state"><p>' + i18nStrings.jsLoadingWaybills + '</p></div>';

    fetch('/api/worker/incoming-waybills', {
        method: 'GET',
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
    })
    .then(res => {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const contentType = res.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) throw new Error('Response is not JSON');
        return res.json();
    })
    .then(data => {
        incomingWaybills = data.waybills || [];
        renderIncomingWaybills();
    })
    .catch(err => {
        console.error('[ERROR] Error loading incoming waybills:', err);
        grid.innerHTML = `
            <div class="worker-empty-state" style="border-color: rgba(220,38,38,0.4);">
                <p style="color: var(--danger-red);">${esc(i18nStrings.jsErrorLoadingWaybills)}: ${esc(err.message)}</p>
                <button onclick="loadIncomingWaybills()" class="worker-btn worker-btn-primary" style="margin-top: 10px; padding: 6px 14px; font-size: 12px;">
                    ${esc(i18nStrings.jsTryAgain)}
                </button>
            </div>`;
    });
}

function renderIncomingWaybills() {
    const grid = document.getElementById('incoming-waybills-grid');
    const countBadge = document.getElementById('incoming-count');
    countBadge.textContent = incomingWaybills.length;
    countBadge.className = 'worker-count-badge' + (incomingWaybills.length === 0 ? ' zero' : '');

    if (incomingWaybills.length === 0) {
        grid.innerHTML = `
            <div class="worker-empty-state">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="1" y="3" width="15" height="13"></rect>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                    <circle cx="5.5" cy="18.5" r="2.5"></circle>
                    <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
                <p>${esc(i18nStrings.jsNoWaybills)}</p>
            </div>`;
        return;
    }

    let html = '';
    incomingWaybills.forEach((waybill, idx) => {
        html += `
            <div class="wb-card clickable" onclick="selectWaybill(${esc(idx)})" title="${esc(i18nStrings.jsSelectWaybill)}">
                <div class="wb-band">
                    <span class="wb-company">${esc(WB_COMPANY)}</span>
                    <span class="wb-serial">${esc(waybill.waybill_serial || '-')}</span>
                    <span class="wb-date">${esc(waybill.waybill_date || '-')}</span>
                </div>
                <div class="wb-body">
                    <div class="wb-row">
                        <div class="wb-field" style="flex: 1;">
                            <span class="wb-label">${esc(i18nStrings.jsDriverName)}</span>
                            <span class="wb-value">${esc(waybill.driver_name || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsDriverPhone)}</span>
                            <span class="wb-value" dir="ltr">${esc(waybill.driver_phone || '-')}</span>
                        </div>
                    </div>
                    <div class="wb-row">
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTruckPlate)}</span>
                            <span class="wb-value">${esc(waybill.truck_plate || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTruckType)}</span>
                            <span class="wb-value">${esc(waybill.truck_type || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsCementType)}</span>
                            <span class="wb-value">${esc(waybill.cement_type || '-')}</span>
                        </div>
                    </div>
                    <hr class="wb-divider">
                    <div class="wb-row">
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsBagCount)}</span>
                            <span class="wb-value">${esc(waybill.total_bags || '-')}</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsTonnage)}</span>
                            <span class="wb-value wb-tonnage">${esc(waybill.tonnage || '-')} Tons</span>
                        </div>
                        <div class="wb-field">
                            <span class="wb-label">${esc(i18nStrings.jsFreightTotal)}</span>
                            <span class="wb-value wb-freight">${esc((waybill.total_freight || 0).toLocaleString())} AFN</span>
                        </div>
                    </div>
                    <div class="wb-row" style="align-items: center;">
                        <span class="wb-route">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
