/* ============================================================
   Sale entry modal
   ============================================================ */
function selectWaybill(index) {
    selectedWaybill = incomingWaybills[index];

    document.getElementById('selected-waybill-id').value = selectedWaybill.id;
    document.getElementById('modal-waybill-serial').textContent = selectedWaybill.waybill_serial || '-';
    document.getElementById('selected-waybill-serial').textContent = selectedWaybill.waybill_serial || '-';
    document.getElementById('selected-waybill-date').textContent = selectedWaybill.waybill_date || '-';
    document.getElementById('selected-waybill-driver').textContent = selectedWaybill.driver_name || '-';
    document.getElementById('selected-waybill-plate').textContent = selectedWaybill.truck_plate || '-';
    document.getElementById('selected-waybill-cement').textContent = selectedWaybill.cement_type || '-';
    document.getElementById('selected-waybill-bags').textContent = selectedWaybill.total_bags || '-';
    document.getElementById('selected-waybill-tonnage').textContent = selectedWaybill.tonnage || '-';
    document.getElementById('selected-waybill-truck-type').textContent = selectedWaybill.truck_type || '-';
    document.getElementById('selected-waybill-loading').textContent = selectedWaybill.loading_province || '-';
    document.getElementById('selected-waybill-unloading').textContent = selectedWaybill.unloading_province || '-';

    document.getElementById('sale-modal').style.display = 'flex';
    calculateSaleTotals();
}

function clearSelectedWaybill() {
    selectedWaybill = null;
    document.getElementById('sale-modal').style.display = 'none';
    document.getElementById('sale-entry-form').reset();
}

function calculateSaleTotals() {
    if (!selectedWaybill) return;

    const shortageBags = parseInt(document.getElementById('shortage_bags').value) || 0;
    const unitPrice = parseFloat(document.getElementById('sale_unit_price').value) || 0;

    const totalBags = selectedWaybill.total_bags || 0;
    const soldBags = totalBags - shortageBags;

    // Total sales = sold bags * unit price
    const totalSales = soldBags * unitPrice;
    document.getElementById('total_sale_amount').value = totalSales.toFixed(2);

    // Total freight from waybill
    const totalFreight = selectedWaybill.total_freight || 0;
    document.getElementById('total_freight').value = totalFreight.toFixed(2);

    // Net cement = total sales - total freight
    const netCement = totalSales - totalFreight;
    document.getElementById('net_cement_money').value = netCement.toFixed(2);
}

function addSaleToQueue(event) {
    event.preventDefault();

    if (!selectedWaybill) {
        workerDialog({ message: i18nStrings.jsAlertSelectWaybill, icon: 'error', showCancel: false, confirmClass: 'worker-btn-primary' });
        return;
    }

    const custSelect = document.getElementById('customer_id');
    const customer = customers.find(c => c.id === parseInt(custSelect.value));

    const saleEntry = {
        waybill_id: selectedWaybill.id,
        waybill_serial: selectedWaybill.waybill_serial,
        waybill_date: selectedWaybill.waybill_date,
        sale_date: document.getElementById('sale_date').value,
        customer_id: parseInt(custSelect.value),
        customer_name: customer ? customer.name : 'Unknown',
        driver_name: selectedWaybill.driver_name,
        driver_phone: selectedWaybill.driver_phone,
        truck_plate: selectedWaybill.truck_plate,
        truck_type: selectedWaybill.truck_type || 'company',
        cement_type: selectedWaybill.cement_type,
        total_bags: selectedWaybill.total_bags,
        tonnage: selectedWaybill.tonnage,
        shortage_bags: parseInt(document.getElementById('shortage_bags').value) || 0,
        sale_unit_price: parseFloat(document.getElementById('sale_unit_price').value) || 0,
        total_sale_amount: parseFloat(document.getElementById('total_sale_amount').value) || 0,
        freight_per_ton: selectedWaybill.freight_per_ton || 0,
        total_freight: parseFloat(document.getElementById('total_freight').value) || 0,
        net_cement_money: parseFloat(document.getElementById('net_cement_money').value) || 0
    };

    // Mark waybill as in_queue on server
    fetch('/api/worker/mark-waybill-in-queue', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ waybill_id: selectedWaybill.id })
    })
    .then(response => response.json().then(data => ({ status: response.status, ok: response.ok, data })))
    .then(({ ok, data }) => {
        if (ok && data.success) {
            waitingQueue.push(saleEntry);
            renderWaitingQueue();

            // Remove selected waybill from incoming list BEFORE closing the modal
            incomingWaybills = incomingWaybills.filter(w => w.id !== selectedWaybill.id);
            renderIncomingWaybills();

            clearSelectedWaybill();
        } else {
            console.error('[ERROR] Request failed:', { ok, data });
            workerDialog({ message: 'Error: ' + (data.error || 'Failed to add to queue'), icon: 'error', showCancel: false });
        }
    })
    .catch(err => {
        console.error('[ERROR] Fetch error:', err);
        workerDialog({ message: 'Error: Failed to add to queue', icon: 'error', showCancel: false });
    });
}

/* ============================================================
   Waiting queue (waybill sale cards)
   ============================================================ */
function loadWaitingQueue() {
    fetch('/api/worker/waiting-queue', {
        method: 'GET',
        credentials: 'include',
        headers: { 'Accept': 'application/json' }
    })
    .then(res => {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const contentType = res.headers.get('content-type');
        if (!contentType || !contentType.includes('application/json')) throw new Error('Response is not JSON');
        return res.json();
    })
    .then(data => {
        // Server returns local_waybills rows with status = 'in_queue'
        waitingQueue = (data.waybills || []).map(w => ({
            waybill_id: w.id,
            waybill_serial: w.waybill_serial,
            waybill_date: w.waybill_date,
            sale_date: w.sale_date || '',
            customer_id: w.customer_id || '',
            customer_name: w.customer_name || 'Unknown',
            driver_name: w.driver_name,
            driver_phone: w.driver_phone,
            truck_plate: w.truck_plate,
            truck_type: w.truck_type || 'company',
            cement_type: w.cement_type,
            total_bags: w.total_bags,
            tonnage: w.tonnage,
            shortage_bags: w.shortage_bags || 0,
            sale_unit_price: w.sale_unit_price || 0,
            total_sale_amount: w.total_sale_amount || 0,
            freight_per_ton: w.freight_per_ton || 0,
            total_freight: w.total_freight || 0,
            net_cement_money: w.net_cement_money || 0
        }));
        renderWaitingQueue();
    })
    .catch(err => {
        console.error('[ERROR] Error loading waiting queue:', err);
        renderWaitingQueue();
    });
}

