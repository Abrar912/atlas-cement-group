<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('auth.access_denied_title') %></title>
    <style>
        :root {
            --bg-gradient-start: #667eea;
            --bg-gradient-end: #764ba2;
            --card-bg: #ffffff;
            --error-color: #cf222e;
            --text-main: #24292e;
            --text-muted: #57606a;
            --btn-bg: #0969da;
            --btn-hover: #0866d4;
        }

        [data-theme="dark"] {
            --bg-gradient-start: #1a1f2e;
            --bg-gradient-end: #2d3748;
            --card-bg: #161b22;
            --error-color: #f85149;
            --text-main: #c9d1d9;
            --text-muted: #8b949e;
            --btn-bg: #58a6ff;
            --btn-hover: #79c0ff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        }
        body {
            background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            direction: rtl;
            text-align: right;
        }
        .error-container {
            background: var(--card-bg);
            padding: 60px 40px;
            border-radius: 12px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            text-align: center;
            max-width: 500px;
        }
        .error-code {
            font-size: 120px;
            font-weight: 700;
            color: var(--error-color);
            line-height: 1;
            margin-bottom: 20px;
        }
        .error-title {
            font-size: 28px;
            font-weight: 600;
            color: var(--text-main);
            margin-bottom: 15px;
        }
        .error-message {
            font-size: 16px;
            color: var(--text-muted);
            margin-bottom: 30px;
            line-height: 1.6;
        }
        .back-btn {
            display: inline-block;
            padding: 12px 30px;
            background: var(--btn-bg);
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 600;
            transition: background 0.2s;
        }
        .back-btn:hover {
            background: var(--btn-hover);
        }
    </style>
</head>
<body>
    <div class="error-container">
        <div class="error-code">403</div>
        <h1 class="error-title"><%= t('auth.access_denied_heading') %></h1>
        <p class="error-message">
            <%= message || t('auth.access_denied_message') %>
        </p>
        <a href="/admin" class="back-btn"><%= t('auth.back_to_dashboard') %></a>
    </div>
</body>
</html>
