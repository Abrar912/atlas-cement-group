<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <title><%= t('home.product_catalog_title') %> | <%= t('home.header_company_name') %></title>
    <link rel="icon" type="image/png" href="/Logo.png">
    <%- include('partials/customer_styles') %>
</head>
<body>
    <%- include('partials/customer_nav') %>

    <section class="page-hero">
        <div class="container">
            <h1><%= t('home.product_catalog_title') %></h1>
            <p><%= t('home.footer_description') %></p>
        </div>
    </section>

    <section class="section" style="padding-top: 10px;">
        <div class="container">
            <div class="product-grid">
                <% if (products && products.length > 0) { %>
                    <% products.forEach(function (product) { %>
                        <div class="product-card reveal">
                            <div class="product-media">
                                <% if (product.image_path) { %>
                                    <img src="<%= product.image_path %>" alt="<%= product.name %>">
                                <% } else { %>
                                    <%= (product.name || '?').charAt(0) %>
                                <% } %>
                            </div>
                            <h3><%= product.name %></h3>
                            <p><%= product.description %></p>
                            <div class="product-specs"><%= product.specifications %></div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="empty-note"><%= t('home.no_products_available') %></div>
                <% } %>
            </div>
        </div>
    </section>

    <%- include('partials/customer_footer') %>
</body>
</html>
