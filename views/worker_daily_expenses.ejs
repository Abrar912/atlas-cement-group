<%- include('partials/header') %>

<style>
    /* Page-specific styles - scoped to daily-expenses-page */
    .daily-expenses-page .kpi-card {
        border-radius: 8px;
        padding: 16px;
        color: #ffffff;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        text-align: center;
    }
    
    .daily-expenses-page .kpi-green {
        background: linear-gradient(135deg, #2ea44f 0%, #1a7f37 100%);
    }
    
    .daily-expenses-page .kpi-red {
        background: linear-gradient(135deg, #da3633 0%, #cf222e 100%);
    }
    
    .daily-expenses-page .kpi-blue {
        background: linear-gradient(135deg, #0969da 0%, #0550ae 100%);
    }
    
    .daily-expenses-page .kpi-orange {
        background: linear-gradient(135deg, #d29922 0%, #9a6700 100%);
    }
    
    /* Compact form grid layout */
    .daily-expenses-page .expense-form-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr 0.8fr 1.2fr;
        gap: 12px;
        margin-bottom: 12px;
        align-items: start;
    }
    
    .daily-expenses-page .expense-form-grid .col-span-2 {
        grid-column: span 2;
    }
    
    .daily-expenses-page .expense-form-grid .col-span-3 {
        grid-column: span 3;
    }
    
    .daily-expenses-page .expense-form-grid .col-span-4 {
        grid-column: span 4;
    }
    
    .daily-expenses-page .form-field {
        display: flex;
        flex-direction: column;
        text-align: left;
    }
    
    .daily-expenses-page .form-field label {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 4px;
    }
    
    .daily-expenses-page .form-field input,
    .daily-expenses-page .form-field select {
        padding: 8px 12px;
        font-size: 13px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background-color: var(--input-bg);
        color: var(--text-main);
        height: 38px;
        box-sizing: border-box;
        width: 100%;
    }
    
    .daily-expenses-page .form-field input:focus,
    .daily-expenses-page .form-field select:focus {
        outline: none;
        border-color: var(--sidebar-active);
    }
    
    /* Auto-growing textarea styling */
    .daily-expenses-page .form-field textarea {
        padding: 8px 12px;
        font-size: 13px;
        border: 1px solid var(--input-border);
        border-radius: 6px;
        background-color: var(--input-bg);
        color: var(--text-main);
        min-height: 38px;
        max-height: 100px;
        box-sizing: border-box;
        resize: none;
        overflow-y: auto;
        font-family: inherit;
        width: 100%;
    }
    
    .daily-expenses-page .form-field textarea:focus {
        outline: none;
        border-color: var(--sidebar-active);
    }
    
    /* Form actions row */
    .daily-expenses-page .form-actions {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        margin-top: 12px;
    }
    
    .daily-expenses-page .form-actions button {
        padding: 8px 16px;
        font-size: 13px;
        border-radius: 6px;
        border: none;
        cursor: pointer;
        font-weight: 500;
    }
    
    /* Compact card styling */
    .daily-expenses-page .compact-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 16px;
        margin-bottom: 16px;
    }
    
    .daily-expenses-page .compact-card h3 {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        margin: 0 0 12px 0;
    }
    
    /* Table row number styling - theme-aware */
    .daily-expenses-page .table-row-number {
        padding: 8px;
        text-align: center;
        font-weight: 600;
        background-color: var(--table-header-bg);
        color: var(--text-muted);
    }
    
    /* Queue table header - theme-aware */
    .daily-expenses-page .queue-table-header {
        background-color: var(--table-header-bg);
        border-bottom: 2px solid var(--border-color);
        color: var(--text-main);
        font-weight: 700;
    }
    
    [data-theme="dark"] .daily-expenses-page .queue-table-header {
        background-color: #1a2f1a;
        border-bottom-color: #3fb950;
    }
    
    /* Compact filter row */
    .daily-expenses-page .filter-row {
        display: flex;
        gap: 8px;
        align-items: flex-end;
        flex-wrap: nowrap;
    }
    
    .daily-expenses-page .filter-row .filter-item {
        flex-shrink: 0;
    }
    
    /* Advanced Filters button */
    .daily-expenses-page .filter-row .filter-item:first-child button {
        width: 120px;
        height: 34px;
        padding: 6px 12px;
        font-size: 12px;
    }
    
    /* Category Filter dropdown button */
    .daily-expenses-page .filter-row .filter-item:nth-child(2) button {
        width: 160px;
        height: 34px;
        padding: 6px 10px;
        font-size: 12px;
    }
    
    /* Date inputs */
    .daily-expenses-page .filter-row .filter-item:nth-child(3) input,
    .daily-expenses-page .filter-row .filter-item:nth-child(4) input {
        width: 135px;
        height: 34px;
        padding: 6px 10px;
        font-size: 12px;
    }
    
    /* Reset Filters button */
    .daily-expenses-page .filter-row .filter-item:last-child button {
        width: 100px;
        height: 34px;
        padding: 6px 12px;
        font-size: 12px;
    }
    
    /* Filter labels */
    .daily-expenses-page .filter-row .filter-item label {
        margin-bottom: 4px;
        font-size: 12px;
    }
    
    /* Responsive filter row */
    @media (max-width: 1200px) {
        .daily-expenses-page .filter-row {
            flex-wrap: wrap;
        }
        
        .daily-expenses-page .filter-row .filter-item {
            flex-shrink: 1;
        }
        
        .daily-expenses-page .filter-row .filter-item button,
        .daily-expenses-page .filter-row .filter-item input {
            width: auto;
            min-width: 100px;
        }
    }
    
    /* Responsive adjustments */
    @media (max-width: 1024px) {
        .daily-expenses-page .expense-form-grid {
            grid-template-columns: 1fr 1fr;
        }
        
        .daily-expenses-page .expense-form-grid .col-span-2 {
            grid-column: span 2;
        }
        
        .daily-expenses-page .expense-form-grid .col-span-3 {
            grid-column: span 2;
        }
        
        .daily-expenses-page .expense-form-grid .col-span-4 {
            grid-column: span 2;
        }
    }
    
    @media (max-width: 768px) {
        .daily-expenses-page .expense-form-grid {
            grid-template-columns: 1fr;
        }
        
        .daily-expenses-page .expense-form-grid .col-span-2,
        .daily-expenses-page .expense-form-grid .col-span-3,
        .daily-expenses-page .expense-form-grid .col-span-4 {
            grid-column: span 1;
        }
        
        .daily-expenses-page .form-actions {
            flex-direction: column;
        }
        
        .daily-expenses-page .form-actions button {
            width: 100%;
        }
    }
    @media print {
        .sidebar, .top-navbar, .filter-row, .no-print, select, input, button {
            display: none !important;
        }
        .main-viewport { flex: 1; overflow: visible; }
        body { background: #ffffff !important; color: #000000 !important; }
        .card { border: 1px solid #000 !important; box-shadow: none !important; }
        .table-responsive { overflow: visible !important; }
        table { width: 100% !important; border: 1px solid #000 !important; }
    }

    /* Empty state cell styling */
    .empty-state-cell {
        text-align: center;
        padding: 30px 20px;
        background-color: var(--card-bg);
    }

    .empty-state-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
    }

    .empty-state-icon {
        font-size: 32px;
    }

    .empty-state-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        margin: 0;
    }

    .empty-state-description {
        font-size: 12px;
        color: var(--text-muted);
        margin: 0;
    }

    /* Compact filter row for desktop */
    .daily-expenses-page .filter-row.no-print {
        flex-wrap: nowrap;
        gap: 8px;
    }

    .daily-expenses-page .filter-row.no-print .filter-item {
        min-width: 0;
        flex: 0 0 auto;
    }

    .daily-expenses-page .filter-row.no-print .filter-item:nth-child(2) {
        flex: 0 0 180px;
    }

    @media (max-width: 1024px) {
        .daily-expenses-page .filter-row.no-print {
            flex-wrap: wrap;
        }
    }

    /* Category popup styling */
    #category_checkbox_popup {
        scrollbar-width: thin;
        scrollbar-color: #9ca3af #f1f5f9;
    }

    #category_checkbox_popup::-webkit-scrollbar {
        width: 6px;
    }

    #category_checkbox_popup::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 6px;
    }

    #category_checkbox_popup::-webkit-scrollbar-thumb {
        background: #9ca3af;
        border-radius: 6px;
    }

    [data-theme="dark"] #category_checkbox_popup {
        scrollbar-color: #4b5563 #1f2937;
    }

    [data-theme="dark"] #category_checkbox_popup::-webkit-scrollbar-track {
        background: #1f2937;
    }

    [data-theme="dark"] #category_checkbox_popup::-webkit-scrollbar-thumb {
        background: #4b5563;
    }

    .category-popup-btn {
        background: none;
        border: none;
        cursor: pointer;
        font-weight: 600;
        padding: 0;
    }

    .category-popup-btn.select-all {
        color: #0969da;
    }

    .category-popup-btn.clear-all {
        color: #cf222e;
    }

    [data-theme="dark"] .category-popup-btn.select-all {
        color: #58a6ff;
    }

    [data-theme="dark"] .category-popup-btn.clear-all {
        color: #ff7b72;
    }
</style>

<div class="daily-expenses-page">
<div style="border-bottom: 2px solid var(--border-color); padding-bottom: 8px; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <h2 style="font-size: 18px; margin: 0 0 4px 0;"><%= t('worker_daily_expenses.title') %></h2>
        <p style="font-size: 13px; color: var(--text-muted); margin: 0;"><%= t('worker_daily_expenses.page_description', { agency: user_agency }) %></p>
    </div>
    <button onclick="window.print()" class="btn btn-primary no-print" style="background-color: #24292f; padding: 8px 16px; font-size: 13px;">
        <%= t('worker_daily_expenses.export_report') %>
    </button>
</div>

<!-- KPI Summary Cards - 4 Cards -->
<div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 16px;">
    <div class="kpi-card kpi-green">
        <span style="font-size: 12px; font-weight: 600;"><%= t('worker_daily_expenses.kpi_cash_in') %></span>
        <h2 id="kpi-total-cash-in" style="margin-top: 8px; font-size: 1.5rem; font-weight: 700; margin: 8px 0 0 0;">0 <%= t('worker_daily_expenses.afghani') %></h2>
    </div>
    <div class="kpi-card kpi-red">
        <span style="font-size: 12px; font-weight: 600;"><%= t('worker_daily_expenses.kpi_cash_out') %></span>
        <h2 id="kpi-total-cash-out" style="margin-top: 8px; font-size: 1.5rem; font-weight: 700; margin: 8px 0 0 0;">0 <%= t('worker_daily_expenses.afghani') %></h2>
    </div>
    <div class="kpi-card kpi-blue">
        <span style="font-size: 12px; font-weight: 600;"><%= t('worker_daily_expenses.kpi_balance') %></span>
        <h2 id="kpi-available-balance" style="margin-top: 8px; font-size: 1.5rem; font-weight: 700; margin: 8px 0 0 0;">0 <%= t('worker_daily_expenses.afghani') %></h2>
    </div>
    <div class="kpi-card kpi-orange">
        <span style="font-size: 12px; font-weight: 600;"><%= t('worker_daily_expenses.kpi_reimbursement') %></span>
        <h2 id="kpi-reimbursement-due" style="margin-top: 8px; font-size: 1.5rem; font-weight: 700; margin: 8px 0 0 0;">0 <%= t('worker_daily_expenses.afghani') %></h2>
    </div>
</div>

<!-- Add Expense Form -->
<div class="compact-card no-print">
    <h3><%= t('worker_daily_expenses.add_expense') %></h3>
    <form id="expense-form" onsubmit="addExpense(event)" data-required-fields="<%= t('worker_daily_expenses.required_fields') %>" data-entry-queue="<%= t('worker_daily_expenses.entry_queue') %>" data-draft-updated="<%= t('worker_daily_expenses.draft_updated') %>" data-delete-confirm="<%= t('worker_daily_expenses.delete_confirm') %>" data-no-queue="<%= t('worker_daily_expenses.no_queue') %>" data-transmit-confirm="<%= t('worker_daily_expenses.transmit_confirm') %>" data-transmit-success="<%= t('worker_daily_expenses.transmit_success') %>" data-transmit-error="<%= t('worker_daily_expenses.transmit_error') %>" data-add-success="<%= t('worker_daily_expenses.add_success') %>" data-add-error="<%= t('worker_daily_expenses.add_error') %>" data-update-draft="<%= t('worker_daily_expenses.update_draft') %>" data-add-direct="<%= t('worker_daily_expenses.add_direct') %>" data-all-categories="<%= t('worker_daily_expenses.all_categories') %>" data-none-selected="<%= t('worker_daily_expenses.none_selected') %>" data-selected-count="<%= t('worker_daily_expenses.selected_count') %>">
        <div class="expense-form-grid">
            <!-- Row 1: Date + Category + Qty + Unit Price -->
            <!-- Mandatory Date -->
            <div class="form-field">
                <label><%= t('worker_daily_expenses.date') %> <span style="color: #ff6b00;">★</span></label>
                <input type="text" id="exp_transaction_date" class="form-control" data-datepicker="jalali" placeholder="e.g. 1405/03/25" required>
            </div>

            <!-- Category -->
            <div class="form-field">
                <label><%= t('worker_daily_expenses.category') %></label>
                <select id="exp_category" class="form-control" required onchange="handleCategoryToggle('exp')">
                    <option value=""><%= t('worker_daily_expenses.select_category') %></option>
                    <option value="Food"><%= t('worker_daily_expenses.cat_food') %></option>
                    <option value="Stationery"><%= t('worker_daily_expenses.cat_stationery') %></option>
                    <option value="Rent"><%= t('worker_daily_expenses.cat_rent') %></option>
                    <option value="Electricity"><%= t('worker_daily_expenses.cat_electricity') %></option>
                    <option value="Salaries"><%= t('worker_daily_expenses.cat_salaries') %></option>
                    <option value="Furniture"><%= t('worker_daily_expenses.cat_furniture') %></option>
                    <option value="HQ Inflow"><%= t('worker_daily_expenses.cat_hq_inflow') %></option>
                    <option value="Other"><%= t('worker_daily_expenses.cat_other') %></option>
                </select>
                <input type="text" id="exp_custom_category" class="form-control" placeholder="<%= t('worker_daily_expenses.category_name') %>" style="display: none; margin-top: 4px;">
            </div>

            <!-- Quantity (Hidden for HQ Inflow) -->
            <div class="form-field" id="container_quantity">
                <label><%= t('worker_daily_expenses.quantity') %></label>
                <input type="number" step="any" id="exp_quantity" class="form-control" value="1" placeholder="1">
            </div>

            <!-- Unit Price (Hidden for HQ Inflow) -->
            <div class="form-field" id="container_unit_price">
                <label><%= t('worker_daily_expenses.unit_price') %></label>
                <input type="number" step="any" id="exp_unit_price" class="form-control" value="0" placeholder="0">
            </div>

            <!-- Row 2: Description + Total/Cash Out + Person + Cash In -->
            <!-- Description -->
            <div class="form-field col-span-2">
                <label><%= t('worker_daily_expenses.description') %></label>
                <textarea id="exp_description" class="form-control auto-grow" placeholder="<%= t('worker_daily_expenses.description_placeholder') %>" rows="1"></textarea>
            </div>

            <!-- Merged Total / Cash Out (Hidden for HQ Inflow) -->
            <div class="form-field col-span-2" id="container_total_cash_out">
                <label><%= t('worker_daily_expenses.total_cash_out') %></label>
                <input type="number" step="any" id="exp_total_cash_out" class="form-control" value="0" placeholder="0">
            </div>

            <!-- Person Involved (Hidden by default, shown ONLY for HQ Inflow) -->
            <div class="form-field" id="container_person" style="display: none;">
                <label><%= t('worker_daily_expenses.person') %></label>
                <input type="text" id="exp_person" class="form-control" placeholder="<%= t('worker_daily_expenses.person_placeholder') %>">
            </div>

            <!-- Cash In (Hidden by default, shown ONLY for HQ Inflow) -->
            <div class="form-field" id="container_cash_in" style="display: none;">
                <label><%= t('worker_daily_expenses.cash_in') %></label>
                <input type="number" step="any" id="exp_cash_in" class="form-control" value="0" placeholder="0">
            </div>

            <!-- Row 3: Remarks (full width) -->
            <!-- Remarks -->
            <div class="form-field col-span-4">
                <label><%= t('worker_daily_expenses.remarks') %></label>
                <textarea id="exp_remarks" class="form-control auto-grow" placeholder="<%= t('worker_daily_expenses.remarks_placeholder') %>" rows="1"></textarea>
            </div>
        </div>

        <div class="form-actions">
            <button type="button" onclick="addToQueue()" class="btn btn-primary" style="background-color: #2ea44f;">
                <%= t('worker_daily_expenses.add_to_queue') %>
            </button>
            <button type="submit" class="btn btn-primary" style="background-color: #0969da;">
                <%= t('worker_daily_expenses.add_direct') %>
            </button>
        </div>
    </form>
</div>

<!-- Unposted Staging Queue -->
<div class="compact-card no-print" style="border: 2px solid #d29922;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <h3 style="margin: 0;"><%= t('worker_daily_expenses.queue_title') %></h3>
        <button onclick="transmitBatch()" class="btn btn-primary" style="background-color: #d29922; padding: 6px 14px; font-size: 12px;">
            <%= t('worker_daily_expenses.transmit_batch') %>
        </button>
    </div>
    <div class="table-responsive" style="overflow-x: auto;">
        <table style="font-size: 12px; white-space: nowrap; table-layout: fixed; width: 100%; border-collapse: collapse;">
            <colgroup>
                <col style="width: 50px;" />
                <col style="width: 90px;" />
                <col style="width: 120px;" />
                <col style="width: 150px;" />
                <col style="width: 120px;" />
                <col style="width: 80px;" />
                <col style="width: 90px;" />
                <col style="width: 100px;" />
                <col style="width: 100px;" />
                <col style="width: 100px;" />
                <col style="width: 150px;" />
                <col style="width: 100px;" />
            </colgroup>
            <thead class="queue-table-header">
                <tr>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_hash') %></th>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_date') %></th>
                    <th style="padding: 6px; text-align: right;"><%= t('worker_daily_expenses.th_category') %></th>
                    <th style="padding: 6px; text-align: right;"><%= t('worker_daily_expenses.th_description') %></th>
                    <th style="padding: 6px; text-align: right;"><%= t('worker_daily_expenses.th_person') %></th>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_qty') %></th>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_unit') %></th>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_total') %></th>
                    <th style="padding: 6px; text-align: center; color: #1a7f37;"><%= t('worker_daily_expenses.th_in') %></th>
                    <th style="padding: 6px; text-align: center; color: #cf222e;"><%= t('worker_daily_expenses.th_out') %></th>
                    <th style="padding: 6px; text-align: right;"><%= t('worker_daily_expenses.th_notes') %></th>
                    <th style="padding: 6px; text-align: center;"><%= t('worker_daily_expenses.th_actions') %></th>
                </tr>
            </thead>
            <tbody id="queue-rows">
                <tr>
                    <td colspan="12" style="text-align: center; color: var(--text-muted); padding: 20px;"><%= t('worker_daily_expenses.no_items') %></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Filter Bar -->
<div class="filter-row no-print" style="margin-bottom: 12px;">
    <!-- Advanced Filters Button -->
    <div class="filter-item">
        <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); display:block; margin-bottom:4px;">&nbsp;</label>
        <button onclick="openAdvancedFilters()" class="btn btn-primary" style="background-color:#0969da; color: white; padding: 6px 12px; font-size: 12px;">
            <%= t('worker_daily_expenses.advanced_filters') %>
        </button>
    </div>
    <!-- Category Multi-Select Checkbox Filter Container -->
    <div class="filter-item" style="position: relative;">
        <label style="font-size: 12px; font-weight: 600; color: var(--text-muted); display:block; margin-bottom:4px;">
            <%= t('worker_daily_expenses.category_filter') %>
        </label>
        
        <!-- Filter Toggle Button -->
        <button 
            type="button" 
            id="category_dropdown_btn" 
            onclick="toggleCategoryMenu(event)" 
            class="form-control" 
            style="text-align: right; background: var(--bg-color); cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; font-size: 12px;"
        >
            <span id="category_btn_label"><%= t('worker_daily_expenses.all_categories') %></span>
            <span style="font-size: 10px; color: var(--text-muted);">▼</span>
        </button>

        <!-- Checkbox Popup Window -->
        <div 
            id="category_checkbox_popup" 
            style="display: none; position: absolute; top: 100%; right: 0; left: 0; z-index: 1000; background: var(--modal-bg); border: 1px solid var(--border-color); border-radius: 6px; box-shadow: 0 8px 24px rgba(140,149,159,0.2); padding: 12px; margin-top: 4px; min-width: 220px;"
        >
            <!-- Select All / Clear All Row -->
            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-bottom: 8px; font-size: 12px;">
                <button type="button" onclick="selectAllCategories(true)" class="category-popup-btn select-all"><%= t('worker_daily_expenses.select_all') %></button>
                <button type="button" onclick="selectAllCategories(false)" class="category-popup-btn clear-all"><%= t('worker_daily_expenses.clear_all') %></button>
            </div>

            <!-- Checkbox Options List -->
            <div style="max-height: 200px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
                <label style="font-size: 13px; display: flex; align-items: center; gap: 8px; cursor: pointer;">
                    <input type="checkbox" class="category-checkbox" value="Food" onchange="onCategoryFilterChange()" checked> <%= t('worker_daily_expenses.cat_food') %>
                </label>
