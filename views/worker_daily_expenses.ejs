<script>
document.getElementById('nav-worker-expenses').classList.add('active');

// Auto-grow textarea functionality
function autoGrowTextarea(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = Math.min(textarea.scrollHeight, 100) + 'px';
}

// Initialize auto-grow for textareas
document.addEventListener('DOMContentLoaded', function() {
    const autoGrowTextareas = document.querySelectorAll('.auto-grow');
    autoGrowTextareas.forEach(function(textarea) {
        textarea.addEventListener('input', function() {
            autoGrowTextarea(this);
        });
        // Initial height adjustment
        autoGrowTextarea(textarea);
    });
});

// Local staging queue array
let expenseBatchDraft = [];
let editingDraftIndex = null;

// Pagination state
let allExpensesRecords = [];
let currentPage = 1;
let itemsPerPage = 10;

// Pagination functions
function prevPage() {
    if (currentPage > 1) {
        currentPage--;
        renderPaginatedExpenses();
    }
}

function nextPage() {
    const totalPages = Math.ceil(allExpensesRecords.length / itemsPerPage);
    if (currentPage < totalPages) {
        currentPage++;
        renderPaginatedExpenses();
    }
}

function changePageSize() {
    itemsPerPage = parseInt(document.getElementById('items-per-page').value);
    currentPage = 1;
    renderPaginatedExpenses();
}

function updatePaginationControls() {
    const totalRecords = allExpensesRecords.length;
    const totalPages = Math.ceil(totalRecords / itemsPerPage) || 1;
    const startIdx = totalRecords === 0 ? 0 : (currentPage - 1) * itemsPerPage + 1;
    const endIdx = Math.min(currentPage * itemsPerPage, totalRecords);
    
    document.getElementById('page-start-idx').textContent = startIdx;
    document.getElementById('page-end-idx').textContent = endIdx;
    document.getElementById('page-total-count').textContent = totalRecords;
    document.getElementById('page-indicator').textContent = `Page ${currentPage} of ${totalPages}`;
    
    document.getElementById('btn-prev-page').disabled = currentPage === 1;
    document.getElementById('btn-next-page').disabled = currentPage === totalPages || totalRecords === 0;
}

function renderPaginatedExpenses() {
    const startIndex = (currentPage - 1) * itemsPerPage;
    const endIndex = startIndex + itemsPerPage;
    const paginatedRecords = allExpensesRecords.slice(startIndex, endIndex);
    
    renderExpensesTable(paginatedRecords, allExpensesRecords);
    updatePaginationControls();
}

// Handle category change - show/hide custom category input and toggle HQ Inflow fields
function handleCategoryToggle(prefix) {
    const categorySelect = document.getElementById(prefix + '_category');
    const customInput = document.getElementById(prefix + '_custom_category');
    
    // Handle custom category input for "Other"
    if (categorySelect.value === 'Other') {
        customInput.style.display = 'block';
        customInput.required = true;
    } else {
        customInput.style.display = 'none';
        customInput.required = false;
        customInput.value = '';
    }
    
    // Handle HQ Inflow vs other categories field visibility
    const isHQInflow = categorySelect.value === 'HQ Inflow';
    
    // Containers for different field groups
    const containerPerson = document.getElementById('container_person');
    const containerCashIn = document.getElementById('container_cash_in');
    const containerQuantity = document.getElementById('container_quantity');
    const containerUnitPrice = document.getElementById('container_unit_price');
    const containerTotalCashOut = document.getElementById('container_total_cash_out');
    
    if (isHQInflow) {
        // SHOW: Person Involved, Cash In
        containerPerson.style.display = 'block';
        containerCashIn.style.display = 'block';
        
        // HIDE: Quantity, Unit Price, Total/Cash Out
        containerQuantity.style.display = 'none';
        containerUnitPrice.style.display = 'none';
        containerTotalCashOut.style.display = 'none';
        
        // Reset hidden fields
        document.getElementById('exp_quantity').value = 1;
        document.getElementById('exp_unit_price').value = 0;
        document.getElementById('exp_total_cash_out').value = 0;
    } else {
        // SHOW: Quantity, Unit Price, Total/Cash Out
        containerQuantity.style.display = 'block';
        containerUnitPrice.style.display = 'block';
        containerTotalCashOut.style.display = 'block';
        
        // HIDE: Person Involved, Cash In
        containerPerson.style.display = 'none';
        containerCashIn.style.display = 'none';
        
        // Reset hidden fields
        document.getElementById('exp_person').value = '';
        document.getElementById('exp_cash_in').value = 0;
    }
}

// Calculate total price from quantity * unit price - clean event listener approach
function calculateTotalPrice() {
    const qty = parseFloat(document.getElementById('exp_quantity').value) || 0;
    const unitPrice = parseFloat(document.getElementById('exp_unit_price').value) || 0;
    const totalField = document.getElementById('exp_total_cash_out');
    if (totalField) {
        totalField.value = (qty * unitPrice).toFixed(2);
    }
}

// Attach event listeners after DOM is ready
document.addEventListener('DOMContentLoaded', function() {
    const qtyInput = document.getElementById('exp_quantity');
    const unitPriceInput = document.getElementById('exp_unit_price');
    
    if (qtyInput) {
        qtyInput.addEventListener('input', calculateTotalPrice);
    }
    if (unitPriceInput) {
        unitPriceInput.addEventListener('input', calculateTotalPrice);
    }
});

// Add expense to staging queue
function addToQueue() {
    const categorySelect = document.getElementById('exp_category');
    const customCategory = document.getElementById('exp_custom_category').value;
    const finalCategory = categorySelect.value === 'Other' ? customCategory : categorySelect.value;
    
    const isHQInflow = categorySelect.value === 'HQ Inflow';
    const totalCashOut = parseFloat(document.getElementById('exp_total_cash_out').value) || 0;
    
    const formData = {
        transaction_date: document.getElementById('exp_transaction_date').value,
        category: finalCategory,
        description: document.getElementById('exp_description').value,
        person_involved: document.getElementById('exp_person').value,
        quantity: isHQInflow ? 1 : (parseFloat(document.getElementById('exp_quantity').value) || 1),
        unit_price: isHQInflow ? 0 : (parseFloat(document.getElementById('exp_unit_price').value) || 0),
        total_price: isHQInflow ? 0 : totalCashOut,
        cash_in: parseFloat(document.getElementById('exp_cash_in').value) || 0,
        cash_out: isHQInflow ? 0 : totalCashOut,
        remarks: document.getElementById('exp_remarks').value
    };
    
    const form = document.getElementById('expense-form');
    const requiredFieldsMsg = form.getAttribute('data-required-fields');
    const entryQueueMsg = form.getAttribute('data-entry-queue');
    
    if (!formData.transaction_date || !formData.category) {
        alert(requiredFieldsMsg);
        return;
    }
    
    expenseBatchDraft.push(formData);
    renderQueue();
    
    // Reset form
    document.getElementById('expense-form').reset();
    document.getElementById('exp_quantity').value = 1;
    document.getElementById('exp_unit_price').value = 0;
    document.getElementById('exp_total_cash_out').value = 0;
    document.getElementById('exp_cash_in').value = 0;
    document.getElementById('exp_custom_category').style.display = 'none';
    
    alert(entryQueueMsg);
}

// Render staging queue table
function renderQueue() {
    const rowsContainer = document.getElementById('queue-rows');
    const form = document.getElementById('expense-form');
    let html = '';
    
    if (expenseBatchDraft.length === 0) {
        html = '<tr><td colspan="12" style="text-align: center; color: var(--text-muted); padding: 20px;">' + form.getAttribute('data-no-queue') + '</td></tr>';
    } else {
        expenseBatchDraft.forEach((item, index) => {
            const categoryBadge = getCategoryBadge(item.category);
            
            html += `
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td class="table-row-number">${esc(index + 1)}</td>
                    <td style="padding: 6px; text-align: center;">${esc(item.transaction_date || '-')}</td>
                    <td style="padding: 6px; text-align: right;">${esc(categoryBadge)}</td>
                    <td style="padding: 6px; text-align: right;">${esc(item.description || '-')}</td>
                    <td style="padding: 6px; text-align: right;">${esc(item.person_involved || '-')}</td>
                    <td style="padding: 6px; text-align: center;">${esc(item.quantity || 1)}</td>
                    <td style="padding: 6px; text-align: center;">${esc(item.unit_price.toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 600;">${esc(item.total_price.toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 700; color: #1a7f37;">${esc(item.cash_in.toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 700; color: #cf222e;">${esc(item.cash_out.toLocaleString())}</td>
                    <td style="padding: 6px; text-align: right; color: var(--text-muted);">${esc(item.remarks || '-')}</td>
                    <td style="padding: 8px; text-align: center;">
                        <button onclick="editDraft(${esc(index)})" class="btn btn-secondary" style="padding: 4px 8px; font-size: 11px; margin-right: 5px;">Edit</button>
                        <button onclick="deleteDraft(${esc(index)})" class="btn btn-secondary" style="padding: 4px 8px; font-size: 11px; background-color: #cf222e;">Delete</button>
                    </td>
                </tr>
            `;
        });
    }
    
    rowsContainer.innerHTML = html;
}

// Edit draft item
function editDraft(index) {
    const item = expenseBatchDraft[index];
    editingDraftIndex = index;
    
    // Populate form with draft data
    document.getElementById('exp_transaction_date').value = item.transaction_date;
    document.getElementById('exp_description').value = item.description;
    document.getElementById('exp_person').value = item.person_involved;
    document.getElementById('exp_quantity').value = item.quantity;
    document.getElementById('exp_unit_price').value = item.unit_price;
    document.getElementById('exp_total_cash_out').value = item.cash_out || item.total_price || 0;
    document.getElementById('exp_cash_in').value = item.cash_in;
    document.getElementById('exp_remarks').value = item.remarks;
    
    // Handle category
    const categorySelect = document.getElementById('exp_category');
    const customInput = document.getElementById('exp_custom_category');
    
    // Check if category matches standard options
    const standardCategories = ['Food', 'Stationery', 'Rent', 'Electricity', 'Salaries', 'Furniture', 'HQ Inflow'];
    if (standardCategories.includes(item.category)) {
        categorySelect.value = item.category;
        customInput.style.display = 'none';
        customInput.value = '';
    } else {
        categorySelect.value = 'Other';
        customInput.style.display = 'block';
        customInput.value = item.category;
        customInput.required = true;
    }
    
    // Trigger category toggle to show/hide appropriate fields
    handleCategoryToggle('exp');
    
    // Change button to update
    const submitBtn = document.querySelector('#expense-form button[type="submit"]');
    const form = document.getElementById('expense-form');
    submitBtn.textContent = form.getAttribute('data-update-draft');
    submitBtn.onclick = function(e) {
        e.preventDefault();
        updateDraft();
    };
    
    // Scroll to form
    document.getElementById('expense-form').scrollIntoView({ behavior: 'smooth' });
}

// Update draft item
function updateDraft() {
    const categorySelect = document.getElementById('exp_category');
    const customCategory = document.getElementById('exp_custom_category').value;
    const finalCategory = categorySelect.value === 'Other' ? customCategory : categorySelect.value;
    
    const isHQInflow = categorySelect.value === 'HQ Inflow';
    const totalCashOut = parseFloat(document.getElementById('exp_total_cash_out').value) || 0;
    
    const formData = {
        transaction_date: document.getElementById('exp_transaction_date').value,
        category: finalCategory,
        description: document.getElementById('exp_description').value,
        person_involved: document.getElementById('exp_person').value,
        quantity: isHQInflow ? 1 : (parseFloat(document.getElementById('exp_quantity').value) || 1),
        unit_price: isHQInflow ? 0 : (parseFloat(document.getElementById('exp_unit_price').value) || 0),
        total_price: isHQInflow ? 0 : totalCashOut,
        cash_in: parseFloat(document.getElementById('exp_cash_in').value) || 0,
        cash_out: isHQInflow ? 0 : totalCashOut,
        remarks: document.getElementById('exp_remarks').value
    };
    
    const form = document.getElementById('expense-form');
    const requiredFieldsMsg = form.getAttribute('data-required-fields');
    const draftUpdatedMsg = form.getAttribute('data-draft-updated');
    const addDirectMsg = form.getAttribute('data-add-direct');
    
    if (!formData.transaction_date || !formData.category) {
        alert(requiredFieldsMsg);
        return;
    }
    
    expenseBatchDraft[editingDraftIndex] = formData;
    renderQueue();
    
    // Reset form and button
    document.getElementById('expense-form').reset();
    document.getElementById('exp_quantity').value = 1;
    document.getElementById('exp_unit_price').value = 0;
    document.getElementById('exp_total_cash_out').value = 0;
    document.getElementById('exp_cash_in').value = 0;
    document.getElementById('exp_custom_category').style.display = 'none';
    editingDraftIndex = null;
    
    const submitBtn = document.querySelector('#expense-form button[type="submit"]');
    submitBtn.textContent = addDirectMsg;
    submitBtn.onclick = null;
    
    alert(draftUpdatedMsg);
}

// Delete draft item
function deleteDraft(index) {
    const form = document.getElementById('expense-form');
    const deleteConfirmMsg = form.getAttribute('data-delete-confirm');
    
    if (confirm(deleteConfirmMsg)) {
        expenseBatchDraft.splice(index, 1);
        renderQueue();
    }
}

// Transmit batch to server
function transmitBatch() {
    const form = document.getElementById('expense-form');
    const noQueueMsg = form.getAttribute('data-no-queue');
    const transmitConfirmMsg = form.getAttribute('data-transmit-confirm');
    const transmitSuccessMsg = form.getAttribute('data-transmit-success');
    const transmitErrorMsg = form.getAttribute('data-transmit-error');
    
    if (expenseBatchDraft.length === 0) {
        alert(noQueueMsg);
        return;
    }
    
    if (!confirm(transmitConfirmMsg.replace('{count}', expenseBatchDraft.length))) {
        return;
    }
    
    fetch('/worker/add-expenses-batch', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ expenses: expenseBatchDraft })
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            expenseBatchDraft = [];
            renderQueue();
            loadExpenses();
            loadSummary();
            alert(transmitSuccessMsg.replace('{count}', data.count));
        } else {
            alert(transmitErrorMsg + (data.error || 'Unknown error'));
        }
    })
    .catch(err => {
        console.error('[ERROR] Error transmitting batch:', err);
        alert(transmitErrorMsg + err.message);
    });
}

// Add expense transaction (direct)
function addExpense(event) {
    event.preventDefault();
    
    const categorySelect = document.getElementById('exp_category');
    const customCategory = document.getElementById('exp_custom_category').value;
    const finalCategory = categorySelect.value === 'Other' ? customCategory : categorySelect.value;
    
    const isHQInflow = categorySelect.value === 'HQ Inflow';
    const totalCashOut = parseFloat(document.getElementById('exp_total_cash_out').value) || 0;
    
    const formData = {
        transaction_date: document.getElementById('exp_transaction_date').value,
        category: finalCategory,
        description: document.getElementById('exp_description').value,
        person_involved: document.getElementById('exp_person').value,
        quantity: isHQInflow ? 1 : (parseFloat(document.getElementById('exp_quantity').value) || 1),
        unit_price: isHQInflow ? 0 : (parseFloat(document.getElementById('exp_unit_price').value) || 0),
        total_price: isHQInflow ? 0 : totalCashOut,
        cash_in: parseFloat(document.getElementById('exp_cash_in').value) || 0,
        cash_out: isHQInflow ? 0 : totalCashOut,
        remarks: document.getElementById('exp_remarks').value
    };
    
    const form = document.getElementById('expense-form');
    const addSuccessMsg = form.getAttribute('data-add-success');
    const addErrorMsg = form.getAttribute('data-add-error');
    
    fetch('/worker/add-expense', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(formData)
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            // Reset form
            document.getElementById('expense-form').reset();
            document.getElementById('exp_quantity').value = 1;
            document.getElementById('exp_unit_price').value = 0;
            document.getElementById('exp_total_cash_out').value = 0;
            document.getElementById('exp_cash_in').value = 0;
            document.getElementById('exp_custom_category').style.display = 'none';
            
            // Reload expenses and summary
            loadExpenses();
            loadSummary();
            
            alert(addSuccessMsg);
        } else {
            alert(addErrorMsg + (data.error || 'Unknown error'));
        }
    })
    .catch(err => {
        console.error('[ERROR] Error adding expense:', err);
        alert(addErrorMsg + err.message);
    });
}

// Toggle category checkbox menu
function toggleCategoryMenu(event) {
    event.stopPropagation();
    const popup = document.getElementById('category_checkbox_popup');
    const isVisible = popup.style.display === 'block';
    popup.style.display = isVisible ? 'none' : 'block';
}

// Select or clear all category checkboxes
function selectAllCategories(selectAll) {
    const checkboxes = document.querySelectorAll('.category-checkbox');
    checkboxes.forEach(cb => cb.checked = selectAll);
    const form = document.getElementById('expense-form');
    document.getElementById('category_btn_label').textContent = form.getAttribute('data-all-categories');
    onCategoryFilterChange();
}

// Get array of checked category values
function getSelectedCategories() {
    const checkedCheckboxes = document.querySelectorAll('.category-checkbox:checked');
    return Array.from(checkedCheckboxes).map(cb => cb.value.trim());
}

// Handle category filter change - update label and reload expenses
function onCategoryFilterChange() {
    const allCheckboxes = document.querySelectorAll('.category-checkbox');
    const selected = getSelectedCategories();
    const btnLabel = document.getElementById('category_btn_label');
    const form = document.getElementById('expense-form');

    if (selected.length === allCheckboxes.length) {
        btnLabel.textContent = form.getAttribute('data-all-categories');
    } else if (selected.length === 0) {
        btnLabel.textContent = form.getAttribute('data-none-selected');
    } else {
        btnLabel.textContent = `${selected.length} ${form.getAttribute('data-selected-count')}`;
    }

    loadExpenses();
    loadSummary();
}

// Close category menu when clicking outside
document.addEventListener('click', function(event) {
    const popup = document.getElementById('category_checkbox_popup');
    const btn = document.getElementById('category_dropdown_btn');
    if (popup && popup.style.display === 'block' && !popup.contains(event.target) && !btn.contains(event.target)) {
        popup.style.display = 'none';
    }
});

// Global object to store advanced filter criteria
window.advFilterCriteria = {};

// Open advanced filters modal
function openAdvancedFilters() {
    document.getElementById('advancedFilterModal').style.display = 'flex';
}

// Close advanced filters modal
function closeAdvancedFilters() {
    document.getElementById('advancedFilterModal').style.display = 'none';
}

// Clear advanced filters
function clearAdvancedFilters() {
    resetFilters();
    closeAdvancedFilters();
}

// Apply advanced filters
function applyAdvancedFilters() {
    window.advFilterCriteria = {
        adv_start_date: document.getElementById('adv_start_date')?.value.trim() || '',
        adv_end_date: document.getElementById('adv_end_date')?.value.trim() || '',
        adv_category: document.getElementById('adv_category')?.value.trim() || '',
        adv_person: document.getElementById('adv_person')?.value.trim() || '',
        adv_cash_in: document.getElementById('adv_cash_in')?.value.trim() || '',
        adv_cash_out: document.getElementById('adv_cash_out')?.value.trim() || '',
        adv_description: document.getElementById('adv_description')?.value.trim() || '',
        adv_quantity: document.getElementById('adv_quantity')?.value.trim() || '',
        adv_unit_price: document.getElementById('adv_unit_price')?.value.trim() || '',
        adv_remarks: document.getElementById('adv_remarks')?.value.trim() || ''
    };
    closeAdvancedFilters();
    loadExpenses();
}

// Load expenses data
function loadExpenses() {
    const allCheckboxes = document.querySelectorAll('.category-checkbox');
    const selectedCategories = getSelectedCategories();
    const startDate = document.getElementById('filter_start_date')?.value || '';
    const endDate = document.getElementById('filter_end_date')?.value || '';

    console.log('[DEBUG] All checkboxes count:', allCheckboxes.length);
    console.log('[DEBUG] Selected categories:', selectedCategories);
    console.log('[DEBUG] Selected count:', selectedCategories.length);
    console.log('[DEBUG] Advanced filter criteria:', window.advFilterCriteria);

    // If user unchecked ALL boxes, render empty array immediately
    if (selectedCategories.length === 0) {
        allExpensesRecords = [];
        currentPage = 1;
        renderPaginatedExpenses();
        return;
    }

    let queryUrl = `/api/worker/expenses?start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}`;

    // ONLY append specific categories parameter if user selected a SUBSET of categories
    if (selectedCategories.length < allCheckboxes.length) {
        queryUrl += `&categories=${encodeURIComponent(selectedCategories.join(','))}`;
        console.log('[DEBUG] Sending categories param:', selectedCategories.join(','));
    } else {
        console.log('[DEBUG] All categories selected, not sending categories param');
    }

    // Append advanced filter parameters if they have values
    if (window.advFilterCriteria.adv_start_date) {
        queryUrl += `&adv_start_date=${encodeURIComponent(window.advFilterCriteria.adv_start_date)}`;
    }
    if (window.advFilterCriteria.adv_end_date) {
        queryUrl += `&adv_end_date=${encodeURIComponent(window.advFilterCriteria.adv_end_date)}`;
    }
    if (window.advFilterCriteria.adv_category) {
        queryUrl += `&adv_category=${encodeURIComponent(window.advFilterCriteria.adv_category)}`;
    }
    if (window.advFilterCriteria.adv_person) {
        queryUrl += `&adv_person=${encodeURIComponent(window.advFilterCriteria.adv_person)}`;
    }
    if (window.advFilterCriteria.adv_cash_in) {
        queryUrl += `&adv_cash_in=${encodeURIComponent(window.advFilterCriteria.adv_cash_in)}`;
    }
    if (window.advFilterCriteria.adv_cash_out) {
        queryUrl += `&adv_cash_out=${encodeURIComponent(window.advFilterCriteria.adv_cash_out)}`;
    }
    if (window.advFilterCriteria.adv_description) {
        queryUrl += `&adv_description=${encodeURIComponent(window.advFilterCriteria.adv_description)}`;
    }
    if (window.advFilterCriteria.adv_quantity) {
        queryUrl += `&adv_quantity=${encodeURIComponent(window.advFilterCriteria.adv_quantity)}`;
    }
    if (window.advFilterCriteria.adv_unit_price) {
        queryUrl += `&adv_unit_price=${encodeURIComponent(window.advFilterCriteria.adv_unit_price)}`;
    }
    if (window.advFilterCriteria.adv_remarks) {
        queryUrl += `&adv_remarks=${encodeURIComponent(window.advFilterCriteria.adv_remarks)}`;
    }

    console.log('[DEBUG] Final queryUrl:', queryUrl);

    fetch(queryUrl)
        .then(res => res.json())
        .then(data => {
            console.log('[DEBUG] API response records count:', (data.records || []).length);
            // Store all records for pagination
            allExpensesRecords = data.records || [];
            // Reset to first page when loading new data
            currentPage = 1;
            renderPaginatedExpenses();
        })
        .catch(err => {
            console.error('[ERROR] Error loading expenses:', err);
            document.getElementById('expenses-rows').innerHTML = `<tr><td colspan="11" style="text-align: center; color:#cf222e; padding:20px;">Error loading data: ${esc(err.message)}</td></tr>`;
        });
}

// Load summary KPIs
function loadSummary() {
    const startDate = document.getElementById('filter_start_date').value;
    const endDate = document.getElementById('filter_end_date').value;
    
    let queryUrl = `/api/worker/expenses-summary?start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}`;
    
    fetch(queryUrl)
        .then(res => res.json())
        .then(data => {
            const rawBalance = parseFloat(data.current_balance) || 0;
            
            // If balance is 0 or negative (no money left), clamp cleanly to 0
            const displayBalance = rawBalance > 0 
                ? rawBalance.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs' 
                : '0 Afs';

            document.getElementById('kpi-total-cash-in').textContent = (parseFloat(data.total_cash_in) || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs';
            document.getElementById('kpi-total-cash-out').textContent = (parseFloat(data.total_cash_out) || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs';
            document.getElementById('kpi-available-balance').textContent = displayBalance;
            document.getElementById('kpi-reimbursement-due').textContent = (parseFloat(data.reimbursement_due) || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs';
        })
        .catch(err => {
            console.error('[ERROR] Error loading summary:', err);
        });
}

// Render expenses table
function renderExpensesTable(records, allRecords = null) {
    const rowsContainer = document.getElementById('expenses-rows');
    let html = '';
    
    // Calculate totals from all records (not just current page)
    const recordsForTotals = allRecords || records;
    let totalCashIn = 0;
    let totalCashOut = 0;
    
    if (recordsForTotals && recordsForTotals.length > 0) {
        recordsForTotals.forEach(row => {
            totalCashIn += parseFloat(row.cash_in) || 0;
            totalCashOut += parseFloat(row.cash_out) || 0;
        });
    }
    
    if (!records || records.length === 0) {
        html = `
            <tr>
                <td colspan="11" class="empty-state-cell">
                    <div class="empty-state-content">
                        <span class="empty-state-icon">🔍</span>
                        <p class="empty-state-title">
                            <%= t('worker_daily_expenses.no_transactions') %>
                        </p>
                        <p class="empty-state-description">
                            <%= t('worker_daily_expenses.no_transactions_sub') %>
                        </p>
                    </div>
                </td>
            </tr>
        `;
    } else {
        records.forEach((row, index) => {
            const categoryBadge = getCategoryBadge(row.category);
            
            html += `
                <tr style="border-bottom: 1px solid #eaeef2;">
                    <td class="table-row-number">${esc(index + 1)}</td>
                    <td style="padding: 6px; text-align: center;">${esc(row.transaction_date || '-')}</td>
                    <td style="padding: 6px; text-align: right;">${esc(categoryBadge)}</td>
                    <td style="padding: 6px; text-align: right;">${esc(row.description || '-')}</td>
                    <td style="padding: 6px; text-align: right;">${esc(row.person_involved || '-')}</td>
                    <td style="padding: 6px; text-align: center;">${esc(row.quantity || 1)}</td>
                    <td style="padding: 6px; text-align: center;">${esc((row.unit_price || 0).toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 600;">${esc((row.total_price || 0).toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 700; color: #1a7f37;">${esc((row.cash_in || 0).toLocaleString())}</td>
                    <td style="padding: 6px; text-align: center; font-weight: 700; color: #cf222e;">${esc((row.cash_out || 0).toLocaleString())}</td>
                    <td style="padding: 6px; text-align: right; color: var(--text-muted);">${esc(row.remarks || '-')}</td>
                </tr>
            `;
        });
    }
    
    rowsContainer.innerHTML = html;
    
    // Update footer totals from all records
    document.getElementById('total-cash-in-cell').textContent = totalCashIn.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs';
    document.getElementById('total-cash-out-cell').textContent = totalCashOut.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}) + ' Afs';
}

// Get category badge styling
function getCategoryBadge(category) {
    const badges = {
        'Food': '<span class="role-tag" style="background-color:#fff8c5; color:#9a6700; font-weight:700;">Food</span>',
        'Stationery': '<span class="role-tag" style="background-color:#e1ecf4; color:#0969da; font-weight:700;">Stationery</span>',
        'Rent': '<span class="role-tag" style="background-color:#ffebe9; color:#cf222e; font-weight:700;">Rent</span>',
        'Electricity': '<span class="role-tag" style="background-color:#ffebe9; color:#cf222e; font-weight:700;">Electricity</span>',
        'Salaries': '<span class="role-tag" style="background-color:#e1ecf4; color:#0969da; font-weight:700;">Salaries</span>',
        'Furniture': '<span class="role-tag" style="background-color:#dafbe3; color:#1a7f37; font-weight:700;">Furniture</span>',
        'HQ Inflow': '<span class="role-tag" style="background-color:#dafbe3; color:#1a7f37; font-weight:700;">HQ Inflow</span>',
        'Other': '<span class="role-tag" style="background-color:#f6f8fa; color: var(--text-muted); font-weight:700;">Other</span>'
    };
    return badges[category] || `<span class="role-tag" style="background-color:#f6f8fa; color: var(--text-muted); font-weight:700;">${esc(category)}</span>`;
}

// Reset filters
function resetFilters() {
    // 1. Reset main category checkboxes to checked
    const checkboxes = document.querySelectorAll('.category-checkbox');
    checkboxes.forEach(cb => cb.checked = true);
    document.getElementById('category_btn_label').textContent = 'همه دسته‌بندی‌ها (All Categories)';
    
    // 2. Clear main datepickers
    document.getElementById('filter_start_date').value = '';
    document.getElementById('filter_end_date').value = '';
    
    // 3. Clear advanced modal inputs
    if (document.getElementById('adv_start_date')) document.getElementById('adv_start_date').value = '';
    if (document.getElementById('adv_end_date')) document.getElementById('adv_end_date').value = '';
    if (document.getElementById('adv_category')) document.getElementById('adv_category').value = '';
    if (document.getElementById('adv_person')) document.getElementById('adv_person').value = '';
    if (document.getElementById('adv_cash_in')) document.getElementById('adv_cash_in').value = '';
    if (document.getElementById('adv_cash_out')) document.getElementById('adv_cash_out').value = '';
    if (document.getElementById('adv_description')) document.getElementById('adv_description').value = '';
    if (document.getElementById('adv_quantity')) document.getElementById('adv_quantity').value = '';
    if (document.getElementById('adv_unit_price')) document.getElementById('adv_unit_price').value = '';
    if (document.getElementById('adv_remarks')) document.getElementById('adv_remarks').value = '';
    
    // 4. Wipe active advanced filter criteria object
    window.advFilterCriteria = {};
    
    // 5. Reload clean data
    loadExpenses();
    loadSummary();
}

// Load initial data
loadExpenses();
loadSummary();
</script>

