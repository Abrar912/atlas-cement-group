        <div class="form-group">
            <label><%= t('waybill.remarks') %></label>
            <textarea id="wb_remarks" class="form-control" rows="3" placeholder="<%= t('waybill.remarks_placeholder') %>" oninput="updateWaybillSheet()"></textarea>
        </div>


        <button onclick="saveWaybill()" class="btn btn-primary" style="width: 100%; background-color: #4a90e2; padding: 12px; font-size: 15px; margin-top: 10px;">
            💾 <%= t('waybill.save_button') %>
        </button>
    </div>

    <!-- Live Preview & Printable Sheet -->
    <div class="card waybill-print-sheet">
        <div class="eway-container" dir="<%= dir %>">
            
            <!-- Header Banner: Logo, Centered Title, Contact Phones -->
            <div class="eway-header">
                <!-- Left Side: Configured Contact Numbers -->
                <div style="text-align: start !important; font-size: 12px; color: #24292e;">
                    <strong><%= t('waybill.print_contact_numbers') %></strong><br>
                    <span>📞 <%= content.waybill_phone_1 || '+۹۳ ۷۰۰ ۰۰۰ ۰۰۰' %></span><br>
                    <span>📞 <%= content.waybill_phone_2 || '+۹۳ ۷۸۰ ۰۰۰ ۰۰۰' %></span>
                </div>

                <!-- Center: Company Name & Subtext -->
                <div style="text-align: center !important;">
                    <h1 class="eway-title"><%= t('waybill.print_company_name') %></h1>
                    <p style="margin: 4px 0 0 0; font-size: 13px; color: #57606a; text-align: center !important;"><%= t('waybill.print_subtitle') %></p>
                </div>

                <!-- Right Side: Company Logo -->
                <div style="text-align: end;">
                    <img src="/Logo.png" alt="Atlas Cement Group ERP" style="width: 55px; height: 55px; object-fit: contain;">
                </div>
            </div>

            <!-- Section 1: Waybill Metadata -->
            <div class="eway-section-header"><%= t('waybill.section_1_header') %></div>
            <table class="eway-grid-table">
                <tr>
                    <td style="width: 20%; font-weight: bold;"><%= t('waybill.print_serial_number') %></td>
                    <td style="width: 30%; color: #cf222e; font-weight: bold;" id="lbl_wb_serial">WB-0001</td>
                    <td style="width: 20%; font-weight: bold;"><%= t('waybill.print_loading_date') %></td>
                    <td style="width: 30%;" id="lbl_wb_date">____/__/__</td>
                </tr>
                <tr>
                    <td style="font-weight: bold;"><%= t('waybill.print_sent_to_agency') %></td>
                    <td id="lbl_wb_selled_to" colspan="3">__________</td>
                </tr>
            </table>

            <!-- Section 2: Transport & Driver Details -->
            <div class="eway-section-header"><%= t('waybill.section_2_header') %></div>
            <table class="eway-grid-table">
                <tr>
                    <td style="font-weight: bold;"><%= t('waybill.print_driver_name') %></td>
