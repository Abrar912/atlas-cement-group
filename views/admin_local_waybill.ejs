// Auto-calculate Tonnage from Bags (20 Bags = 1 Ton) with Dari display
document.getElementById('wb_bags').addEventListener('input', function() {
    calculateTonnage();
});

function calculateTonnage() {
    const bags = parseFloat(document.getElementById('wb_bags').value) || 0;
    const tonnage = (bags / 20).toFixed(2);
    document.getElementById('wb_tonnage').value = `${tonnage} ${waybillTranslations.js_ton_unit} (${bags} کیسه)`;
    document.getElementById('wb_calculated_tonnage_val').value = tonnage;
    updateWaybillSheet();
}

// Validate Bags Count Range (650-950)
function validateBagsCount() {
    const bagsInput = document.getElementById('wb_bags');
    const errorElement = document.getElementById('wb_bags_error');
    const bags = parseFloat(bagsInput.value);

    if (bags < 650 || bags > 950) {
        errorElement.style.display = 'block';
        bagsInput.style.borderColor = '#cf222e';
        return false;
    } else {
        errorElement.style.display = 'none';
        bagsInput.style.borderColor = '';
        return true;
    }
}

// Cement stock link: Bag Count stays disabled until a cement type is picked,
// then the available stock of that type is shown below the field.
let stockAvailMap = window.STOCK_AVAILABILITY || {};

function onCementTypeChange() {
    const typeEl = document.getElementById('wb_type');
    const bagsEl = document.getElementById('wb_bags');
    const availEl = document.getElementById('wb_stock_avail');
    const errEl = document.getElementById('wb_stock_error');
    if (errEl) errEl.style.display = 'none';

    if (!typeEl.value) {
        bagsEl.disabled = true;
        if (availEl) {
            availEl.style.display = 'none';
            availEl.textContent = '';
        }
        return;
    }

    bagsEl.disabled = false;
    if (availEl) {
        if (stockAvailMap.hasOwnProperty(typeEl.value)) {
            const avail = Number(stockAvailMap[typeEl.value]) || 0;
            availEl.textContent = waybillTranslations.stock_available_label + ': ' +
                avail.toLocaleString('en-US') + ' ' + waybillTranslations.stock_unit_bags;
            availEl.style.display = 'block';
        } else {
            availEl.style.display = 'none';
        }
    }
    validateStockCount();
}

// Not enough bags in stock? Show the inline error (used on input and before save)
function validateStockCount() {
    const typeEl = document.getElementById('wb_type');
    const bagsEl = document.getElementById('wb_bags');
    const errEl = document.getElementById('wb_stock_error');
    const hasTracking = typeEl.value && stockAvailMap.hasOwnProperty(typeEl.value);
    const avail = hasTracking ? Number(stockAvailMap[typeEl.value]) : null;
    const bags = parseInt(bagsEl.value) || 0;
    const over = avail !== null && bags > avail;
    if (errEl) errEl.style.display = over ? 'block' : 'none';
    if (over) bagsEl.style.borderColor = '#cf222e';
    return !over;
}

// Toggle Rent Fields based on Truck Type
function toggleTruckRentInput() {
    const type = document.getElementById('wb_truck_type').value;
    const rentBox = document.getElementById('wb_rent_container');
    const totalBox = document.getElementById('wb_total_freight_container');
    
    if (type === 'rented') {
        rentBox.style.display = 'block';
        totalBox.style.display = 'block';
        calculateFreightTotal();
    } else {
        rentBox.style.display = 'none';
        totalBox.style.display = 'none';
        document.getElementById('wb_freight_per_ton').value = 0;
        document.getElementById('wb_total_freight_val').value = 0;
        document.getElementById('wb_total_freight_display').value = waybillTranslations.js_company_truck_freight;
    }
}

// Calculate Total Freight (Tonnage * Freight per Ton)
function calculateFreightTotal() {
    const tonnage = parseFloat(document.getElementById('wb_calculated_tonnage_val').value) || 0;
    const rate = parseFloat(document.getElementById('wb_freight_per_ton').value) || 0;
    const total = tonnage * rate;
    
    document.getElementById('wb_total_freight_val').value = total.toFixed(2);
    document.getElementById('wb_total_freight_display').value = `${total.toLocaleString()} ${waybillTranslations.js_afghani_currency}`;
}

// Validate Driver Phone Number (Must be at least 9 digits)
function getFormattedDriverPhone() {
    const rawPhone = (document.getElementById('wb_driver_phone').value || '').trim();
    if (rawPhone.length < 9) {
        return null;
    }
    return `+93${esc(rawPhone)}`;
}

// Update Waybill Live Preview & Printable Card
function updateWaybillSheet() {
    document.getElementById('lbl_wb_date').textContent = document.getElementById('wb_date').value || '____/__/__';
    
    document.getElementById('lbl_wb_driver').textContent = document.getElementById('wb_driver_name').value || '__________';
    
    // Bind phone with +93 prefix
    const rawPhone = (document.getElementById('wb_driver_phone').value || '').trim();
    document.getElementById('lbl_wb_driver_phone').textContent = rawPhone ? `+93 ${rawPhone}` : '__________';
    
    document.getElementById('lbl_wb_plate').textContent = document.getElementById('wb_truck_plate').value || '__________';
    document.getElementById('lbl_wb_type').textContent = document.getElementById('wb_type').value || waybillTranslations.js_default_cement;
    document.getElementById('lbl_wb_bags').textContent = document.getElementById('wb_bags').value || '____';
    
    // Format tonnage with decimal places
    const tonnageVal = document.getElementById('wb_calculated_tonnage_val').value || '0';
    document.getElementById('lbl_wb_tonnage').textContent = `${parseFloat(tonnageVal).toFixed(2)} ${waybillTranslations.js_ton_unit}`;
    
    const truckType = document.getElementById('wb_truck_type').value;
    const totalFreight = document.getElementById('wb_total_freight_val').value || 0;
    const truckLabel = truckType === 'rented' 
        ? waybillTranslations.js_rented_freight_label.replace('{freight}', parseFloat(totalFreight).toLocaleString())
        : waybillTranslations.js_truck_company_label;
    if (document.getElementById('lbl_wb_truck_type')) {
        document.getElementById('lbl_wb_truck_type').textContent = truckLabel;
    }

    const freightLabel = truckType === 'rented' ? `${parseFloat(totalFreight).toLocaleString()} ${esc(waybillTranslations.js_afghani_currency)}` : `۰ ${esc(waybillTranslations.js_afghani_currency)}`;
    document.getElementById('lbl_wb_total_freight').textContent = freightLabel;

    const loadingSelect = document.getElementById('wb_loading_province');
    document.getElementById('lbl_wb_loading').textContent = loadingSelect.options[loadingSelect.selectedIndex]?.text || '__________';
    
    const unloadingSelect = document.getElementById('wb_unloading_province');
    document.getElementById('lbl_wb_unloading').textContent = unloadingSelect.options[unloadingSelect.selectedIndex]?.text || '__________';
    
    const remarksVal = document.getElementById('wb_remarks').value.trim();
    document.getElementById('lbl_wb_remarks').textContent = remarksVal || waybillTranslations.js_remark_default;
    
    // Update "ارسال شده به" field - display the selected option's text (agency_name)
    const selledToSelect = document.getElementById('wb_selled_to');
    const selledTo = selledToSelect.options[selledToSelect.selectedIndex]?.text || '__________';
    if (document.getElementById('lbl_wb_selled_to')) {
        document.getElementById('lbl_wb_selled_to').textContent = selledTo;
    }
    
    // Update barcode serial
    const serial = document.getElementById('wb_serial').value || 'WB-0001';
    if (document.getElementById('barcode_serial')) {
        document.getElementById('barcode_serial').textContent = serial;
    }
}

// Save waybill to database
function saveWaybill() {
    const rawPhone = (document.getElementById('wb_driver_phone').value || '').trim();
    
    // Remove any non-digit characters for validation
    const digitsOnly = rawPhone.replace(/\D/g, '');
    
    // 9-digit Validation Check
    if (digitsOnly.length !== 9) {
        alert(waybillTranslations.js_phone_validation_error);
        document.getElementById('wb_driver_phone').focus();
        return;
    }

    // Bags Count Range Validation (650-950)
    if (!validateBagsCount()) {
        alert(waybillTranslations.js_bags_validation_error);
        document.getElementById('wb_bags').focus();
        return;
    }

    // Cement stock gate: not enough bags in stock for the selected cement type
    if (!validateStockCount()) {
        alert(waybillTranslations.js_stock_insufficient_error);
        document.getElementById('wb_bags').focus();
        return;
    }

    // Format phone with country code (input should be local digits only)
    const formattedPhone = `+93${esc(digitsOnly)}`;

    const waybillData = {
        waybill_serial: document.getElementById('wb_serial').value,
        waybill_date: document.getElementById('wb_date').value,
        selled_to_agent: document.getElementById('wb_selled_to').value,
        driver_name: document.getElementById('wb_driver_name').value,
        driver_phone: formattedPhone,
        truck_plate: document.getElementById('wb_truck_plate').value,
        truck_type: document.getElementById('wb_truck_type').value,
        freight_per_ton: parseFloat(document.getElementById('wb_freight_per_ton').value) || 0,
        total_freight: parseFloat(document.getElementById('wb_total_freight_val').value) || 0,
        cement_type: document.getElementById('wb_type').value,
        total_bags: parseInt(document.getElementById('wb_bags').value) || 0,
        tonnage: parseFloat(document.getElementById('wb_calculated_tonnage_val').value) || 0,
        loading_province: document.getElementById('wb_loading_province').value,
        unloading_province: document.getElementById('wb_unloading_province').value,
        remarks: document.getElementById('wb_remarks').value
    };

    // Validate required fields
    if (!waybillData.waybill_date || !waybillData.selled_to_agent || !waybillData.driver_name || 
        !waybillData.truck_plate || !waybillData.total_bags || !waybillData.loading_province || !waybillData.unloading_province) {
        alert(waybillTranslations.js_required_fields_error);
        return;
    }

    fetch('/api/admin/save-waybill', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(waybillData)
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert(waybillTranslations.js_save_success);

            // Reflect the stock deduction in the availability display without reloading
            if (waybillData.cement_type && stockAvailMap.hasOwnProperty(waybillData.cement_type)) {
                stockAvailMap[waybillData.cement_type] = Number(stockAvailMap[waybillData.cement_type]) - waybillData.total_bags;
                onCementTypeChange();
            }

            // Clear form inputs
            document.getElementById('wb_date').value = '';
            document.getElementById('wb_selled_to').value = '';
            document.getElementById('wb_driver_name').value = '';
            document.getElementById('wb_driver_phone').value = '';
            document.getElementById('wb_truck_plate').value = '';
            document.getElementById('wb_bags').value = '';
            document.getElementById('wb_tonnage').value = '';
            document.getElementById('wb_calculated_tonnage_val').value = '';
            document.getElementById('wb_freight_per_ton').value = '';
            document.getElementById('wb_total_freight_val').value = '0';
            document.getElementById('wb_remarks').value = '';
            document.getElementById('wb_loading_province').value = '';
            document.getElementById('wb_unloading_province').value = '';
            
            // Instant Real-time Data Refresh without page reload
            fetchNextSerial();
            loadWaybillHistory();
            updateWaybillSheet();
        } else if (data.code === 'insufficient_stock') {
            alert(waybillTranslations.js_stock_insufficient_error);
        } else {
            alert(waybillTranslations.js_save_error.replace('{error}', data.error || waybillTranslations.js_unknown_error));
        }
    })
    .catch(err => {
        console.error('Error saving waybill:', err);
        alert(waybillTranslations.js_connection_error);
    });
}

// Waybill History Table Management
let currentTableData = [];
let filteredTableData = [];
let wbCurrentPage = 1;
let wbRowsPerPage = 10; // Default dynamic rows count

function loadWaybillHistory() {
    fetch('/api/admin/waybill-history')
        .then(res => res.json())
        .then(data => {
            currentTableData = data.records || [];
            filteredTableData = [...currentTableData];
            wbCurrentPage = 1;
            renderWaybillTable();
        })
        .catch(err => console.error('Error loading history:', err));
}

function filterWaybillTable() {
    const term = document.getElementById('wb_search_input').value.toLowerCase().trim();
    filteredTableData = currentTableData.filter(row => 
        (row.waybill_serial || '').toLowerCase().includes(term) ||
        (row.driver_name || '').toLowerCase().includes(term) ||
        (row.truck_plate || '').toLowerCase().includes(term) ||
        (row.selled_to_agent || '').toLowerCase().includes(term)
    );
    wbCurrentPage = 1;
    renderWaybillTable();
}

function renderWaybillTable() {
    const container = document.getElementById('waybill-history-rows');
    if (filteredTableData.length === 0) {
        container.innerHTML = `<tr><td colspan="15" style="padding: 20px; color: #57606a;">${esc(waybillTranslations.no_waybills)}</td></tr>`;
        updateWbPagination(0);
        return;
    }

    const totalRecords = filteredTableData.length;
    const totalPages = Math.ceil(totalRecords / wbRowsPerPage) || 1;
    const startIdx = (wbCurrentPage - 1) * wbRowsPerPage;
    const paginated = filteredTableData.slice(startIdx, startIdx + wbRowsPerPage);

    let html = '';
    paginated.forEach((row, i) => {
        const isSold = row.status === 'posted_sold' || row.status === 'draft_sold';

        const statusBadge = isSold
            ? `<span class="waybill-status-badge waybill-status-sold">${esc(waybillTranslations.status_sold)}</span>`
            : `<span class="waybill-status-badge waybill-status-pending">${esc(waybillTranslations.status_pending)}</span>`;

        const truckLabel = row.truck_type === 'rented' ? waybillTranslations.js_truck_rented_label : waybillTranslations.js_truck_company_label;
        const freightLabel = row.truck_type === 'rented' ? `${parseFloat(row.total_freight || 0).toLocaleString()} ${esc(waybillTranslations.js_afghani_currency)}` : waybillTranslations.js_truck_company_label;

        html += `
            <tr class="${esc(isSold ? 'waybill-row-sold' : '')}">
                <td style="padding: 10px 8px;" class="waybill-action-cell">
                    <div style="display: flex; gap: 6px; justify-content: center; align-items: center; min-width: 100px;">
                        <button onclick="openEditWbModal(${esc(row.id)})" class="btn btn-primary waybill-action-btn">${esc(waybillTranslations.js_edit_button)}</button>
                        <button onclick="deleteWaybill(${esc(row.id)})" class="btn btn-danger waybill-action-btn">${esc(waybillTranslations.js_delete_button)}</button>
                    </div>
                </td>
                <td style="padding: 10px 8px;">${statusBadge}</td>
                <td style="padding: 10px 8px;">${esc(row.unloading_province || '-')}</td>
                <td style="padding: 10px 8px;">${esc(row.loading_province || '-')}</td>
                <td style="padding: 10px 8px; font-weight: 600;">${esc(row.tonnage || 0)} ${esc(waybillTranslations.js_ton_unit)}</td>
                <td style="padding: 10px 8px; font-weight: 600;">${esc(row.total_bags || 0)}</td>
                <td style="padding: 10px 8px; font-weight: 600;">${esc(freightLabel)}</td>
                <td style="padding: 10px 8px; font-weight: 600;">${esc(truckLabel)}</td>
                <td style="padding: 10px 8px;">${esc(row.truck_plate || '-')}</td>
                <td style="padding: 10px 8px;">${esc(row.driver_phone || '-')}</td>
                <td style="padding: 10px 8px;">${esc(row.driver_name || '-')}</td>
                <td style="padding: 10px 8px;">${esc(row.agency_name || row.selled_to_agent || '-')}</td>
                <td style="padding: 10px 8px;">${esc(row.waybill_date || '-')}</td>
                <td style="padding: 10px 8px; font-weight: 600;">${esc(row.waybill_serial || '-')}</td>
                <td style="padding: 10px 8px;">${esc(startIdx + i + 1)}</td>
            </tr>
        `;
    });
    container.innerHTML = html;
    updateWbPagination(totalRecords);
}

function updateWbPagination(totalRecords) {
    const totalPages = Math.ceil(totalRecords / wbRowsPerPage) || 1;
    const start = totalRecords === 0 ? 0 : (wbCurrentPage - 1) * wbRowsPerPage + 1;
    const end = Math.min(wbCurrentPage * wbRowsPerPage, totalRecords);

    if (document.getElementById('lbl_page_start')) document.getElementById('lbl_page_start').textContent = start.toLocaleString();
    if (document.getElementById('lbl_page_end')) document.getElementById('lbl_page_end').textContent = end.toLocaleString();
    if (document.getElementById('lbl_total_count')) document.getElementById('lbl_total_count').textContent = totalRecords.toLocaleString();
    if (document.getElementById('lbl_page_indicator')) document.getElementById('lbl_page_indicator').textContent = `${waybillTranslations.page_label} ${wbCurrentPage} ${waybillTranslations.page_of} ${totalPages}`;

    if (document.getElementById('btn_page_prev')) document.getElementById('btn_page_prev').disabled = (wbCurrentPage === 1 || totalRecords === 0);
    if (document.getElementById('btn_page_next')) document.getElementById('btn_page_next').disabled = (wbCurrentPage === totalPages || totalRecords === 0);
}

// Handle Rows Per Page Selection Change
function handleRowsPerPageChange(val) {
    wbRowsPerPage = parseInt(val) || 10;
    wbCurrentPage = 1; // Reset to first page when limit changes
    renderWaybillTable();
}

// Go to previous page
function goToPrevPage() {
    if (wbCurrentPage > 1) {
        wbCurrentPage--;
        renderWaybillTable();
    }
}

// Go to next page
function goToNextPage() {
    const maxP = Math.ceil(filteredTableData.length / wbRowsPerPage);
    if (wbCurrentPage < maxP) {
        wbCurrentPage++;
        renderWaybillTable();
    }
}

function deleteWaybill(id) {
    if (!confirm('Are you sure you want to delete this waybill? This action cannot be undone.')) return;
    fetch(`/api/admin/waybill/${id}`, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                loadWaybillHistory();
                fetchNextSerial();
            } else {
                alert(waybillTranslations.js_save_error.replace('{error}', data.error || waybillTranslations.js_unknown_error));
            }
        })
        .catch(err => console.error('Error deleting waybill:', err));
}

// Edit Waybill Modal Functions
function openEditWbModal(id) {
    const item = currentTableData.find(r => r.id === id);
    if (!item) return;

    document.getElementById('edit_wb_id').value = item.id;
    document.getElementById('edit_modal_serial').textContent = `(${item.waybill_serial})`;
    document.getElementById('edit_wb_date').value = item.waybill_date || '';
    document.getElementById('edit_wb_driver_name').value = item.driver_name || '';
    
    // Strip country code from phone number for display in edit modal
    let phoneDisplay = item.driver_phone || '';
    if (phoneDisplay.startsWith('+93')) {
        phoneDisplay = phoneDisplay.substring(3);
    }
    document.getElementById('edit_wb_driver_phone').value = phoneDisplay;
    
    document.getElementById('edit_wb_truck_plate').value = item.truck_plate || '';
    document.getElementById('edit_wb_type').value = item.cement_type || '';
    document.getElementById('edit_wb_truck_type').value = item.truck_type || 'company';
    document.getElementById('edit_wb_freight_per_ton').value = item.freight_per_ton || 0;
    document.getElementById('edit_wb_bags').value = item.total_bags || 0;
    document.getElementById('edit_wb_tonnage').value = `${item.tonnage || 0} تن`;
    document.getElementById('edit_wb_loading').value = item.loading_province || '';
    document.getElementById('edit_wb_unloading').value = item.unloading_province || '';
    document.getElementById('edit_wb_remarks').value = item.remarks || '';

    // Set edit agency dropdown value using username (database stores username)
    document.getElementById('edit_wb_selled_to').value = item.selled_to_agent || '';

    // Copy options to edit cement type dropdown
    const mainCementSelect = document.getElementById('wb_type');
    const editCementSelect = document.getElementById('edit_wb_type');
    if (mainCementSelect && editCementSelect) {
        editCementSelect.innerHTML = mainCementSelect.innerHTML;
        editCementSelect.value = item.cement_type || '';
    }

    calcEditFreight();
    document.getElementById('editWbModal').style.display = 'flex';
}

function closeEditWbModal() {
    document.getElementById('editWbModal').style.display = 'none';
}

function calcEditTonnage() {
    const bags = parseFloat(document.getElementById('edit_wb_bags').value) || 0;
    const tonnage = (bags / 20).toFixed(2);
    document.getElementById('edit_wb_tonnage').value = `${tonnage} تن`;
    calcEditFreight();
}

function calcEditFreight() {
    const type = document.getElementById('edit_wb_truck_type').value;
    const rentBox = document.getElementById('edit_rent_box');
    rentBox.style.display = type === 'rented' ? 'block' : 'none';
}

function saveEditWaybill() {
    const id = document.getElementById('edit_wb_id').value;
    const bags = parseFloat(document.getElementById('edit_wb_bags').value) || 0;
    const tonnage = (bags / 20).toFixed(2);
    const rate = parseFloat(document.getElementById('edit_wb_freight_per_ton').value) || 0;
    const totalFreight = document.getElementById('edit_wb_truck_type').value === 'rented' ? (tonnage * rate).toFixed(2) : 0;

    const payload = {
        waybill_date: document.getElementById('edit_wb_date').value,
        selled_to_agent: document.getElementById('edit_wb_selled_to').value,
        driver_name: document.getElementById('edit_wb_driver_name').value,
        driver_phone: document.getElementById('edit_wb_driver_phone').value,
        truck_plate: document.getElementById('edit_wb_truck_plate').value,
        truck_type: document.getElementById('edit_wb_truck_type').value,
        freight_per_ton: rate,
        total_freight: totalFreight,
        cement_type: document.getElementById('edit_wb_type').value,
        total_bags: bags,
        tonnage: tonnage,
        loading_province: document.getElementById('edit_wb_loading').value,
        unloading_province: document.getElementById('edit_wb_unloading').value,
        remarks: document.getElementById('edit_wb_remarks').value
    };

    fetch(`/api/admin/waybill/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            alert('تغییرات بارنامه با موفقیت ثبت شد');
            closeEditWbModal();
            loadWaybillHistory();
        } else {
            alert('خطا در ثبت تغییرات: ' + (data.error || 'خطای ناشناخته'));
        }
    })
    .catch(err => {
        console.error('Error updating waybill:', err);
        alert('خطا در ثبت تغییرات بارنامه');
    });
}

// Initialize intl-tel-input for driver phone field
let driverPhoneInput;

document.addEventListener('DOMContentLoaded', function() {
    // Initialize driver phone input
    const driverPhoneElement = document.getElementById('wb_driver_phone');
    if (driverPhoneElement) {
        driverPhoneInput = intlTelInput(driverPhoneElement, {
            initialCountry: 'af',
            separateDialCode: true,
            utilsScript: 'https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js',
            rtl: true,
            nationalMode: true,
            formatOnDisplay: false
        });

        // Handle input to limit digits based on country
        driverPhoneElement.addEventListener('input', function(e) {
            const countryData = driverPhoneInput.getSelectedCountryData();
            const dialCode = countryData.dialCode;
            const maxLength = countryData.name === 'Afghanistan' ? 9 : 15;
            
            // Get current value and remove non-digits
            let value = e.target.value.replace(/\D/g, '');
            
            // Limit to max digits for the country
            if (value.length > maxLength) {
                value = value.substring(0, maxLength);
                e.target.value = value;
            }
            
            // Clear error while typing
            const errorElement = document.getElementById('wb_driver_phone_error');
            if (errorElement) {
                errorElement.style.display = 'none';
            }
        });

        // Handle paste to prevent duplicate country codes
        driverPhoneElement.addEventListener('paste', function(e) {
            e.preventDefault();
            const pastedText = (e.clipboardData || window.clipboardData).getData('text');
            
            // Remove any existing country code from pasted text
            let cleanNumber = pastedText.replace(/\D/g, '');
            
            // If pasted number starts with country code, remove it
            const countryData = driverPhoneInput.getSelectedCountryData();
            const dialCode = countryData.dialCode;
            if (cleanNumber.startsWith(dialCode)) {
                cleanNumber = cleanNumber.substring(dialCode.length);
            }
            
            // Limit to max digits for the country
            const maxLength = countryData.name === 'Afghanistan' ? 9 : 15;
            if (cleanNumber.length > maxLength) {
                cleanNumber = cleanNumber.substring(0, maxLength);
            }
            
            // Insert the cleaned number
            const start = e.target.selectionStart;
            const end = e.target.selectionEnd;
            const currentValue = e.target.value.replace(/\D/g, '');
            const newValue = currentValue.substring(0, start) + cleanNumber + currentValue.substring(end);
            
            e.target.value = newValue.substring(0, maxLength);
        });

        // Add validation on blur (when user leaves the field)
        driverPhoneElement.addEventListener('blur', function() {
            validateDriverPhone(true);
        });
    }

    // Add form validation for saveWaybill
    const originalSaveWaybill = window.saveWaybill;
    window.saveWaybill = function() {
        if (!validateDriverPhone(false)) {
            alert('لطفاً شماره تماس معتبر وارد کنید');
            document.getElementById('wb_driver_phone').focus();
            return;
        }
        // Phone number formatting is handled in saveWaybill function itself
        originalSaveWaybill();
    };

    // Add form validation for saveEditWaybill
    const originalSaveEditWaybill = window.saveEditWaybill;
    window.saveEditWaybill = function() {
        const editPhoneElement = document.getElementById('edit_wb_driver_phone');
        // For edit modal, we don't have intl-tel-input initialized, so just do basic validation
        if (editPhoneElement && editPhoneElement.value) {
            const cleanPhone = editPhoneElement.value.trim();
            // Remove any non-digit characters
            const digitsOnly = cleanPhone.replace(/\D/g, '');
            
            // Validate Afghan phone number (9 digits)
            if (digitsOnly.length !== 9) {
                alert('شماره تماس راننده باید ۹ رقم باشد.');
                editPhoneElement.focus();
                return;
            }
            
            // Add country code for storage
            editPhoneElement.value = '+93' + digitsOnly;
        }
        originalSaveEditWaybill();
    };
});

function validateDriverPhone(isBlur) {
    const errorElement = document.getElementById('wb_driver_phone_error');
    if (!driverPhoneInput || !errorElement) return true;

    const phoneNumber = driverPhoneInput.getNumber(intlTelInputUtils.numberFormat.NATIONAL);
    
    // If field is empty
    if (!phoneNumber || phoneNumber.trim() === '') {
        errorElement.style.display = 'none';
        return false;
    }

    // Get country data for specific validation
    const countryData = driverPhoneInput.getSelectedCountryData();
    const currentLength = phoneNumber.replace(/\D/g, '').length;
    
    // Afghanistan-specific validation: exactly 9 digits
    if (countryData.name === 'Afghanistan') {
        if (currentLength === 9) {
            errorElement.style.display = 'none';
            return true;
        }
        
        // Only show error on blur or when called from save (isBlur = false means save)
        if (isBlur || !isBlur) {
            errorElement.style.display = 'block';
            errorElement.textContent = 'شماره تماس راننده باید ۹ رقم باشد.';
            return false;
        }
    } else {
        // For other countries, use standard validation
        if (driverPhoneInput.isValidNumber()) {
            errorElement.style.display = 'none';
            return true;
        }
        
        // Only show error on blur or when called from save
        if (isBlur || !isBlur) {
            errorElement.style.display = 'block';
            errorElement.textContent = 'شماره تماس واردشده معتبر نیست.';
            return false;
        }
    }

    // If typing and not at error condition, don't show error
    errorElement.style.display = 'none';
    return false;
}

// Override openEditWbModal to handle existing phone numbers
const originalOpenEditWbModal = openEditWbModal;
openEditWbModal = function(id) {
    originalOpenEditWbModal(id);
    
    // Set the phone number in the edit modal
    const item = currentTableData.find(r => r.id === id);
    const editPhoneElement = document.getElementById('edit_wb_driver_phone');
    if (editPhoneElement && item && item.driver_phone) {
        editPhoneElement.value = item.driver_phone;
    }
};
</script>

