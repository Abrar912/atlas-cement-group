// Populate agency dropdown on page load
document.addEventListener('DOMContentLoaded', function() {
    loadAgencyUsers();
    loadEditAgencyDropdown();
    fetchNextSerial();
    updateWaybillSheet();
    loadWaybillHistory();
    populateAdvAgencyCheckboxes();
    loadCementTypesDropdown();
});

// Modal Controls
function openAdvWbModal() { 
    document.getElementById('advWbModal').style.display = 'flex'; 
}

function closeAdvWbModal() { 
    document.getElementById('advWbModal').style.display = 'none'; 
}

// Populate Agency Checkboxes in Modal
function populateAdvAgencyCheckboxes() {
    fetch('/api/admin/agency-users')
        .then(res => res.json())
        .then(data => {
            const container = document.getElementById('adv_agency_checkboxes');
            if (!container) return;
            container.innerHTML = '';
            (data.agencies || []).forEach(user => {
                const label = document.createElement('label');
                label.style.cssText = 'font-size: 12px; display: flex; align-items: center; gap: 6px; cursor: pointer;';
                label.innerHTML = `<input type="checkbox" class="adv-agency-cb" value="${esc(user.username)}"> ${esc(user.agency_name || user.username)}`;
                container.appendChild(label);
            });
        });
}

// Populate edit modal agency dropdown
function loadEditAgencyDropdown() {
    fetch('/api/admin/agency-users')
        .then(res => res.json())
        .then(data => {
            const editSelect = document.getElementById('edit_wb_selled_to');
            if (!editSelect) return;

            editSelect.innerHTML = `<option value="">${esc(waybillTranslations.js_select_agency_default)}</option>`;

            if (data.agencies && data.agencies.length > 0) {
                data.agencies.forEach(user => {
                    const option = document.createElement('option');
                    option.value = user.username; // Use username for database compatibility
                    option.textContent = user.agency_name || user.username; // Display agency_name or fallback to username
                    editSelect.appendChild(option);
                });
            }
        })
        .catch(err => {
            console.error('[ERROR] Error loading edit agency dropdown:', err);
        });
}

// Apply Advanced Filter Rules
function applyAdvWbFilters() {
    const serial = document.getElementById('adv_wb_serial').value.trim();
    const startDate = document.getElementById('adv_wb_start_date').value.trim();
    const endDate = document.getElementById('adv_wb_end_date').value.trim();
    const checkedAgencies = Array.from(document.querySelectorAll('.adv-agency-cb:checked')).map(cb => cb.value);
    const driver = document.getElementById('adv_wb_driver').value.toLowerCase().trim();
    const phone = document.getElementById('adv_wb_phone').value.trim();
    const plate = document.getElementById('adv_wb_plate').value.toLowerCase().trim();
    const type = document.getElementById('adv_wb_type').value.trim();
    const bags = document.getElementById('adv_wb_bags').value.trim();
    const tonnage = document.getElementById('adv_wb_tonnage').value.trim();
    const loading = document.getElementById('adv_wb_loading').value.toLowerCase().trim();
    const unloading = document.getElementById('adv_wb_unloading').value.toLowerCase().trim();
    const truckType = document.getElementById('adv_wb_truck_type').value.trim();
    const status = document.getElementById('adv_wb_status').value.trim();

    filteredTableData = currentTableData.filter(row => {
        if (serial && !(row.waybill_serial || '').toLowerCase().includes(`wb-${esc(serial.toLowerCase())}`)) return false;
        if (startDate && (row.waybill_date || '') < startDate) return false;
        if (endDate && (row.waybill_date || '') > endDate) return false;
        if (checkedAgencies.length > 0 && !checkedAgencies.includes(row.selled_to_agent)) return false;
        if (driver && !(row.driver_name || '').toLowerCase().includes(driver)) return false;
        if (phone && !(row.driver_phone || '').includes(phone)) return false;
        if (plate && !(row.truck_plate || '').toLowerCase().includes(plate)) return false;
        if (type && (row.cement_type || '') !== type) return false;
        if (bags && parseInt(row.total_bags) !== parseInt(bags)) return false;
        if (tonnage && parseFloat(row.tonnage) !== parseFloat(tonnage)) return false;
        if (loading && !(row.loading_province || '').toLowerCase().includes(loading)) return false;
        if (unloading && !(row.unloading_province || '').toLowerCase().includes(unloading)) return false;
        if (truckType && row.truck_type !== truckType) return false;
        if (status && (row.status || '') !== status) return false;
        return true;
    });

    wbCurrentPage = 1;
    renderWaybillTable();
    closeAdvWbModal();
}

