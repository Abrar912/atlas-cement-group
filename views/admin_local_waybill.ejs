// Load agency users dynamically
function loadAgencyUsers() {
    fetch('/api/admin/agency-users')
        .then(res => res.json())
        .then(data => {
            const agentSelect = document.getElementById('wb_selled_to');
            if (!agentSelect) return;

            // Clear existing options except default
            while (agentSelect.options.length > 1) {
                agentSelect.remove(1);
            }

            // Populate with agency users from database
            // Display agency_name, use username as value for database compatibility
            if (data.agencies && data.agencies.length > 0) {
                data.agencies.forEach(user => {
                    const option = document.createElement('option');
                    option.value = user.username; // Use username for database compatibility
                    option.textContent = user.agency_name || user.username; // Display agency_name or fallback to username
                    agentSelect.appendChild(option);
                });
            }
        })
        .catch(err => {
            console.error('[ERROR] Error loading agency users:', err);
        });
}

// Load Cement Types Dropdown Options
async function loadCementTypesDropdown() {
    try {
        const res = await fetch('/api/config/cement-types');
        if (!res.ok) return;
        const items = await res.json();

        const selectMain = document.getElementById('wb_type');
        const selectEdit = document.getElementById('edit_wb_type');
        const selectAdv = document.getElementById('adv_wb_type');
        
        const optionsHtml = items.map(item => 
