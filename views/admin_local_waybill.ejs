        ).join('');

        if (selectMain) {
            selectMain.innerHTML = `<option value="">${esc(waybillTranslations.js_select_cement_default)}</option>` + optionsHtml;
            onCementTypeChange();
        }
        if (selectEdit) {
            selectEdit.innerHTML = `<option value="">${esc(waybillTranslations.js_select_default)}</option>` + optionsHtml;
        }
        if (selectAdv) {
            selectAdv.innerHTML = `<option value="">${esc(waybillTranslations.filter_all_cement_types || 'All Cement Types')}</option>` + optionsHtml;
        }
