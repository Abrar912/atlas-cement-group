function fetchCementSummaryReport() {
    const startDate = document.getElementById('cement_report_start_date').value;
    const endDate = document.getElementById('cement_report_end_date').value;
    
    let url = '/api/reports/cement-summary';
    const params = new URLSearchParams();
    if (startDate) params.append('startDate', startDate);
    if (endDate) params.append('endDate', endDate);
    if (params.toString()) url += '?' + params.toString();
    
    const loadingDiv = document.getElementById('cement-summary-loading');
    const contentDiv = document.getElementById('cement-summary-content');
    
    loadingDiv.style.display = 'block';
    contentDiv.style.display = 'none';
    
    fetch(url)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            cementSummaryData = data.records || [];
            const totals = data.totals;
            
            // Reset to page 1 when filters change
            cementSummaryCurrentPage = 1;
            
            renderCementSummaryTable(cementSummaryData, totals);
            
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'block';
        })
        .catch(err => {
            console.error('[ERROR] Error loading cement summary report:', err);
            const translations = window.translations || {};
            const errorMsg = translations.cement_summary_error_loading || 'Error loading report:';
            loadingDiv.innerHTML = `<div style="color: #ef4444;">${esc(errorMsg)} ${esc(err.message)}</div>`;
        });
}

function renderCementSummaryTable(records, totals) {
    const tbody = document.getElementById('cement-summary-table-body');
    
    // Calculate pagination
    const totalPages = Math.ceil(records.length / cementSummaryRowsPerPage) || 1;
    const startIndex = (cementSummaryCurrentPage - 1) * cementSummaryRowsPerPage;
    const paginatedRecords = records.slice(startIndex, startIndex + cementSummaryRowsPerPage);
    
    let html = '';
    
    // Render paginated cement type records
    if (paginatedRecords.length === 0 && records.length === 0) {
        const translations = window.translations || {};
        const noDataMsg = translations.cement_summary_no_data || 'No cement types registered or no data available.';
        html = `<tr><td colspan="11" style="padding: 30px; color: var(--text-muted); text-align: center;">${esc(noDataMsg)}</td></tr>`;
    } else {
        paginatedRecords.forEach((record, index) => {
            html += `
                <tr style="border-bottom: 1px solid var(--border-color);">
                    <td style="padding: 10px;">${esc(startIndex + index + 1)}</td>
                    <td style="padding: 10px; font-weight: 700; color: var(--text-main);">${esc(record.cement_type)}</td>
                    <td style="padding: 10px;">${esc((record.total_waybills || 0).toLocaleString())}</td>
                    <td style="padding: 10px;">${esc((record.total_bags || 0).toLocaleString())}</td>
                    <td style="padding: 10px;">${esc((record.total_tonnage || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td style="padding: 10px;">${esc((record.total_shortage || 0).toLocaleString())}</td>
                    <td style="padding: 10px;">${esc((record.company_trucks_count || 0).toLocaleString())}</td>
                    <td style="padding: 10px;">${esc((record.rental_trucks_count || 0).toLocaleString())}</td>
                    <td style="padding: 10px;">${esc((record.total_freight || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                    <td style="padding: 10px;">${esc((record.total_sales || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                    <td style="padding: 10px; font-weight: 700; color: var(--success-green);">${esc((record.total_net_cement || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                </tr>
            `;
        });
        
        // Render totals row if available (always show totals at the bottom of current page)
        if (totals) {
            html += `
                <tr style="background-color: var(--table-header-bg); border-top: 2px solid var(--border-color); font-weight: 800;">
                    <td style="padding: 12px;">-</td>
                    <td style="padding: 12px; color: var(--text-main);">${esc(totals.cement_type)}</td>
                    <td style="padding: 12px;">${esc((totals.total_waybills || 0).toLocaleString())}</td>
                    <td style="padding: 12px;">${esc((totals.total_bags || 0).toLocaleString())}</td>
                    <td style="padding: 12px;">${esc((totals.total_tonnage || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
                    <td style="padding: 12px;">${esc((totals.total_shortage || 0).toLocaleString())}</td>
                    <td style="padding: 12px;">${esc((totals.company_trucks_count || 0).toLocaleString())}</td>
                    <td style="padding: 12px;">${esc((totals.rental_trucks_count || 0).toLocaleString())}</td>
                    <td style="padding: 12px;">${esc((totals.total_freight || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                    <td style="padding: 12px;">${esc((totals.total_sales || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                    <td style="padding: 12px; color: var(--success-green);">${esc((totals.total_net_cement || 0).toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))} Afs</td>
                </tr>
            `;
        }
    }
    
    tbody.innerHTML = html;
    
    // Update pagination controls
    updateCementSummaryPagination(records.length, totalPages);
}

function updateCementSummaryPagination(totalRecords, totalPages) {
    const start = totalRecords === 0 ? 0 : (cementSummaryCurrentPage - 1) * cementSummaryRowsPerPage + 1;
    const end = Math.min(cementSummaryCurrentPage * cementSummaryRowsPerPage, totalRecords);
    
    document.getElementById('cement-summary-page-start').textContent = start.toLocaleString();
    document.getElementById('cement-summary-page-end').textContent = end.toLocaleString();
    document.getElementById('cement-summary-total-count').textContent = totalRecords.toLocaleString();
    
    // Update page numbers
    const pageNumbersDiv = document.getElementById('cement-summary-page-numbers');
    let pageNumbersHtml = '';
    
    for (let i = 1; i <= totalPages; i++) {
        if (i === cementSummaryCurrentPage) {
            pageNumbersHtml += `<button style="background: var(--accent-blue); color: #fff; border: none; padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 13px;">${esc(i)}</button>`;
        } else {
            pageNumbersHtml += `<button onclick="cementSummaryGoToPage(${esc(i)})" style="background: var(--table-header-bg); color: var(--text-main); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 13px;">${esc(i)}</button>`;
        }
    }
    
    pageNumbersDiv.innerHTML = pageNumbersHtml;
    
    // Update prev/next buttons
    document.getElementById('cement-summary-prev-btn').disabled = (cementSummaryCurrentPage === 1 || totalRecords === 0);
    document.getElementById('cement-summary-next-btn').disabled = (cementSummaryCurrentPage === totalPages || totalRecords === 0);
}

function handleCementSummaryRowsPerPageChange(val) {
    cementSummaryRowsPerPage = parseInt(val) || 10;
    cementSummaryCurrentPage = 1;
    renderCementSummaryTable(cementSummaryData, null);
}

function cementSummaryGoToPage(pageNum) {
    cementSummaryCurrentPage = pageNum;
    renderCementSummaryTable(cementSummaryData, null);
}

function cementSummaryGoToPrevPage() {
    if (cementSummaryCurrentPage > 1) {
        cementSummaryCurrentPage--;
        renderCementSummaryTable(cementSummaryData, null);
    }
}

function cementSummaryGoToNextPage() {
    const totalPages = Math.ceil(cementSummaryData.length / cementSummaryRowsPerPage);
    if (cementSummaryCurrentPage < totalPages) {
        cementSummaryCurrentPage++;
        renderCementSummaryTable(cementSummaryData, null);
    }
}

function printCementReport() {
    window.print();
}

// Advanced Customer Search Modal Functions
function openCustomerSearchModal() {
    document.getElementById('customerSearchModal').style.display = 'flex';
}

function closeCustomerSearchModal() {
    document.getElementById('customerSearchModal').style.display = 'none';
}

function applyCustomerSearch() {
    const customerId = document.getElementById('search_cust_id').value.trim();
    const customerName = document.getElementById('search_cust_name').value.trim();
    const province = document.getElementById('search_cust_province').value;
    const agent = document.getElementById('search_cust_agent').value;
    const phone = document.getElementById('search_cust_phone').value.trim();
    const address = document.getElementById('search_cust_address').value.trim();
    const email = document.getElementById('search_cust_email').value.trim();
    
    // Store search criteria in a global object for filtering
    // Only include non-empty fields
    window.customerSearchCriteria = {};
    
    if (customerId) window.customerSearchCriteria.customerId = customerId;
    if (customerName) window.customerSearchCriteria.customerName = customerName;
    if (province !== 'All') window.customerSearchCriteria.province = province;
    if (agent !== 'All') window.customerSearchCriteria.agent = agent;
    if (phone) window.customerSearchCriteria.phone = phone;
    if (address) window.customerSearchCriteria.address = address;
    if (email) window.customerSearchCriteria.email = email;
    
    console.log('[DEBUG] Customer search criteria applied:', window.customerSearchCriteria);
    
    // If no criteria provided, clear the search
    if (Object.keys(window.customerSearchCriteria).length === 0) {
        window.customerSearchCriteria = null;
    }
    
    applyFilters();
    closeCustomerSearchModal();
}

function resetCustomerSearch() {
    document.getElementById('search_cust_id').value = '';
    document.getElementById('search_cust_name').value = '';
    document.getElementById('search_cust_province').value = 'All';
    document.getElementById('search_cust_agent').value = 'All';
    document.getElementById('search_cust_phone').value = '';
    document.getElementById('search_cust_address').value = '';
    document.getElementById('search_cust_email').value = '';
    
    window.customerSearchCriteria = null;
    applyFilters();
}

// Admin Edit Row Function
function editRow(rowId) {
    const row = currentTableData.find(r => r.id == rowId);
    if (!row) {
        console.error('[ERROR] Row not found:', rowId);
        return;
    }
    
    // Populate edit modal with row data
    document.getElementById('edit_record_id').value = row.id;
    document.getElementById('edit_loading_date').value = row.loading_date || '';
    document.getElementById('edit_sale_date').value = row.sale_date || '';
    document.getElementById('edit_customer_id').value = row.customer_id || '';
    document.getElementById('edit_driver_name').value = row.driver_name || '';
    document.getElementById('edit_driver_phone').value = row.driver_phone || '';
    document.getElementById('edit_car_plate').value = row.car_plate || '';
    document.getElementById('edit_waybill_number').value = row.waybill_number || '';
    document.getElementById('edit_cement_type').value = row.cement_type || '';
    document.getElementById('edit_bags_count').value = row.bags_count || 0;
    document.getElementById('edit_tonnage').value = row.tonnage || 0;
    document.getElementById('edit_shortage').value = row.shortage || 0;
    document.getElementById('edit_unit_price_bag').value = row.unit_price_bag || 0;
    document.getElementById('edit_total_sales_money').value = row.total_sales_money || 0;
    document.getElementById('edit_freight_per_ton').value = row.freight_per_ton || 0;
    document.getElementById('edit_total_freight').value = row.total_freight || 0;
    document.getElementById('edit_net_cement_money').value = row.net_cement_money || 0;
    document.getElementById('edit_province_origin').value = row.province_origin || '';
    
    // Show edit modal
    document.getElementById('editAgentLogModal').style.display = 'flex';
}

// Admin Delete Row Function
function deleteRow(rowId) {
    if (!confirm('آیا از حذف این رکورد اطمینان دارید؟\nAre you sure you want to delete this record?')) {
        return;
    }
    
    fetch(`/api/reports/agent-log/${rowId}`, {
        method: 'DELETE',
        credentials: 'include'
    })
    .then(res => {
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        return res.json();
    })
    .then(data => {
        if (data.success) {
            console.log('[DEBUG] Record deleted successfully');
            loadAgentLogSubmissions(); // Reload the table
        } else {
            alert('Error deleting record: ' + (data.message || 'Unknown error'));
        }
    })
    .catch(err => {
        console.error('[ERROR] Error deleting record:', err);
        alert('Error deleting record: ' + err.message);
    });
}

// Save Edited Record
function saveEditedRecord() {
    const recordId = document.getElementById('edit_record_id').value;
    
    const updateData = {
        sale_date: document.getElementById('edit_sale_date').value,
        customer_id: parseInt(document.getElementById('edit_customer_id').value),
        driver_name: document.getElementById('edit_driver_name').value,
        car_plate: document.getElementById('edit_car_plate').value,
        waybill_number: document.getElementById('edit_waybill_number').value,
        cement_type: document.getElementById('edit_cement_type').value,
        bags_count: parseInt(document.getElementById('edit_bags_count').value) || 0,
        tonnage: parseFloat(document.getElementById('edit_tonnage').value) || 0,
        shortage: parseInt(document.getElementById('edit_shortage').value) || 0,
        unit_price_bag: parseFloat(document.getElementById('edit_unit_price_bag').value) || 0,
        total_sales_money: parseFloat(document.getElementById('edit_total_sales_money').value) || 0,
        freight_per_ton: parseFloat(document.getElementById('edit_freight_per_ton').value) || 0,
        total_freight: parseFloat(document.getElementById('edit_total_freight').value) || 0,
        net_cement_money: parseFloat(document.getElementById('edit_net_cement_money').value) || 0,
        province_origin: document.getElementById('edit_province_origin').value
    };
    
    fetch(`/api/reports/agent-log/${recordId}`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json'
        },
        credentials: 'include',
        body: JSON.stringify(updateData)
    })
    .then(res => {
        if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
        return res.json();
    })
    .then(data => {
        if (data.success) {
            console.log('[DEBUG] Record updated successfully');
            closeEditModal();
            loadAgentLogSubmissions(); // Reload the table
        } else {
            alert('Error updating record: ' + (data.message || 'Unknown error'));
        }
    })
    .catch(err => {
        console.error('[ERROR] Error updating record:', err);
        alert('Error updating record: ' + err.message);
    });
}

function closeEditModal() {
    document.getElementById('editAgentLogModal').style.display = 'none';
}
</script>

