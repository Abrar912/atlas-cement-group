<style>
/* Customer Balance Report Modal Full Screen */
#customerBalanceReportModal.fullscreen-active {
    align-items: flex-start;
    justify-content: flex-start;
}

#customerBalanceReportModalContent.full-screen {
    width: 100% !important;
    max-width: none !important;
    max-height: 100vh !important;
    border-radius: 0 !important;
    height: 100vh !important;
}

/* Customer Balance Report Table Container - Modern Themed Scrollbar */
.customer-balance-table-container {
    direction: ltr;
}

.customer-balance-table-container::-webkit-scrollbar {
    width: 10px;
    height: 10px;
}

.customer-balance-table-container::-webkit-scrollbar-track {
    background: var(--table-header-bg);
    border-radius: 6px;
}

.customer-balance-table-container::-webkit-scrollbar-thumb {
    background: var(--text-muted);
    border-radius: 6px;
    border: 2px solid var(--table-header-bg);
}

.customer-balance-table-container::-webkit-scrollbar-thumb:hover {
    background: var(--text-main);
}

/* Firefox scrollbar support */
.customer-balance-table-container {
    scrollbar-width: thin;
    scrollbar-color: var(--text-muted) var(--table-header-bg);
}

/* Customer Balance Report Value Colors */
.customer-balance-table-container .customer-balance-company-owes {
    color: var(--status-warning) !important;
    font-weight: 600 !important;
}

.customer-balance-table-container .customer-balance-customer-owes {
    color: var(--status-error) !important;
    font-weight: 600 !important;
}

/* Customer Balance Report Dark Mode Fixes */
@media (prefers-color-scheme: dark) {
    #customerBalanceReportModal button[onclick="printCustomerBalanceReport()"] {
        background: #1a1a1a !important;
        color: #fff !important;
    }
    
    #customerBalanceReportModal select {
        background: var(--input-bg) !important;
        color: var(--text-main) !important;
        border-color: var(--border-color) !important;
    }
    
    #customerBalanceReportModal #customer-balance-pagination button {
        background: var(--table-header-bg) !important;
        color: var(--text-main) !important;
        border-color: var(--border-color) !important;
    }
}

/* Customer Balance Report Print Styles */
@media print {
    @page {
        size: landscape;
        margin: 0.5cm;
    }
    
    body * {
        visibility: hidden;
    }
    
    #customerBalanceReportModal,
    #customerBalanceReportModal * {
        visibility: visible;
    }
    
    #customerBalanceReportModal {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: white;
        z-index: 9999;
        padding: 20px;
        overflow: visible;
    }
    
    #customerBalanceReportModalContent {
        max-width: none;
        max-height: none;
        border: none;
        border-radius: 0;
        height: auto;
        overflow: visible;
    }
    
    .no-print,
    #customer-balance-pagination,
    .report-filter-bar,
    .report-header button,
    .filter-group button,
    #customer-balance-loading,
    #customer-balance-rows-per-page {
        display: none !important;
    }
    
    #customer-balance-content {
        padding: 0;
        overflow: visible;
        display: block !important;
    }
    
    table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
    }
    
    table th,
    table td {
        border: 1px solid #000;
        padding: 6px 4px;
        color: #000;
    }
    
    table th {
        background-color: #f0f0f0;
        color: #000;
        font-weight: 600;
    }
    
    table tbody tr {
        page-break-inside: avoid;
    }
    
    .report-header {
        border-bottom: 2px solid #000;
        padding-bottom: 16px;
        margin-bottom: 20px;
    }
    
    .report-header h2 {
        font-size: 18px;
        color: #000;
        margin: 0;
    }
    
    .report-header p {
        color: #000;
        margin: 4px 0 0 0;
        font-size: 12px;
    }
}
</style>

<script>
// Tonnage Statistics Chart
let tonnageChart = null;
let cementTypesData = [];
let agenciesData = [];

// Initialize tonnage chart on page load
document.addEventListener('DOMContentLoaded', function() {
    loadCementTypes();
    loadAgencies();
    loadTonnageFilters().then(() => {
        initTonnageChart();
    });
});

// Load cement types for filter
function loadCementTypes() {
    fetch('/api/config/cement-types')
        .then(res => res.json())
        .then(data => {
            cementTypesData = data;
            const select = document.getElementById('tonnage-cement-types');
            select.innerHTML = '';
            data.forEach(ct => {
                const option = document.createElement('option');
                option.value = ct.cement_name;
                option.textContent = ct.cement_name;
                select.appendChild(option);
            });
        })
        .catch(err => console.error('Error loading cement types:', err));
}

// Load agencies for filter
function loadAgencies() {
    fetch('/api/admin/agencies-list')
        .then(res => res.json())
        .then(data => {
            // F-A3: the endpoint returns { agencies: [...] }; the old code did
            // data.forEach(...) on the object and threw "forEach is not a
            // function", leaving the agency filter empty. Normalize the shape
            // (and tolerate an error payload) before iterating.
            const list = Array.isArray(data) ? data : (data && Array.isArray(data.agencies) ? data.agencies : []);
            agenciesData = list;
            const select = document.getElementById('tonnage-agency');
            select.innerHTML = '<option value="all"><%= t('admin.filter_all_agencies') %></option>';
            list.forEach(agency => {
                const option = document.createElement('option');
                option.value = agency.agency_name;
                option.textContent = agency.agency_name;
                select.appendChild(option);
            });
        })
        .catch(err => console.error('Error loading agencies:', err));
}

// Load tonnage filters (months and years)
function loadTonnageFilters() {
    // Load available years from database
    return fetch('/api/admin/tonnage-years')
        .then(res => res.json())
        .then(data => {
            const yearSelect = document.getElementById('tonnage-year');
            yearSelect.innerHTML = '';
            // Sort years numerically
            const sortedYears = data.years.sort((a, b) => parseInt(a) - parseInt(b));
            sortedYears.forEach(year => {
                const option = document.createElement('option');
                option.value = year;
                option.textContent = year;
                yearSelect.appendChild(option);
            });
            // Set to latest year
            if (sortedYears.length > 0) {
                yearSelect.value = sortedYears[sortedYears.length - 1];
            }
        })
        .catch(err => console.error('Error loading years:', err))
        .then(() => {
            // Populate months with Jalali month names
            const monthSelect = document.getElementById('tonnage-month');
            const jalaliMonths = [
                { value: '01', name: '01 — حمل' },
                { value: '02', name: '02 — ثور' },
                { value: '03', name: '03 — جوزا' },
                { value: '04', name: '04 — سرطان' },
                { value: '05', name: '05 — اسد' },
                { value: '06', name: '06 — سنبله' },
                { value: '07', name: '07 — میزان' },
                { value: '08', name: '08 — عقرب' },
                { value: '09', name: '09 — قوس' },
                { value: '10', name: '10 — جدی' },
                { value: '11', name: '11 — دلو' },
                { value: '12', name: '12 — حوت' }
            ];
            monthSelect.innerHTML = '';
            jalaliMonths.forEach(month => {
                const option = document.createElement('option');
                option.value = month.value;
                option.textContent = month.name;
                monthSelect.appendChild(option);
            });
            // Set to current month (06 as example)
            monthSelect.value = '06';
        })
        .then(() => {
            // Attach event listeners after elements are populated
            attachTonnageEventListeners();
        });
}

// Attach event listeners to tonnage filter elements
function attachTonnageEventListeners() {
    const periodSelect = document.getElementById('tonnage-period');
    const yearSelect = document.getElementById('tonnage-year');
    const monthSelect = document.getElementById('tonnage-month');
    const cementTypeSelect = document.getElementById('tonnage-cement-types');
    const agencySelect = document.getElementById('tonnage-agency');
    const startDateInput = document.getElementById('tonnage-start-date');
    const endDateInput = document.getElementById('tonnage-end-date');

    // Store current values before cloning
    const periodValue = periodSelect.value;
    const yearValue = yearSelect.value;
    const monthValue = monthSelect.value;
    const cementTypeValue = cementTypeSelect.value;
    const agencyValue = agencySelect.value;
    const startDateValue = startDateInput.value;
    const endDateValue = endDateInput.value;

    // Remove existing listeners to prevent duplicates
    const newPeriodSelect = periodSelect.cloneNode(true);
    periodSelect.parentNode.replaceChild(newPeriodSelect, periodSelect);
    newPeriodSelect.value = periodValue;
    newPeriodSelect.addEventListener('change', handlePeriodChange);

    const newYearSelect = yearSelect.cloneNode(true);
    yearSelect.parentNode.replaceChild(newYearSelect, yearSelect);
    newYearSelect.value = yearValue;
    newYearSelect.addEventListener('change', updateTonnageChart);

    const newMonthSelect = monthSelect.cloneNode(true);
    monthSelect.parentNode.replaceChild(newMonthSelect, monthSelect);
    newMonthSelect.value = monthValue;
    newMonthSelect.addEventListener('change', updateTonnageChart);

    const newCementTypeSelect = cementTypeSelect.cloneNode(true);
    cementTypeSelect.parentNode.replaceChild(newCementTypeSelect, cementTypeSelect);
    newCementTypeSelect.value = cementTypeValue;
    newCementTypeSelect.addEventListener('change', updateTonnageChart);

    const newAgencySelect = agencySelect.cloneNode(true);
    agencySelect.parentNode.replaceChild(newAgencySelect, agencySelect);
    newAgencySelect.value = agencyValue;
    newAgencySelect.addEventListener('change', updateTonnageChart);

    const newStartDateInput = startDateInput.cloneNode(true);
    startDateInput.parentNode.replaceChild(newStartDateInput, startDateInput);
    newStartDateInput.value = startDateValue;
    newStartDateInput.addEventListener('change', updateTonnageChart);
    newStartDateInput.addEventListener('input', updateTonnageChart);

    const newEndDateInput = endDateInput.cloneNode(true);
    endDateInput.parentNode.replaceChild(newEndDateInput, endDateInput);
    newEndDateInput.value = endDateValue;
    newEndDateInput.addEventListener('change', updateTonnageChart);
    newEndDateInput.addEventListener('input', updateTonnageChart);
}

// Handle period change to show/hide appropriate filters
function handlePeriodChange() {
    const period = document.getElementById('tonnage-period').value;
    const monthGroup = document.getElementById('tonnage-month-group');
    const yearGroup = document.getElementById('tonnage-year-group');
    const dateRangeGroup = document.getElementById('tonnage-date-range-group');
    const yearSelect = document.getElementById('tonnage-year');

    if (period === 'daily') {
        monthGroup.style.display = 'none';
        yearGroup.style.display = 'none';
        dateRangeGroup.style.display = 'block';
    } else if (period === 'monthly') {
        monthGroup.style.display = 'block';
        yearGroup.style.display = 'block';
        dateRangeGroup.style.display = 'none';
    } else if (period === 'yearly') {
        monthGroup.style.display = 'none';
        yearGroup.style.display = 'block';
        dateRangeGroup.style.display = 'none';
        // Ensure year dropdown has a selected value
        if (!yearSelect.value && yearSelect.options.length > 0) {
            yearSelect.value = yearSelect.options[yearSelect.options.length - 1].value;
        }
    }

    // Update chart immediately with current period value
    updateTonnageChart();
}

// Initialize chart
function initTonnageChart() {
    const ctx = document.getElementById('tonnage-chart').getContext('2d');
    
    tonnageChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: [],
            datasets: []
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: {
                mode: 'index',
                intersect: false
            },
            plugins: {
                legend: {
                    position: 'top',
                    labels: {
                        color: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim(),
                        font: {
                            size: 12
                        },
                        usePointStyle: true
                    }
                },
                tooltip: {
                    backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--bg-surface-elevated').trim(),
                    titleColor: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim(),
                    bodyColor: getComputedStyle(document.documentElement).getPropertyValue('--text-primary').trim(),
                    borderColor: getComputedStyle(document.documentElement).getPropertyValue('--border').trim(),
                    borderWidth: 1,
                    padding: 12,
                    callbacks: {
                        label: function(context) {
                            return context.dataset.label + ': ' + context.parsed.y.toFixed(1) + ' <%= t('admin.tons') %>';
                        }
                    }
                }
            },
            scales: {
                x: {
                    type: 'category',
                    grid: {
                        color: getComputedStyle(document.documentElement).getPropertyValue('--border').trim(),
                        drawBorder: false
                    },
                    ticks: {
                        color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim(),
                        font: {
                            size: 11
                        }
                    }
                },
                y: {
                    beginAtZero: true,
                    grid: {
                        color: getComputedStyle(document.documentElement).getPropertyValue('--border').trim(),
                        drawBorder: false
                    },
                    ticks: {
                        color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim(),
                        font: {
                            size: 11
                        },
                        callback: function(value) {
                            return value.toFixed(0);
                        }
                    },
                    title: {
                        display: true,
                        text: '<%= t('admin.tons') %>',
                        color: getComputedStyle(document.documentElement).getPropertyValue('--text-secondary').trim(),
                        font: {
                            size: 11
                        }
                    }
                }
            }
        }
    });

    // Load initial data
    loadAnalyticsFilters();
    updateTonnageChart();
}

// Update chart with filtered data
function updateTonnageChart() {
    const period = document.getElementById('tonnage-period').value;
    const startDate = document.getElementById('tonnage-start-date').value;
    const endDate = document.getElementById('tonnage-end-date').value;
    const cementType = document.getElementById('tonnage-cement-types').value;
    const cementTypesParam = cementType || 'all';
    const agency = document.getElementById('tonnage-agency').value;
    const month = document.getElementById('tonnage-month').value;
    const year = document.getElementById('tonnage-year').value;
    
    // Clear previous error
    const errorDiv = document.getElementById('date-range-error');
    errorDiv.style.display = 'none';
    errorDiv.textContent = '';
    
    // Validate date range (datepicker ensures format, just check logical order)
    if (startDate && endDate && startDate > endDate) {
        errorDiv.textContent = 'Start date cannot be after end date';
        errorDiv.style.display = 'block';
        return;
    }

    const params = new URLSearchParams({
        period: period,
        cementTypes: cementTypesParam,
        agency: agency
    });

    if (startDate) params.append('startDate', startDate);
    if (endDate) params.append('endDate', endDate);
    if (period === 'monthly' && month && year) {
        params.append('month', month);
        params.append('year', year);
    }
    if (period === 'yearly' && year) {
        params.append('year', year);
    }

    fetch(`/api/admin/tonnage-statistics?${params}`)
        .then(res => res.json())
        .then(data => {
            // Update totals
            document.getElementById('tonnage-total').textContent = data.totals.totalTonnage.toLocaleString();
            document.getElementById('tonnage-average').textContent = data.totals.averageDaily.toLocaleString();

            // Check for empty data
            const chartContainer = document.getElementById('tonnage-chart').parentElement;
            const emptyState = document.getElementById('tonnage-empty-state');

            if (data.labels.length === 0 || data.datasets.every(ds => ds.data.every(v => v === 0))) {
                chartContainer.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            chartContainer.style.display = 'block';
            emptyState.style.display = 'none';

            // Transform labels based on period
            let displayLabels = [...data.labels];
            if (period === 'daily') {
                displayLabels = data.labels.map(label => {
                    if (!label || typeof label !== 'string') {
                        return '';
                    }
                    const parts = label.split('/');
                    return parts.length === 3 ? `${esc(parts[1])}/${esc(parts[2])}` : label;
                });
            } else if (period === 'monthly') {
                displayLabels = data.labels.map(label => {
                    if (!label || typeof label !== 'string') {
                        return '';
                    }
                    const parts = label.split('/');
                    return parts.length === 3 ? `${esc(parts[1])}/${esc(parts[2])}` : label;
                });
            }
            // For yearly, labels are already Jalali month names from backend

            // Update date range display in header
            updateDateRangeDisplay(period, startDate, endDate, month, year, data.labels);

            // Update chart data
            tonnageChart.data.labels = displayLabels;
            tonnageChart.data.datasets = data.datasets;
            
            console.log('[TONNAGE AXIS FORENSIC]', {
                chartType: tonnageChart.config.type,
                xScaleType: tonnageChart.options.scales?.x?.type,
                labels: tonnageChart.data.labels,
                firstLabel: tonnageChart.data.labels[0],
                lastLabel: tonnageChart.data.labels[tonnageChart.data.labels.length - 1],
                datasetLength: tonnageChart.data.datasets[0]?.data?.length
            });
            
            tonnageChart.update();

            // Update chart colors for theme
            updateChartTheme();
        })
        .catch(err => {
            console.error('Error loading tonnage statistics:', err);
            document.getElementById('tonnage-chart').parentElement.style.display = 'none';
            document.getElementById('tonnage-empty-state').style.display = 'block';
        });

    // Also update analytics charts (donut and province)
    updateAnalytics();
}

// Update date range display in header
function updateDateRangeDisplay(period, startDate, endDate, month, year, labels) {
    const dateRangeEl = document.getElementById('tonnage-date-range');
    if (!dateRangeEl) return;

    if (period === 'daily' && labels.length > 0) {
        // Show full date range for Daily mode
        const firstLabel = labels[0];
        const lastLabel = labels[labels.length - 1];
        
        if (!firstLabel || !lastLabel || typeof firstLabel !== 'string' || typeof lastLabel !== 'string') {
            dateRangeEl.textContent = '';
            return;
        }
        
        dateRangeEl.textContent = `Daily • ${firstLabel} → ${lastLabel}`;
    } else if (period === 'monthly' && month && year && labels.length > 0) {
        // Show month/year for Monthly mode
        const firstLabel = labels[0];
        const lastLabel = labels[labels.length - 1];
        
        if (!firstLabel || !lastLabel || typeof firstLabel !== 'string' || typeof lastLabel !== 'string') {
            dateRangeEl.textContent = `Monthly • ${year}/${month}`;
            return;
        }
        
        dateRangeEl.textContent = `Monthly • ${year}/${month} • ${firstLabel} → ${lastLabel}`;
    } else if (period === 'yearly' && year && labels.length > 0) {
        // Show year for Yearly mode
        dateRangeEl.textContent = `Yearly • ${year}`;
    } else {
        dateRangeEl.textContent = '';
    }
}

// Update chart colors based on theme
function updateChartTheme() {
    if (!tonnageChart) return;

    const textColor = getComputedStyle(document.documentElement).getPropertyValue('--text-main').trim();
    const mutedColor = getComputedStyle(document.documentElement).getPropertyValue('--text-muted').trim();
    const borderColor = getComputedStyle(document.documentElement).getPropertyValue('--border-color').trim();
    const tooltipBg = getComputedStyle(document.documentElement).getPropertyValue('--tooltip-bg').trim();
    const tooltipText = getComputedStyle(document.documentElement).getPropertyValue('--tooltip-text').trim();

    tonnageChart.options.plugins.legend.labels.color = textColor;
    tonnageChart.options.plugins.tooltip.backgroundColor = tooltipBg;
    tonnageChart.options.plugins.tooltip.titleColor = tooltipText;
    tonnageChart.options.plugins.tooltip.bodyColor = tooltipText;
    tonnageChart.options.plugins.tooltip.borderColor = borderColor;
    tonnageChart.options.scales.x.grid.color = borderColor;
    tonnageChart.options.scales.x.ticks.color = mutedColor;
    tonnageChart.options.scales.y.grid.color = borderColor;
    tonnageChart.options.scales.y.ticks.color = mutedColor;
    tonnageChart.options.scales.y.title.color = mutedColor;

    tonnageChart.update();
}

// Listen for theme changes
const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
        if (mutation.attributeName === 'data-theme') {
            updateChartTheme();
        }
    });
});

observer.observe(document.documentElement, { attributes: true });

// Cement Analytics (Donut + Province Bar Charts)
let distributionChart = null;

// Initialize analytics charts
function initAnalytics() {
    // Initialize donut chart
    const ctx = document.getElementById('distribution-chart').getContext('2d');
    
    distributionChart = new Chart(ctx, {
        type: 'doughnut',
        data: {
            labels: [],
            datasets: [{
                data: [],
                backgroundColor: [],
                borderColor: [],
                borderWidth: 2,
                hoverOffset: 8
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            cutout: '65%',
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    backgroundColor: getComputedStyle(document.documentElement).getPropertyValue('--tooltip-bg').trim(),
                    titleColor: getComputedStyle(document.documentElement).getPropertyValue('--tooltip-text').trim(),
                    bodyColor: getComputedStyle(document.documentElement).getPropertyValue('--tooltip-text').trim(),
                    borderColor: getComputedStyle(document.documentElement).getPropertyValue('--border-color').trim(),
                    borderWidth: 1,
                    padding: 12,
                    displayColors: true,
                    callbacks: {
                        label: function(context) {
                            const label = context.label || '';
                            const value = context.parsed || 0;
                            const total = context.dataset.data.reduce((a, b) => a + b, 0);
                            const percentage = total > 0 ? ((value / total) * 100).toFixed(1) : 0;
                            return `${esc(label)}: ${esc(value.toLocaleString())} Tons (${esc(percentage)}%)`;
                        }
                    }
                }
            }
        }
    });

    // Load initial data (filters are shared with tonnage statistics)
    updateAnalytics();
}

// Load analytics filters (now uses tonnage filters)
function loadAnalyticsFilters() {
    // Load cement types into tonnage filter dropdown
    fetch('/api/config/cement-types')
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById('tonnage-cement-types');
            select.innerHTML = '<option value="all"><%= t('admin.filter_all_cement') %></option>';
            data.forEach(ct => {
                const option = document.createElement('option');
                option.value = ct.cement_name;
                option.textContent = ct.cement_name;
                select.appendChild(option);
            });
        });

    // Load agencies into tonnage filter dropdown
    fetch('/api/admin/agencies-list')
        .then(res => res.json())
        .then(data => {
            const select = document.getElementById('tonnage-agency');
            select.innerHTML = '<option value="all"><%= t('admin.filter_all_agencies') %></option>';
            const agencies = data.agencies || data; // Handle both object with agencies property and direct array
            if (Array.isArray(agencies)) {
                agencies.forEach(agency => {
                    const option = document.createElement('option');
                    option.value = agency.agency_name;
                    option.textContent = agency.agency_name;
                    select.appendChild(option);
                });
            }
        });
}

// Reset statistics filters to default state
function resetStatisticsFilters() {
    document.getElementById('tonnage-period').value = 'daily';
    document.getElementById('tonnage-start-date').value = '';
    document.getElementById('tonnage-end-date').value = '';
    document.getElementById('tonnage-cement-types').value = 'all';
    document.getElementById('tonnage-agency').value = 'all';
    
    // Refresh all charts
    updateTonnageChart();
}

// Update analytics (both donut and province charts)
function updateAnalytics() {
    const startDate = document.getElementById('tonnage-start-date').value;
    const endDate = document.getElementById('tonnage-end-date').value;
    const period = document.getElementById('tonnage-period').value;
    const cementType = document.getElementById('tonnage-cement-types').value;
    const cementTypesParam = cementType || 'all';
    const agency = document.getElementById('tonnage-agency').value;

    const params = new URLSearchParams({
        cementTypes: cementTypesParam,
        agency: agency
    });

    if (startDate && endDate) {
        params.append('startDate', startDate);
        params.append('endDate', endDate);
    } else if (period === 'monthly') {
        // Extract month from start date if in monthly mode
        if (startDate && startDate.length >= 7) {
            params.append('month', startDate.substring(0, 7));
        }
    } else if (period === 'yearly') {
        // Extract year from start date if in yearly mode
        if (startDate && startDate.length >= 4) {
            params.append('year', startDate.substring(0, 4));
        }
    }

    // Update donut chart
    updateDonutChart(params);
    // Update province chart
    updateProvinceChart(params);
}

// Update donut chart
function updateDonutChart(params) {
    console.log('[CEMENT ANALYTICS DEBUG] Frontend request params:', params.toString());
    
    fetch(`/api/admin/cement-sales-distribution?${params}`)
        .then(res => res.json())
        .then(data => {
            console.log('[CEMENT ANALYTICS DEBUG] Frontend received data:', data);
            console.log('[CEMENT ANALYTICS DEBUG] Distribution array length:', data.distribution ? data.distribution.length : 'undefined');
            
            // Update center total
            document.getElementById('distribution-total').textContent = data.totalTonnage.toLocaleString();

            // Check for empty data
            const chartContainer = document.getElementById('distribution-chart').parentElement;
            const legendContainer = document.getElementById('distribution-legend');
            const emptyState = document.getElementById('distribution-empty-state');
            const centerText = document.getElementById('distribution-center-text');

            if (data.distribution.length === 0) {
                console.log('[CEMENT ANALYTICS DEBUG] Distribution is empty, showing no-data state');
                chartContainer.style.display = 'none';
                legendContainer.style.display = 'none';
                centerText.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            chartContainer.style.display = 'block';
            legendContainer.style.display = 'block';
            centerText.style.display = 'block';
            emptyState.style.display = 'none';

            // Update chart data
            distributionChart.data.labels = data.distribution.map(d => d.cement_type);
            distributionChart.data.datasets[0].data = data.distribution.map(d => d.tonnage);
            distributionChart.data.datasets[0].backgroundColor = data.distribution.map(d => d.color);
            distributionChart.data.datasets[0].borderColor = getComputedStyle(document.documentElement).getPropertyValue('--card-bg').trim();
            distributionChart.update();

            // Update legend
            updateDistributionLegend(data.distribution);
        })
        .catch(err => {
            console.error('[CEMENT ANALYTICS DEBUG] Error loading cement sales distribution:', err);
            document.getElementById('distribution-chart').parentElement.style.display = 'none';
            document.getElementById('distribution-legend').style.display = 'none';
            document.getElementById('distribution-center-text').style.display = 'none';
            document.getElementById('distribution-empty-state').style.display = 'block';
        });
}

// Update province chart
function updateProvinceChart(params) {
    fetch(`/api/admin/province-sales?${params}`)
        .then(res => res.json())
        .then(data => {
            const barsContainer = document.getElementById('province-bars');
            const emptyState = document.getElementById('province-empty-state');
            const chartContainer = document.getElementById('province-chart-container');

            if (data.provinces.length === 0) {
                barsContainer.style.display = 'none';
                chartContainer.style.display = 'none';
                emptyState.style.display = 'block';
                return;
            }

            barsContainer.style.display = 'flex';
            chartContainer.style.display = 'block';
            emptyState.style.display = 'none';

            // Render province bars
            barsContainer.innerHTML = '';
            data.provinces.forEach((item, index) => {
                const barRow = document.createElement('div');
                barRow.style.display = 'flex';
                barRow.style.alignItems = 'center';
                barRow.style.gap = '12px';
                barRow.style.fontSize = '13px';

                const rank = document.createElement('div');
                rank.style.width = '24px';
                rank.style.textAlign = 'center';
                rank.style.color = 'var(--text-muted)';
                rank.style.fontWeight = '500';
                rank.textContent = index + 1;

                const provinceName = document.createElement('div');
                provinceName.style.width = '120px';
                provinceName.style.color = 'var(--text-main)';
                provinceName.style.flexShrink = '0';
                provinceName.textContent = item.province;

                const barContainer = document.createElement('div');
                barContainer.style.flex = '1';
                barContainer.style.height = '24px';
                barContainer.style.backgroundColor = 'var(--border-color)';
                barContainer.style.borderRadius = '3px';
                barContainer.style.overflow = 'hidden';
                barContainer.style.position = 'relative';

                const barFill = document.createElement('div');
                barFill.style.height = '100%';
                barFill.style.width = `${item.percentage}%`;
                barFill.style.backgroundColor = '#3b82f6';
                barFill.style.transition = 'width 0.3s ease';

                barContainer.appendChild(barFill);

                const tonnage = document.createElement('div');
                tonnage.style.width = '80px';
                tonnage.style.textAlign = 'right';
                tonnage.style.color = 'var(--text-main)';
                tonnage.style.fontWeight = '500';
                tonnage.textContent = item.tonnage.toLocaleString();

                const percentage = document.createElement('div');
                percentage.style.width = '50px';
                percentage.style.textAlign = 'right';
                percentage.style.color = 'var(--text-muted)';
                percentage.textContent = `${item.percentage}%`;

                barRow.appendChild(rank);
                barRow.appendChild(provinceName);
                barRow.appendChild(barContainer);
                barRow.appendChild(tonnage);
                barRow.appendChild(percentage);
                barsContainer.appendChild(barRow);
            });
        })
        .catch(err => {
            console.error('Error loading province sales:', err);
            document.getElementById('province-bars').style.display = 'none';
            document.getElementById('province-chart-container').style.display = 'none';
            document.getElementById('province-empty-state').style.display = 'block';
        });
}

// Update distribution legend
function updateDistributionLegend(distribution) {
    const legendContainer = document.getElementById('distribution-legend');
    legendContainer.innerHTML = '';

    distribution.forEach(item => {
        const legendItem = document.createElement('div');
        legendItem.style.display = 'flex';
        legendItem.style.alignItems = 'center';
        legendItem.style.marginBottom = '8px';
        legendItem.style.fontSize = '13px';

        const colorBox = document.createElement('div');
        colorBox.style.width = '12px';
        colorBox.style.height = '12px';
        colorBox.style.borderRadius = '3px';
        colorBox.style.backgroundColor = item.color;
        colorBox.style.marginRight = '8px';
        colorBox.style.flexShrink = '0';

        const label = document.createElement('span');
        label.style.color = 'var(--text-main)';
        label.style.flex = '1';
        label.textContent = item.cement_type;

        const percentage = document.createElement('span');
        percentage.style.color = 'var(--text-muted)';
        percentage.style.fontWeight = '500';
        percentage.textContent = `${item.percentage}%`;

        legendItem.appendChild(colorBox);
        legendItem.appendChild(label);
        legendItem.appendChild(percentage);
        legendContainer.appendChild(legendItem);
    });
}

// Initialize analytics on DOM ready
document.addEventListener('DOMContentLoaded', function() {
    initAnalytics();
});
</script>

