// Store customer balance data globally for client-side filtering and pagination
let allCustomerBalanceData = [];
let filteredCustomerBalanceData = [];
let customerBalanceCurrentPage = 1;
let customerBalanceRowsPerPage = 25;
let customerBalanceCurrentFilter = 'all';
let customerBalanceSearchTerm = '';

// Load Customer Balances
function loadCustomerBalances() {
    const loadingDiv = document.getElementById('customer-balance-loading');
    const contentDiv = document.getElementById('customer-balance-content');
    const tbody = document.getElementById('customer-balances-rows');
    
    loadingDiv.style.display = 'block';
    contentDiv.style.display = 'none';
    
    fetch('/api/admin/customer-balances', {
        credentials: 'include'
    })
    .then(res => res.json())
    .then(data => {
        if (data.error) {
            tbody.innerHTML = `<tr><td colspan="13" style="padding: 25px; color: var(--danger-red);">Error: ${esc(data.error)}</td></tr>`;
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'block';
            return;
        }
        
        if (data.length === 0) {
            tbody.innerHTML = '<tr><td colspan="13" style="padding: 25px; color: var(--text-muted);">No customer data found</td></tr>';
            loadingDiv.style.display = 'none';
            contentDiv.style.display = 'block';
            return;
        }
        
        // Store all data globally
        allCustomerBalanceData = data;
        
        // Apply current filter
        applyCustomerBalanceFilter();
        
        loadingDiv.style.display = 'none';
        contentDiv.style.display = 'block';
    })
    .catch(err => {
        console.error('[ERROR] Error loading customer balances:', err);
        tbody.innerHTML = '<tr><td colspan="13" style="padding: 25px; color: var(--danger-red);">Error loading customer balance data</td></tr>';
        loadingDiv.style.display = 'none';
        contentDiv.style.display = 'block';
    });
}

// Apply customer balance filter
function applyCustomerBalanceFilter() {
    const filterValue = document.getElementById('customer-balance-filter').value;
    customerBalanceCurrentFilter = filterValue;
    
    // Reset to page 1 when filter changes
    customerBalanceCurrentPage = 1;
    
    // Apply both filter and search
    applyCustomerBalanceFilterAndSearch();
}

// Apply customer balance search
function applyCustomerBalanceSearch() {
    const searchValue = document.getElementById('customer-balance-search').value;
    customerBalanceSearchTerm = searchValue.toLowerCase();
    
    // Reset to page 1 when search changes
    customerBalanceCurrentPage = 1;
    
    // Apply both filter and search
    applyCustomerBalanceFilterAndSearch();
}

// Clear customer balance search
function clearCustomerBalanceSearch() {
    document.getElementById('customer-balance-search').value = '';
    customerBalanceSearchTerm = '';
    customerBalanceCurrentPage = 1;
    
    // Apply both filter and search
    applyCustomerBalanceFilterAndSearch();
}

// Apply both filter and search together
function applyCustomerBalanceFilterAndSearch() {
    const filterValue = customerBalanceCurrentFilter;
    const searchValue = customerBalanceSearchTerm;
    
    // First apply balance filter
    let result = allCustomerBalanceData;
    
    if (filterValue === 'company_owes') {
        result = result.filter(c => c['Company Owes Customer'] > 0);
    } else if (filterValue === 'customer_owes') {
        result = result.filter(c => c['Customer Owes Company'] > 0);
    }
    
    // Then apply search filter
    if (searchValue && searchValue.trim() !== '') {
        result = result.filter(c => {
            const name = (c['Name'] || '').toLowerCase();
            const id = (c['ID'] || '').toLowerCase();
            const agency = (c['Agency'] || '').toLowerCase();
            const phone = (c['Phone Number'] || '').toLowerCase();
            
            return name.includes(searchValue) || 
                   id.includes(searchValue) || 
                   agency.includes(searchValue) || 
                   phone.includes(searchValue);
        });
    }
    
    filteredCustomerBalanceData = result;
    renderCustomerBalanceTable();
}

// Change rows per page
function changeCustomerBalanceRowsPerPage() {
    customerBalanceRowsPerPage = parseInt(document.getElementById('customer-balance-rows-per-page').value);
    customerBalanceCurrentPage = 1;
    renderCustomerBalanceTable();
}

// Render customer balance table with pagination
function renderCustomerBalanceTable() {
    const tbody = document.getElementById('customer-balances-rows');
    const paginationDiv = document.getElementById('customer-balance-pagination');
    
    if (filteredCustomerBalanceData.length === 0) {
        tbody.innerHTML = `<tr><td colspan="13" style="padding: 25px; color: var(--text-muted);"><%= t('admin.customer_balance_no_customers_found') %></td></tr>`;
        paginationDiv.style.display = 'none';
        return;
    }
    
    // Calculate pagination
    const startIndex = (customerBalanceCurrentPage - 1) * customerBalanceRowsPerPage;
    const endIndex = Math.min(startIndex + customerBalanceRowsPerPage, filteredCustomerBalanceData.length);
    const pageData = filteredCustomerBalanceData.slice(startIndex, endIndex);
    const totalPages = Math.ceil(filteredCustomerBalanceData.length / customerBalanceRowsPerPage);
    
    // Render table rows
    tbody.innerHTML = pageData.map((customer, index) => `
        <tr style="border-bottom: 1px solid var(--border-color);">
            <td style="padding: 12px 10px;">${esc(startIndex + index + 1)}</td>
            <td style="padding: 12px 10px;">${esc(customer['ID'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Name'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Agency'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Province'])}</td>
            <td style="padding: 12px 10px; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${esc(customer['Full Address'])}">${esc(customer['Full Address'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Customer Type'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Email'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Phone Number'])}</td>
            <td style="padding: 12px 10px;">${esc(customer['Total Cement Purchases'].toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
            <td style="padding: 12px 10px;">${esc(customer['Total Payments / Receipts'].toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
            <td class="customer-balance-company-owes" style="padding: 12px 10px;">${esc(customer['Company Owes Customer'].toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
            <td class="customer-balance-customer-owes" style="padding: 12px 10px;">${esc(customer['Customer Owes Company'].toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}))}</td>
        </tr>
    `).join('');
    
    // Update pagination UI
    document.getElementById('customer-balance-page-start').textContent = startIndex + 1;
    document.getElementById('customer-balance-page-end').textContent = endIndex;
    document.getElementById('customer-balance-total-count').textContent = filteredCustomerBalanceData.length;
    
    // Update button states
    document.getElementById('customer-balance-prev-btn').disabled = customerBalanceCurrentPage === 1;
    document.getElementById('customer-balance-next-btn').disabled = customerBalanceCurrentPage === totalPages;
    
    // Generate page numbers
    const pageNumbersDiv = document.getElementById('customer-balance-page-numbers');
    pageNumbersDiv.innerHTML = '';
    
    for (let i = 1; i <= totalPages; i++) {
        const pageBtn = document.createElement('button');
        pageBtn.textContent = i;
        pageBtn.onclick = () => customerBalanceGoToPage(i);
        pageBtn.style.padding = '6px 12px';
        pageBtn.style.border = '1px solid var(--border-color)';
        pageBtn.style.borderRadius = '6px';
        pageBtn.style.cursor = 'pointer';
        pageBtn.style.fontSize = '13px';
        pageBtn.style.background = i === customerBalanceCurrentPage ? 'var(--accent-blue)' : 'var(--table-header-bg)';
        pageBtn.style.color = i === customerBalanceCurrentPage ? '#fff' : 'var(--text-main)';
        pageNumbersDiv.appendChild(pageBtn);
    }
    
    paginationDiv.style.display = 'flex';
}

// Go to specific page
function customerBalanceGoToPage(pageNum) {
    customerBalanceCurrentPage = pageNum;
    renderCustomerBalanceTable();
}

// Go to previous page
function customerBalanceGoToPrevPage() {
    if (customerBalanceCurrentPage > 1) {
        customerBalanceCurrentPage--;
        renderCustomerBalanceTable();
    }
}

// Go to next page
function customerBalanceGoToNextPage() {
    const totalPages = Math.ceil(filteredCustomerBalanceData.length / customerBalanceRowsPerPage);
    if (customerBalanceCurrentPage < totalPages) {
        customerBalanceCurrentPage++;
        renderCustomerBalanceTable();
    }
}

