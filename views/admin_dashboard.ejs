document.getElementById('nav-admin-dash').classList.add('active');

// Initialize Jalali datepicker for all inputs with data-jdp attribute
if (typeof jalaliDatepicker !== 'undefined') {
    jalaliDatepicker.startWatch({
        months: [
            "حمل",   // Hamal
            "ثور",   // Sawr
