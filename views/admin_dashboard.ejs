// Refresh financial metrics periodically
function refreshFinancialMetrics() {
    console.log('[DEBUG] Refreshing financial metrics...');
    fetch('/api/admin/financial-metrics', {
        headers: {
            'Cache-Control': 'no-cache, no-store',
            'Pragma': 'no-cache'
        }
    })
        .then(res => {
            if (res.status === 401 || res.status === 403) {
                // Session expired / access denied: stop the push stream/poll so a stale
                // tab stops emitting errors every cycle (Phase 2 403/401 fix).
                if (typeof stopMetricsStream === 'function') stopMetricsStream();
                if (res.status === 401) {
                    window.location.href = '/login';
                    return;
                }
                throw new Error(`HTTP error! status: ${res.status}`);
            }
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(applyFinancialMetrics)
        .catch(err => {
            console.error('[ERROR] Error refreshing financial metrics:', err);
        });
}

// Phase 6 — shared metrics renderer (SSE push, fallback fetch, tab-visibility refresh)
function applyFinancialMetrics(data) {
            const metricReceivablesEl = document.getElementById('metric-receivables');
            const metricPayablesEl = document.getElementById('metric-payables');
            const metricSalesEl = document.getElementById('metric-sales');
            const metricReceivedEl = document.getElementById('metric-received');
            
            const currencyLabelReceivables = metricReceivablesEl ? metricReceivablesEl.getAttribute('data-currency-label') : 'AFN';
            const currencyLabelPayables = metricPayablesEl ? metricPayablesEl.getAttribute('data-currency-label') : 'AFN';
            const currencyLabelSales = metricSalesEl ? metricSalesEl.getAttribute('data-currency-label') : 'AFN';
            const currencyLabelReceived = metricReceivedEl ? metricReceivedEl.getAttribute('data-currency-label') : 'AFN';
            
            // F-A4b: apply per field — a partial payload (or a SUM that came
            // back null on an empty table) must skip its tile instead of
            // throwing mid-apply and aborting the remaining tiles.
            if (metricReceivablesEl && Number.isFinite(data.total_receivables)) {
                metricReceivablesEl.innerHTML = `${esc(data.total_receivables.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}))} <span>${esc(currencyLabelReceivables)}</span>`;
            }
            if (metricPayablesEl && Number.isFinite(data.total_payables)) {
                metricPayablesEl.innerHTML = `${esc(data.total_payables.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}))} <span>${esc(currencyLabelPayables)}</span>`;
            }
            if (metricSalesEl && Number.isFinite(data.total_sales_money)) {
                metricSalesEl.innerHTML = `${esc(data.total_sales_money.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}))} <span>${esc(currencyLabelSales)}</span>`;
            }
            if (metricReceivedEl && Number.isFinite(data.total_money_received)) {
                metricReceivedEl.innerHTML = `${esc(data.total_money_received.toLocaleString(undefined, {minimumFractionDigits: 1, maximumFractionDigits: 1}))} <span>${esc(currencyLabelReceived)}</span>`;
            }
            
    console.log('[DEBUG] Financial metrics updated:', data);
}

// Phase 6 — server push (SSE) replaces the old 5s poll; stale-tab guarantees kept (stop + redirect)
var metricsStream = null;
function stopMetricsStream() {
    if (metricsStream) { metricsStream.close(); metricsStream = null; }
}
function startMetricsStream() {
    if (!window.EventSource) { refreshFinancialMetrics(); return; }
    stopMetricsStream();
    metricsStream = new EventSource('/api/admin/financial-metrics/stream');
    metricsStream.onmessage = function (e) {
        try { applyFinancialMetrics(JSON.parse(e.data)); } catch (err) { console.error('[ERROR] metrics parse:', err); }
    };
    metricsStream.addEventListener('session-lost', function () {
        stopMetricsStream();
        window.location.href = '/login';
    });
    metricsStream.onerror = function () {
        stopMetricsStream();
        // Mirror the Phase-2 guarantees: check the session once; redirect if gone, else retry later.
        fetch('/api/admin/financial-metrics', { headers: { 'Cache-Control': 'no-cache' } })
            .then(function (res) {
                if (res.redirected || res.status === 401) { window.location.href = '/login'; return; }
                if (res.status === 403) { return; }
                setTimeout(startMetricsStream, 10000);
            })
            .catch(function () { setTimeout(startMetricsStream, 10000); });
    };
}
startMetricsStream();

// Refresh metrics when page becomes visible again (tab switch)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden) {
        refreshFinancialMetrics();
    }
});

// Refresh metrics when window gains focus
window.addEventListener('focus', function() {
    refreshFinancialMetrics();
});

// Customer Details Modal Functions
function openCustomerModal(customerId) {
    const modal = document.getElementById('customerDetailsModal');
    const loadingDiv = document.getElementById('modal_loading');
    const bodyDiv = document.getElementById('modal_body');
    
    modal.style.display = 'flex';
    loadingDiv.style.display = 'block';
    bodyDiv.style.display = 'none';
    
    fetch(`/api/reports/customer-details?customer_id=${customerId}`)
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                loadingDiv.innerHTML = `<div style="color: #cf222e;">Error: ${esc(data.error)}</div>`;
                return;
            }
            
            const customer = data.customer;
            const creator = data.creator;
            const financial = data.financial;
            
            document.getElementById('modal_customer_name').textContent = customer.name;
            document.getElementById('modal_cust_id').textContent = customer.customer_id || 'N/A';
            document.getElementById('modal_cust_type').textContent = customer.customer_type || 'Not specified';
            document.getElementById('modal_contact_position').textContent = customer.contact_person_position || 'Not specified';
            document.getElementById('modal_province').textContent = customer.province;
            document.getElementById('modal_agency').textContent = customer.created_by_agency || 'Unknown';
            document.getElementById('modal_creator').textContent = creator ? creator.username : 'Not linked';
            document.getElementById('modal_phone').textContent = customer.phone || 'Not provided';
            document.getElementById('modal_alt_phone').textContent = customer.alternative_phone || 'Not provided';
            document.getElementById('modal_email').textContent = customer.email || 'Not provided';
            document.getElementById('modal_address').textContent = customer.address || 'Not provided';
            document.getElementById('modal_total_debit').textContent = financial.total_debit.toLocaleString() + ' Afs';
            document.getElementById('modal_total_credit').textContent = financial.total_credit.toLocaleString() + ' Afs';
            
            // Populate agency badge name
            const agencyValue = customer.created_by_agency || customer.agency || customer.province || 'Unknown';
            let agencyName = agencyValue;
            // Format agency name (e.g., kabul_agent -> Kabul Agency)
            if (agencyValue.includes('_')) {
                const parts = agencyValue.split('_');
                agencyName = parts.map(p => p.charAt(0).toUpperCase() + p.slice(1)).join(' ');
            } else {
                agencyName = agencyValue.charAt(0).toUpperCase() + agencyValue.slice(1);
                if (agencyName.toLowerCase() !== 'unknown') {
                    agencyName += ' Agency';
                }
            }
            document.getElementById('modal_agency_badge_name').textContent = agencyName;
            
            loadingDiv.style.display = 'none';
            bodyDiv.style.display = 'block';
        })
        .catch(err => {
            loadingDiv.innerHTML = `<div style="color: #cf222e;">Error: ${esc(err.message)}</div>`;
        });
}

function closeCustomerModal() {
    document.getElementById('customerDetailsModal').style.display = 'none';
}

// Load Cement Types Dropdown Options
async function loadCementDropdownOptions() {
    try {
        const res = await fetch('/api/config/cement-types');
        if (!res.ok) {
            console.error('[ERROR] Failed response from cement-types API:', res.status);
            return;
        }
        const items = await res.json();
        const select = document.getElementById('filter_cement');
        if (!select) return;

        select.innerHTML = '<option value="All">همه انواع</option>';

        // Handle array structure safely
        const list = Array.isArray(items) ? items : (items.data || []);
        list.forEach(item => {
            const name = item.cement_name || item.name || item;
            const opt = document.createElement('option');
            opt.value = name;
            opt.textContent = name;
            select.appendChild(opt);
        });
        
        console.log('[DEBUG] Cement types loaded:', list);
    } catch (err) {
        console.error('[ERROR] Failed to populate cement types:', err);
    }
}

