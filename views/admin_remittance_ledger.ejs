<%- include('partials/header') %>

<style>
    :root {
        --accent-blue: #2563eb;
        --success-green: #059669;
        --danger-red: #dc2626;
        --warning-amber: #d97706;
    }

    /* Customer Summary Print Button - Always visible in Light Mode */
    .customer-summary-print-btn {
        background-color: #000000 !important;
        color: #ffffff !important;
        border-color: #000000 !important;
    }

    .customer-summary-print-btn:hover:not(:disabled) {
        background-color: #333333 !important;
        color: #ffffff !important;
        border-color: #333333 !important;
    }

    .customer-summary-print-btn:focus {
        background-color: #000000 !important;
        color: #ffffff !important;
        border-color: #000000 !important;
        outline: 2px solid #000000 !important;
        outline-offset: 2px !important;
    }

    .customer-summary-print-btn:active:not(:disabled) {
        background-color: #000000 !important;
        color: #ffffff !important;
        border-color: #000000 !important;
    }

    .customer-summary-print-btn svg {
        stroke: #ffffff !important;
    }

    .page-wrapper {
        /* Direction is inherited from <html dir="..."> so Dari/Pashto render RTL
           and English renders LTR — no more forced ltr/rtl overrides here. */
        padding: 24px;
        background-color: var(--bg-color);
        min-height: 100vh;
        box-sizing: border-box;
    }

    /* Premium Page Header */
    .page-header {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 24px;
        margin-bottom: 24px;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        flex-wrap: wrap;
    }

    .header-content {
        flex: 1;
    }

    .header-content h1 {
        font-size: 22px;
        font-weight: 600;
        color: var(--text-main);
        margin: 0 0 6px 0;
        letter-spacing: -0.02em;
        line-height: 1.3;
    }

    .header-content p {
        font-size: 14px;
        color: var(--text-muted);
        margin: 0;
        line-height: 1.5;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn-primary {
        background-color: var(--primary-color);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.15s ease;
    }

    .btn-primary:hover {
        background-color: #334155;
    }

    .btn-secondary {
        background-color: var(--text-muted);
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 10px 16px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.15s ease;
    }

    .btn-secondary:hover {
        background-color: #4b5563;
    }

    /* Unified Filter Panel */
    .filter-panel {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        margin-bottom: 24px;
    }

    .filter-panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px 16px;
    }

    .filter-panel-title {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .filter-panel-title svg {
        flex-shrink: 0;
    }

    .filter-panel-header .btn-secondary {
        white-space: nowrap;
    }

    .filter-panel-body {
        padding: 20px;
    }

    .filter-section {
        margin-bottom: 20px;
    }

    .filter-section:last-child {
        margin-bottom: 0;
    }

    .filter-section-title {
        font-size: 12px;
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin: 0 0 12px 0;
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        align-items: flex-end;
    }

    .primary-filter-row,
    .search-filter-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        width: 100%;
    }

    .filter-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        box-sizing: border-box;
    }

    .filter-field label {
        font-size: 13px;
        font-weight: 500;
        color: var(--text-muted);
        margin: 0;
    }

    .form-input {
        padding: 8px 10px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 14px;
        background-color: var(--card-bg);
        color: var(--text-main);
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
        min-height: 38px;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .form-input:focus {
        border-color: var(--accent-blue);
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }

    .date-range-group {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        gap: 6px;
        align-items: center;
        width: 100%;
        min-width: 0;
        box-sizing: border-box;
    }

    .date-range-group .form-input {
        min-width: 0;
        width: 100%;
    }

    .date-range-separator {
        font-size: 13px;
        color: var(--text-muted);
        font-weight: 500;
    }
    
    @media (max-width: 1100px) {
        .primary-filter-row,
        .search-filter-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
    
    @media (max-width: 768px) {
        .date-range-group {
            grid-template-columns: 1fr;
            gap: 6px;
        }
        
        .date-range-separator {
            text-align: center;
            grid-row: 1;
        }
    }
    
    @media (max-width: 650px) {
        .primary-filter-row,
        .search-filter-row {
            grid-template-columns: 1fr;
        }
    }

    /* Main Content Area */
    .content-area {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
    }

    /* Enterprise Table */
    .table-wrapper {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

    .data-table thead {
        background-color: var(--bg-color);
        border-bottom: 2px solid var(--border-color);
    }

    .data-table th {
        color: var(--text-main);
        font-weight: 600;
        padding: 14px 16px;
        text-align: center;
        white-space: nowrap;
        font-size: 12px;
        letter-spacing: -0.01em;
        text-transform: uppercase;
    }

    .data-table td {
        padding: 14px 16px;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-muted);
        white-space: nowrap;
    }

    .data-table tbody tr:hover {
        background-color: var(--bg-color);
    }

    .data-table .col-index {
        background-color: var(--bg-color);
        font-weight: 500;
        color: var(--text-muted);
        font-size: 12px;
    }

    .data-table .col-amount {
        font-weight: 600;
        color: var(--success-green);
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
    }

    .customer-link {
        color: var(--accent-blue);
        cursor: pointer;
        text-decoration: none;
        font-weight: 500;
        transition: color 0.15s ease;
    }

    .customer-link:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    /* Status Badges */
    .status-badge {
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .status-badge.bank {
        background-color: #eff6ff;
        color: var(--accent-blue);
    }

    .status-badge.sarafi {
        background-color: #fef3c7;
        color: var(--warning-amber);
    }

    /* Summary Footer */
    .summary-footer {
        background-color: var(--bg-color);
        border-top: 2px solid var(--border-color);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .summary-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
    }

    .summary-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--success-green);
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
    }

    /* Pagination Bar */
    .pagination-bar {
        background-color: var(--surface-elevated);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 16px 24px;
        margin-top: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

    .pagination-info {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        color: var(--text-muted);
    }

    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pagination-btn {
        background-color: var(--bg-color);
        color: var(--text-main);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .pagination-btn:hover:not(:disabled) {
        background-color: var(--border-color);
    }

    .pagination-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .page-indicator {
        font-size: 14px;
        font-weight: 500;
        color: var(--text-main);
    }

    /* Empty State */
    .empty-state {
        padding: 60px 20px;
        text-align: center;
        background-color: var(--bg-color);
    }

    .empty-state-icon {
        width: 48px;
        height: 48px;
        stroke: var(--text-muted);
        stroke-width: 1.5;
        fill: none;
        margin-bottom: 16px;
    }

    .empty-state-text {
        font-size: 15px;
        font-weight: 500;
        color: var(--text-main);
        margin: 0;
    }

    .empty-state-sub {
        font-size: 13px;
        font-weight: 400;
        color: var(--text-muted);
        margin: 6px 0 0;
        line-height: 1.5;
    }

    .empty-state .btn-secondary,
    .error-state .btn-secondary {
        margin-top: 16px;
    }

    /* Loading State */
    .loading-state {
        padding: 60px 20px;
        text-align: center;
    }

    .loading-spinner {
        width: 40px;
        height: 40px;
        stroke: var(--text-muted);
        stroke-width: 1.5;
        fill: none;
        margin-bottom: 16px;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    /* Error State */
    .error-state {
        padding: 60px 20px;
        text-align: center;
        background-color: rgba(220, 38, 38, 0.07);
    }

    .error-icon {
        width: 48px;
        height: 48px;
        stroke: var(--danger-red);
        stroke-width: 1.5;
        fill: none;
        margin-bottom: 16px;
    }

    .error-text {
        font-size: 15px;
        font-weight: 500;
        color: var(--danger-red);
        margin: 0;
    }

    /* Report Close Button - Red X Icon */
    .report-close-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #dc2626;
        color: #ffffff;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        padding: 0;
        transition: background-color 0.2s ease;
    }
    .report-close-btn svg {
        width: 18px;
        height: 18px;
        stroke: #ffffff;
        stroke-width: 2.5;
        fill: none;
        stroke-linecap: round;
    }
    .report-close-btn:hover {
        background: #b91c1c;
    }

    /* Unified Filter Grid - Compact responsive grid holding all 10 filters */
    .unified-filter-grid {
        display: grid;
        /* 5 columns keeps the two-row rhythm on wide laptop screens. */
        grid-template-columns: repeat(5, minmax(140px, 1fr));
        gap: 14px 10px;
        align-items: start;
    }

    .unified-filter-grid .filter-field {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .unified-filter-grid .filter-field label {
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 4px;
        color: var(--text-muted);
        line-height: 1.35;
    }

    .unified-filter-grid .filter-field .form-input {
        font-size: 13px;
        padding: 6px 8px;
        min-height: 38px;
    }

    .unified-filter-grid .date-range-group {
        display: flex;
        gap: 4px;
        align-items: center;
        min-width: 0;
    }

    .unified-filter-grid .date-range-group .form-input {
        flex: 1 1 0;
        min-width: 0;
        width: auto;
    }

    .unified-filter-grid .date-range-separator {
        font-size: 11px;
        color: var(--text-muted);
        flex-shrink: 0;
    }

    /* Laptop / small desktop: keep every filter visible in fewer, wider columns. */
    @media (max-width: 1200px) {
        .unified-filter-grid {
            grid-template-columns: repeat(4, minmax(140px, 1fr));
        }
    }

    @media (max-width: 980px) {
        .unified-filter-grid {
            grid-template-columns: repeat(3, minmax(140px, 1fr));
        }
    }

    @media (max-width: 720px) {
        .unified-filter-grid {
            grid-template-columns: repeat(2, minmax(140px, 1fr));
        }
    }

    /* Phone: one filter per row so every control stays full width and thumb-sized. */
    @media (max-width: 560px) {
        .unified-filter-grid {
            grid-template-columns: 1fr;
        }

        .unified-filter-grid .date-range-group {
            flex-direction: column;
            align-items: stretch;
            gap: 6px;
        }

        .unified-filter-grid .date-range-separator {
            text-align: center;
            font-size: 12px;
        }
    }

    /* NOTE: the mobile input font-size override lives at the end of this
       stylesheet block so it can win over the base .rem-filter-* rules
       that are declared later in this file. */

    /* Customer Financial Summary Compact Table */
    .customer-accounts-summary-table {
        width: 100%;
        table-layout: auto;
        border-collapse: collapse;
        font-size: 13px;
    }

    .customer-accounts-summary-table th,
    .customer-accounts-summary-table td {
        padding: 7px 8px;
        white-space: normal;
        vertical-align: middle;
    }

    .customer-accounts-summary-table th {
        white-space: nowrap;
        font-size: 12px;
    }

    .customer-accounts-summary-table .col-id {
        min-width: 80px;
        max-width: 100px;
    }

    .customer-accounts-summary-table .col-name {
        min-width: 120px;
        max-width: 180px;
    }

    .customer-accounts-summary-table .col-amount {
        min-width: 90px;
        max-width: 120px;
        font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace;
        font-weight: 600;
    }

    .customer-accounts-summary-table .col-count {
        min-width: 70px;
        max-width: 90px;
        text-align: center;
    }

    .customer-accounts-summary-table .col-province {
        min-width: 90px;
        max-width: 120px;
    }

    .customer-accounts-summary-table .col-registered {
        min-width: 100px;
        max-width: 140px;
    }

    @media print {
        .sidebar, .top-navbar, .filter-panel, .header-actions, .pagination-bar, .no-print, select, input, button {
            display: none !important;
        }
        .page-wrapper { padding: 0; background: #fff; }
        .page-header, .content-area { border: none; border-radius: 0; }
        body { background: #ffffff !important; color: #000000 !important; }
        .table-wrapper { overflow: visible !important; }
        .data-table { width: 100% !important; border: 1px solid #000 !important; }
        .data-table th, .data-table td { border: 1px solid #000 !important; }
    }

    /* Customer Financial Summary Modal - Modern Compact Scrollbars */
    #customer-financial-summary-modal-content::-webkit-scrollbar,
    #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    #customer-financial-summary-modal-content::-webkit-scrollbar-track,
    #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-track {
        background: #e5e7eb;
        border-radius: 4px;
    }

    #customer-financial-summary-modal-content::-webkit-scrollbar-thumb,
    #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-thumb {
        background: #4b5563;
        border-radius: 4px;
    }

    #customer-financial-summary-modal-content::-webkit-scrollbar-thumb:hover,
    #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-thumb:hover {
        background: #374151;
    }

    [data-theme="dark"] #customer-financial-summary-modal-content::-webkit-scrollbar-track,
    [data-theme="dark"] #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-track {
        background: #161b22;
    }

    [data-theme="dark"] #customer-financial-summary-modal-content::-webkit-scrollbar-thumb,
    [data-theme="dark"] #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-thumb {
        background: #4b5563;
    }

    [data-theme="dark"] #customer-financial-summary-modal-content::-webkit-scrollbar-thumb:hover,
    [data-theme="dark"] #customer-financial-summary-modal-content .table-wrapper::-webkit-scrollbar-thumb:hover {
        background: #6b7280;
    }

    #customer-financial-summary-modal-content,
    #customer-financial-summary-modal-content .table-wrapper {
        scrollbar-width: thin;
        scrollbar-color: #4b5563 #e5e7eb;
    }

    [data-theme="dark"] #customer-financial-summary-modal-content,
    [data-theme="dark"] #customer-financial-summary-modal-content .table-wrapper {
        scrollbar-color: #4b5563 #161b22;
    }

    /* Custom dropdown controls - Filters section only */
    .rem-filter-dropdown {
        display: inline-flex;
        flex-direction: column;
        width: 100%;
        font-family: inherit;
    }

    .rem-filter-trigger {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 8px 10px;
        font-size: 13px;
        font-weight: 500;
        color: var(--text-main);
        background-color: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 6px;
        cursor: pointer;
        outline: none;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease;
        gap: 8px;
    }

    html[dir="rtl"] .rem-filter-trigger {
        direction: rtl;
        text-align: right;
    }

    .rem-filter-trigger:hover {
        border-color: var(--text-muted);
        background-color: var(--table-header-bg);
    }

    .rem-filter-trigger:focus-visible {
        border-color: var(--accent-blue);
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
    }

    [data-theme="dark"] .rem-filter-trigger:focus-visible {
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.2);
    }

    .rem-filter-trigger[aria-expanded="true"] {
        border-color: var(--accent-blue);
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
        background-color: var(--dropdown-bg);
    }

    html[dir="rtl"] .rem-filter-trigger[aria-expanded="true"] {
        border-bottom-left-radius: 0;
        border-bottom-right-radius: 0;
    }

    .rem-filter-selected {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        text-align: left;
    }

    html[dir="rtl"] .rem-filter-selected {
        text-align: right;
    }

    .rem-filter-arrow {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        stroke: var(--text-muted);
        transition: transform 0.2s ease;
    }

    .rem-filter-trigger[aria-expanded="true"] .rem-filter-arrow {
        transform: rotate(180deg);
    }

    .rem-filter-options {
        position: absolute;
        z-index: 50;
        width: 100%;
        max-height: 260px;
        overflow-y: auto;
        overflow-x: hidden;
        background-color: var(--dropdown-bg);
        border: 1px solid var(--border-color);
        border-top: none;
        border-radius: 0 0 6px 6px;
        box-shadow: var(--shadow);
        margin-top: -1px;
        scrollbar-width: thin;
        scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
    }

    html[dir="rtl"] .rem-filter-options {
        border-radius: 0 0 6px 6px;
    }

    .rem-filter-options::-webkit-scrollbar {
        width: 8px;
    }

    .rem-filter-options::-webkit-scrollbar-track {
        background: var(--scrollbar-track);
    }

    .rem-filter-options::-webkit-scrollbar-thumb {
        background: var(--scrollbar-thumb);
        border-radius: 4px;
    }

    .rem-filter-options::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }

    .rem-filter-option {
        display: flex;
        align-items: center;
        padding: 8px 10px;
        font-size: 13px;
        color: var(--text-main);
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: left;
    }

    html[dir="rtl"] .rem-filter-option {
        text-align: right;
    }

    .rem-filter-option:hover {
        background-color: var(--table-row-hover);
        color: var(--text-main);
    }

    .rem-filter-option[aria-selected="true"] {
        background-color: rgba(59, 130, 246, 0.1);
        color: var(--accent-blue);
        font-weight: 600;
    }

    [data-theme="dark"] .rem-filter-option[aria-selected="true"] {
        background-color: rgba(88, 166, 255, 0.15);
        color: var(--accent-blue);
    }

    .rem-filter-option[data-disabled="true"] {
        color: var(--text-muted);
        cursor: not-allowed;
    }

    .rem-filter-option[data-disabled="true"]:hover {
        background-color: transparent;
    }

    /* Hide the original native select but keep it in the DOM for value access.
       This class is only added by FilterDropdown.build(), so if the script ever
       fails the native selects remain visible and every filter stays usable. */
    .rem-filter-native-select {
        display: none !important;
    }

    /* Visible ring for the keyboard-highlighted option. */
    .rem-filter-option-focused {
        background-color: var(--table-row-hover);
        color: var(--text-main);
        box-shadow: inset 0 0 0 1px var(--accent-blue);
    }

    /* Panel flipped above its trigger when the viewport has no room below. */
    .rem-filter-options--up {
        border-top: 1px solid var(--border-color);
        border-bottom: none;
        border-radius: 6px 6px 0 0;
        margin-top: 0;
        margin-bottom: -1px;
    }

    /* Comfortable control heights (mouse + touch). */
    .rem-filter-trigger {
        min-height: 38px;
    }

    .rem-filter-option {
        min-height: 40px;
    }

    /* ============ Laptop / tablet / phone refinements ============ */

    /* Give the table a readable floor so it scrolls sideways instead of
       crushing ten columns into slivers next to the sidebar. */
    @media (max-width: 1180px) {
        .data-table {
            min-width: 900px;
        }
    }

    @media (max-width: 768px) {
        .page-wrapper {
            padding: 16px;
        }

        .page-header {
            padding: 16px;
            gap: 14px;
            margin-bottom: 16px;
        }

        .header-content h1 {
            font-size: 20px;
        }

        .header-actions {
            width: 100%;
        }

        .header-actions .btn-primary {
            flex: 1 1 180px;
            justify-content: center;
        }

        .filter-panel {
            margin-bottom: 16px;
        }

        .filter-panel-header {
            padding: 14px 16px;
        }

        .filter-panel-body {
            padding: 16px;
        }

        .pagination-bar {
            padding: 14px 16px;
            justify-content: center;
            gap: 12px;
        }

        .pagination-info {
            justify-content: center;
            text-align: center;
            font-size: 13px;
        }

        .pagination-controls {
            width: 100%;
            justify-content: center;
        }

        .pagination-btn {
            min-height: 40px;
            flex: 1 1 auto;
            max-width: 150px;
        }

        .empty-state,
        .error-state,
        .loading-state {
            padding: 40px 16px;
        }
    }

    @media (max-width: 640px) {
        .page-wrapper {
            padding: 12px;
        }

        .page-header {
            padding: 14px;
        }

        .header-content h1 {
            font-size: 19px;
        }

        /* 16px inputs stop iOS/Android auto-zooming the page on focus. */
        .unified-filter-grid .filter-field .form-input,
        .rem-filter-trigger,
        .rem-filter-option {
            font-size: 16px;
        }

        .unified-filter-grid .filter-field label,
        .filter-panel-title,
        .filter-panel-header .btn-secondary {
            font-size: 14px;
        }

        .header-actions .btn-primary {
            flex: 1 1 100%;
        }

        .data-table {
            min-width: 860px;
        }

        .data-table th,
        .data-table td {
            padding: 12px;
        }

        .summary-label {
            font-size: 13px;
        }

        .summary-value {
            font-size: 16px;
        }
    }

    /* Print must never inherit the horizontal-scroll min-width. */
    @media print {
        .data-table {
            min-width: 0 !important;
        }

        .empty-state .btn-secondary,
        .error-state .btn-secondary {
            display: none !important;
        }
    }

    /* ============ Customer Financial Summary modal ============ */

    /* The modal chrome uses inline styles, so mobile tweaks need !important. */
    #customer-financial-summary-modal-content {
        box-sizing: border-box;
    }

    @media (max-width: 640px) {
        #customer-financial-summary-modal {
            align-items: stretch !important;
            padding: 8px;
        }

        #customer-financial-summary-modal-content {
            width: 100% !important;
            max-width: none !important;
            max-height: calc(100vh - 16px) !important;
        }

        #customer-financial-summary-modal-content > div:first-child {
            flex-wrap: wrap;
            gap: 10px;
            padding: 14px !important;
        }

        #customer-financial-summary-modal-content > div:first-child h3 {
            font-size: 16px !important;
            flex: 1 1 100%;
        }

        #customer-financial-summary-modal-content > div:first-child > div {
            flex-wrap: wrap;
            width: 100%;
            justify-content: flex-end;
        }

        #customer-financial-summary-modal-content > div:nth-child(2) {
            padding: 14px !important;
        }

        #customer-financial-summary-modal-content > div:nth-child(2) > div:first-child {
            padding: 14px !important;
        }

        #customer-financial-summary-modal-content > div:nth-child(2) > div:first-child > div {
            grid-template-columns: 1fr !important;
            gap: 12px !important;
        }

        .customer-accounts-summary-table {
            font-size: 12px;
        }
    }
</style>

<div class="page-wrapper">
    <!-- Premium Page Header -->
    <div class="page-header">
        <div class="header-content">
            <h1><%= t('remittance_ledger.title') %></h1>
            <p><%= t('remittance_ledger.description') %></p>
        </div>
        <div class="header-actions no-print">
            <button onclick="openCustomerFinancialSummaryModal()" class="btn-primary customer-accounts-summary-btn" style="background-color: #000000 !important; color: #ffffff !important; border-color: #000000 !important; border: none !important; opacity: 1 !important; visibility: visible !important;">
                <svg style="width: 18px; height: 18px; stroke: #ffffff !important; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>
                <%= t('remittance_ledger.customer_summary_report') %>
            </button>
            <button onclick="window.print()" class="btn-primary print-generate-report-btn" style="background-color: #000000 !important; color: #ffffff !important; border-color: #000000 !important; border: none !important; opacity: 1 !important; visibility: visible !important;">
                <svg style="width: 18px; height: 18px; stroke: #ffffff !important; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v-5a2 2 0 0 1-2 2h-2"/><rect width="12" height="12" x="6" y="10" rx="2"/></svg>
                <%= t('remittance_ledger.print_report') %>
            </button>
        </div>
    </div>

    <!-- Unified Filter Panel -->
    <div class="filter-panel no-print">
        <div class="filter-panel-header">
            <h3 class="filter-panel-title">
                <svg style="width: 18px; height: 18px; stroke: currentColor; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><polygon points="22 3 2 3 10 12.46 10 19 14 16 14 12.46 22 3"/></svg>
                <%= t('remittance_ledger.filters') %>
            </h3>
            <button onclick="resetRemittanceFilters()" class="btn-secondary">
                <svg style="width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 12"/></svg>
                <%= t('remittance_ledger.clear_filters') %>
            </button>
        </div>
        <div class="filter-panel-body">
            <!-- Unified Filter Grid - Two Compact Rows -->
            <div class="unified-filter-grid">
                <!-- Row 1: Primary Filters -->
                <div class="filter-field">
                    <label><%= t('remittance_ledger.province_label') %></label>
                    <select id="rem_filter_province" class="form-input" onchange="applyRemittanceFilters()">
                        <option value="All"><%= t('remittance_ledger.all_provinces') %></option>
                        <option value="Kabul">کابل (Kabul)</option>
                        <option value="Herat">هرات (Herat)</option>
                        <option value="Balkh">بلخ (Balkh)</option>
                        <option value="Kandahar">قندهار (Kandahar)</option>
                        <option value="Nangarhar">ننگرهار (Nangarhar)</option>
                        <option value="Khost">خوست (Khost)</option>
                        <option value="Paktia">پکتیا (Paktia)</option>
                        <option value="Paktika">پکتیکا (Paktika)</option>
                        <option value="Ghazni">غزنی (Ghazni)</option>
                        <option value="Logar">لوگر (Logar)</option>
                        <option value="Laghman">لغمان (Laghman)</option>
                        <option value="Wardak"> میدان وردک (Wardak)</option>
                        <option value="Parwan">پروان (Parwan)</option>
                        <option value="Kapisa">کاپیسا (Kapisa)</option>
                        <option value="Panjshir">پنجشیر (Panjshir)</option>
                        <option value="Kunar">کونر (Kunar)</option>
                        <option value="Nuristan">نورستان (Nuristan)</option>
                        <option value="Badakhshan">بدخشان (Badakhshan)</option>
                        <option value="Takhar">تخار (Takhar)</option>
                        <option value="Baghlan">بغلان (Baghlan)</option>
                        <option value="Kunduz">قندوز (Kunduz)</option>
                        <option value="Samangan">سمنگان (Samangan)</option>
                        <option value="Jowzjan">جوزجان (Jowzjan)</option>
                        <option value="Sar-e Pol">سرپل (Sar-e Pol)</option>
                        <option value="Faryab">فاریاب (Faryab)</option>
                        <option value="Badghis">بادغیس (Badghis)</option>
                        <option value="Ghor">غور (Ghor)</option>
                        <option value="Bamyan">بامیان (Bamyan)</option>
                        <option value="Daikundi">دایکندی (Daikundi)</option>
                        <option value="Farah">فراه (Farah)</option>
                        <option value="Nimruz">نیمروز (Nimruz)</option>
                        <option value="Helmand">هلمند (Helmand)</option>
                        <option value="Zabul">زابل (Zabul)</option>
                        <option value="Uruzgan">ارزگان (Uruzgan)</option>
                    </select>
                    <div class="rem-filter-dropdown" id="dd_rem_filter_province"></div>
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.customer_account_label') %></label>
                    <select id="rem_filter_customer" class="form-input" onchange="applyRemittanceFilters()">
                        <option value="All"><%= t('remittance_ledger.all_accounts') %></option>
                        <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
                            <% customers.forEach(function(customer) { %>
                                <% 
                                    let displayLabel = customer.customer_id || ('#CUST-' + customer.id);
                                    const cleanName = (customer.name || '').trim();
                                    if (cleanName && !displayLabel.includes(cleanName)) {
                                        displayLabel += ' - ' + cleanName;
                                    }
                                    if (customer.province) {
                                        displayLabel += ' (' + customer.province + ')';
                                    }
                                %>
                                <option value="<%= customer.id %>" data-province="<%= customer.province %>"><%= displayLabel %></option>
                            <% }); %>
                        <% } %>
                    </select>
                    <div class="rem-filter-dropdown" id="dd_rem_filter_customer"></div>
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.source_label') %></label>
                    <select id="rem_filter_source" class="form-input" onchange="applyRemittanceFilters()">
                        <option value="All"><%= t('remittance_ledger.all_sources') %></option>
                        <option value="Bank"><%= t('remittance_ledger.source_bank') %></option>
                        <option value="Sarafi"><%= t('remittance_ledger.source_sarafi') %></option>
                    </select>
                    <div class="rem-filter-dropdown" id="dd_rem_filter_source"></div>
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.registered_by_label') %></label>
                    <select id="rem_filter_user" class="form-input" onchange="applyRemittanceFilters()">
                        <option value="All"><%= t('remittance_ledger.all_agencies') %></option>
                        <% if (typeof agencies !== 'undefined' && agencies.length > 0) { %>
                            <% agencies.forEach(function(agency) { %>
                                <option value="<%= agency.agency_name %>"><%= agency.agency_name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                    <div class="rem-filter-dropdown" id="dd_rem_filter_user"></div>
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.date_range_label') %></label>
                    <div class="date-range-group">
                        <input type="text" id="rem_filter_start_date" class="form-input" data-datepicker="jalali" placeholder="<%= t('remittance_ledger.from_date') %>" onchange="applyRemittanceFilters()" readonly>
                        <span class="date-range-separator"><%= t('remittance_ledger.to') %></span>
                        <input type="text" id="rem_filter_end_date" class="form-input" data-datepicker="jalali" placeholder="<%= t('remittance_ledger.to_date') %>" onchange="applyRemittanceFilters()" readonly>
                    </div>
                </div>

                <!-- Row 2: Search Filters -->
                <div class="filter-field">
                    <label><%= t('remittance_ledger.sender_name_label') %></label>
                    <input type="text" id="rem_search_sender" class="form-input" placeholder="<%= t('remittance_ledger.search_sender_placeholder') %>" oninput="applyRemittanceFilters()">
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.bank_name_label') %></label>
                    <input type="text" id="rem_search_source_name" class="form-input" placeholder="<%= t('remittance_ledger.search_bank_placeholder') %>" oninput="applyRemittanceFilters()">
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.hawala_number_label') %></label>
                    <input type="text" id="rem_search_remittance_number" class="form-input" placeholder="<%= t('remittance_ledger.search_hawala_placeholder') %>" oninput="applyRemittanceFilters()">
                </div>
                <div class="filter-field">
                    <label><%= t('remittance_ledger.amount_label') %></label>
                    <input type="number" id="rem_search_amount" class="form-input" placeholder="<%= t('remittance_ledger.search_amount_placeholder') %>" oninput="applyRemittanceFilters()">
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="content-area">
        <div class="table-wrapper">
            <table class="data-table">
                <colgroup>
                    <col style="width: 50px;" />
                    <col style="width: 90px;" />
                    <col style="width: 140px;" />
                    <col style="width: 100px;" />
                    <col style="width: 120px;" />
                    <col style="width: 90px;" />
                    <col style="width: 110px;" />
                    <col style="width: 110px;" />
                    <col style="width: 110px;" />
                    <col style="width: 110px;" />
                </colgroup>
                <thead>
                    <tr>
                        <th>#</th>
                        <th><%= t('remittance_ledger.th_date') %></th>
                        <th><%= t('remittance_ledger.th_customer') %></th>
                        <th><%= t('remittance_ledger.th_province') %></th>
                        <th><%= t('remittance_ledger.th_sender') %></th>
                        <th><%= t('remittance_ledger.th_source') %></th>
                        <th><%= t('remittance_ledger.th_hawala_number') %></th>
                        <th><%= t('remittance_ledger.th_registered_by') %></th>
                        <th><%= t('remittance_ledger.th_agency') %></th>
                        <th><%= t('remittance_ledger.th_amount') %></th>
                    </tr>
                </thead>
                <tbody id="remittance-ledger-rows">
                    <tr>
                        <td colspan="10">
                            <div class="loading-state">
                                <svg class="loading-spinner" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
                                <p style="font-size: 15px; font-weight: 500; color: var(--text-main); margin: 0;"><%= t('remittance_ledger.loading') %></p>
                            </div>
                        </td>
                    </tr>
                </tbody>
                <tfoot id="remittance-ledger-footer">
                    <tr>
                        <td colspan="9" style="padding: 16px 24px; text-align: left; border-top: 2px solid var(--border-color);">
                            <span class="summary-label"><%= t('remittance_ledger.total_amount_label') %></span>
                        </td>
                        <td id="rem-total-amount" style="padding: 16px 24px; text-align: right; border-top: 2px solid var(--border-color);">
                            <span class="summary-value">0</span>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Pagination Bar -->
    <div id="rem-pagination-container" class="pagination-bar no-print" data-page-label="<%= t('remittance_ledger.page') %>" data-of-label="<%= t('remittance_ledger.of') %>">
        <div class="pagination-info">
            <span><%= t('remittance_ledger.rows_per_page') %></span>
            <select id="select_worker_rem_rows_per_page" class="form-input" style="width: 80px;" onchange="handleRowsPerPageChange(this.value)">
                <option value="10" selected>۱۰</option>
                <option value="25">۲۵</option>
                <option value="50">۵۰</option>
                <option value="100">۱۰۰</option>
            </select>
        </div>

        <div class="pagination-info">
            <%= t('remittance_ledger.showing') %> <span id="lbl_page_start">0</span> <%= t('remittance_ledger.to') %> <span id="lbl_page_end">0</span> <%= t('remittance_ledger.of') %> <span id="lbl_total_count">0</span> <%= t('remittance_ledger.items') %>
        </div>

        <div class="pagination-controls">
            <button id="btn_page_prev" onclick="goToPrevPage()" class="pagination-btn" disabled><%= t('remittance_ledger.previous') %></button>
            <span id="lbl_page_indicator" class="page-indicator"><%= t('remittance_ledger.page') %> ۱</span>
            <button id="btn_page_next" onclick="goToNextPage()" class="pagination-btn" disabled><%= t('remittance_ledger.next') %></button>
        </div>
    </div>
</div>

