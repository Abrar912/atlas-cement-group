    const printWindow = window.open('', '_blank');
    
    const startDate = document.getElementById('cust_sum_start_date')?.value || 'همه';
    const endDate = document.getElementById('cust_sum_end_date')?.value || 'همه';
    const searchCustomer = document.getElementById('cust_sum_search')?.value || 'همه';
    const balanceFilter = document.getElementById('cust_sum_balance')?.value || 'همه';
    const provinceFilter = document.getElementById('cust_sum_province')?.value || 'همه';
    const agencyFilter = document.getElementById('cust_sum_agency')?.value || 'همه';
    
    const currentDate = new Date().toLocaleDateString('fa-IR');
    
    printWindow.document.write(`
        <!DOCTYPE html>
        <html dir="rtl">
        <head>
            <meta charset="UTF-8">
            <title>خلاصه گزارشات حسابات مشتریان</title>
            <style>
                body {
                    font-family: Arial, sans-serif;
                    margin: 20px;
                    direction: rtl;
                }
                h1 {
                    text-align: center;
                    margin-bottom: 10px;
                }
                .filters {
                    margin: 20px 0;
                    padding: 15px;
                    background: #f5f5f5;
                    border: 1px solid #ddd;
                }
                .filters p {
                    margin: 5px 0;
                }
                table {
                    width: 100%;
                    border-collapse: collapse;
                    margin-top: 20px;
                }
                th, td {
                    border: 1px solid #ddd;
                    padding: 8px;
                    text-align: right;
                }
                th {
                    background: #f0f0f0;
                    font-weight: bold;
                }
                .totals {
                    background: #e8e8e8;
                    font-weight: bold;
                }
                .date {
                    text-align: left;
                    font-size: 12px;
                    color: #666;
                }
            </style>
        </head>
        <body>
            <h1>خلاصه گزارشات حسابات مشتریان</h1>
            <div class="date">تاریخ چاپ: ${esc(currentDate)}</div>
            
            <div class="filters">
                <p><strong>فیلترهای اعمال شده:</strong></p>
                <p>از تاریخ: ${esc(startDate)}</p>
                <p>تا تاریخ: ${esc(endDate)}</p>
                <p>جستجوی مشتری: ${esc(searchCustomer)}</p>
                <p>وضعیت حساب: ${esc(balanceFilter)}</p>
                <p>ولایت مشتری: ${esc(provinceFilter)}</p>
                <p>ثبت شده با نماینده‌گی: ${esc(agencyFilter)}</p>
            </div>
            
