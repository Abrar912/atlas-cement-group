<!-- Shared customer modal is included once, AFTER the page script (see bottom of file),
     so the shared openCustomerModal/closeCustomerModal implementations win. -->

<script>
// Set active sidebar item
document.getElementById('nav-agent-remittances')?.classList.add('active');

let currentTableData = [];
let filteredTableData = [];
let remCurrentPage = 1;
let remRowsPerPage = 10;

let customerSummaryData = [];
let custSumCurrentPage = 1;
let custSumRowsPerPage = 10;
let isCustomerSummaryMaximized = false;

// Reusable custom dropdown for the Filters section only.
// Wraps a native select element (kept hidden so its .value still works) and
// provides a theme-consistent, keyboard-navigable, ARIA-compliant dropdown with
// a scrollable, styled options panel. No global styles; scoped to this page.
// Shared registry so that opening one dropdown closes any other open one.
const allDropdowns = [];

class FilterDropdown {
    constructor(selectEl) {
        this.select = selectEl;
        this.id = selectEl.id;
        this.panelId = `ddlist_${this.id}`;
        this.container = null;
        this.trigger = null;
        this.panel = null;
        this.selectedDisplay = null;
        this.arrow = null;
        this.isOpen = false;
        this.focusedIndex = -1;
        // Bind once: add/removeEventListener must receive the SAME function
        // reference, otherwise every open/close cycle leaks document listeners
        // and keyboard handling runs multiple times per key press.
        this._onKeyDown = this.onKeyDown.bind(this);
        this._onOutsideClick = this.onOutsideClick.bind(this);
        allDropdowns.push(this);

        this.build();
        this.syncFromNative();
        this.bindEvents();
    }

    build() {
        // Reuse the server-rendered dd_rem_filter_* placeholder when present so the
        // labelled element in the markup is the real control (and no empty husk
        // is left behind); otherwise create a container.
        const placeholder = document.getElementById('dd_' + this.id);
        this.container = placeholder || document.createElement('div');
        this.container.innerHTML = '';
        this.container.className = 'rem-filter-dropdown';
        this.container.style.position = 'relative';

        this.select.classList.add('rem-filter-native-select');

        this.trigger = document.createElement('div');
        this.trigger.className = 'rem-filter-trigger';
        this.trigger.setAttribute('tabindex', '0');
        this.trigger.setAttribute('role', 'combobox');
        this.trigger.setAttribute('aria-expanded', 'false');
        this.trigger.setAttribute('aria-haspopup', 'listbox');
        this.trigger.setAttribute('aria-controls', this.panelId);
        const label = this.select.previousElementSibling;
        this.trigger.setAttribute('aria-label', label ? label.textContent.trim() : this.id);

        this.selectedDisplay = document.createElement('span');
        this.selectedDisplay.className = 'rem-filter-selected';

        this.arrow = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        // NOTE: SVGElement.className is a read-only SVGAnimatedString, so assigning a
        // string to it throws a TypeError and aborts construction of the dropdown.
        // Always assign SVG classes through setAttribute('class', ...).
        this.arrow.setAttribute('class', 'rem-filter-arrow');
        this.arrow.setAttribute('viewBox', '0 0 24 24');
        this.arrow.innerHTML = '<path d="M7 11l5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>';

        this.trigger.appendChild(this.selectedDisplay);
        this.trigger.appendChild(this.arrow);

        this.panel = document.createElement('div');
        this.panel.className = 'rem-filter-options';
        this.panel.id = this.panelId;
        this.panel.setAttribute('role', 'listbox');
        this.panel.hidden = true;

        this.container.appendChild(this.trigger);
        this.container.appendChild(this.panel);

        this.select.parentNode.insertBefore(this.container, this.select.nextSibling);
    }

    syncFromNative() {
        const val = this.select.value;
        const opt = this.select.options[this.select.selectedIndex] || this.select.options[0];
        this.selectedDisplay.textContent = opt ? opt.text : val;
        this.selectedDisplay.setAttribute('data-value', val);

        this.panel.innerHTML = '';
        Array.from(this.select.options).forEach((optEl, index) => {
            const o = document.createElement('div');
            o.id = this.panelId + '_opt_' + index;
            o.className = 'rem-filter-option' + (optEl.selected ? ' rem-filter-option-selected' : '');
            o.setAttribute('role', 'option');
            o.setAttribute('aria-selected', optEl.selected ? 'true' : 'false');
            o.setAttribute('data-value', optEl.value);
            o.textContent = optEl.text;
            if (optEl.dataset.province) o.dataset.province = optEl.dataset.province;
            o.addEventListener('click', () => this.selectValue(optEl.value));
            this.panel.appendChild(o);
        });
    }

    selectValue(value) {
        this.select.value = value;
        this.select.dispatchEvent(new Event('change', { bubbles: true }));
        this.syncFromNative();
        this.close();
    }

    open() {
        if (this.isOpen) return;
        // Only one dropdown may be expanded at a time.
        allDropdowns.forEach((dd) => { if (dd !== this) dd.close(); });
        this.isOpen = true;
        this.trigger.setAttribute('aria-expanded', 'true');
        this.panel.hidden = false;
        this.panel.classList.remove('rem-filter-options--up');
        this.positionPanel();
        this.focusedIndex = Math.max(this.select.selectedIndex, 0);
        this.updateFocusedOption();
        document.addEventListener('keydown', this._onKeyDown);
        document.addEventListener('click', this._onOutsideClick, true);
    }

    close() {
        if (!this.isOpen) return;
        this.isOpen = false;
        this.trigger.setAttribute('aria-expanded', 'false');
        this.trigger.removeAttribute('aria-activedescendant');
        this.panel.hidden = true;
        this.panel.classList.remove('rem-filter-options--up');
        document.removeEventListener('keydown', this._onKeyDown);
        document.removeEventListener('click', this._onOutsideClick, true);
    }

    toggle() {
        if (this.isOpen) this.close(); else this.open();
    }

    positionPanel() {
        // The panel is absolutely positioned inside this.container (position:relative),
        // so every offset must be measured against the container — using document
        // coordinates made the panel jump by window.scrollY after scrolling.
        const cRect = this.container.getBoundingClientRect();
        const tRect = this.trigger.getBoundingClientRect();
        const gap = 8;
        const PREFERRED = 260;
        const spaceBelow = window.innerHeight - tRect.bottom - gap;
        const spaceAbove = tRect.top - gap;

        // Flip above the trigger only when there is genuinely more room up there.
        const flipUp = spaceBelow < 180 && spaceAbove > spaceBelow;
        if (flipUp) {
            this.panel.classList.add('rem-filter-options--up');
            this.panel.style.top = 'auto';
            this.panel.style.bottom = (cRect.bottom - tRect.top) + 'px';
        } else {
            this.panel.classList.remove('rem-filter-options--up');
            this.panel.style.bottom = 'auto';
            this.panel.style.top = (tRect.bottom - cRect.top) + 'px';
        }

        // Never let the list grow past the space that actually exists, so the panel
        // stays fully visible on short windows and inside the mobile viewport.
        const available = flipUp ? spaceAbove : spaceBelow;
        this.panel.style.maxHeight = Math.min(PREFERRED, Math.max(120, available)) + 'px';

        if (document.documentElement.dir === 'rtl') {
            this.panel.style.left = 'auto';
            this.panel.style.right = (cRect.right - tRect.right) + 'px';
        } else {
            this.panel.style.left = (tRect.left - cRect.left) + 'px';
            this.panel.style.right = 'auto';
        }
        this.panel.style.width = tRect.width + 'px';
    }

    updateFocusedOption() {
        const options = Array.from(this.panel.querySelectorAll('.rem-filter-option'));
        options.forEach((o, i) => {
            o.classList.toggle('rem-filter-option-focused', i === this.focusedIndex);
        });
        // Combobox pattern: report the highlighted option back to screen readers.
        const active = options[this.focusedIndex];
        if (this.isOpen && active && active.id) this.trigger.setAttribute('aria-activedescendant', active.id);
        else this.trigger.removeAttribute('aria-activedescendant');
    }

    bindEvents() {
        this.trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            this.toggle();
        });
        this.trigger.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                e.preventDefault();
                this.open();
            }
        });

        this.panel.addEventListener('mouseover', (e) => {
            const opt = e.target.closest('.rem-filter-option');
            if (opt) {
                const index = Array.from(this.panel.children).indexOf(opt);
                if (index >= 0) {
                    this.focusedIndex = index;
                    this.updateFocusedOption();
                }
            }
        });
    }

    onKeyDown(e) {
        if (!this.isOpen) return;
        const options = Array.from(this.panel.querySelectorAll('.rem-filter-option:not([data-disabled="true"])'));
        if (options.length === 0) return;

        if (e.key === 'Escape') {
            e.preventDefault();
            this.close();
            this.trigger.focus();
        } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            this.focusedIndex = Math.min(this.focusedIndex + 1, options.length - 1);
            this.updateFocusedOption();
            options[this.focusedIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            this.focusedIndex = Math.max(this.focusedIndex - 1, 0);
            this.updateFocusedOption();
            options[this.focusedIndex]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Home') {
            e.preventDefault();
            this.focusedIndex = 0;
            this.updateFocusedOption();
            options[0]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'End') {
            e.preventDefault();
            this.focusedIndex = options.length - 1;
            this.updateFocusedOption();
            options[options.length - 1]?.scrollIntoView({ block: 'nearest' });
        } else if (e.key === 'Enter') {
            e.preventDefault();
            const value = options[this.focusedIndex]?.dataset.value;
            if (value !== undefined) this.selectValue(value);
        } else if (e.key.length === 1) {
            const char = e.key.toLowerCase();
            for (let i = 0; i < options.length; i++) {
                if (options[i].textContent.toLowerCase().startsWith(char)) {
                    this.focusedIndex = i;
                    this.updateFocusedOption();
                    options[i]?.scrollIntoView({ block: 'nearest' });
                    break;
                }
            }
        }
    }

    onOutsideClick(e) {
        if (this.container && !this.container.contains(e.target)) {
            this.close();
        }
    }

    refresh() {
        this.syncFromNative();
    }
}

const filterDropdowns = {};
function initFilterDropdowns() {
    ['rem_filter_province', 'rem_filter_customer', 'rem_filter_source', 'rem_filter_user'].forEach((id) => {
        const el = document.getElementById(id);
        if (el) filterDropdowns[id] = new FilterDropdown(el);
    });
}

document.addEventListener('DOMContentLoaded', initFilterDropdowns);

function loadRemittanceLedger() {
    console.log('[DEBUG] Loading remittance ledger...');
    
    const province = document.getElementById('rem_filter_province')?.value || 'All';
    const customerId = document.getElementById('rem_filter_customer')?.value || 'All';
    const source = document.getElementById('rem_filter_source')?.value || 'All';
    const agencyFilter = document.getElementById('rem_filter_user')?.value || 'All';
    const startDate = document.getElementById('rem_filter_start_date')?.value || '';
    const endDate = document.getElementById('rem_filter_end_date')?.value || '';
    const searchSender = document.getElementById('rem_search_sender')?.value || '';
    const searchSourceName = document.getElementById('rem_search_source_name')?.value || '';
    const searchRemittanceNumber = document.getElementById('rem_search_remittance_number')?.value || '';
    const searchAmount = document.getElementById('rem_search_amount')?.value || '';

    let queryUrl = `/api/reports/remittance-ledger?province=${province}&customer_id=${customerId}&source=${source}&agency=${encodeURIComponent(agencyFilter)}&start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}&search_sender=${encodeURIComponent(searchSender)}&search_source_name=${encodeURIComponent(searchSourceName)}&search_remittance_number=${encodeURIComponent(searchRemittanceNumber)}&search_amount=${encodeURIComponent(searchAmount)}`;
    
    fetch(queryUrl)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            let records = [];
            if (Array.isArray(data)) records = data;
            else if (data && Array.isArray(data.remittances)) records = data.remittances;
            else if (data && Array.isArray(data.records)) records = data.records;
            else if (data && Array.isArray(data.data)) records = data.data;

            currentTableData = records;
            
            if (searchAmount) {
                currentTableData = currentTableData.filter(row => 
                    row.amount_received && row.amount_received.toString().includes(searchAmount.toString().trim())
                );
            }
            
            filteredTableData = [...currentTableData];
            remCurrentPage = 1;
            renderRemittanceTable(filteredTableData);
        })
        .catch(err => {
            console.error('[ERROR] Error loading remittance ledger:', err);
            currentTableData = [];
            filteredTableData = [];
            document.getElementById('remittance-ledger-rows').innerHTML = `
                <tr>
                    <td colspan="10">
                        <div class="error-state" role="alert">
                            <svg class="error-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                            <p class="error-text"><%= t('admin.error_loading') %></p>
                            <p class="empty-state-sub">${esc(err.message)}</p>
                            <button type="button" class="btn-secondary" onclick="loadRemittanceLedger()"><%= t('worker.try_again') %></button>
                        </div>
                    </td>
                </tr>
            `;
            renderPaginationControls(1);
        });
}

function applyRemittanceFilters() { loadRemittanceLedger(); }

function resetRemittanceFilters() {
    document.getElementById('rem_filter_province').value = 'All';
    document.getElementById('rem_filter_customer').value = 'All';
    document.getElementById('rem_filter_source').value = 'All';
    document.getElementById('rem_filter_user').value = 'All';
    document.getElementById('rem_filter_start_date').value = '';
    document.getElementById('rem_filter_end_date').value = '';
    document.getElementById('rem_search_sender').value = '';
    document.getElementById('rem_search_source_name').value = '';
    document.getElementById('rem_search_remittance_number').value = '';
    document.getElementById('rem_search_amount').value = '';
    Object.values(filterDropdowns).forEach((dd) => dd.refresh());
    applyRemittanceFilters();
}

function openCustomerFinancialSummaryModal() {
    document.getElementById('customer-financial-summary-modal').style.display = 'flex';
    loadCustomerFinancialSummary();
}

function toggleCustomerSummaryMaximize() {
    const modal = document.getElementById('customer-financial-summary-modal');
    const modalContent = modal.querySelector('div[style*="background: var(--card-bg)"]');
    const maximizeIcon = document.getElementById('cust_sum_maximize_icon');
    const restoreIcon = document.getElementById('cust_sum_restore_icon');

    isCustomerSummaryMaximized = !isCustomerSummaryMaximized;

    if (isCustomerSummaryMaximized) {
        // Maximize
        modalContent.style.width = '98%';
        modalContent.style.maxWidth = '98%';
        modalContent.style.height = '95vh';
        modalContent.style.maxHeight = '95vh';
        modalContent.style.borderRadius = '4px';
        maximizeIcon.style.display = 'none';
        restoreIcon.style.display = 'block';
    } else {
        // Restore
        modalContent.style.width = '95%';
        modalContent.style.maxWidth = '1400px';
        modalContent.style.height = 'auto';
        modalContent.style.maxHeight = '90vh';
        modalContent.style.borderRadius = '8px';
        maximizeIcon.style.display = 'block';
        restoreIcon.style.display = 'none';
    }
}

function closeCustomerFinancialSummaryModal() {
    // Reset maximize state when closing
    if (isCustomerSummaryMaximized) {
        toggleCustomerSummaryMaximize();
    }
    document.getElementById('customer-financial-summary-modal').style.display = 'none';
}

function applyCustomerSummaryFilters() {
    loadCustomerFinancialSummary();
}

function loadCustomerFinancialSummary() {
    const startDate = document.getElementById('cust_sum_start_date')?.value || '';
    const endDate = document.getElementById('cust_sum_end_date')?.value || '';
    const searchCustomer = document.getElementById('cust_sum_search')?.value || '';
    const balanceFilter = document.getElementById('cust_sum_balance')?.value || 'All';
    const provinceFilter = document.getElementById('cust_sum_province')?.value || 'All';
    const agencyFilter = document.getElementById('cust_sum_agency')?.value || 'All';

    let queryUrl = `/api/reports/customer-financial-summary?start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}&search_customer=${encodeURIComponent(searchCustomer)}&balance=${encodeURIComponent(balanceFilter)}&province=${encodeURIComponent(provinceFilter)}&agency=${encodeURIComponent(agencyFilter)}`;

    fetch(queryUrl)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            const customers = data.customers || [];
            customerSummaryData = customers;
            custSumCurrentPage = 1;
            renderCustomerFinancialSummary();
        })
        .catch(err => {
            console.error('[ERROR] Error loading customer financial summary:', err);
            document.getElementById('customer-financial-summary-rows').innerHTML = `
                <tr>
                    <td colspan="11">
                        <div class="error-state" role="alert">
                            <svg class="error-icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                            <p class="error-text"><%= t('admin.error_loading') %></p>
                            <p class="empty-state-sub">${esc(err.message)}</p>
                            <button type="button" class="btn-secondary" onclick="loadCustomerFinancialSummary()"><%= t('worker.try_again') %></button>
                        </div>
                    </td>
                </tr>
            `;
        });
}

function renderCustomerFinancialSummary() {
    const rowsContainer = document.getElementById('customer-financial-summary-rows');
    const totalsContainer = document.getElementById('customer-financial-summary-totals');
    let html = '';

    if (!customerSummaryData || customerSummaryData.length === 0) {
        html = `
            <tr>
                <td colspan="11">
                    <div class="empty-state">
                        <svg class="empty-state-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        <p class="empty-state-text"><%= t('remittance_ledger.customer_summary_no_customers') %></p>
                    </div>
                </td>
            </tr>
        `;
        totalsContainer.innerHTML = '';
        totalsContainer.style.display = 'none';
        document.getElementById('customer-summary-pagination').style.display = 'none';
    } else {
        // Calculate totals from ALL filtered data
        const totals = {
            total_cement_purchase_value: 0,
            total_money_transferred: 0,
            company_owes_customer: 0,
            customer_owes_company: 0,
            total_transfers: 0,
            bank_transfers: 0,
            sarafi_transfers: 0
        };

        customerSummaryData.forEach(customer => {
            totals.total_cement_purchase_value += customer.total_cement_purchase_value || 0;
            totals.total_money_transferred += customer.total_money_transferred || 0;
            totals.company_owes_customer += customer.company_owes_customer || 0;
            totals.customer_owes_company += customer.customer_owes_company || 0;
            totals.total_transfers += customer.total_transfers || 0;
            totals.bank_transfers += customer.bank_transfers || 0;
            totals.sarafi_transfers += customer.sarafi_transfers || 0;
        });

        // Pagination
        const totalPages = Math.ceil(customerSummaryData.length / custSumRowsPerPage) || 1;
        const startIndex = (custSumCurrentPage - 1) * custSumRowsPerPage;
        const endIndex = Math.min(startIndex + custSumRowsPerPage, customerSummaryData.length);
        const paginatedCustomers = customerSummaryData.slice(startIndex, endIndex);

        paginatedCustomers.forEach((customer, index) => {
            html += `
                <tr>
                    <td style="font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace; font-weight: 500;">${esc(customer.customer_customer_id || '-')}</td>
                    <td style="font-weight: 500; color: var(--text-main);">
                        <span class="customer-link" onclick="openCustomerModal('${esc(customer.customer_id)}')">${esc(customer.customer_name || '-')}</span>
                    </td>
                    <td class="col-amount">${esc((customer.total_cement_purchase_value || 0).toLocaleString())}</td>
                    <td class="col-amount">${esc((customer.total_money_transferred || 0).toLocaleString())}</td>
                    <td class="col-amount" style="color: ${esc(customer.company_owes_customer > 0 ? 'var(--success-green)' : 'var(--text-muted)')}">${esc((customer.company_owes_customer || 0).toLocaleString())}</td>
                    <td class="col-amount" style="color: ${esc(customer.customer_owes_company > 0 ? 'var(--danger-red)' : 'var(--text-muted)')}">${esc((customer.customer_owes_company || 0).toLocaleString())}</td>
                    <td>${esc(customer.total_transfers || 0)}</td>
                    <td>${esc(customer.bank_transfers || 0)}</td>
                    <td>${esc(customer.sarafi_transfers || 0)}</td>
                    <td>${esc(customer.customer_province || '-')}</td>
                    <td>${esc(customer.registered_agency || '-')}</td>
                </tr>
            `;
        });

        // Render totals row
        const totalsHtml = `
            <tr style="background-color: var(--bg-color); font-weight: 600;">
                <td colspan="2" style="text-align: right; padding: 12px;"><%= t('tables.total') %></td>
                <td class="col-amount">${esc(totals.total_cement_purchase_value.toLocaleString())}</td>
                <td class="col-amount">${esc(totals.total_money_transferred.toLocaleString())}</td>
                <td class="col-amount" style="color: var(--success-green);">${esc(totals.company_owes_customer.toLocaleString())}</td>
                <td class="col-amount" style="color: var(--danger-red);">${esc(totals.customer_owes_company.toLocaleString())}</td>
                <td>${esc(totals.total_transfers)}</td>
                <td>${esc(totals.bank_transfers)}</td>
                <td>${esc(totals.sarafi_transfers)}</td>
                <td colspan="2"></td>
            </tr>
        `;
        totalsContainer.innerHTML = totalsHtml;
        totalsContainer.style.display = 'table-footer-group';

        // Update pagination controls
        document.getElementById('cust_sum_page_start').textContent = startIndex + 1;
        document.getElementById('cust_sum_page_end').textContent = endIndex;
        document.getElementById('cust_sum_total_count').textContent = customerSummaryData.length;
        const sumBar = document.getElementById('customer-summary-pagination');
        const sumPageLabel = (sumBar && sumBar.dataset.pageLabel) || '';
        document.getElementById('cust_sum_page_indicator').textContent = `${sumPageLabel} ${custSumCurrentPage}`;
        document.getElementById('cust_sum_btn_prev').disabled = custSumCurrentPage === 1;
        document.getElementById('cust_sum_btn_next').disabled = custSumCurrentPage === totalPages;
        document.getElementById('customer-summary-pagination').style.display = 'flex';
    }

    rowsContainer.innerHTML = html;
}

function handleCustomerSummaryRowsPerPageChange(rowsPerPage) {
    custSumRowsPerPage = parseInt(rowsPerPage);
    custSumCurrentPage = 1;
    renderCustomerFinancialSummary();
}

function goToCustomerSummaryPrevPage() {
    if (custSumCurrentPage > 1) {
        custSumCurrentPage--;
        renderCustomerFinancialSummary();
    }
}

function goToCustomerSummaryNextPage() {
    const totalPages = Math.ceil(customerSummaryData.length / custSumRowsPerPage) || 1;
    if (custSumCurrentPage < totalPages) {
        custSumCurrentPage++;
        renderCustomerFinancialSummary();
    }
}

