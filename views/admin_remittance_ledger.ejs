}

function renderRemittanceTable(records) {
    const rowsContainer = document.getElementById('remittance-ledger-rows');
    let html = '';
    
    if (!records || records.length === 0) {
        html = `
            <tr>
                <td colspan="10">
                    <div class="empty-state">
                        <svg class="empty-state-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                        <p class="empty-state-text"><%= t('worker_agent_remittances.no_remittances') %></p>
                        <p class="empty-state-sub"><%= t('admin.no_records_filter') %></p>
                        <button type="button" class="btn-secondary" onclick="resetRemittanceFilters()"><%= t('remittance_ledger.clear_filters') %></button>
                    </div>
                </td>
            </tr>
        `;
        const totalAmountEl = document.getElementById('rem-total-amount');
        if (totalAmountEl) totalAmountEl.innerHTML = '<span class="summary-value">0</span>';
        // Keep the pager in sync when a filter combination matches nothing.
        renderPaginationControls(1);
    } else {
        const totalPages = Math.ceil(records.length / remRowsPerPage) || 1;
        const startIndex = (remCurrentPage - 1) * remRowsPerPage;
        const endIndex = Math.min(startIndex + remRowsPerPage, records.length);
        const paginatedRecords = records.slice(startIndex, endIndex);
        
        // Calculate total from ALL filtered records, not just paginated ones
        let totalAmount = 0;
        records.forEach((row, index) => {
            totalAmount += (row.amount_received || 0);
        });
        
        paginatedRecords.forEach((row, index) => {
            
            // Escape the raw value first; only the two known sources are replaced
            // with badge markup that we control, so the row template can insert
            // sourceBadge without re-escaping it (escaping it would print the tags).
            let sourceBadge = esc(row.origin_source || '-');
            if (row.origin_source === 'Bank') {
                sourceBadge = `<span class="status-badge bank">Bank</span>`;
            } else if (row.origin_source === 'Sarafi') {
                sourceBadge = `<span class="status-badge sarafi">Sarafi</span>`;
            }
            
            const displayIndex = startIndex + index + 1;
            
            html += `
                <tr>
                    <td class="col-index">${esc(displayIndex)}</td>
                    <td>${esc(row.receipt_date || '-')}</td>
                    <td>
                        <span class="customer-link" onclick="openCustomerModal('${esc(row.customer_id)}')">
                            ${esc(row.customer_name || 'نامشخص')}
                        </span>
                    </td>
                    <td>${esc(row.customer_province || '-')}</td>
                    <td>${esc(row.sender_name || '-')}</td>
                    <td>${sourceBadge}</td>
                    <td style="font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Roboto Mono', monospace; font-weight: 500;">${esc(row.remittance_number || '-')}</td>
                    <td>${esc(row.submitted_by || '-')}</td>
                    <td>${esc(row.agency || '-')}</td>
                    <td class="col-amount">${esc(row.amount_received ? row.amount_received.toLocaleString() : '0')}</td>
                </tr>
            `;
        });
        
        const totalAmountEl = document.getElementById('rem-total-amount');
        if (totalAmountEl) totalAmountEl.innerHTML = '<span class="summary-value">' + totalAmount.toLocaleString() + ' Afs</span>';
        
        renderPaginationControls(totalPages);
    }
    
    rowsContainer.innerHTML = html;
}

function renderPaginationControls(totalPages) {
    const totalRecords = filteredTableData.length;
    const start = totalRecords === 0 ? 0 : (remCurrentPage - 1) * remRowsPerPage + 1;
    const end = Math.min(remCurrentPage * remRowsPerPage, totalRecords);
    const pages = Math.max(totalPages || 1, 1);

    // Labels come from the server-rendered data attributes so the indicator
    // follows the active locale instead of being hardcoded.
    const bar = document.getElementById('rem-pagination-container');
    const pageLabel = (bar && bar.dataset.pageLabel) || '';
    const ofLabel = (bar && bar.dataset.ofLabel) || '';

    if (document.getElementById('lbl_page_start')) document.getElementById('lbl_page_start').textContent = start.toLocaleString();
    if (document.getElementById('lbl_page_end')) document.getElementById('lbl_page_end').textContent = end.toLocaleString();
    if (document.getElementById('lbl_total_count')) document.getElementById('lbl_total_count').textContent = totalRecords.toLocaleString();
    if (document.getElementById('lbl_page_indicator')) document.getElementById('lbl_page_indicator').textContent = `${pageLabel} ${remCurrentPage} ${ofLabel} ${pages}`;

    if (document.getElementById('btn_page_prev')) document.getElementById('btn_page_prev').disabled = (remCurrentPage === 1 || totalRecords === 0);
    if (document.getElementById('btn_page_next')) document.getElementById('btn_page_next').disabled = (remCurrentPage >= pages || totalRecords === 0);
}

function handleRowsPerPageChange(val) {
    remRowsPerPage = parseInt(val) || 10;
    remCurrentPage = 1;
    renderRemittanceTable(filteredTableData);
}

// The ledger is loaded once at the end of this script (the markup above has
// already been parsed at that point), so no second DOMContentLoaded fetch.

function goToPrevPage() {
    if (remCurrentPage > 1) {
        remCurrentPage--;
        renderRemittanceTable(filteredTableData);
    }
}

function goToNextPage() {
    const totalPages = Math.ceil(filteredTableData.length / remRowsPerPage);
    if (remCurrentPage < totalPages) {
        remCurrentPage++;
        renderRemittanceTable(filteredTableData);
    }
}

// openCustomerModal()/closeCustomerModal() intentionally live in
// partials/customer_modal.ejs (included once, after this script) so the page and
// every other view share a single implementation.
loadRemittanceLedger();
</script>

