                <p style="margin: 8px 0 0 0; font-size: 12px; color: var(--text-main);"><%= t("admin_users.security_notice_text") %></p>
            </div>
        </div>
        
        <div style="padding: 15px 20px; border-top: 1px solid var(--border-color); display: flex; gap: 10px; justify-content: flex-end; flex-wrap: wrap;">
            <button type="button" class="btn btn-primary" id="modalGenerateKeyBtn" onclick="generateKeyFromModal()" style="padding: 8px 16px;">
