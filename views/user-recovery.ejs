<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <title><%= t('recovery.user_recovery_title') %></title>
    <link rel="icon" type="image/png" href="/Logo.png">
    <style>
        :root {
            --bg-color: #f6f8fa;
            --card-bg: #ffffff;
            --border-color: #d0d7de;
            --text-main: #24292e;
            --text-muted: #57606a;
            --input-bg: #ffffff;
        }

        [data-theme="dark"] {
            --bg-color: #0d1117;
            --card-bg: #161b22;
            --border-color: #30363d;
            --text-main: #c9d1d9;
            --text-muted: #8b949e;
            --input-bg: #0d1117;
        }

        body { background-color: var(--bg-color); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        .recovery-box { background: var(--card-bg); width: 100%; max-width: 480px; border: 1px solid var(--border-color); border-radius: 12px; padding: 48px 40px; box-shadow: 0 8px 24px rgba(0,0,0,0.08); margin: 20px; }
        .logo { text-align: center; margin-bottom: 32px; }
        .logo img { width: 72px; height: 72px; }
        h1 { text-align: center; margin-bottom: 8px; color: var(--text-main); font-size: 28px; font-weight: 600; }
        .subtitle { text-align: center; color: var(--text-muted); margin-bottom: 32px; font-size: 15px; line-height: 1.5; }
        .divider { height: 1px; background: var(--border-color); margin: 32px 0; }
        .form-group { margin-bottom: 24px; }
        .form-label { display: block; font-size: 14px; font-weight: 600; color: var(--text-main); margin-bottom: 8px; }
        .form-control { width: 100%; padding: 12px 16px; border: 1px solid var(--border-color); border-radius: 8px; box-sizing: border-box; font-size: 15px; transition: border-color 0.2s, box-shadow 0.2s; background: var(--input-bg); color: var(--text-main); }
        .form-control:focus { outline: none; border-color: #0969da; box-shadow: 0 0 0 3px rgba(9, 105, 218, 0.15); }
        .form-control::placeholder { color: var(--text-muted); }
        .btn { width: 100%; background-color: #2ea44f; color: #fff; padding: 14px 20px; font-weight: 600; border: 0; border-radius: 8px; cursor: pointer; font-size: 15px; transition: background-color 0.2s; }
        .btn:hover { background-color: #2c974b; }
        .btn:active { background-color: #298e46; }
        .btn-secondary { background-color: transparent; color: #0969da; padding: 12px 16px; font-weight: 500; margin-top: 16px; }
        .btn-secondary:hover { background-color: var(--bg-color); }
        .back-link { display: block; text-align: center; margin-top: 24px; color: #0969da; text-decoration: none; font-size: 14px; font-weight: 500; }
        .back-link:hover { text-decoration: underline; }
        .message { padding: 12px 16px; border-radius: 8px; margin-bottom: 24px; font-size: 14px; text-align: center; }
        .message.error { background-color: #ffebe9; color: #cf222e; border: 1px solid rgba(255,129,130,0.4); }
        [data-theme="dark"] .message.error { background-color: rgba(218, 35, 35, 0.1); color: #f85149; border-color: rgba(248, 81, 73, 0.3); }
        .message.success { background-color: #dcfce7; color: #059669; border: 1px solid #bbf7d0; }
        [data-theme="dark"] .message.success { background-color: rgba(46, 160, 67, 0.1); color: #3fb950; border-color: rgba(63, 185, 80, 0.3); }
        @media (max-width: 520px) {
            .recovery-box { padding: 32px 24px; margin: 16px; }
            h1 { font-size: 24px; }
        }
    </style>
</head>
<body>
    <!-- Theme Toggle Button -->
    <button id="themeToggle" onclick="toggleTheme()" style="position: fixed; top: 20px; right: 20px; background: none; border: none; cursor: pointer; padding: 8px; border-radius: 6px; transition: background-color 0.2s ease; display: flex; align-items: center; justify-content: center; z-index: 1000;" title="Toggle Theme">
        <span id="themeIcon" style="font-size: 24px;">☀️</span>
    </button>

    <script>
        // Theme toggle functionality
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            
            function updateThemeIcon() {
                const themeIcon = document.getElementById('themeIcon');
                const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                if (themeIcon) {
                    themeIcon.textContent = currentTheme === 'dark' ? '🌙' : '☀️';
                }
            }
            
            window.toggleTheme = function() {
                const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
                const newTheme = currentTheme === 'light' ? 'dark' : 'light';
                document.documentElement.setAttribute('data-theme', newTheme);
                localStorage.setItem('theme', newTheme);
                updateThemeIcon();
            };
            
            updateThemeIcon();
        })();
    </script>

    <div class="recovery-box">
        <div class="logo">
            <img src="/Logo.png" alt="<%= t('auth.logo_alt') %>">
        </div>
        
        <h1><%= t('recovery.user_recovery_title') %></h1>
        <p class="subtitle"><%= t('recovery.user_recovery_subtitle') %></p>
        
        <% if (message) { %>
            <p class="message <%= message.type === 'error' ? 'error' : 'success' %>"><%= message.text %></p>
        <% } %>
        
        <div class="divider"></div>
        
        <form action="/recovery/user/verify-key" method="POST">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <div class="form-group">
                <label class="form-label"><%= t('auth.username_label') %></label>
                <input type="text" name="username" class="form-control" required placeholder="<%= t('auth.username_placeholder') %>" dir="ltr" autocomplete="username">
            </div>
            
            <div class="form-group">
                <label class="form-label"><%= t('recovery.recovery_key_label') %></label>
                <input type="text" name="recoveryKey" class="form-control" required placeholder="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" dir="ltr" style="font-family: 'Courier New', monospace; letter-spacing: 1px;" autocomplete="off">
            </div>
            
            <button type="submit" class="btn"><%= t('recovery.verify_key') %></button>
        </form>
        
        <button type="button" class="btn btn-secondary" onclick="window.location.href='/recovery/user/request'"><%= t('recovery.try_another_way') %></button>
        
        <a href="/recovery" class="back-link"><%= t('recovery.back_to_recovery') %></a>
    </div>
</body>
</html>
