                    </colgroup>
                    <thead>
                        <tr style="background-color: var(--table-header-bg); border-bottom: 2px solid var(--border-color); color: var(--text-main); font-weight: 700;">
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_id') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_name') %></th>
