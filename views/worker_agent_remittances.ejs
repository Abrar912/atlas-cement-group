                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_company_owes') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_customer_owes') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_transfers') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_bank_transfers') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_sarafi_transfers') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_province') %></th>
                            <th style="padding: 7px 8px; white-space: nowrap;"><%= t('remittance_ledger.customer_summary_header_registered_by') %></th>
                        </tr>
                    </thead>
                    <tbody id="customer-financial-summary-rows">
                        <tr>
                            <td colspan="11">
                                <div style="padding: 60px 20px; text-align: center;">
                                    <svg style="width: 40px; height: 40px; stroke: var(--text-muted); stroke-width: 1.5; fill: none; margin-bottom: 16px; animation: spin 1s linear infinite;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 2a10 10 0 0 1 10 10"/></svg>
                                    <p style="font-size: 15px; font-weight: 500; color: var(--text-main); margin: 0;"><%= t('remittance_ledger.customer_summary_loading') %></p>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div id="customer-summary-pagination" class="no-print" style="margin-top: 20px; display: flex; justify-content: space-between; align-items:-center; padding-top: 12px; border-top: 1px solid var(--border-color);">
                <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted);">
                    <span><%= t('worker_agent_remittances.rows_per_page') %></span>
                    <select id="cust_sum_rows_per_page" class="form-control" style="width: 80px;" onchange="handleCustomerSummaryRowsPerPageChange(this.value)">
                        <option value="10" selected>۱۰</option>
                        <option value="50">۵۰</option>
                        <option value="100">۱۰۰</option>
                    </select>
                </div>

                <div style="font-size: 13px; color: var(--text-muted);">
                    <%= t('worker_agent_remittances.showing') %> <span id="cust_sum_page_start">0</span> <%= t('worker_agent_remittances.to') %> <span id="cust_sum_page_end">0</span> <%= t('worker_agent_remittances.of') %> <span id="cust_sum_total_count">0</span> <%= t('worker_agent_remittances.items') %>
                </div>

                <div style="display: flex; gap: 8px;">
                    <button id="cust_sum_btn_prev" onclick="goToCustomerSummaryPrevPage()" class="btn btn-secondary no-print" style="padding: 6px 12px; font-size: 12px;" disabled><%= t('worker_agent_remittances.previous') %></button>
                    <span id="cust_sum_page_indicator" style="font-size: 13px; color: var(--text-main);"><%= t('worker_agent_remittances.page_of_js') %></span>
                    <button id="cust_sum_btn_next" onclick="goToCustomerSummaryNextPage()" class="btn btn-secondary no-print" style="padding: 6px 12px; font-size: 12px;" disabled><%= t('worker_agent_remittances.next') %></button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
@keyframes spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}
</style>

<script>
// Set active sidebar item
document.getElementById('nav-worker-remittances').classList.add('active');

// Bank/Sarafi Name field conditional visibility
function toggleBankSarafiField() {
    const sourceSelect = document.getElementById('rem_filter_source');
    const bankSarafiContainer = document.getElementById('bank_sarafi_name_container');
    const bankSarafiInput = document.getElementById('rem_search_source_name');
    
    if (sourceSelect && bankSarafiContainer) {
        const sourceValue = sourceSelect.value;
        
        if (sourceValue === 'Bank' || sourceValue === 'Sarafi') {
            bankSarafiContainer.style.display = 'block';
        } else {
            bankSarafiContainer.style.display = 'none';
            // Clear the input when hiding
            if (bankSarafiInput) {
                bankSarafiInput.value = '';
            }
        }
    }
}

// Attach event listener to Source dropdown
document.addEventListener('DOMContentLoaded', function() {
    const sourceSelect = document.getElementById('rem_filter_source');
    if (sourceSelect) {
        sourceSelect.addEventListener('change', toggleBankSarafiField);
        // Initialize visibility on page load
        toggleBankSarafiField();
    }
});

// Table Pagination State
let currentTableData = [];
let filteredTableData = [];
let remCurrentPage = 1;
let remRowsPerPage = 10; // Default dynamic rows count

// Load remittance ledger data
function loadRemittanceLedger() {
    console.log('[DEBUG] Loading remittance ledger...');
    
    // Get filter values with defensive reading
    const province = document.getElementById('rem_filter_province')?.value || 'All';
    const customerId = document.getElementById('rem_filter_customer')?.value || 'All';
    const source = document.getElementById('rem_filter_source')?.value || 'All';
    const startDate = document.getElementById('rem_filter_start_date')?.value || '';
    const endDate = document.getElementById('rem_filter_end_date')?.value || '';
    const searchSender = document.getElementById('rem_search_sender')?.value || '';
    const searchSourceName = document.getElementById('rem_search_source_name')?.value || '';
    const searchRemittanceNumber = document.getElementById('rem_search_remittance_number')?.value || '';
    const searchAmount = document.getElementById('rem_search_amount')?.value || '';
    
    // Build query URL with encoding (worker-scoped API)
    let queryUrl = `/api/worker/remittance-ledger?province=${province}&customer_id=${customerId}&source=${source}&start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}&search_sender=${encodeURIComponent(searchSender)}&search_source_name=${encodeURIComponent(searchSourceName)}&search_remittance_number=${encodeURIComponent(searchRemittanceNumber)}&search_amount=${encodeURIComponent(searchAmount)}`;
    
    fetch(queryUrl)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            // Safely extract array regardless of payload structure
            let records = [];
            if (Array.isArray(data)) {
                records = data;
            } else if (data && Array.isArray(data.remittances)) {
                records = data.remittances;
            } else if (data && Array.isArray(data.records)) {
                records = data.records;
            } else if (data && Array.isArray(data.data)) {
                records = data.data;
            } else if (data && data.error) {
                throw new Error(data.error);
            }

            currentTableData = records;
            
            // Apply client-side amount filtering if specified
            if (searchAmount) {
                currentTableData = currentTableData.filter(row => 
                    row.amount_received && row.amount_received.toString().includes(searchAmount.toString().trim())
                );
            }
            
            filteredTableData = [...currentTableData];
            remCurrentPage = 1; // Reset to first page on new data
            renderRemittanceTable(filteredTableData);
        })
        .catch(err => {
            console.error('[ERROR] Error loading remittance ledger:', err);
            currentTableData = [];
            filteredTableData = [];
            const pageData = document.querySelector('[data-no-remittances]');
            document.getElementById('remittance-ledger-rows').innerHTML = `
                <tr>
                    <td colspan="8" style="text-align: center; color:#cf222e; padding:20px;">
                        ${esc(pageData.getAttribute('data-error-loading'))}: ${esc(err.message)}
                    </td>
                </tr>
            `;
        });
}

// Apply remittance filters
function applyRemittanceFilters() {
    console.log('[DEBUG] Applying remittance filters...');
    loadRemittanceLedger();
}

// Reset all remittance filters
function resetRemittanceFilters() {
    // Reset dropdowns
    document.getElementById('rem_filter_province').value = 'All';
    document.getElementById('rem_filter_customer').value = 'All';
    document.getElementById('rem_filter_source').value = 'All';
    
    // Reset date inputs
    document.getElementById('rem_filter_start_date').value = '';
    document.getElementById('rem_filter_end_date').value = '';
    
    // Clear search inputs
    document.getElementById('rem_search_sender').value = '';
    document.getElementById('rem_search_source_name').value = '';
    document.getElementById('rem_search_remittance_number').value = '';
    document.getElementById('rem_search_amount').value = '';
    
    // Apply filters
    applyRemittanceFilters();
}

// Render remittance table with pagination
function renderRemittanceTable(records) {
    const rowsContainer = document.getElementById('remittance-ledger-rows');
    let html = '';
    
    if (!records || records.length === 0) {
        const pageData = document.querySelector('[data-no-remittances]');
        html = `
            <tr>
                <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 30px 20px; background-color: var(--bg-color);">
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;">
                        <span style="font-size: 32px;">🔍</span>
                        <p style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0;">
                            ${esc(pageData.getAttribute('data-no-remittances'))}
                        </p>
                        <p style="font-size: 12px; color: var(--text-muted); margin: 0;">
                            ${esc(pageData.getAttribute('data-no-remittances-sub'))}
                        </p>
                    </div>
                </td>
            </tr>
        `;
        
        // Reset footer total
        const totalAmountEl = document.getElementById('rem-total-amount');
        if (totalAmountEl) totalAmountEl.textContent = '0';
        
        // Clear pagination
        const paginationContainer = document.getElementById('rem-pagination-container');
        if (paginationContainer) {
            paginationContainer.innerHTML = '';
        }
    } else {
        // Calculate pagination
        const totalPages = Math.ceil(records.length / remRowsPerPage) || 1;
        const startIndex = (remCurrentPage - 1) * remRowsPerPage;
        const endIndex = Math.min(startIndex + remRowsPerPage, records.length);
        const paginatedRecords = records.slice(startIndex, endIndex);
        
        let totalAmount = 0;
        
        paginatedRecords.forEach((row, index) => {
            totalAmount += (row.amount_received || 0);
            
            // Source badge styling
            let sourceBadge;
            if (row.origin_source === 'Bank') {
                sourceBadge = `<span class="role-tag" style="background-color:#e1ecf4; color:#0969da; font-weight:700;">Bank</span>`;
            } else if (row.origin_source === 'Sarafi') {
                sourceBadge = `<span class="role-tag" style="background-color:#fff8c5; color:#9a6700; font-weight:700;">Sarafi</span>`;
            } else {
                sourceBadge = row.origin_source || '-';
            }
            
            const displayIndex = startIndex + index + 1;
            
            html += `
                <tr style="border-bottom: 1px solid #eaeef2;">
                    <td class="table-row-number">${esc(displayIndex)}</td>
                    <td style="padding: 8px; text-align: center;">${esc(row.receipt_date || '-')}</td>
                    <td style="padding: 8px; text-align: right; font-weight: 600;">
                        <span style="color: var(--accent-blue); cursor: pointer; text-decoration: none;"
                              onclick="openCustomerModal('${esc(row.customer_id)}')"
                              onmouseover="this.style.textDecoration='underline'"
                              onmouseout="this.style.textDecoration='none'">
                            ${esc(row.customer_name || 'Unknown')}
                        </span>
                    </td>
                    <td style="padding: 8px; text-align: right;">${esc(row.sender_name || '-')}</td>
                    <td style="padding: 8px; text-align: center;">${esc(sourceBadge)}</td>
                    <td style="padding: 8px; text-align: center; font-family: monospace;">${esc(row.remittance_number || '-')}</td>
                    <td style="padding: 8px; text-align: center;">${esc(row.submitted_by || '-')}</td>
                    <td style="padding: 8px; text-align: center; font-weight: 700; color: #1a7f37;">${esc(row.amount_received ? row.amount_received.toLocaleString() : '0')} Afs</td>
                </tr>
            `;
        });
        
        // Update footer total
        const totalAmountEl = document.getElementById('rem-total-amount');
        if (totalAmountEl) totalAmountEl.textContent = totalAmount.toLocaleString() + ' Afs';
        
        // Render pagination controls
        renderPaginationControls(totalPages);
    }
    
    rowsContainer.innerHTML = html;
}

// Render pagination controls
function renderPaginationControls(totalPages) {
    const totalRecords = filteredTableData.length;
    const start = totalRecords === 0 ? 0 : (remCurrentPage - 1) * remRowsPerPage + 1;
    const end = Math.min(remCurrentPage * remRowsPerPage, totalRecords);

    if (document.getElementById('lbl_page_start')) document.getElementById('lbl_page_start').textContent = start.toLocaleString();
    if (document.getElementById('lbl_page_end')) document.getElementById('lbl_page_end').textContent = end.toLocaleString();
    if (document.getElementById('lbl_total_count')) document.getElementById('lbl_total_count').textContent = totalRecords.toLocaleString();
    const pageData = document.querySelector('[data-no-remittances]');
    const pageOfTemplate = pageData.getAttribute('data-page-of');
    if (document.getElementById('lbl_page_indicator')) document.getElementById('lbl_page_indicator').textContent = pageOfTemplate.replace('{current}', remCurrentPage).replace('{total}', totalPages);

    if (document.getElementById('btn_page_prev')) document.getElementById('btn_page_prev').disabled = (remCurrentPage === 1 || totalRecords === 0);
    if (document.getElementById('btn_page_next')) document.getElementById('btn_page_next').disabled = (remCurrentPage >= totalPages || totalRecords === 0);
}

// Handle Rows Per Page Selection Change
function handleRowsPerPageChange(val) {
    remRowsPerPage = parseInt(val) || 10;
    remCurrentPage = 1; // Reset to first page when limit changes
    renderRemittanceTable(filteredTableData);
}

// Go to previous page
function goToPrevPage() {
    if (remCurrentPage > 1) {
        remCurrentPage--;
        renderRemittanceTable(filteredTableData);
    }
}

// Go to next page
function goToNextPage() {
    const totalPages = Math.ceil(filteredTableData.length / remRowsPerPage);
    if (remCurrentPage < totalPages) {
        remCurrentPage++;
        renderRemittanceTable(filteredTableData);
    }
}


// Customer Details Modal Functions
function openCustomerModal(customerId) {
    const modal = document.getElementById('customerDetailsModal');
    const loadingDiv = document.getElementById('modal_loading');
    const bodyDiv = document.getElementById('modal_body');
    
    if (!modal) return;
    
    modal.style.display = 'flex';
    if (loadingDiv) loadingDiv.style.display = 'block';
    if (bodyDiv) bodyDiv.style.display = 'none';
    
    fetch(`/api/reports/customer-details?customer_id=${customerId}`)
        .then(res => res.json())
        .then(data => {
            if (data.error) {
                if (loadingDiv) loadingDiv.innerHTML = `<div style="color: #cf222e; padding:20px;">Error: ${esc(data.error)}</div>`;
                return;
            }
            
            const customer = data.customer || {};
            const creator = data.creator || {};
            const financial = data.financial || { total_debit: 0, total_credit: 0 };
            
            // Populate fields using correct partials/customer_modal.ejs IDs
            if (document.getElementById('modal_customer_name')) document.getElementById('modal_customer_name').textContent = customer.name || 'N/A';
            if (document.getElementById('modal_cust_id')) document.getElementById('modal_cust_id').textContent = customer.customer_id || ('#CUST-' + customer.id);
            if (document.getElementById('modal_cust_type')) document.getElementById('modal_cust_type').textContent = customer.customer_type || 'Not specified';
            if (document.getElementById('modal_contact_position')) document.getElementById('modal_contact_position').textContent = customer.contact_person_position || 'Not specified';
            if (document.getElementById('modal_province')) document.getElementById('modal_province').textContent = customer.province || 'N/A';
            if (document.getElementById('modal_agency')) document.getElementById('modal_agency').textContent = customer.created_by_agency || customer.agency || 'Unknown';
            if (document.getElementById('modal_creator')) document.getElementById('modal_creator').textContent = creator.username || 'Not linked';
            if (document.getElementById('modal_phone')) document.getElementById('modal_phone').textContent = customer.phone || 'Not provided';
            if (document.getElementById('modal_alt_phone')) document.getElementById('modal_alt_phone').textContent = customer.alternative_phone || 'Not provided';
            if (document.getElementById('modal_email')) document.getElementById('modal_email').textContent = customer.email || 'Not provided';
            if (document.getElementById('modal_address')) document.getElementById('modal_address').textContent = customer.address || 'Not provided';
            
            if (document.getElementById('modal_total_debit')) document.getElementById('modal_total_debit').textContent = (financial.total_debit || 0).toLocaleString() + ' Afs';
            if (document.getElementById('modal_total_credit')) document.getElementById('modal_total_credit').textContent = (financial.total_credit || 0).toLocaleString() + ' Afs';
            
            // Format agency badge name
            const agencyValue = customer.created_by_agency || customer.agency || customer.province || 'Unknown';
            let agencyName = agencyValue;
            if (agencyValue.includes('_')) {
                agencyName = agencyValue.split('_').map(p => p.charAt(0).toUpperCase() + p.slice(1)).join(' ');
            } else {
                agencyName = agencyValue.charAt(0).toUpperCase() + agencyValue.slice(1);
                if (agencyName.toLowerCase() !== 'unknown') agencyName += ' Agency';
            }
            if (document.getElementById('modal_agency_badge_name')) document.getElementById('modal_agency_badge_name').textContent = agencyName;
            
            if (loadingDiv) loadingDiv.style.display = 'none';
            if (bodyDiv) bodyDiv.style.display = 'block';
        })
        .catch(err => {
            if (loadingDiv) loadingDiv.innerHTML = `<div style="color: #cf222e; text-align: center; padding: 20px;">Error: ${esc(err.message)}</div>`;
        });
}

function closeCustomerModal() {
    document.getElementById('customerDetailsModal').style.display = 'none';
}

// Close modal when clicking outside
window.onclick = function(event) {
    const modal = document.getElementById('customerDetailsModal');
    if (event.target === modal) {
        closeCustomerModal();
    }
}

// Customer Financial Summary Modal Functions
let customerSummaryData = [];
let customerSummaryTotals = null;
let custSumCurrentPage = 1;
let custSumRowsPerPage = 10;
let isCustomerSummaryMaximized = false;

function openCustomerFinancialSummaryModal() {
    document.getElementById('customer-financial-summary-modal').style.display = 'flex';
    loadCustomerFinancialSummary();
}

function closeCustomerFinancialSummaryModal() {
    document.getElementById('customer-financial-summary-modal').style.display = 'none';
}

function toggleCustomerSummaryMaximize() {
    const modal = document.getElementById('customer-financial-summary-modal');
    const modalContent = modal.querySelector('div[style*="background: var(--card-bg)"]');
    const maximizeIcon = document.getElementById('cust_sum_maximize_icon');
    const restoreIcon = document.getElementById('cust_sum_restore_icon');

    isCustomerSummaryMaximized = !isCustomerSummaryMaximized;

    if (isCustomerSummaryMaximized) {
        modalContent.style.width = '98%';
        modalContent.style.maxWidth = '98%';
        modalContent.style.height = '95vh';
        modalContent.style.maxHeight = '95vh';
        modalContent.style.borderRadius = '4px';
        maximizeIcon.style.display = 'none';
        restoreIcon.style.display = 'block';
    } else {
        modalContent.style.width = '95%';
        modalContent.style.maxWidth = '1400px';
        modalContent.style.height = 'auto';
        modalContent.style.maxHeight = '90vh';
        modalContent.style.borderRadius = '8px';
        maximizeIcon.style.display = 'block';
        restoreIcon.style.display = 'none';
    }
}

function loadCustomerFinancialSummary() {
    const startDate = document.getElementById('cust_sum_start_date')?.value || '';
    const endDate = document.getElementById('cust_sum_end_date')?.value || '';
    const searchCustomer = document.getElementById('cust_sum_search')?.value || '';
    const balanceStatus = document.getElementById('cust_sum_balance')?.value || 'All';
    const province = document.getElementById('cust_sum_province')?.value || 'All';

    let queryUrl = `/api/worker/customer-financial-summary?start_date=${encodeURIComponent(startDate)}&end_date=${encodeURIComponent(endDate)}&search_customer=${encodeURIComponent(searchCustomer)}&balance_status=${balanceStatus}&province=${province}`;
    
    fetch(queryUrl)
        .then(res => {
            if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
            return res.json();
        })
        .then(data => {
            customerSummaryData = data.records || [];
            customerSummaryTotals = data.totals || null;
            custSumCurrentPage = 1;
            renderCustomerFinancialSummaryTable();
        })
        .catch(err => {
            console.error('[ERROR] Error loading customer financial summary:', err);
            document.getElementById('customer-financial-summary-rows').innerHTML = `
                <tr>
                    <td colspan="11">
                        <div style="padding: 60px 20px; text-align: center; color: #dc2626;">
                            <p style="font-size: 15px; font-weight: 500; margin: 0;">خطا در بارگذاری اطلاعات: ${esc(err.message)}</p>
                        </div>
                    </td>
                </tr>
            `;
        });
}

function applyCustomerSummaryFilters() {
    loadCustomerFinancialSummary();
}

function renderCustomerFinancialSummaryTable() {
    const tbody = document.getElementById('customer-financial-summary-rows');
    const startIndex = (custSumCurrentPage - 1) * custSumRowsPerPage;
    const endIndex = startIndex + custSumRowsPerPage;
    const paginatedData = customerSummaryData.slice(startIndex, endIndex);

    if (paginatedData.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="11" style="text-align: center; padding: 40px; color: var(--text-muted);">
                    <%= t('worker_agent_remittances.no_remittances') %>
                </td>
            </tr>
        `;
        document.getElementById('cust_sum_page_start').textContent = '0';
        document.getElementById('cust_sum_page_end').textContent = '0';
        document.getElementById('cust_sum_total_count').textContent = '0';
        document.getElementById('cust_sum_btn_prev').disabled = true;
        document.getElementById('cust_sum_btn_next').disabled = true;
        return;
    }

    let html = '';
    paginatedData.forEach(row => {
        html += `
            <tr>
                <td>${esc(row.customer_id || ('#CUST-' + row.id))}</td>
                <td>${esc(row.name || '-')}</td>
                <td style="font-family: monospace; font-weight: 600;">${esc(row.total_debit ? row.total_debit.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; font-weight: 600;">${esc(row.total_credit ? row.total_credit.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; font-weight: 600; color: ${esc(row.balance > 0 ? '#059669' : '#000')};">${esc(row.balance > 0 ? row.balance.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; font-weight: 600; color: ${esc(row.balance < 0 ? '#dc2626' : '#000')};">${esc(row.balance < 0 ? Math.abs(row.balance).toLocaleString() : '0')}</td>
                <td>${esc(row.transfer_count || 0)}</td>
                <td>${esc(row.bank_count || 0)}</td>
                <td>${esc(row.sarafi_count || 0)}</td>
                <td>${esc(row.province || '-')}</td>
                <td>${esc(row.created_by || '-')}</td>
            </tr>
        `;
    });

    // Add totals row if we have totals data
    if (customerSummaryTotals) {
        html += `
            <tr style="background-color: var(--table-header-bg); border-top: 2px solid var(--border-color); font-weight: 700;">
                <td colspan="2" style="text-align: center; color: var(--text-main);">TOTAL</td>
                <td style="font-family: monospace; color: var(--text-main);">${esc(customerSummaryTotals.total_debit ? customerSummaryTotals.total_debit.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; color: var(--text-main);">${esc(customerSummaryTotals.total_credit ? customerSummaryTotals.total_credit.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; color: #059669;">${esc(customerSummaryTotals.company_owes_customer ? customerSummaryTotals.company_owes_customer.toLocaleString() : '0')}</td>
                <td style="font-family: monospace; color: #dc2626;">${esc(customerSummaryTotals.customer_owes_company ? customerSummaryTotals.customer_owes_company.toLocaleString() : '0')}</td>
                <td style="color: var(--text-main);">${esc(customerSummaryTotals.total_transfers || 0)}</td>
                <td style="color: var(--text-main);">${esc(customerSummaryTotals.bank_transfers || 0)}</td>
                <td style="color: var(--text-main);">${esc(customerSummaryTotals.sarafi_transfers || 0)}</td>
                <td colspan="2"></td>
            </tr>
        `;
    }

    tbody.innerHTML = html;

    // Update pagination info
    const totalPages = Math.ceil(customerSummaryData.length / custSumRowsPerPage);
    document.getElementById('cust_sum_page_start').textContent = startIndex + 1;
    document.getElementById('cust_sum_page_end').textContent = Math.min(endIndex, customerSummaryData.length);
    document.getElementById('cust_sum_total_count').textContent = customerSummaryData.length;
    
    // Fix pagination text by replacing placeholders
    const pageOfTemplate = '<%= t("worker_agent_remittances.page_of_js") %>';
    document.getElementById('cust_sum_page_indicator').textContent = pageOfTemplate.replace('{current}', custSumCurrentPage).replace('{total}', totalPages);

    // Update pagination buttons
    document.getElementById('cust_sum_btn_prev').disabled = custSumCurrentPage === 1;
    document.getElementById('cust_sum_btn_next').disabled = endIndex >= customerSummaryData.length;
}

function handleCustomerSummaryRowsPerPageChange(value) {
    custSumRowsPerPage = parseInt(value);
    custSumCurrentPage = 1;
    renderCustomerFinancialSummaryTable();
}

function goToCustomerSummaryPrevPage() {
    if (custSumCurrentPage > 1) {
        custSumCurrentPage--;
        renderCustomerFinancialSummaryTable();
    }
}

function goToCustomerSummaryNextPage() {
    const maxPage = Math.ceil(customerSummaryData.length / custSumRowsPerPage);
    if (custSumCurrentPage < maxPage) {
        custSumCurrentPage++;
        renderCustomerFinancialSummaryTable();
    }
}

function printCustomerFinancialSummary() {
    window.print();
}

// Load remittance ledger on page load
loadRemittanceLedger();

// Viewport-aware datepicker positioning for end date input
function repositionRemittanceDatepicker() {
    setTimeout(() => {
        const popup = document.getElementById('custom-jalali-datepicker');
        const endDateInput = document.getElementById('rem_filter_end_date');
        if (popup && endDateInput) {
            const inputRect = endDateInput.getBoundingClientRect();
            const viewportWidth = window.innerWidth;
            const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
            
            popup.style.setProperty('position', 'fixed', 'important');
            popup.style.setProperty('top', `${inputRect.bottom + 4}px`, 'important');
            
            // Position from right edge to avoid scrollbar overlap
            const rightPos = viewportWidth - inputRect.right - scrollbarWidth - 15;
            popup.style.setProperty('left', 'auto', 'important');
            popup.style.setProperty('right', `${rightPos}px`, 'important');
        }
    }, 30);
}

// Attach positioning handlers
setTimeout(() => {
    const endDateInput = document.getElementById('rem_filter_end_date');
    if (endDateInput) {
        endDateInput.addEventListener('focus', repositionRemittanceDatepicker);
        endDateInput.addEventListener('click', repositionRemittanceDatepicker);
    }
}, 100);
</script>

