<%- include('partials/header') %>

<style>
    /* Page-specific styles - filter-row now handled globally in header.ejs */
    .role-tag {
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        display: inline-block;
    }

    /* Table row number styling - theme-aware */
    .table-row-number {
        padding: 8px;
        text-align: center;
        font-weight: 600;
        background-color: var(--table-header-bg);
        color: var(--text-muted);
    }

    @media print {
        .sidebar, .top-navbar, .filter-row, .no-print, select, input, button {
            display: none !important;
        }
        .main-viewport { flex: 1; overflow: visible; }
        body { background: #ffffff !important; color: #000000 !important; }
        .card { border: 1px solid #000 !important; box-shadow: none !important; background: #ffffff !important; }
        .table-responsive { overflow: visible !important; }
        table { width: 100% !important; border: 1px solid #000 !important; background: #ffffff !important; color: #000000 !important; }
        thead { background: #ffffff !important; color: #000000 !important; }
        tbody { background: #ffffff !important; color: #000000 !important; }
        tfoot { background: #ffffff !important; color: #000000 !important; }
        th { background: #f5f5f5 !important; color: #000000 !important; border: 1px solid #000 !important; }
        td { background: #ffffff !important; color: #000000 !important; border: 1px solid #000 !important; }
        .page-header-print { display: none !important; }
    }
</style>

<div class="page-header-print" style="border-bottom: 2px solid var(--border-color); padding-bottom: 10px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;" data-no-remittances="<%= t('worker_agent_remittances.no_remittances') %>" data-no-remittances-sub="<%= t('worker_agent_remittances.no_remittances_sub') %>" data-error-loading="<%= t('worker_agent_remittances.error_loading') %>" data-page-of="<%= t('worker_agent_remittances.page_of_js') %>">
    <div>
        <h2><%= t('worker_agent_remittances.title') %></h2>
        <p style="font-size: 14px; color: var(--text-muted);"><%= t('worker_agent_remittances.description') %></p>
    </div>
    <div style="display: flex; gap: 10px;">
        <button onclick="openCustomerFinancialSummaryModal()" class="btn btn-primary no-print" style="background-color: #2563eb;">
            <%= t('remittance_ledger.customer_summary_title') %>
        </button>
        <button onclick="window.print()" class="btn btn-primary no-print" style="background-color: #24292f;">
            <%= t('worker_agent_remittances.export_ledger') %>
        </button>
    </div>
</div>

<!-- Filter Bar - 3 Dropdown Controls (Agent/Zone removed for workers) -->
<div class="no-print" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px;">
    <div>
        <label style="font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-main);"><%= t('worker_agent_remittances.province') %></label>
        <select id="rem_filter_province" class="form-control" onchange="applyRemittanceFilters()">
            <option value="All"><%= t('worker_agent_remittances.all_provinces') %></option>
            <option value="Kabul">کابل (Kabul)</option>
            <option value="Herat">هرات (Herat)</option>
            <option value="Balkh">بلخ (Balkh)</option>
            <option value="Kandahar">قندهار (Kandahar)</option>
            <option value="Nangarhar">ننگرهار (Nangarhar)</option>
            <option value="Khost">خوست (Khost)</option>
            <option value="Paktia">پکتیا (Paktia)</option>
            <option value="Paktika">پکتیکا (Paktika)</option>
            <option value="Ghazni">غزنی (Ghazni)</option>
            <option value="Logar">لوگر (Logar)</option>
            <option value="Laghman">لغمان (Laghman)</option>
            <option value="Wardak"> میدان وردک (Wardak)</option>
            <option value="Parwan">پروان (Parwan)</option>
            <option value="Kapisa">کاپیسا (Kapisa)</option>
            <option value="Panjshir">پنجشیر (Panjshir)</option>
            <option value="Kunar">کونر (Kunar)</option>
            <option value="Nuristan">نورستان (Nuristan)</option>
            <option value="Badakhshan">بدخشان (Badakhshan)</option>
            <option value="Takhar">تخار (Takhar)</option>
            <option value="Baghlan">بغلان (Baghlan)</option>
            <option value="Kunduz">قندوز (Kunduz)</option>
            <option value="Samangan">سمنگان (Samangan)</option>
            <option value="Jowzjan">جوزجان (Jowzjan)</option>
            <option value="Sar-e Pol">سرپل (Sar-e Pol)</option>
            <option value="Faryab">فاریاب (Faryab)</option>
            <option value="Badghis">بادغیس (Badghis)</option>
            <option value="Ghor">غور (Ghor)</option>
            <option value="Bamyan">بامیان (Bamyan)</option>
            <option value="Daikundi">دایکندی (Daikundi)</option>
            <option value="Farah">فراه (Farah)</option>
            <option value="Nimruz">نیمروز (Nimruz)</option>
            <option value="Helmand">هلمند (Helmand)</option>
            <option value="Zabul">زابل (Zabul)</option>
            <option value="Uruzgan">ارزگان (Uruzgan)</option>
        </select>
    </div>
    <div>
        <label style="font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-main);"><%= t('worker_agent_remittances.customer') %></label>
        <select id="rem_filter_customer" class="form-control" onchange="applyRemittanceFilters()">
            <option value="All"><%= t('worker_agent_remittances.all_accounts') %></option>
            <% if (typeof customers !== 'undefined' && customers.length > 0) { %>
                <% customers.forEach(function(customer) { %>
                    <% 
                        // Clean up display label to prevent duplicating customer name
                        let displayLabel = customer.customer_id || ('#CUST-' + customer.id);
                        const cleanName = (customer.name || '').trim();
                        
                        // Only append customer.name if it isn't already included in customer_id
                        if (cleanName && !displayLabel.includes(cleanName)) {
                            displayLabel += ' - ' + cleanName;
                        }
                        if (customer.province) {
                            displayLabel += ' (' + customer.province + ')';
                        }
                    %>
                    <option value="<%= customer.id %>" data-province="<%= customer.province %>">
                        <%= displayLabel %>
                    </option>
                <% }); %>
            <% } %>
        </select>
    </div>
    <div style="display: flex; gap: 16px; align-items: flex-start; grid-column: span 2;">
        <div style="flex: 1;">
            <label style="font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-main);"><%= t('worker_agent_remittances.source') %></label>
            <select id="rem_filter_source" class="form-control" onchange="applyRemittanceFilters()">
                <option value="All"><%= t('worker_agent_remittances.all_sources') %></option>
                <option value="Bank"><%= t('worker_agent_remittances.bank') %></option>
                <option value="Sarafi"><%= t('worker_agent_remittances.sarafi') %></option>
            </select>
        </div>
        <div id="bank_sarafi_name_container" style="flex: 1; display: none;">
            <label style="font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-main); display: block;"><%= t('worker_agent_remittances.bank_sarafi_name') %></label>
            <input type="text" id="rem_search_source_name" class="form-control" placeholder="<%= t('worker_agent_remittances.search_bank_placeholder') %>" oninput="applyRemittanceFilters()">
        </div>
    </div>
    <div>
        <label style="font-size: 13px; font-weight: 600; margin-bottom: 6px; color: var(--text-main);"><%= t('worker_agent_remittances.time_range') %></label>
        <div style="display: flex; gap: 5px; align-items: center;">
            <input type="text" id="rem_filter_start_date" class="form-control" data-datepicker="jalali" placeholder="<%= t('worker_agent_remittances.from_date_placeholder') %>" onchange="applyRemittanceFilters()" readonly>
            <span style="font-size: 12px; color:#57606a;"><%= t('worker_agent_remittances.to') %></span>
            <input type="text" id="rem_filter_end_date" class="form-control" data-datepicker="jalali" placeholder="<%= t('worker_agent_remittances.to_date_placeholder') %>" onchange="applyRemittanceFilters()" readonly>
        </div>
    </div>
</div>

<!-- Quick Search Toolbar - 3 Search Controls (Customer search and Bank/Sarafi Name removed for workers) -->
<div class="no-print" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; padding: 15px; background-color: var(--bg-color); border-radius: 6px; border: 1px solid var(--border-color);">
    <div>
        <label style="font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--text-muted);"><%= t('worker_agent_remittances.sender_name') %></label>
        <input type="text" id="rem_search_sender" class="form-control" placeholder="<%= t('worker_agent_remittances.search_sender_placeholder') %>" oninput="applyRemittanceFilters()">
    </div>
    <div>
        <label style="font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--text-muted);"><%= t('worker_agent_remittances.remittance_number') %></label>
        <input type="text" id="rem_search_remittance_number" class="form-control" placeholder="<%= t('worker_agent_remittances.search_remittance_placeholder') %>" oninput="applyRemittanceFilters()">
    </div>
    <div>
        <label style="font-size: 12px; font-weight: 600; margin-bottom: 4px; color: var(--text-muted);"><%= t('worker_agent_remittances.amount') %></label>
        <input type="number" id="rem_search_amount" class="form-control" placeholder="<%= t('worker_agent_remittances.search_amount_placeholder') %>" oninput="applyRemittanceFilters()">
    </div>
</div>

<!-- Reset Filters Button -->
<div class="no-print" style="margin-bottom: 20px;">
    <button onclick="resetRemittanceFilters()" class="btn btn-secondary" style="background-color:#6e7781; color: white; width: 100%; padding: 10px;"><%= t('worker_agent_remittances.reset_filters') %></button>
</div>

<!-- Remittance Data Table -->
<div class="table-responsive" style="overflow-x: auto;">
    <table style="font-size: 12px; white-space: nowrap; table-layout: fixed; width: 100%; border-collapse: collapse;">
        <colgroup>
            <col style="width: 50px;" />
            <col style="width: 90px;" />
            <col style="width: 130px;" />
            <col style="width: 120px;" />
            <col style="width: 100px;" />
            <col style="width: 110px;" />
            <col style="width: 110px;" />
            <col style="width: 130px;" />
        </colgroup>
        <thead style="background-color: var(--table-header-bg); border-bottom: 2px solid var(--border-color); color: var(--text-main); font-weight: 700;">
            <tr>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_hash') %></th>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_date') %></th>
                <th style="padding: 8px; text-align: right;"><%= t('worker_agent_remittances.th_customer') %></th>
                <th style="padding: 8px; text-align: right;"><%= t('worker_agent_remittances.th_sender') %></th>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_source') %></th>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_ref') %></th>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_agent') %></th>
                <th style="padding: 8px; text-align: center;"><%= t('worker_agent_remittances.th_amount') %></th>
            </tr>
        </thead>
        <tbody id="remittance-ledger-rows">
            <tr>
                <td colspan="8" style="text-align: center; color:#57606a; padding: 20px;"><%= t('worker_agent_remittances.loading') %></td>
            </tr>
        </tbody>
        <tfoot id="remittance-ledger-footer" style="background-color: var(--bg-color); font-weight: 700; border-top: 2px solid var(--border-color);">
            <tr>
                <td colspan="7" style="padding: 8px; text-align: center; color: var(--text-main);"><%= t('worker_agent_remittances.total_remitted') %></td>
                <td id="rem-total-amount" style="padding: 8px; text-align: center; color: var(--success-color); font-weight: 800;">0</td>
            </tr>
        </tfoot>
    </table>
</div>

<!-- Standardized Pagination Footer with Rows Per Page Dropdown -->
<div id="rem-pagination-container" class="no-print" style="display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding-top: 12px; border-top: 1px solid var(--border-color); flex-wrap: wrap; gap: 10px; direction: rtl; text-align: right;">
    
    <!-- Rows Per Page Selector -->
    <div style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted);">
        <span><%= t('worker_agent_remittances.rows_per_page') %></span>
        <select id="select_worker_rem_rows_per_page" class="form-control" style="width: 80px; padding: 4px 8px; font-size: 13px; font-weight: bold; border: 1px solid var(--border-color); border-radius: 6px;" onchange="handleRowsPerPageChange(this.value)">
            <option value="10" selected>۱۰</option>
            <option value="25">۲۵</option>
            <option value="50">۵۰</option>
            <option value="100">۱۰۰</option>
        </select>
    </div>

    <!-- Summary Count Indicator -->
    <div style="font-size: 13px; color: var(--text-muted);">
        <%= t('worker_agent_remittances.showing') %> <span id="lbl_page_start">0</span> <%= t('worker_agent_remittances.to') %> <span id="lbl_page_end">0</span> <%= t('worker_agent_remittances.of') %> <span id="lbl_total_count">0</span> <%= t('worker_agent_remittances.entries') %>
    </div>

    <!-- Page Buttons Navigation -->
    <div style="display: flex; gap: 8px; align-items: center;">
        <button id="btn_page_prev" onclick="goToPrevPage()" class="btn btn-secondary" style="padding: 5px 12px; font-size: 12px;" disabled><%= t('worker_agent_remittances.previous') %></button>
        <span id="lbl_page_indicator" style="font-size: 13px; font-weight: bold; color: #0284c7;">Page 1</span>
        <button id="btn_page_next" onclick="goToNextPage()" class="btn btn-secondary" style="padding: 5px 12px; font-size: 12px;" disabled><%= t('worker_agent_remittances.next') %></button>
    </div>
</div>

<!-- Customer Details Modal -->
<%- include('partials/customer_modal') %>

<!-- Customer Financial Summary Modal -->
<div id="customer-financial-summary-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 1000; align-items: center; justify-content: center;">
    <div id="customer-financial-summary-modal-content" style="background: var(--card-bg); border-radius: 8px; width: 95%; max-width: 1400px; max-height: 90vh; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);" class="rtl-content">
        <div style="padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 18px; font-weight: 600; color: var(--text-main);"><%= t('remittance_ledger.customer_summary_title') %></h3>
            <div style="display: flex; gap: 10px;">
                <button onclick="printCustomerFinancialSummary()" class="btn btn-primary no-print" style="padding: 8px 16px; font-size: 14px; background-color: #2563eb;">
                    <svg style="width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="12" x="6" y="10" rx="2"/></svg>
                    <%= t('remittance_ledger.print') %>
                </button>
                <button onclick="toggleCustomerSummaryMaximize()" id="cust_sum_maximize_btn" class="btn no-print" style="background: var(--table-header-bg); color: var(--text-main); padding: 8px 12px; border: 1px solid var(--border-color); border-radius: 6px; font-weight: 500; cursor: pointer;" title="<%= t('admin.full_screen') %>">
                    <svg id="cust_sum_maximize_icon" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none;" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/></svg>
                    <svg id="cust_sum_restore_icon" style="width: 14px; height: 14px; stroke: currentColor; stroke-width: 2; fill: none; display: none;" viewBox="0 0 24 24"><path d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3m0 18v-3a2 2 0 0 1 2-2h3M3 16h3a2 2 0 0 1 2 2v3"/></svg>
                </button>
                <button onclick="closeCustomerFinancialSummaryModal()" class="btn no-print" style="background: #dc2626; color: #fff; padding: 8px 16px; border: none; border-radius: 6px; font-weight: 500; cursor: pointer;">
                    <%= t('admin.close') %>
                </button>
            </div>
        </div>

        <div style="padding: 20px;">
            <!-- Filters -->
            <div class="no-print" style="background: var(--bg-color); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; margin-bottom: 20px;">
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; align-items: flex-end;">
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 600; color: var(--text-muted);"><%= t('remittance_ledger.from_date') %></label>
                        <input type="text" id="cust_sum_start_date" class="form-control" data-datepicker="jalali" placeholder="<%= t('remittance_ledger.from_date_example') %>" onchange="applyCustomerSummaryFilters()" readonly>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 600; color: var(--text-muted);"><%= t('remittance_ledger.to_date') %></label>
                        <input type="text" id="cust_sum_end_date" class="form-control" data-datepicker="jalali" placeholder="<%= t('remittance_ledger.to_date_example') %>" onchange="applyCustomerSummaryFilters()" readonly>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 600; color: var(--text-muted);"><%= t('remittance_ledger.search_customer') %></label>
                        <input type="text" id="cust_sum_search" class="form-control" placeholder="<%= t('remittance_ledger.search_customer_placeholder') %>" oninput="applyCustomerSummaryFilters()">
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 600; color: var(--text-muted);"><%= t('remittance_ledger.account_status') %></label>
                        <select id="cust_sum_balance" class="form-control" onchange="applyCustomerSummaryFilters()">
                            <option value="All"><%= t('remittance_ledger.all_statuses') %></option>
                            <option value="customer_owes"><%= t('remittance_ledger.status_customer_owes') %></option>
                            <option value="company_owes"><%= t('remittance_ledger.status_company_owes') %></option>
                            <option value="zero"><%= t('remittance_ledger.status_zero') %></option>
                        </select>
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 6px;">
                        <label style="font-size: 13px; font-weight: 600; color: var(--text-muted);"><%= t('remittance_ledger.customer_province') %></label>
