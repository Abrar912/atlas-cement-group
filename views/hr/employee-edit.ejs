            <!-- =============================================
                 EMPLOYEE DOCUMENTS
                 ============================================= -->
            <div class="empedit-section">
                <div class="empedit-section-header">
                    <div class="empedit-section-icon empedit-section-icon--documents">&#128196;</div>
                    <h3 class="empedit-section-title"><%= t('hr.employees.documents') %></h3>
                </div>
                <p class="empedit-field-help" style="margin-bottom: var(--empedit-space-md);"><%= t('hr.employees.doc_hint') %></p>

                <div class="empedit-doc-grid">
                    <% var catKeys = ['tazkira_passport','cv','degrees_certificates','other']; %>
                    <% var catLabels = [t('hr.employees.doc_tazkira_passport'), t('hr.employees.doc_cv'), t('hr.employees.doc_degrees_certificates'), t('hr.employees.doc_other')]; %>
                    <% var catIds = ['tazkira','cv','degrees','other']; %>
                    <% var catTypeIds = [4, 7, 2, 3]; %>
                    <% for (var ci = 0; ci < catKeys.length; ci++) { %>
                    <% var cat = docCategories[catKeys[ci]]; %>
                    <div class="empedit-doc-card <%= (cat && cat.file_path) ? 'empedit-doc-card--uploaded' : cat ? 'empedit-doc-card--no-file' : 'empedit-doc-card--empty' %>">
                        <div class="empedit-doc-label">
                            <span class="empedit-doc-status <%= (cat && cat.file_path) ? 'empedit-doc-status--ok' : cat ? 'empedit-doc-status--warn' : 'empedit-doc-status--empty' %>"></span>
                            <%= catLabels[ci] %>
                        </div>
                        <% if (cat && cat.file_path) { %>
                            <div class="empedit-doc-filename"><%= cat.original_filename || 'document.pdf' %></div>
                            <div class="empedit-doc-actions">
                                <a href="/admin/hr/employees/<%= employee.id %>/documents/<%= cat.id %>/view" target="_blank" class="empedit-btn empedit-btn--view empedit-btn--small"><%= t('hr.employees.doc_view') %></a>
                                <form method="POST" action="/admin/hr/employees/<%= employee.id %>/documents/<%= cat.id %>/replace" enctype="multipart/form-data" style="display:inline;">
                                    <input type="file" name="file" accept=".pdf" style="display:none;" id="replace_<%= catIds[ci] %>" onchange="if(this.files[0]&&this.files[0].size>10*1024*1024){alert('<%= t("hr.employees.doc_too_large") %>');this.value='';}else if(this.files[0]&&!this.files[0].name.toLowerCase().endsWith('.pdf')){alert('<%= t("hr.employees.doc_invalid_type") %>');this.value='';}else{this.form.submit();}">
                                    <button type="button" onclick="document.getElementById('replace_<%= catIds[ci] %>').click();" class="empedit-btn empedit-btn--secondary empedit-btn--small"><%= t('hr.employees.doc_replace') %></button>
                                </form>
                                <form method="POST" action="/admin/hr/employees/<%= employee.id %>/documents/<%= cat.id %>/remove" style="display:inline;" onsubmit="return confirm('<%= t('hr.employees.doc_remove_confirm') %>');">
                                    <button type="submit" class="empedit-btn empedit-btn--danger empedit-btn--small"><%= t('hr.employees.doc_remove') %></button>
                                </form>
                            </div>
                        <% } else if (cat) { %>
                            <div class="empedit-doc-filename"><%= t('hr.employees.doc_no_file') %></div>
                            <div class="empedit-field-help"><%= t('hr.employees.document_number') %>: <%= cat.document_number || '-' %></div>
                            <div class="empedit-doc-actions">
                                <form method="POST" action="/admin/hr/employees/<%= employee.id %>/documents/<%= cat.id %>/replace" enctype="multipart/form-data" style="display:inline;">
                                    <input type="file" name="file" accept=".pdf,application/pdf" style="display:none;" id="attach_<%= catIds[ci] %>_<%= employee.id %>" onchange="if(this.files[0]&&this.files[0].size>10*1024*1024){alert('<%= t("hr.employees.doc_too_large") %>');this.value='';}else if(this.files[0]&&!this.files[0].name.toLowerCase().endsWith('.pdf')){alert('<%= t("hr.employees.doc_invalid_type") %>');this.value='';}else{this.form.submit();}">
                                    <button type="button" onclick="document.getElementById('attach_<%= catIds[ci] %>_<%= employee.id %>').click();" class="empedit-btn empedit-btn--accent empedit-btn--small"><%= t('hr.employees.doc_add') %></button>
                                </form>
                            </div>
                        <% } else { %>
                            <div class="empedit-doc-filename"><%= t('hr.employees.doc_none') %></div>
                            <div class="empedit-doc-actions">
                                <form method="POST" action="/admin/hr/employees/<%= employee.id %>/documents" enctype="multipart/form-data" style="display:inline;">
                                    <input type="hidden" name="employee_id" value="<%= employee.id %>">
                                    <input type="hidden" name="document_type_id" value="<%= catTypeIds[ci] %>">
                                    <input type="file" name="file" accept=".pdf,application/pdf" style="display:none;" id="add_<%= catIds[ci] %>_<%= employee.id %>" onchange="if(this.files[0]&&this.files[0].size>10*1024*1024){alert('<%= t('hr.employees.doc_too_large') %>');this.value='';}else if(this.files[0]&&!this.files[0].name.toLowerCase().endsWith('.pdf')){alert('<%= t('hr.employees.doc_invalid_type') %>');this.value='';}else{this.form.submit();}">
                                    <button type="button" onclick="document.getElementById('add_<%= catIds[ci] %>_<%= employee.id %>').click();" class="empedit-btn empedit-btn--accent empedit-btn--small"><%= t('hr.employees.doc_add') %></button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </div>

    </div>
</div>

