                        <select name="departure_reason" class="form-control" id="departure_reason">
                            <option value=""><%= t('forms.select') %></option>
                            <option value="Resigned" <%= employee.departure_reason === 'Resigned' ? 'selected' : '' %>><%= t('hr.employees.resigned') %></option>
                            <option value="Terminated" <%= employee.departure_reason === 'Terminated' ? 'selected' : '' %>><%= t('hr.employees.terminated') %></option>
