                        <label for="emergency_contact_relationship"><%= t('hr.employees.emergency_contact_relationship') %></label>
                        <input type="text" name="emergency_contact_relationship" class="form-control" value="<%= employee.emergency_contact_relationship || '' %>" dir="rtl" id="emergency_contact_relationship">
                    </div>
