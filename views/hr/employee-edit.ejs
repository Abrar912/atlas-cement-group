                            <option value="Retirement" <%= employee.departure_reason === 'Retirement' ? 'selected' : '' %>><%= t('hr.employees.retirement') %></option>
                            <option value="Other" <%= employee.departure_reason === 'Other' ? 'selected' : '' %>><%= t('hr.employees.other') %></option>
