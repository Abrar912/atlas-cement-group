<script>
function previewEmployeePhoto(input) {
    if (input.files && input.files[0]) {
        var file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
            alert('File too large. Maximum size is 5MB.');
            input.value = '';
            return;
        }
        var reader = new FileReader();
        reader.onload = function(e) {
            var heroImg = document.getElementById('heroPhotoImg');
            var heroIcon = document.getElementById('heroPhotoIcon');
            if (heroImg) { heroImg.src = e.target.result; heroImg.style.display = 'block'; }
            if (heroIcon) { heroIcon.style.display = 'none'; }
            var previewImg = document.getElementById('photoPreviewImg');
            var previewIcon = document.getElementById('photoPreviewIcon');
            if (previewImg) { previewImg.src = e.target.result; previewImg.style.display = 'block'; }
            if (previewIcon) { previewIcon.style.display = 'none'; }
        };
        reader.readAsDataURL(file);
    }
}

function validateJalaliDate(dateStr) {
    if (!dateStr) return { valid: true };
    const regex = /^\d{4}\/\d{2}\/\d{2}$/;
    if (!regex.test(dateStr)) {
        return { valid: false, error: 'فرمت نامعتبر. استفاده از فرمت سال/ماه/روز (مثلاً ۱۳۸۵/۰۳/۲۵)' };
    }
    const parts = dateStr.split('/');
    const year = parseInt(parts[0], 10);
    const month = parseInt(parts[1], 10);
    const day = parseInt(parts[2], 10);
    if (month < 1 || month > 12) {
        return { valid: false, error: 'ماه باید بین ۰۱ تا ۱۲ باشد' };
    }
    const daysInMonth = [31, 31, 31, 31, 31, 31, 30, 30, 30, 30, 30, 30];
    const isLeapYear = (year * 31) % 128 < 31;
    const maxDays = (month === 12) ? (isLeapYear ? 30 : 29) : daysInMonth[month - 1];
    if (day < 1 || day > maxDays) {
        return { valid: false, error: 'روز نامعتبر برای این ماه. حداکثر ' + maxDays + ' روز' };
    }
    return { valid: true };
}

document.addEventListener('DOMContentLoaded', function() {
    const form = document.querySelector('form[action="/admin/hr/employees/<%= employee.id %>/edit"]');
    if (form) {
        form.addEventListener('submit', function(e) {
            const dateOfBirth = document.getElementById('date_of_birth').value;
            const hireDate = document.getElementById('hire_date').value;
            const employmentEndDate = document.getElementById('employment_end_date').value;

            if (hireDate) {
                const validation = validateJalaliDate(hireDate);
                if (!validation.valid) {
                    e.preventDefault();
                    alert('خطا در تاریخ استخدام: ' + validation.error);
                    document.getElementById('hire_date').focus();
                    return;
                }
            }

            if (dateOfBirth) {
                const validation = validateJalaliDate(dateOfBirth);
                if (!validation.valid) {
                    e.preventDefault();
                    alert('خطا در تاریخ تولد: ' + validation.error);
                    document.getElementById('date_of_birth').focus();
                    return;
                }
            }

            if (employmentEndDate) {
                const validation = validateJalaliDate(employmentEndDate);
                if (!validation.valid) {
                    e.preventDefault();
                    alert('خطا در تاریخ پایان استخدام: ' + validation.error);
                    document.getElementById('employment_end_date').focus();
                    return;
                }
            }
        });
    }
});
</script>
