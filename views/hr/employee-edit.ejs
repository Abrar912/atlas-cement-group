                    <div class="empedit-field">
                        <label for="employment_end_date"><%= t('hr.employees.employment_end_date') %></label>
                        <input type="text" id="employment_end_date" name="employment_end_date" class="form-control" value="<%= employee.employment_end_date || '' %>" data-datepicker="jalali" data-datepicker-allow-manual="true" placeholder="YYYY/MM/DD" dir="ltr">
                        <small class="empedit-field-help">فرمت: سال/ماه/روز (مثلاً ۱۴۰۳/۰۱/۰۱) - کلیک برای تقویم یا تایپ دستی</small>
