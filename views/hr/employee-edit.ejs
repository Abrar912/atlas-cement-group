<%- include('../partials/header') %>

<style>
/* ============================================
   EMPLOYEE EDIT — PAGE-SCOPED DESIGN SYSTEM
   ============================================ */

/* --- Spacing Tokens --- */
:root {
    --empedit-space-xs: 4px;
    --empedit-space-sm: 8px;
    --empedit-space-md: 16px;
    --empedit-space-lg: 24px;
    --empedit-space-xl: 32px;
    --empedit-radius-sm: 6px;
    --empedit-radius-md: 10px;
    --empedit-radius-lg: 14px;
    --empedit-radius-full: 9999px;
    --empedit-shadow-sm: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
    --empedit-shadow-md: 0 4px 12px rgba(0,0,0,0.08), 0 2px 4px rgba(0,0,0,0.04);
    --empedit-shadow-lg: 0 8px 24px rgba(0,0,0,0.1), 0 4px 8px rgba(0,0,0,0.05);
    --empedit-transition: 0.2s ease;
}

/* --- Page Container --- */
.empedit-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 8px;
}

/* --- Employee Hero --- */
.empedit-hero {
    display: flex;
    align-items: center;
    gap: var(--empedit-space-lg);
    padding: var(--empedit-space-lg) var(--empedit-space-xl);
    border-radius: var(--empedit-radius-lg);
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    box-shadow: var(--empedit-shadow-md);
    margin-bottom: var(--empedit-space-lg);
    flex-wrap: wrap;
}

.empedit-hero-photo {
    width: 110px;
    height: 110px;
    border-radius: var(--empedit-radius-full);
    background: linear-gradient(135deg, var(--primary), var(--primary-dark, #E65100));
    border: 3px solid rgba(255,255,255,0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: var(--empedit-shadow-md);
    transition: transform var(--empedit-transition), box-shadow var(--empedit-transition);
}

.empedit-hero-photo:hover {
    transform: scale(1.03);
    box-shadow: var(--empedit-shadow-lg);
}

.empedit-hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.empedit-hero-info {
    flex: 1;
    min-width: 200px;
}

.empedit-hero-name {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0 0 4px 0;
    line-height: 1.3;
}

.empedit-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 6px;
}

.empedit-hero-meta span {
    font-size: 13px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 4px;
}

.empedit-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--empedit-radius-full);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
}

.empedit-badge--active {
    background: rgba(5,150,105,0.12);
    color: var(--status-success);
}

.empedit-badge--leave {
    background: rgba(245,158,11,0.12);
    color: var(--status-warning, #d97706);
}

.empedit-badge--former {
    background: rgba(207,34,46,0.1);
    color: var(--status-error);
}

.empedit-hero-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-end;
}

.empedit-hero-actions .empedit-photo-hint {
    font-size: 11px;
    color: var(--text-muted);
    text-align: right;
}

/* --- Section Card --- */
.empedit-section {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: var(--empedit-radius-lg);
    padding: var(--empedit-space-lg);
    margin-bottom: var(--empedit-space-md);
    box-shadow: var(--empedit-shadow-sm);
    transition: box-shadow var(--empedit-transition);
}

.empedit-section:hover {
    box-shadow: var(--empedit-shadow-md);
}

.empedit-section-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--empedit-space-md);
    padding-bottom: var(--empedit-space-sm);
    border-bottom: 2px solid var(--border-color);
}

.empedit-section-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--empedit-radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
}

.empedit-section-icon--personal { background: rgba(59,130,246,0.1); }
.empedit-section-icon--employment { background: rgba(16,185,129,0.1); }
.empedit-section-icon--emergency { background: rgba(245,158,11,0.1); }
.empedit-section-icon--documents { background: rgba(139,92,246,0.1); }
.empedit-section-icon--departure { background: rgba(239,68,68,0.1); }

.empedit-section-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
}

/* --- Form Grid --- */
.empedit-form-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--empedit-space-md);
}

.empedit-form-grid .empedit-full-width {
    grid-column: 1 / -1;
}

/* --- Form Fields --- */
.empedit-field {
    display: flex;
    flex-direction: column;
}

.empedit-field label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 5px;
}

.empedit-field .form-control {
    transition: border-color var(--empedit-transition), box-shadow var(--empedit-transition);
    border-radius: var(--empedit-radius-sm);
}

.empedit-field .form-control:focus {
    border-color: var(--accent-blue);
    box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
}

.empedit-field-help {
    font-size: 11px;
    color: var(--text-muted);
    margin-top: 4px;
}

/* --- Departure Section Variant --- */
.empedit-section--departure {
    background: rgba(239,68,68,0.04);
    border-color: rgba(239,68,68,0.18);
}

.empedit-section--departure .empedit-section-header {
    border-bottom-color: rgba(239,68,68,0.18);
}

.empedit-section--departure .empedit-section-title {
    color: var(--status-error);
}

/* --- Document Cards --- */
.empedit-doc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--empedit-space-md);
}

.empedit-doc-card {
    border-radius: var(--empedit-radius-md);
    padding: var(--empedit-space-md);
    border: 1px solid var(--border-color);
    transition: border-color var(--empedit-transition), box-shadow var(--empedit-transition), background var(--empedit-transition);
}

.empedit-doc-card:hover {
    box-shadow: var(--empedit-shadow-sm);
}

.empedit-doc-card--uploaded {
    background: rgba(5,150,105,0.04);
    border-color: rgba(5,150,105,0.22);
}

.empedit-doc-card--uploaded:hover {
    border-color: rgba(5,150,105,0.4);
}

.empedit-doc-card--no-file {
    background: rgba(245,158,11,0.04);
    border-color: rgba(245,158,11,0.22);
}

.empedit-doc-card--no-file:hover {
    border-color: rgba(245,158,11,0.4);
}

.empedit-doc-card--empty {
    background: var(--card-bg);
    border-style: dashed;
    border-color: var(--border-color);
}

.empedit-doc-card--empty:hover {
    border-color: var(--accent-blue);
    background: rgba(59,130,246,0.02);
}

.empedit-doc-label {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: var(--empedit-space-sm);
    display: flex;
    align-items: center;
    gap: 8px;
}

.empedit-doc-status {
    font-size: 11px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
}

.empedit-doc-status--ok { background: var(--status-success); }
.empedit-doc-status--warn { background: var(--status-warning, #d97706); }
.empedit-doc-status--empty { background: var(--text-muted); opacity: 0.5; }

.empedit-doc-filename {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: var(--empedit-space-sm);
    word-break: break-all;
}

.empedit-doc-actions {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    align-items: center;
}

/* --- Buttons --- */
.empedit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--empedit-radius-sm);
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    transition: background var(--empedit-transition), border-color var(--empedit-transition), color var(--empedit-transition), box-shadow var(--empedit-transition), transform 0.1s ease;
    white-space: nowrap;
    line-height: 1.3;
}

.empedit-btn:active {
    transform: scale(0.97);
}

.empedit-btn--primary {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
}

.empedit-btn--primary:hover {
    background: var(--primary-dark, #E65100);
    box-shadow: var(--empedit-shadow-sm);
}

.empedit-btn--view {
    background: var(--accent-blue);
    color: #fff;
}

.empedit-btn--view:hover {
    background: #2563eb;
    box-shadow: var(--empedit-shadow-sm);
}

.empedit-btn--secondary {
    background: var(--bg-color);
    border-color: var(--border-color);
    color: var(--text-main);
}

.empedit-btn--secondary:hover {
    background: var(--border-color);
}

.empedit-btn--danger {
    background: rgba(239,68,68,0.08);
    border-color: rgba(239,68,68,0.25);
    color: var(--status-error);
}

.empedit-btn--danger:hover {
    background: rgba(239,68,68,0.15);
    border-color: rgba(239,68,68,0.4);
}

.empedit-btn--accent {
    background: var(--primary);
    color: #fff;
}

.empedit-btn--accent:hover {
    background: var(--primary-dark, #E65100);
    box-shadow: var(--empedit-shadow-sm);
}

.empedit-btn--small {
    padding: 5px 10px;
    font-size: 11px;
}

/* --- Action Bar --- */
.empedit-actions {
    display: flex;
    gap: var(--empedit-space-sm);
    flex-wrap: wrap;
    align-items: center;
    padding: var(--empedit-space-md) 0 var(--empedit-space-xl);
}

.empedit-actions .empedit-btn--primary {
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 700;
    border-radius: var(--empedit-radius-md);
}

/* --- Photo Upload Area --- */
.empedit-photo-area {
    display: flex;
    align-items: center;
    gap: var(--empedit-space-md);
}

.empedit-photo-circle {
    width: 110px;
    height: 110px;
    border-radius: var(--empedit-radius-full);
    background: linear-gradient(135deg, var(--primary), var(--primary-dark, #E65100));
    border: 3px solid rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: var(--empedit-shadow-sm);
}

.empedit-photo-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

/* --- Responsive --- */
@media (max-width: 768px) {
    .empedit-hero {
        flex-direction: column;
        text-align: center;
        padding: var(--empedit-space-md);
    }

    .empedit-hero-actions {
        align-items: center;
    }

    .empedit-hero-meta {
        justify-content: center;
    }

    .empedit-hero-name {
        font-size: 20px;
    }

    .empedit-form-grid {
        grid-template-columns: 1fr;
    }

    .empedit-photo-area {
        flex-direction: column;
        align-items: flex-start;
    }

    .empedit-photo-circle {
        width: 90px;
        height: 90px;
        font-size: 30px;
    }

    .empedit-doc-grid {
        grid-template-columns: 1fr;
    }

    .empedit-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .empedit-actions .empedit-btn {
        justify-content: center;
    }

    .empedit-actions .empedit-btn--primary {
        order: -1;
    }
}

@media (max-width: 480px) {
    .empedit-hero {
        padding: var(--empedit-space-sm) var(--empedit-space-md);
    }

    .empedit-section {
        padding: var(--empedit-space-md);
    }

    .empedit-hero-name {
        font-size: 18px;
    }
}
</style>

<div class="empedit-page">
    <div class="card" style="padding: 0; border: none; background: transparent; box-shadow: none;">
        <form method="POST" action="/admin/hr/employees/<%= employee.id %>/edit" enctype="multipart/form-data">

            <!-- =============================================
                 EMPLOYEE HERO
                 ============================================= -->
            <div class="empedit-hero">
                <div class="empedit-hero-photo">
                    <% if (employee.photo_path) { %>
                        <img id="heroPhotoImg" src="/<%= employee.photo_path %>" alt="">
                        <span id="heroPhotoIcon" style="display:none;"><%= employee.full_name.charAt(0).toUpperCase() %></span>
                    <% } else { %>
                        <span id="heroPhotoIcon"><%= employee.full_name.charAt(0).toUpperCase() %></span>
                        <img id="heroPhotoImg" src="" alt="" style="display:none;">
                    <% } %>
                </div>

                <div class="empedit-hero-info">
                    <h2 class="empedit-hero-name"><%= employee.full_name %></h2>
                    <div class="empedit-hero-meta">
                        <span dir="ltr"><%= employee.employee_id || '' %></span>
                        <% if (employee.position) { %>
                            <span>|</span>
                            <span><%= employee.position %></span>
                        <% } %>
                        <% if (employee.employment_status) { %>
                            <span>|</span>
                            <span class="empedit-badge empedit-badge--<%= employee.employment_status === 'Active' ? 'active' : employee.employment_status === 'On Leave' ? 'leave' : 'former' %>">
                                <%= employee.employment_status === 'Active' ? t('hr.employees.active') : employee.employment_status === 'On Leave' ? t('hr.employees.on_leave') : t('hr.employees.former') %>
                            </span>
                        <% } %>
                    </div>
                </div>

                <div class="empedit-hero-actions">
                    <input type="file" name="employee_photo" id="employeePhotoInput" accept="image/jpeg,image/png,image/webp" style="display:none;" onchange="previewEmployeePhoto(this)">
                    <button type="button" onclick="document.getElementById('employeePhotoInput').click();" class="empedit-btn empedit-btn--secondary">
                        <%= t('hr.employees.change_photo') %>
                    </button>
                    <div class="empedit-photo-hint"><%= t('hr.employees.photo_hint') %></div>
                </div>
            </div>

            <!-- Hidden photo preview elements (referenced by JS) -->
            <div style="display:none;">
                <div id="photoPreviewContainer">
                    <div id="photoPreviewCircle">
                        <% if (employee.photo_path) { %>
                            <img id="photoPreviewImg" src="/<%= employee.photo_path %>" alt="">
                            <span id="photoPreviewIcon" style="display:none;"><%= employee.full_name.charAt(0).toUpperCase() %></span>
                        <% } else { %>
                            <span id="photoPreviewIcon"><%= employee.full_name.charAt(0).toUpperCase() %></span>
                            <img id="photoPreviewImg" src="" alt="" style="display:none;">
                        <% } %>
                    </div>
                </div>
            </div>

            <!-- =============================================
                 PERSONAL INFORMATION
                 ============================================= -->
            <div class="empedit-section">
                <div class="empedit-section-header">
                    <div class="empedit-section-icon empedit-section-icon--personal">&#128100;</div>
                    <h3 class="empedit-section-title"><%= t('hr.employees.personal_info') %></h3>
                </div>

                <div class="empedit-form-grid">
                    <div class="empedit-field">
                        <label for="employee_id"><%= t('hr.employees.employee_id') %></label>
                        <input type="text" name="employee_id" class="form-control" value="<%= employee.employee_id || '' %>" readonly dir="ltr" id="employee_id">
                    </div>

                    <div class="empedit-field">
                        <label for="full_name"><%= t('hr.employees.full_name') %> *</label>
                        <input type="text" name="full_name" class="form-control" value="<%= employee.full_name %>" required dir="rtl" id="full_name">
                    </div>

                    <div class="empedit-field">
                        <label for="father_name"><%= t('hr.employees.father_name') %></label>
                        <input type="text" name="father_name" class="form-control" value="<%= employee.father_name || '' %>" dir="rtl" id="father_name">
                    </div>

                    <div class="empedit-field">
                        <label for="gender"><%= t('hr.employees.gender') %></label>
                        <select name="gender" class="form-control" id="gender">
                            <option value=""><%= t('forms.select') %></option>
                            <option value="Male" <%= employee.gender === 'Male' ? 'selected' : '' %>><%= t('hr.employees.male') %></option>
                            <option value="Female" <%= employee.gender === 'Female' ? 'selected' : '' %>><%= t('hr.employees.female') %></option>
                        </select>
                    </div>

                    <div class="empedit-field">
                        <label for="date_of_birth"><%= t('hr.employees.date_of_birth') %></label>
                        <input type="text" id="date_of_birth" name="date_of_birth" class="form-control" value="<%= employee.date_of_birth || '' %>" data-datepicker="jalali" data-datepicker-allow-manual="true" placeholder="YYYY/MM/DD" dir="ltr">
                        <small class="empedit-field-help">فرمت: سال/ماه/روز (مثلاً ۱۳۷۵/۰۵/۲۰) - کلیک برای تقویم یا تایپ دستی</small>
                    </div>

                    <div class="empedit-field">
                        <label for="phone"><%= t('hr.employees.phone') %> *</label>
                        <input type="tel" name="phone" class="form-control" value="<%= employee.phone %>" required dir="ltr" id="phone">
                    </div>

                    <div class="empedit-field empedit-full-width">
                        <label for="address"><%= t('hr.employees.address') %></label>
                        <textarea name="address" class="form-control" rows="2" dir="rtl" id="address"><%= employee.address || '' %></textarea>
                    </div>
                </div>
            </div>

            <!-- =============================================
                 EMPLOYMENT INFORMATION
                 ============================================= -->
            <div class="empedit-section">
                <div class="empedit-section-header">
                    <div class="empedit-section-icon empedit-section-icon--employment">&#128188;</div>
                    <h3 class="empedit-section-title"><%= t('hr.employees.employment_info') %></h3>
                </div>

                <div class="empedit-form-grid">
                    <div class="empedit-field">
                        <label for="position"><%= t('hr.employees.position') %> *</label>
                        <input type="text" name="position" class="form-control" value="<%= employee.position %>" required dir="rtl" id="position">
                    </div>

                    <div class="empedit-field">
                        <label for="department_id"><%= t('hr.employees.department') %></label>
                        <select name="department_id" class="form-control" id="department_id">
                            <option value=""><%= t('hr.employees.select_department') %></option>
                            <% if (departments && departments.length > 0) { %>
                                <% departments.forEach(function(dept) { %>
                                    <option value="<%= dept.id %>" <%= employee.department_id === dept.id ? 'selected' : '' %>><%= dept.name %></option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="empedit-field">
                        <label for="hire_date"><%= t('hr.employees.hire_date') %> *</label>
                        <input type="text" id="hire_date" name="hire_date" class="form-control" value="<%= employee.hire_date %>" required data-datepicker="jalali" data-datepicker-allow-manual="true" placeholder="YYYY/MM/DD" dir="ltr">
                        <small class="empedit-field-help">فرمت: سال/ماه/روز (مثلاً ۱۴۰۳/۰۱/۰۱) - کلیک برای تقویم یا تایپ دستی</small>
                    </div>

                    <div class="empedit-field">
                        <label for="employment_status"><%= t('hr.employees.employment_status') %></label>
                        <select name="employment_status" class="form-control" id="employment_status">
                            <option value="Active" <%= employee.employment_status === 'Active' ? 'selected' : '' %>><%= t('hr.employees.active') %></option>
                            <option value="On Leave" <%= employee.employment_status === 'On Leave' ? 'selected' : '' %>><%= t('hr.employees.on_leave') %></option>
                            <option value="Former" <%= employee.employment_status === 'Former' ? 'selected' : '' %>><%= t('hr.employees.former') %></option>
                        </select>
                    </div>

                    <div class="empedit-field">
                        <label for="work_location"><%= t('hr.employees.work_location') %></label>
                        <input type="text" name="work_location" class="form-control" value="<%= employee.work_location || '' %>" dir="rtl" id="work_location">
                    </div>

                    <div class="empedit-field">
                        <label for="contract_type"><%= t('hr.employees.contract_type') %></label>
                        <select name="contract_type" class="form-control" id="contract_type">
                            <option value=""><%= t('forms.select') %></option>
                            <option value="Permanent" <%= employee.contract_type === 'Permanent' ? 'selected' : '' %>><%= t('hr.employees.permanent') %></option>
                            <option value="Temporary" <%= employee.contract_type === 'Temporary' ? 'selected' : '' %>><%= t('hr.employees.temporary') %></option>
                            <option value="Contract" <%= employee.contract_type === 'Contract' ? 'selected' : '' %>><%= t('hr.employees.contract') %></option>
                            <option value="Daily Worker" <%= employee.contract_type === 'Daily Worker' ? 'selected' : '' %>><%= t('hr.employees.daily_worker') %></option>
                        </select>
                    </div>

                    <div class="empedit-field">
                        <label for="payment_method"><%= t('hr.employees.payment_method') %></label>
                        <select name="payment_method" class="form-control" id="payment_method">
                            <option value=""><%= t('forms.select') %></option>
                            <option value="Cash" <%= employee.payment_method === 'Cash' ? 'selected' : '' %>><%= t('hr.employees.cash') %></option>
                            <option value="Bank Transfer" <%= employee.payment_method === 'Bank Transfer' ? 'selected' : '' %>><%= t('hr.employees.bank_transfer') %></option>
