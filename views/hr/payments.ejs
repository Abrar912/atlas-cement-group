<div class="card">
<%
var _payTab = (mode === 'create' || mode === 'edit' || mode === 'detail') ? 'pay' : (mode === 'list' ? 'list' : '');
%>
<nav class="pc-tabbar" aria-label="Payroll">
  <a href="/admin/hr/payroll" class="pc-tab<%= _payTab === '' ? ' pc-tab-active' : '' %>"><%= t('hr.payroll.title') %></a>
  <a href="/admin/hr/payments/create" class="pc-tab<%= _payTab === 'pay' ? ' pc-tab-active' : '' %>"><%= t('hr.payments.page_title_pay') %></a>
  <a href="/admin/hr/payments/history-report" class="pc-tab<%= _payTab === 'history' ? ' pc-tab-active' : '' %>"><%= t('hr.payments.page_title_history') %></a>
</nav>
<% if (mode === 'list') { %>
<style>
.pl-head{display:flex;align-items:flex-start;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--border-color,#d1d5db)}
.pl-head-main{min-width:0}
.pl-title{font-size:22px;font-weight:800;margin:0;letter-spacing:-.3px}
.pl-sub{font-size:13px;color:var(--text-muted,#6b7280);margin:5px 0 0}
.pl-actions{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.pl-create{padding:9px 18px;font-weight:700;box-shadow:0 1px 2px rgba(15,23,42,.08)}
.pl-quiet{color:var(--text-muted,#6b7280)}
.pl-toolbar{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:12px;padding:14px 16px;border:1px solid var(--border-color,#d1d5db);border-radius:14px;background:var(--bg-color,#fafafa);box-shadow:0 1px 2px rgba(15,23,42,.04)}
.pl-field{flex:1;min-width:170px}
.pl-label{display:block;margin-bottom:5px;font-size:11.5px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:var(--text-muted,#6b7280)}
.pl-toolbar-actions{display:flex;gap:8px;align-items:center;padding-bottom:1px}
.pl-chips{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px;padding:10px 14px;border:1px dashed rgba(59,130,246,.45);border-radius:10px;background:rgba(59,130,246,.06);font-size:12px}
.pl-chips-label{font-weight:800}
.pl-chip{display:inline-block;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;padding:3px 8px;border-radius:7px;background:rgba(107,114,128,.12);color:inherit}
.pl-empty{display:flex;flex-direction:column;align-items:center;gap:12px;padding:40px 20px;border:1px dashed var(--border-color,#d1d5db);border-radius:14px;background:var(--bg-color,#fafafa);text-align:center}
.pl-empty-text{margin:0;font-size:14px;font-weight:600;color:var(--text-muted,#6b7280)}
.pl-table-wrap{border:1px solid var(--border-color,#d1d5db);border-radius:14px;background:var(--bg-color,#fafafa);overflow:hidden}
.pl-table{width:100%;border-collapse:collapse;font-size:13.5px}
.pl-table thead th{font-size:10.5px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:var(--text-muted,#6b7280);background:rgba(107,114,128,.07);padding:11px 10px;border-bottom:1px solid var(--border-color,#d1d5db);text-align:start;white-space:nowrap}
.pl-table tbody td{padding:12px 10px;border-bottom:1px solid rgba(107,114,128,.14);vertical-align:middle}
.pl-table tbody tr:last-child td{border-bottom:none}
.pl-table tbody tr:hover td{background:rgba(59,130,246,.05)}
.pl-num{font-variant-numeric:tabular-nums;font-weight:700}
.pl-net{font-weight:800}
.pl-serial{display:inline-block;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11.5px;font-weight:700;padding:3px 8px;border-radius:7px;background:rgba(107,114,128,.1)}
.pl-serial-fallback{background:rgba(107,114,128,.06);color:var(--text-muted,#6b7280)}
.pl-dup{display:block;width:max-content;margin-top:5px;font-size:10.5px;font-weight:800;padding:2px 8px;border-radius:6px;background:rgba(245,158,11,.15);color:#b45309}
.pl-emp{display:block;font-weight:700;font-size:13.5px}
.pl-dept{display:block;font-size:11.5px;color:var(--text-muted,#6b7280);margin-top:2px}
.pl-date{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:12.5px}
.pl-status{display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.4px;white-space:nowrap}
.pl-status::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;opacity:.85}
.pl-status-draft{background:rgba(59,130,246,.13);color:#1d4ed8}
.pl-status-finalized{background:rgba(16,185,129,.15);color:#047857}
.pl-status-corrected{background:rgba(245,158,11,.16);color:#b45309}
.pl-view{display:inline-flex;align-items:center;gap:5px;padding:6px 10px;border:1px solid var(--border-color,#d1d5db);border-radius:9px;background:var(--bg-color,#fafafa);font-size:12.5px;font-weight:700;color:inherit;text-decoration:none}
.pl-view::after{content:"\2192";font-size:12px;opacity:.7}
.pl-view:hover{border-color:rgba(59,130,246,.5);background:rgba(59,130,246,.06)}
.pl-create:focus-visible,.pl-view:focus-visible,.pl-quiet:focus-visible{outline:2px solid rgba(59,130,246,.65);outline-offset:2px}
[data-theme="dark"] .pl-head{border-bottom-color:rgba(163,173,188,.2)}
[data-theme="dark"] .pl-title{color:#e6edf3}
[data-theme="dark"] .pl-toolbar,[data-theme="dark"] .pl-table-wrap,[data-theme="dark"] .pl-empty,[data-theme="dark"] .pl-view{box-shadow:0 1px 2px rgba(0,0,0,.35)}
[data-theme="dark"] .pl-create{box-shadow:0 1px 2px rgba(0,0,0,.4)}
[data-theme="dark"] .pl-chips{border-color:rgba(96,165,250,.45);background:rgba(96,165,250,.08)}
[data-theme="dark"] .pl-table thead th{background:rgba(163,173,188,.08);color:#9fb0c3}
[data-theme="dark"] .pl-table tbody td{border-bottom-color:rgba(163,173,188,.14)}
[data-theme="dark"] .pl-table tbody tr:hover td{background:rgba(96,165,250,.08)}
[data-theme="dark"] .pl-status-draft{background:rgba(96,165,250,.16);color:#60a5fa}
[data-theme="dark"] .pl-status-finalized{background:rgba(63,185,80,.16);color:#3fb950}
[data-theme="dark"] .pl-status-corrected{background:rgba(251,191,36,.16);color:#fbbf24}
[data-theme="dark"] .pl-dup{background:rgba(251,191,36,.16);color:#fbbf24}
[dir="rtl"] .pl-view::after{content:"\2190"}
@media (max-width:600px){
.pl-head{flex-direction:column;align-items:stretch}
.pl-actions{width:100%}
.pl-actions .pl-create{flex:1;text-align:center}
.pl-title{font-size:18px}
.pl-field{min-width:140px}
.pl-toolbar-actions{width:100%}
.pl-table thead th,.pl-table tbody td{padding:9px 10px}
}
</style>
    <div class="pl-head">
        <div class="pl-head-main">
            <h2 class="pl-title"><%= t('hr.payments.title') %></h2>
            <p class="pl-sub"><%= t('hr.payments.subtitle') %></p>
        </div>
        <div class="pl-actions">
            <a href="/admin/hr/payments/create" class="btn btn-primary pl-create"><%= t('hr.payments.new_payment') %></a>
            <a href="/admin/hr/payments/history-report" class="btn pl-quiet"><%= t('hr.payment_report.btn_history') %></a>
            <a href="/admin/hr/payroll" class="btn pl-quiet"><%= t('hr.payroll_period.back_to_payroll') %></a>
        </div>
    </div>
    <form method="GET" action="/admin/hr/payments" class="pl-toolbar">
        <div class="pl-field">
            <label class="pl-label"><%= t('hr.correction.filter_employee') %></label>
            <select name="employee_id" class="form-control">
                <option value="">—</option>
                <% (employees || []).forEach(function(e) { %>
                    <option value="<%= e.id %>" <%= filters && String(filters.employee_id) === String(e.id) ? 'selected' : '' %>><%= e.full_name %></option>
                <% }); %>
            </select>
        </div>
        <div class="pl-field">
            <label class="pl-label"><%= t('hr.correction.filter_period') %></label>
            <input type="text" name="period_month" class="form-control" dir="ltr" pattern="\d{4}/\d{2}/01" value="<%= filters && filters.period_month ? filters.period_month : '' %>">
        </div>
        <div class="pl-field">
            <label class="pl-label"><%= t('hr.correction.filter_status') %></label>
            <select name="status" class="form-control">
                <option value="">—</option>
                <option value="DRAFT" <%= filters && filters.status === 'DRAFT' ? 'selected' : '' %>><%= t('hr.payments.status_draft') %></option>
                <option value="FINALIZED" <%= filters && filters.status === 'FINALIZED' ? 'selected' : '' %>><%= t('hr.payments.status_finalized') %></option>
                <option value="CORRECTED" <%= filters && filters.status === 'CORRECTED' ? 'selected' : '' %>><%= t('hr.payments.status_corrected') %></option>
            </select>
        </div>
        <div class="pl-toolbar-actions">
            <button type="submit" class="btn btn-secondary"><%= t('hr.correction.filter_apply') %></button>
            <a href="/admin/hr/payments" class="btn btn-secondary"><%= t('hr.correction.filter_clear') %></a>
        </div>
    </form>
    <% if (filters && (filters.employee_id !== undefined || filters.period_month !== undefined || filters.status !== undefined)) { %>
        <div class="pl-chips">
            <span class="pl-chips-label"><%= t('hr.correction.filter_active') %>:</span>
            <% if (filters.employee_id !== undefined) { %>
                <span class="pl-chip"><%= t('hr.correction.filter_employee') %>: <%= (employees || []).filter(function(e) { return String(e.id) === String(filters.employee_id); }).map(function(e) { return e.full_name; }).join('') || ('#' + filters.employee_id) %></span>
            <% } %>
            <% if (filters.period_month !== undefined) { %><span class="pl-chip" dir="ltr"><%= t('hr.correction.filter_period') %>: <%= filters.period_month %></span><% } %>
            <% if (filters.status !== undefined) { %><span class="pl-chip"><%= t('hr.correction.filter_status') %>: <%= t('hr.payments.status_' + (filters.status === 'FINALIZED' ? 'finalized' : filters.status === 'CORRECTED' ? 'corrected' : 'draft')) %></span><% } %>
        </div>
    <% } %>
    <% if (!payments || payments.length === 0) { %>
        <div class="pl-empty">
            <p class="pl-empty-text"><%= t('hr.payments.list_empty') %></p>
            <a href="/admin/hr/payments/create" class="btn btn-primary pl-create"><%= t('hr.payments.new_payment') %></a>
        </div>
    <% } else { %>
        <div class="table-responsive pl-table-wrap">
            <table class="pl-table">
                <thead>
                    <tr>
                        <th scope="col"><%= t('hr.payments.col_serial') %></th>
                        <th scope="col"><%= t('hr.payments.col_employee') %></th>
                        <th scope="col"><%= t('hr.payments.col_period') %></th>
                        <th scope="col"><%= t('hr.payments.col_date') %></th>
                        <th scope="col"><%= t('hr.payments.col_status') %></th>
                        <th scope="col"><%= t('hr.payments.col_earnings') %></th>
                        <th scope="col"><%= t('hr.payments.col_advance') %></th>
                        <th scope="col"><%= t('hr.payments.col_net') %></th>
                        <th scope="col"><%= t('hr.payments.col_actions') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% payments.forEach(function(p) { %>
                        <tr>
                            <td dir="ltr">
                                <% if (p.payment_serial) { %><span class="pl-serial"><%= p.payment_serial %></span>
                                <% } else { %><span class="pl-serial pl-serial-fallback">#<%= p.id %></span><% } %>
                                <% if (p.duplicate_confirmed) { %><span class="pl-dup"><%= t('hr.payments.dup_flag') %></span><% } %>
                            </td>
                            <td>
                                <span class="pl-emp"><%= p.employee_name || '—' %></span>
                                <span class="pl-dept"><%= p.department_name || '' %></span>
                            </td>
                            <td dir="ltr" class="pl-date"><%= p.period_month %></td>
                            <td dir="ltr" class="pl-date"><%= p.payment_date %></td>
                            <td>
                                <span class="pl-status <%= p.status === 'FINALIZED' ? 'pl-status-finalized' : p.status === 'CORRECTED' ? 'pl-status-corrected' : 'pl-status-draft' %>">
                                    <%= t('hr.payments.status_' + (p.status === 'FINALIZED' ? 'finalized' : p.status === 'CORRECTED' ? 'corrected' : 'draft')) %>
                                </span>
                            </td>
                            <td class="pay-num pl-num" dir="ltr"><%= (Number(p.earnings_total) / 100).toFixed(2) %></td>
                            <td class="pay-num pl-num" dir="ltr"><%= (Number(p.advance_deduction_total) / 100).toFixed(2) %></td>
                            <td class="pay-num pl-num pl-net" dir="ltr"><%= (Number(p.net_cash_paid) / 100).toFixed(2) %></td>
                            <td><a href="/admin/hr/payments/<%= p.id %>" class="pl-view"><%= t('hr.payments.view') %></a></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } %>
<% } %>
<% if (mode === 'create' || mode === 'edit') { %>
<% var inc = (typeof includes !== 'undefined' && includes && typeof includes.salary !== 'undefined')
    ? includes : { salary: true, overtime: true, advance: true, controlled: false }; %>
<% if (mode === 'create') { %>
    <div class="pay-head">
        <div>
            <h2 class="pay-page-title"><%= t('hr.payments.page_title_pay') %></h2>
            <p class="pay-page-sub"><%= t('hr.payments.page_desc_pay') %></p>
        </div>
        <div class="pay-head-actions">
            <a href="/admin/hr/payments" class="btn btn-secondary"><%= t('hr.payments.btn_cancel') %></a>
        </div>
    </div>

    <%
    var wInc = (typeof includes !== 'undefined' && includes && typeof includes.salary !== 'undefined')
        ? includes : { salary: true, overtime: true, advance: true, controlled: false };
    var wEng = (typeof engine !== 'undefined' && engine) ? engine : ((typeof preview !== 'undefined' && preview && preview.engine) ? preview.engine : null);
    var wS1 = !!(form.employee_id && typeof preview !== 'undefined' && preview && preview.employee);
    var wOblMissing = (typeof refusal !== 'undefined' && refusal === 'OBLIGATION_NOT_FOUND') ||
        (typeof blockers !== 'undefined' && blockers && blockers.length && blockers.indexOf('OBLIGATION_NOT_FOUND') !== -1) ||
        (wEng && wEng.blockers && wEng.blockers.length && wEng.blockers.indexOf('OBLIGATION_NOT_FOUND') !== -1);
    var wBlocked = !!(wEng && wEng.blockers && wEng.blockers.length);
    var wS2 = !!(wS1 && wEng && !wOblMissing);
    var wS3 = !!(wS2 && (wInc.salary || wInc.overtime || wInc.advance));
    var wDupBlock = (typeof refusal !== 'undefined' && (refusal === 'DUPLICATE_PAYMENT_NOT_CONFIRMED' || refusal === 'DUPLICATE_SUBMIT'));
    var wS4 = !!(wS3 && !wDupBlock);
    var wizDone = 0;
    if (wS1) wizDone = 1;
    if (wS2) wizDone = 2;
    if (wS3) wizDone = 3;
    if (wS4) wizDone = 4;
    var wizPct = wizDone * 20;
    var wizStage = wizDone < 4 ? wizDone + 1 : 4;
    var wizSteps = [
        { n: 1, label: t('hr.payws.wiz_s1'), pct: 20 },
        { n: 2, label: t('hr.payws.wiz_s2'), pct: 40 },
        { n: 3, label: t('hr.payws.wiz_s3'), pct: 60 },
        { n: 4, label: t('hr.payws.wiz_s4'), pct: 80 },
        { n: 5, label: t('hr.payws.wiz_s5'), pct: 100 }
    ];
    %>
    <div class="wiz-prog" id="payWizard" data-max="<%= wizDone %>" data-stage="<%= wizStage %>" data-blocked="<%= wBlocked ? '1' : '0' %>">
        <div class="wiz-prog-top">
            <span class="wiz-prog-title"><%= t('hr.payws.wiz_progress') %></span>
            <span class="wiz-prog-pct" id="wizPct"><%= t('hr.payws.wiz_step') %> <%= wizStage %> <%= t('hr.payws.wiz_of') %> <%= wizSteps.length %> · <%= wizPct %>%</span>
        </div>
        <div class="wiz-track"><div class="wiz-fill" id="wizFill" style="width:<%= wizPct %>%"></div></div>
        <ol class="wiz-steps">
            <% wizSteps.forEach(function(ws) { %>
            <li class="wiz-step<%= ws.n <= wizDone ? ' wiz-step-done' : '' %><%= ws.n === wizStage ? ' wiz-step-current' : '' %><%= (ws.n === wizStage && wBlocked) ? ' wiz-step-blocked' : '' %>" data-step="<%= ws.n %>">
                <span class="wiz-step-no"><%= ws.n %></span>
                <span class="wiz-step-label"><%= ws.label %></span>
                <span class="wiz-step-pct"><%= ws.pct %>%</span>
                <% if (ws.n === wizStage && wBlocked) { %><span class="wiz-step-blocked-tag"><%= t('hr.payws.wiz_blocked') %></span><% } %>
            </li>
            <% }); %>
        </ol>
    </div>

    <% if (wOblMissing) { %>
        <div class="wiz-obl-remedy">
            <div><%= t('hr.payws.wiz_obl_remedy') %></div>
            <div style="margin-top:8px;"><a class="btn btn-primary" href="/admin/hr/payroll/periods/open?month=<%= encodeURIComponent(form.period_month) %>"><%= t('hr.payws.wiz_obl_link') %></a></div>
            <div class="pay-note" style="margin-top:8px;"><%= t('hr.payws.wiz_obl_adv_note') %></div>
        </div>
    <% } %>

    <% if (typeof preview !== 'undefined' && preview && preview.mode_preview) { %>
        <div class="pay-warning"><span class="pay-badge pay-badge-amber"><%= t('hr.payws.preview_badge') %></span> <strong><%= t('hr.payws.preview_title') %></strong> — <%= t('hr.payws.preview_note') %></div>
    <% } %>

    <% if (typeof refusal !== 'undefined' && refusal) { %>
        <div class="pay-error-box">
            <%= t('hr.payments.err_generic') %> — <%= codeLabel(CODE_T, refusal) %>
            <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary><span class="pay-key" dir="ltr"><%= refusal %></span></details>
            <% if (typeof blockers !== 'undefined' && blockers && blockers.length) { %>
                <div class="pay-chip-row">
                    <% blockers.forEach(function(b) { %><span class="pay-chip"><%= codeLabel(BL_T, b) %></span><% }); %>
                </div>
                <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary><% blockers.forEach(function(b) { %><span class="pay-key" dir="ltr"><%= b %></span><% }); %></details>
            <% } %>
        </div>
    <% } %>
    <% var chipEng = (typeof engine !== 'undefined' && engine) ? engine : ((typeof preview !== 'undefined' && preview && preview.mode_preview && preview.engine) ? preview.engine : null); %>
    <% if (chipEng) { %>
        <% if (chipEng.blockers && chipEng.blockers.length) { %>
            <div class="pay-error-box">
                <%= t('hr.payments.blockers') %>:
                <% chipEng.blockers.forEach(function(b) { %><span class="pay-chip"><%= codeLabel(BL_T, b) %></span><% }); %>
                <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary><% chipEng.blockers.forEach(function(b) { %><span class="pay-key" dir="ltr"><%= b %></span><% }); %></details>
            </div>
        <% } %>
        <% if (chipEng.warnings && chipEng.warnings.length) { %>
            <div class="pay-warning">
                <%= t('hr.payments.warnings') %>:
                <% chipEng.warnings.forEach(function(w) { %><span class="pay-chip pay-chip-warn"><%= codeLabel(WL_T, w) %></span><% }); %>
                <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary><% chipEng.warnings.forEach(function(w) { %><span class="pay-key" dir="ltr"><%= w %></span><% }); %></details>
            </div>
        <% } %>
    <% } %>
    <% var eng = (typeof engine !== 'undefined' && engine) ? engine : ((typeof preview !== 'undefined' && preview && preview.engine) ? preview.engine : null); %>

    <form method="POST" action="<%= mode === 'create' ? '/admin/hr/payments' : '/admin/hr/payments/' + payment.id + '/edit' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="idempotency_key" value="<%= form.idempotency_key %>">
        <input type="hidden" name="mode" value="FIFO">
        <div class="pay-create-grid">
            <div class="pay-create-main">
                <div class="pay-create-sec wiz-stage" data-stage="1">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">1</span><span class="pay-create-sec-title"><%= t('hr.payments.step_who') %></span></div>
                    <div class="pay-form-grid">
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_employee') %> <span class="pay-req">*</span></label>
                            <select name="employee_id" class="form-control" required>
                                <option value="">—</option>
                                <% (employees || []).forEach(function(e) { %>
                                    <option value="<%= e.id %>" <%= String(form.employee_id) === String(e.id) ? 'selected' : '' %>>
                                        <%= e.full_name %> — <%= e.department_name || '' %>
                                    </option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_period') %> <span class="pay-req">*</span></label>
                            <input type="text" name="period_month" class="form-control" dir="ltr" required pattern="\d{4}/\d{2}/01" value="<%= form.period_month %>">
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_date') %> <span class="pay-req">*</span></label>
                            <input type="text" name="payment_date" class="form-control" dir="ltr" required pattern="\d{4}/\d{2}/\d{2}" value="<%= form.payment_date %>">
                        </div>
                    </div>
                    <div class="pay-note"><%= t('hr.payments.hint_immutable') %></div>
                    <% if (typeof preview !== 'undefined' && preview && preview.employee) { %>
                        <% var wse = preview.employee; %>
                        <div class="pay-label" style="margin-top:12px;"><%= t('hr.payws.emp_card') %></div>
                        <div class="pay-sum-list">
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_code') %></span><span class="pay-sum-row-value" dir="ltr"><%= wse.employee_code || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_department') %></span><span class="pay-sum-row-value"><%= wse.department_name || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_position') %></span><span class="pay-sum-row-value"><%= wse.position || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_contract') %></span><span class="pay-sum-row-value"><%= wse.contract_type || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_salary') %></span><span class="pay-sum-row-value" dir="ltr"><%= (wse.basic_salary !== null && wse.basic_salary !== undefined) ? Number(wse.basic_salary).toFixed(2) : '—' %></span></div>
                            <% if (wse.basic_salary_from) { %>
                                <div class="pay-note"><%= t('hr.payws.emp_salary_asof') %> <span dir="ltr"><%= wse.basic_salary_from %></span></div>
                            <% } %>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_dob') %></span><span class="pay-sum-row-value" dir="ltr"><%= wse.date_of_birth || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_phone') %></span><span class="pay-sum-row-value" dir="ltr"><%= wse.phone || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_hired') %></span><span class="pay-sum-row-value" dir="ltr"><%= wse.hire_date || '—' %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_status') %></span><span class="pay-sum-row-value"><%= wse.employment_status || '—' %></span></div>
                        </div>
                    <% } else if (typeof preview !== 'undefined' && preview) { %>
                        <div class="pay-note"><%= t('hr.payws.emp_none') %></div>
                    <% } %>
                </div>

                <% if (typeof preview !== 'undefined' && preview && preview.attendance) { %>
                <% var att = preview.attendance;
                   var blockLabelMap = {
                     NO_SCHEDULE: 'hr.payws.block_NO_SCHEDULE',
                     MISSING_ATTENDANCE: 'hr.payws.block_MISSING_ATTENDANCE',
                     MISSING_CHECK_IN: 'hr.payws.block_MISSING_CHECK_IN'
                   }; %>
                <div class="pay-create-sec wiz-stage" data-stage="2">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">2</span><span class="pay-create-sec-title"><%= t('hr.payws.att_title') %></span></div>
                    <% if (att.status === 'BLOCKED') { %>
                        <div class="pay-error-box">
                            <%= t('hr.payws.att_blocked') %>:
                            <% (att.blockers || []).forEach(function(b) { %><span class="pay-chip"><%= (b && b.code && blockLabelMap[b.code]) ? t(blockLabelMap[b.code]) : t('hr.payws.code_generic') %></span><% }); %>
                            <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary>
                                <% (att.blockers || []).forEach(function(b) { %><span class="pay-key" dir="ltr"><%= b && b.code ? b.code : '' %></span><span class="pay-sub"><%= b && b.message ? b.message : '' %></span><% }); %>
                            </details>
                        </div>
                    <% } else { %>
                        <div class="pay-stat">
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.calendar_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_calendar') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.scheduled_working_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_scheduled') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.paid_working_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_paid') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.leave_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_leave') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.unpaid_working_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_unpaid') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.missing_attendance_days %></div><div class="pay-stat-label"><%= t('hr.payws.att_missing') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= att.lateness_minutes_total %></div><div class="pay-stat-label"><%= t('hr.payws.att_late') %></div></div>
                            <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= Number(att.salary_entitlement).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payws.att_entitlement') %></div></div>
                        </div>
                        <div class="pay-sum-card" style="margin-top:8px;">
                            <div class="pay-sum-head"><%= t('hr.payws.ent_rates_title') %></div>
                            <div class="pay-sum-list">
                                <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_grace') %></span><span class="pay-sum-row-value" dir="ltr"><%= (att.grace_period_minutes !== null && att.grace_period_minutes !== undefined) ? att.grace_period_minutes : '—' %></span></div>
                                <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_late_deduction') %></span><span class="pay-sum-row-value" dir="ltr"><%= (att.lateness_deduction_total !== null && att.lateness_deduction_total !== undefined) ? Number(att.lateness_deduction_total).toFixed(2) : '—' %></span></div>
                                <% if (att.salary_segments && att.salary_segments.length) { %>
                                    <% att.salary_segments.forEach(function(seg) { %>
                                        <% if (att.salary_segments.length > 1 && (seg.effective_from || seg.effective_to)) { %>
                                            <div class="pay-note"><span dir="ltr"><%= seg.effective_from || '' %><%= (seg.effective_from && seg.effective_to) ? ' – ' : '' %><%= seg.effective_to || '' %></span></div>
                                        <% } %>
                                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.emp_salary') %></span><span class="pay-sum-row-value" dir="ltr"><%= (seg.basic_salary !== null && seg.basic_salary !== undefined) ? Number(seg.basic_salary).toFixed(2) : '—' %></span></div>
                                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_daily') %></span><span class="pay-sum-row-value" dir="ltr"><%= seg.rates && seg.rates.daily !== null && seg.rates.daily !== undefined ? Number(seg.rates.daily).toFixed(2) : '—' %></span></div>
                                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_hourly') %></span><span class="pay-sum-row-value" dir="ltr"><%= seg.rates && seg.rates.hourly !== null && seg.rates.hourly !== undefined ? Number(seg.rates.hourly).toFixed(2) : '—' %></span></div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_daily') %></span><span class="pay-sum-row-value" dir="ltr">—</span></div>
                                    <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payws.ent_hourly') %></span><span class="pay-sum-row-value" dir="ltr">—</span></div>
                                <% } %>
                            </div>
                            <div class="pay-note"><%= t('hr.payws.ent_divisor_note') %></div>
                            <div class="pay-note"><%= t('hr.payws.ent_grace_note') %></div>
                        </div>
                        <% if (att.unpaid_dates && att.unpaid_dates.length) { %>
                            <div class="pay-note"><%= t('hr.payws.att_unpaid_dates') %>: <span dir="ltr"><%= att.unpaid_dates.join(', ') %></span></div>
                        <% } %>
                        <% if (att.unpaid_working_days > 0 || (att.unpaid_dates && att.unpaid_dates.length)) { %>
                            <div class="pay-note"><span class="pay-badge pay-badge-amber"><%= t('hr.payws.att_unpaid_resolved') %></span></div>
                        <% } %>
                    <% } %>
                    <% if (att.review_items && att.review_items.length) { %>
                        <%
                        var _riGroups = []; var _riSeen = {};
                        att.review_items.forEach(function(ri) {
                            var _c = (ri && ri.code) ? ri.code : String(ri);
                            if (_riSeen[_c]) { _riSeen[_c].count++; _riSeen[_c].items.push(ri); }
                            else { _riSeen[_c] = { code: _c, count: 1, items: [ri] }; _riGroups.push(_riSeen[_c]); }
                        });
                        %>
                        <div class="pay-chip-row">
                            <% _riGroups.forEach(function(g) { %><span class="pay-chip pay-chip-warn"><%= codeLabel(WL_T, g.code) %><% if (g.count > 1) { %> (<%= g.count %>)<% } %></span><% }); %>
                            <details class="pay-tech"><summary><%= t('hr.payws.tech_details') %></summary><% _riGroups.forEach(function(g) { g.items.forEach(function(ri) { %><span class="pay-key" dir="ltr"><%= (ri && ri.code) ? ri.code : String(ri) %></span><span class="pay-sub"><%= (ri && ri.date) ? ri.date : '' %> <%= (ri && ri.message) ? ri.message : '' %></span><% }); }); %></details>
                        </div>
                    <% } %>
                    <div class="pay-note"><%= t('hr.payws.att_note') %></div>
                </div>
                <% } %>

                <% var owe = (typeof preview !== 'undefined' && preview && preview.obligation) ? preview.obligation : null; %>
                <% if (owe) { %>
                <div class="pay-create-sec wiz-stage" data-stage="2">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">2</span><span class="pay-create-sec-title"><%= t('hr.payments.step_howmuch') %></span></div>
                    <div class="pay-sum-card">
                        <div class="pay-sum-head"><%= t('hr.payments.amount_owed_title') %></div>
                        <div class="pay-sum-list">
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.amount_owed_total') %></span><span class="pay-sum-row-value" dir="ltr"><%= (Number(owe.salary_earned) / 100).toFixed(2) %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.amount_owed_paid') %></span><span class="pay-sum-row-value" dir="ltr"><%= (Number(owe.salary_paid) / 100).toFixed(2) %></span></div>
                            <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.amount_owed_payable') %></span><span class="pay-sum-row-value" dir="ltr"><%= (Number(owe.salary_remaining) / 100).toFixed(2) %></span></div>
                        </div>
                    </div>
                </div>
                <% } %>

                <div class="pay-create-sec wiz-stage" data-stage="3">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">3</span><span class="pay-create-sec-title"><%= t('hr.payws.inc_legend') %></span></div>
                    <input type="hidden" name="include_controls" value="1">
                    <div>
                        <label class="pay-create-dup-label" style="margin-inline-end:16px;">
                            <input type="checkbox" name="include_salary" value="1" <%= inc.salary ? 'checked' : '' %>> <%= t('hr.payws.manual_salary') %>
                        </label>
                        <label class="pay-create-dup-label" style="margin-inline-end:16px;">
                            <input type="checkbox" name="include_overtime" value="1" <%= inc.overtime ? 'checked' : '' %>> <%= t('hr.payws.manual_ot') %>
                        </label>
                        <label class="pay-create-dup-label">
                            <input type="checkbox" name="include_advance" value="1" <%= inc.advance ? 'checked' : '' %>> <%= t('hr.payws.manual_adv') %>
                        </label>
                    </div>
                    <div class="pay-note"><%= t('hr.payws.inc_note') %></div>
                    <div class="pay-form-grid">
                        <%# HR-31: mode selector removed; legacy allocation-mode option retired (value="MANUAL") %>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_method') %></label>
                            <select name="payment_method" class="form-control">
                                <option value="CASH" <%= form.payment_method === 'CASH' ? 'selected' : '' %>><%= t('hr.payments.method_cash') %></option>
                                <option value="BANK" <%= form.payment_method === 'BANK' ? 'selected' : '' %>><%= t('hr.payments.method_bank') %></option>
                                <option value="OTHER" <%= form.payment_method === 'OTHER' ? 'selected' : '' %>><%= t('hr.payments.method_other') %></option>
                            </select>
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.amount_now_label') %></label>
                            <input type="text" name="requested_amount" class="form-control" dir="ltr" inputmode="decimal" value="<%= form.requested_amount %>">
                            <div class="pay-note"><%= t('hr.payments.amount_now_hint') %></div>
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_reference') %></label>
                            <input type="text" name="payment_reference" class="form-control" maxlength="200" value="<%= form.payment_reference %>">
                        </div>
                    </div>
                    <% if (typeof preview !== 'undefined' && preview && preview.sources) { %>
                    <% var msrc = preview.sources; var mout = preview.engine; var mvals = form.manual_values || {};
                       var disp = msrc.uncurated || msrc; var mobl = disp.obligation; %>
                    <div class="pay-label" style="margin-top:12px;"><%= t('hr.payws.manual_title') %></div>
                    <div class="pay-note"><%= t('hr.payws.manual_hint') %></div>
                    <div class="pay-sum-card">
                        <div class="pay-sum-head"><%= t('hr.payws.manual_salary') %></div>
                        <% if (mobl) { %>
                            <div class="pay-sum-row">
                                <% var salCapCents = (mout && mout.salary && typeof mout.salary.remaining_before === 'number') ? mout.salary.remaining_before : Number(mobl.salary_remaining); %>
                                <span class="pay-sum-row-label"><%= t('hr.payws.manual_cap') %> <span dir="ltr">(<%= (salCapCents / 100).toFixed(2) %>)</span></span>
                                <input type="text" class="form-control pay-sum-row-value" style="max-width:160px;" name="msal_<%= mobl.id %>" dir="ltr" inputmode="decimal" value="<%= mvals['msal_' + mobl.id] || '' %>">
                            </div>
                        <% } else { %>
                            <div class="pay-empty"><%= t('hr.payws.manual_no_salary') %></div>
                        <% } %>
                    </div>
                    <div class="pay-sum-card">
                        <div class="pay-sum-head"><%= t('hr.payws.manual_ot') %></div>
                        <% if (disp.ot_candidates && disp.ot_candidates.length) { %>
                            <% disp.ot_candidates.forEach(function(ot) { %>
                                <% var otEng = (mout && mout.overtime) ? mout.overtime.find(function(x) { return x.id === ot.id; }) : null; %>
                                <% var otCapCents = otEng && typeof otEng.available_before === 'number' ? otEng.available_before : Number(ot.remaining_cents); %>
                                <div class="pay-sum-row">
                                    <span class="pay-sum-row-label"><span dir="ltr">#<%= ot.id %> · <%= ot.overtime_date || '—' %></span> · <%= t('hr.payws.manual_cap') %> <span dir="ltr">(<%= (otCapCents / 100).toFixed(2) %>)</span></span>
                                    <input type="text" class="form-control pay-sum-row-value" style="max-width:160px;" name="mot_<%= ot.id %>" dir="ltr" inputmode="decimal" value="<%= mvals['mot_' + ot.id] || '' %>">
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="pay-empty"><%= t('hr.payws.manual_no_ot') %></div>
                        <% } %>
                    </div>
                    <div class="pay-sum-card">
                        <div class="pay-sum-head"><%= t('hr.payws.manual_adv') %></div>
                        <% if (disp.advance_candidates && disp.advance_candidates.length) { %>
                            <% disp.advance_candidates.forEach(function(ad) { %>
                                <% var adEng = (mout && mout.advance) ? mout.advance.find(function(x) { return x.id === ad.id; }) : null; %>
                                <% var adCapCents = adEng && typeof adEng.available_before === 'number' ? adEng.available_before
                                    : (typeof ad.available_cents === 'number' ? ad.available_cents : Number(ad.original_amount_cents)); %>
                                <div class="pay-sum-row">
                                    <span class="pay-sum-row-label"><span dir="ltr">#<%= ad.id %> · <%= ad.date || '—' %></span> · <%= t('hr.payws.manual_cap') %> <span dir="ltr">(<%= (adCapCents / 100).toFixed(2) %>)</span></span>
                                    <input type="text" class="form-control pay-sum-row-value" style="max-width:160px;" name="madv_<%= ad.id %>" dir="ltr" inputmode="decimal" value="<%= mvals['madv_' + ad.id] || '' %>">
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="pay-empty"><%= t('hr.payws.manual_no_adv') %></div>
                        <% } %>
                    </div>
                    <div class="pay-note"><%= t('hr.payws.manual_server_note') %></div>
                    <% } %>
                </div>

                <div class="pay-create-sec wiz-stage" data-stage="3">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">3</span><span class="pay-create-sec-title"><%= t('hr.payments.additional_section') %></span></div>
                    <div class="pay-form-grid">
                        <div>
                            <label class="pay-label"><%= t('hr.payments.additional_amount') %></label>
                            <input type="text" name="additional_amount" class="form-control" dir="ltr" inputmode="decimal" value="<%= form.additional_amount %>">
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.additional_reason') %></label>
                            <select name="additional_reason" class="form-control">
                                <option value="">—</option>
                                <% [['BONUS_APPROVED','ar_bonus'],['RETENTION_INCENTIVE','ar_retention'],['CORRECTION_PRIOR_PERIOD','ar_correction'],['ALLOWANCE_UNCLASSIFIED','ar_allowance'],['GOODWILL_PAYMENT','ar_goodwill'],['REIMBURSEMENT','ar_reimbursement'],['OTHER_APPROVED','ar_other']].forEach(function(r) { %>
                                    <option value="<%= r[0] %>" <%= form.additional_reason === r[0] ? 'selected' : '' %>><%= t('hr.payments.' + r[1]) %></option>
                                <% }); %>
                            </select>
                        </div>
                        <div>
                            <label class="pay-label"><%= t('hr.payments.additional_note') %></label>
                            <input type="text" name="additional_note" class="form-control" maxlength="500" value="<%= form.additional_note %>">
                        </div>
                    </div>
                    <div class="pay-note"><%= t('hr.payments.additional_hint') %></div>
                </div>

                <div class="pay-create-sec wiz-stage" data-stage="4">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">4</span><span class="pay-create-sec-title"><%= t('hr.payments.form_notes') %></span></div>
                    <div class="pay-form-grid">
                        <div>
                            <label class="pay-label"><%= t('hr.payments.form_notes') %></label>
                            <input type="text" name="notes" class="form-control" maxlength="1000" value="<%= form.notes %>">
                        </div>
                    </div>
                    <div class="pay-warning"><%= t('hr.payments.dup_confirm_warning') %></div>
                    <div class="pay-create-dup">
                        <label class="pay-create-dup-label">
                            <input type="checkbox" name="duplicate_confirmed" value="1" <%= form.duplicate_confirmed ? 'checked' : '' %>>
                            <%= t('hr.payments.form_duplicate') %>
                        </label>
                    </div>
                    <div class="pay-note"><%= t('hr.payments.form_duplicate_hint') %></div>
                </div>

                <% if (typeof preview !== 'undefined' && preview && preview.openObligations) { %>
                <div class="pay-create-sec wiz-stage" data-stage="4">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">4</span><span class="pay-create-sec-title"><%= t('hr.payws.obl_title') %></span></div>
                    <% if (preview.openObligations.length) { %>
                        <div class="table-responsive">
                            <table class="table table-sm pay-list-table">
                                <thead>
                                    <tr>
                                        <th><%= t('hr.payws.obl_month') %></th>
                                        <th><%= t('hr.payments.obl_earned') %></th>
                                        <th><%= t('hr.payments.obl_paid') %></th>
                                        <th><%= t('hr.payments.obl_remaining') %></th>
                                        <th><%= t('hr.payments.obl_status') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% preview.openObligations.forEach(function(o) { %>
                                        <tr>
                                            <td dir="ltr"><%= o.earning_month %></td>
                                            <td dir="ltr"><%= (Number(o.salary_earned) / 100).toFixed(2) %></td>
                                            <td dir="ltr"><%= (Number(o.salary_paid) / 100).toFixed(2) %></td>
                                            <td dir="ltr"><%= (Number(o.salary_remaining) / 100).toFixed(2) %></td>
                                            <td><%= statusLabel(o.status) %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="pay-empty"><%= t('hr.payws.obl_none') %></div>
                    <% } %>
                    <div class="pay-note"><%= t('hr.payws.obl_note') %></div>
                </div>
                <% } %>

                <% if (typeof preview !== 'undefined' && preview && preview.history) { %>
                <div class="pay-create-sec wiz-stage" data-stage="4">
                    <div class="pay-create-sec-head"><span class="pay-create-sec-no">4</span><span class="pay-create-sec-title"><%= t('hr.payws.hist_title') %></span></div>
                    <% if (preview.history.length) { %>
                        <div class="table-responsive">
                            <table class="table table-sm pay-list-table">
                                <thead>
                                    <tr>
                                        <th><%= t('hr.payments.col_serial') %></th>
                                        <th><%= t('hr.payments.form_period') %></th>
                                        <th><%= t('hr.payments.form_date') %></th>
                                        <th><%= t('hr.payments.col_status') %></th>
                                        <th><%= t('hr.payments.t_salary') %></th>
                                        <th><%= t('hr.payments.t_net') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% preview.history.forEach(function(p) { %>
                                        <tr>
                                            <td dir="ltr"><%= p.id %></td>
                                            <td dir="ltr"><%= p.period_month %></td>
                                            <td dir="ltr"><%= p.payment_date %></td>
                                            <td><%= p.status === 'DRAFT' ? t('hr.payments.status_draft') : (p.status === 'CORRECTED' ? t('hr.payments.status_corrected') : t('hr.payments.status_finalized')) %></td>
                                            <td dir="ltr"><%= (Number(p.salary_total) / 100).toFixed(2) %></td>
                                            <td dir="ltr"><%= (Number(p.net_cash_paid) / 100).toFixed(2) %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="pay-empty"><%= t('hr.payws.hist_none') %></div>
                    <% } %>
                </div>
                <% } %>
            </div>

            <aside class="pay-create-rail">
                <div class="pay-sum-card">
                    <div class="pay-sum-head"><%= t('hr.payments.totals_title') %></div>
                    <div class="pay-sum-hero">
                        <div class="pay-sum-hero-label"><%= t('hr.payments.t_net') %></div>
                        <div class="pay-sum-hero-value" dir="ltr"><%= eng ? (eng.totals.net_cents / 100).toFixed(2) : '—' %></div>
                    </div>
                    <div class="pay-sum-rows">
                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.t_salary') %></span><span class="pay-sum-row-value" dir="ltr"><%= eng ? (eng.totals.salary_total / 100).toFixed(2) : '—' %></span></div>
                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.t_overtime') %></span><span class="pay-sum-row-value" dir="ltr"><%= eng ? (eng.totals.overtime_total / 100).toFixed(2) : '—' %></span></div>
                        <div class="pay-sum-row"><span class="pay-sum-row-label"><%= t('hr.payments.t_advance') %></span><span class="pay-sum-row-value" dir="ltr"><%= eng ? (eng.totals.advance_deduction_total / 100).toFixed(2) : '—' %></span></div>
                    </div>
                    <% if (typeof preview !== 'undefined' && preview && preview.mode_preview && preview.after) { %>
