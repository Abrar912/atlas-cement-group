<%- include('../partials/header') %>

<style>
.pay-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:14px}
.pay-head-actions{display:flex;gap:10px;flex-wrap:wrap}
.pay-page-title{font-size:21px;font-weight:700;margin:0;letter-spacing:-.2px}
.pay-page-sub{font-size:13px;color:var(--text-muted,#6b7280);margin:6px 0 0 0}
.pay-panel{border:1px solid var(--border-color,#d1d5db);border-radius:12px;padding:16px 18px;background:var(--bg-color,#fafafa);margin-top:16px}
.pay-panel-head{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:700;margin-bottom:14px}
.pay-panel-head::after{content:"";flex:1;height:1px;background:var(--border-color,#d1d5db)}
.pay-form-footer{justify-content:space-between;border-top:1px solid var(--border-color,#d1d5db);margin-top:18px;padding-top:16px}
.pay-req{color:var(--status-error,#cf222e);font-weight:700}
.pay-stat{display:flex;gap:12px;flex-wrap:wrap;margin:14px 0 18px 0}
.pay-stat-item{flex:1;min-width:132px;border:1px solid var(--border-color,#d1d5db);border-radius:10px;padding:12px 14px;background:var(--bg-color,#fafafa);text-align:start}
.pay-stat-value{font-size:17px;font-weight:800}
.pay-stat-label{font-size:11.5px;color:var(--text-muted,#6b7280);margin-top:4px}
.pay-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap;letter-spacing:.2px}
.pay-badge-green{background:rgba(16,185,129,.15);color:#047857}
.pay-badge-amber{background:rgba(245,158,11,.15);color:#b45309}
.pay-badge-blue{background:rgba(59,130,246,.15);color:#1d4ed8}
[data-theme="dark"] .pay-badge-green{background:rgba(16,185,129,.2);color:#3fb950}
[data-theme="dark"] .pay-badge-amber{background:rgba(245,158,11,.2);color:#fbbf24}
[data-theme="dark"] .pay-badge-blue{background:rgba(59,130,246,.2);color:#60a5fa}
.pay-chip{display:inline-block;font-family:monospace;font-size:11px;padding:2px 7px;border-radius:6px;background:rgba(239,68,68,.12);color:#b91c1c;margin:2px}
.pay-chip-warn{background:rgba(245,158,11,.14);color:#b45309}
.pay-error-box{border-inline-start:4px solid #ef4444;background:rgba(239,68,68,.08);padding:11px 14px;border-radius:10px;font-size:12.5px;margin-bottom:16px;font-weight:600}
.pay-warning{border-inline-start:4px solid #f59e0b;background:rgba(245,158,11,.08);padding:11px 14px;border-radius:10px;font-size:12.5px;margin-bottom:16px}
.pay-note{font-size:12px;color:var(--text-muted,#6b7280);margin-top:6px}
.pay-label{display:block;margin-bottom:5px;font-size:13px;font-weight:600}
.pay-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:18px}
.pay-emp{font-weight:700;font-size:13.5px}
.pay-sub{font-size:11.5px;color:var(--text-muted,#6b7280)}
.pay-key{display:inline-block;font-family:monospace;font-size:10.5px;padding:2px 6px;border-radius:6px;background:rgba(107,114,128,.12);color:inherit}
.pay-empty{padding:22px 18px;border:1px dashed var(--border-color,#d1d5db);border-radius:12px;font-size:13px;color:var(--text-muted,#6b7280);background:var(--bg-color,#fafafa);text-align:center}
.pay-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
.pay-inline{display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end}
.pay-readonly{font-weight:700;font-size:13.5px;padding:8px 10px;border:1px solid var(--border-color,#d1d5db);border-radius:8px;background:rgba(107,114,128,.08)}
.pay-sec{margin-top:20px;padding-top:14px;border-top:1px solid var(--border-color,#d1d5db)}
.pay-filters{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end;margin-bottom:16px;padding:14px 16px;border:1px solid var(--border-color,#d1d5db);border-radius:12px;background:var(--bg-color,#fafafa)}
.pay-filters>div{min-width:160px;flex:1}
.pay-filters .pay-actions{margin-top:0;gap:8px}
.pay-list-table th{font-size:12px;white-space:nowrap}
.pay-list-table td{vertical-align:middle}
.pay-num{text-align:end;white-space:nowrap}
.pay-create-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,360px);gap:20px;align-items:start;margin-top:16px}
.pay-create-main{min-width:0;display:flex;flex-direction:column;gap:16px}
.pay-create-rail{min-width:0;display:flex;flex-direction:column;gap:16px;position:sticky;top:14px}
.pay-create-sec{border:1px solid var(--border-color,#d1d5db);border-radius:14px;padding:16px 18px 18px;background:var(--bg-color,#fafafa);box-shadow:0 1px 2px rgba(15,23,42,.04)}
.pay-create-sec-head{display:flex;align-items:center;gap:9px;margin-bottom:14px}
.pay-create-sec-no{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;flex:none;border-radius:7px;background:rgba(59,130,246,.14);color:#1d4ed8;font-size:11.5px;font-weight:800}
.pay-create-sec-title{font-size:13.5px;font-weight:700}
.pay-sum-card{border:1px solid var(--border-color,#d1d5db);border-radius:14px;padding:16px 18px;background:var(--bg-color,#fafafa);box-shadow:0 1px 2px rgba(15,23,42,.04)}
.pay-sum-head{font-size:11.5px;font-weight:800;letter-spacing:.6px;text-transform:uppercase;color:var(--text-muted,#6b7280);margin-bottom:12px}
.pay-sum-hero{padding:14px 16px;border-radius:12px;border:1px solid rgba(16,185,129,.35);background:rgba(16,185,129,.09)}
.pay-sum-hero-label{font-size:12px;font-weight:700;color:var(--text-muted,#6b7280)}
.pay-sum-hero-value{font-size:30px;font-weight:800;letter-spacing:-.5px;margin-top:3px;font-variant-numeric:tabular-nums}
.pay-sum-rows{margin-top:12px;padding-top:10px;border-top:1px dashed var(--border-color,#d1d5db);display:flex;flex-direction:column;gap:8px}
.pay-sum-list{display:flex;flex-direction:column;gap:8px}
.pay-sum-row{display:flex;justify-content:space-between;align-items:baseline;gap:10px;font-size:13px}
.pay-sum-row-label{color:var(--text-muted,#6b7280);font-weight:600}
.pay-sum-row-value{font-weight:700;font-variant-numeric:tabular-nums}
.pay-sum-warn{margin:12px 0 0 0}
.pay-create-dup{display:flex;gap:10px;align-items:flex-start;margin-top:12px;padding:11px 14px;border:1px dashed var(--border-color,#d1d5db);border-radius:10px;background:rgba(245,158,11,.07)}
.pay-create-dup-label{display:flex;gap:8px;align-items:center;font-size:13px;font-weight:600;margin:0}
.pay-create-submit{padding:10px 24px;font-weight:700}
.pay-create-rail .pay-empty{padding:14px 12px;text-align:start}
[data-theme="dark"] .pay-create-sec-no{background:rgba(96,165,250,.18);color:#60a5fa}
[data-theme="dark"] .pay-sum-hero{border-color:rgba(16,185,129,.4);background:rgba(16,185,129,.13)}
[data-theme="dark"] .pay-create-sec,[data-theme="dark"] .pay-sum-card{box-shadow:0 1px 2px rgba(0,0,0,.35)}
.pay-tech{margin-top:6px}
.pay-tech summary{cursor:pointer;font-size:11.5px;font-weight:700;color:var(--text-muted,#6b7280);letter-spacing:.2px}
.pay-tech[open] summary{margin-bottom:4px}
.pay-tech .pay-key{margin:2px 4px 2px 0}
.pay-chip-row{margin-top:6px}
.pay-chip-float{float:inline-end}
@media (max-width:960px){
.pay-create-grid{grid-template-columns:1fr}
.pay-create-rail{position:static}
}
@media screen{
.pay-list-table tbody tr:nth-child(even) td{background:rgba(107,114,128,.045)}
[data-theme="dark"] .pay-list-table tbody tr:nth-child(even) td{background:rgba(163,173,188,.05)}
.pay-form-grid .form-control:user-invalid{border-color:var(--status-error,#cf222e)}
}
@media (max-width:600px){
.pay-head{flex-direction:column;align-items:flex-start}
.pay-head-actions{width:100%}
.pay-page-title{font-size:19px}
.pay-form-footer{flex-direction:column;align-items:flex-start}
.pay-stat-item{min-width:110px}
}
.pc-tabbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px}
.pc-tab{display:inline-flex;align-items:center;gap:6px;padding:7px 15px;border-radius:9px;font-size:13px;font-weight:700;color:var(--text-muted,#6b7280);border:1px solid var(--border-color,#e5e7eb);background:transparent;text-decoration:none;cursor:pointer}
.pc-tab:hover{background:rgba(107,114,128,.08);color:inherit}
.pc-tab-active{background:var(--primary,#FF6F00);color:#fff;border-color:var(--primary,#FF6F00)}
.pc-tab-active:hover{background:var(--primary,#FF6F00);color:#fff}
.wiz-prog{border:1px solid var(--border-color,#d1d5db);border-radius:12px;padding:14px 16px;background:var(--bg-color,#fafafa);margin-bottom:16px}
.wiz-prog-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:10px}
.wiz-prog-title{font-size:12px;font-weight:800;letter-spacing:.4px;text-transform:uppercase;color:var(--text-muted,#6b7280)}
.wiz-prog-pct{font-size:15px;font-weight:800;font-variant-numeric:tabular-nums}
.wiz-track{height:8px;border-radius:999px;background:rgba(107,114,128,.14);overflow:hidden;margin-bottom:12px}
.wiz-fill{height:100%;border-radius:999px;background:var(--primary,#FF6F00);transition:width .25s ease}
.wiz-steps{display:flex;gap:6px;flex-wrap:wrap;list-style:none;margin:0;padding:0}
.wiz-step{flex:1;min-width:96px;display:flex;flex-direction:column;gap:4px;padding:8px 10px;border-radius:9px;border:1px solid var(--border-color,#e5e7eb);font-size:11.5px;color:var(--text-muted,#6b7280)}
.wiz-step-no{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:999px;background:rgba(107,114,128,.14);font-size:10.5px;font-weight:800}
.wiz-step-label{font-weight:700}
.wiz-step-pct{font-size:10.5px;font-weight:700;opacity:.85}
.wiz-step-done{border-color:rgba(16,185,129,.4)}
.wiz-step-done .wiz-step-no{background:rgba(16,185,129,.18);color:#047857}
.wiz-step-current{border-color:var(--primary,#FF6F00);background:rgba(255,111,0,.06)}
.wiz-step-current .wiz-step-no{background:var(--primary,#FF6F00);color:#fff}
.wiz-step-blocked{border-color:rgba(239,68,68,.55);background:rgba(239,68,68,.06)}
.wiz-step-blocked .wiz-step-no{background:rgba(239,68,68,.18);color:#b91c1c}
.wiz-step-blocked-tag{display:inline-flex;align-items:center;align-self:flex-start;font-size:10px;font-weight:800;letter-spacing:.3px;padding:1px 7px;border-radius:999px;background:rgba(239,68,68,.16);color:#b91c1c}
.wiz-stage{display:none}
.wiz-stage-active{display:block}
.wiz-nav{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:16px}
.wiz-obl-remedy{border-inline-start:4px solid #ef4444;background:rgba(239,68,68,.08);padding:12px 14px;border-radius:10px;font-size:13px;font-weight:600;margin-top:10px}
.wiz-done{border:1px solid rgba(16,185,129,.4);background:rgba(16,185,129,.08);border-radius:12px;padding:16px 18px;margin-bottom:16px}
.wiz-done-head{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:800;margin-bottom:6px}
[data-theme="dark"] .wiz-step-done{border-color:rgba(63,185,80,.4)}
[data-theme="dark"] .wiz-step-done .wiz-step-no{background:rgba(63,185,80,.2);color:#3fb950}
[data-theme="dark"] .wiz-obl-remedy{background:rgba(239,68,68,.14)}
[data-theme="dark"] .wiz-done{background:rgba(63,185,80,.14);border-color:rgba(63,185,80,.4)}
</style>
