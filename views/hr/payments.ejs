    <script>
    (function(){
      var root=document.getElementById('payWizard');
      if(!root)return;
      var maxStage=parseInt(root.getAttribute('data-max'),10)||0;
      var cur=parseInt(root.getAttribute('data-stage'),10)||1;
      var blocked=root.getAttribute('data-blocked')==='1';
      var back=document.getElementById('wizBack');
      var next=document.getElementById('wizNext');
      var stageEls=document.querySelectorAll('.wiz-stage');
      var stepEls=document.querySelectorAll('.wiz-step');
      function render(){
        var i;
        for(i=0;i<stageEls.length;i++){var sn=parseInt(stageEls[i].getAttribute('data-stage'),10);if(sn===cur)stageEls[i].classList.add('wiz-stage-active');else stageEls[i].classList.remove('wiz-stage-active');}
        for(i=0;i<stepEls.length;i++){var sn2=parseInt(stepEls[i].getAttribute('data-step'),10);if(sn2===cur)stepEls[i].classList.add('wiz-step-current');else stepEls[i].classList.remove('wiz-step-current');}
        if(back)back.disabled=(cur<=1);
        if(next){next.style.display=(cur>=4)?'none':'';if(blocked)next.disabled=true;}
      }
      if(back)back.addEventListener('click',function(){if(cur>1){cur--;render();}});
      if(next)next.addEventListener('click',function(){
        if(blocked)return;
        if(cur>=4)return;
        if(cur<maxStage){cur++;render();return;}
        var pv=next.form?next.form.querySelector('button[name="preview"]'):null;
        if(pv)pv.click();
      });
      render();
    })();
    </script>
<% } else { %>
