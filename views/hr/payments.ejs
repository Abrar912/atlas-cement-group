                <li class="wiz-step wiz-step-done"><span class="wiz-step-no">2</span><span class="wiz-step-label"><%= t('hr.payws.wiz_s2') %></span><span class="wiz-step-pct">40%</span></li>
                <li class="wiz-step wiz-step-done"><span class="wiz-step-no">3</span><span class="wiz-step-label"><%= t('hr.payws.wiz_s3') %></span><span class="wiz-step-pct">60%</span></li>
                <li class="wiz-step wiz-step-done"><span class="wiz-step-no">4</span><span class="wiz-step-label"><%= t('hr.payws.wiz_s4') %></span><span class="wiz-step-pct">80%</span></li>
                <li class="wiz-step wiz-step-done wiz-step-current"><span class="wiz-step-no">5</span><span class="wiz-step-label"><%= t('hr.payws.wiz_s5') %></span><span class="wiz-step-pct">100%</span></li>
            </ol>
        </div>
        <div class="wiz-done">
            <div class="wiz-done-head"><span class="pay-badge pay-badge-green"><%= t('hr.payments.status_draft') %></span> <%= t('hr.payments.ok_created') %></div>
            <p class="pay-sub"><%= t('hr.payments.finalize_title') %>: <%= t('hr.payments.finalize_confirm') %></p>
            <% if (payment.status === 'DRAFT') { %>
                <a href="#wizFinalize" class="btn btn-primary"><%= t('hr.payments.btn_finalize') %></a>
            <% } %>
        </div>
    <% } %>

    <div class="pay-stat">
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= payment.period_month %></div><div class="pay-stat-label"><%= t('hr.payments.col_period') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= payment.payment_date %></div><div class="pay-stat-label"><%= t('hr.payments.col_date') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value"><%= t('hr.payments.method_' + (payment.payment_method === 'BANK' ? 'bank' : payment.payment_method === 'OTHER' ? 'other' : 'cash')) %></div><div class="pay-stat-label"><%= t('hr.payments.form_method') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.net_cash_paid) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_net') %></div></div>
    </div>

    <div class="pay-label"><%= t('hr.payments.totals_title') %></div>
    <div class="pay-stat">
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.salary_total) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_salary') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.overtime_total) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_overtime') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.additional_total) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_additional') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.advance_deduction_total) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_advance') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.entered_total) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_entered') %></div></div>
        <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(payment.net_cash_paid) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.t_net') %></div></div>
    </div>

    <div class="pay-sec">
        <div class="pay-label"><%= t('hr.payments.components_title') %> (<%= components.length %>)</div>
        <% if (!components.length) { %>
            <div class="pay-empty"><%= t('hr.payments.comp_empty') %></div>
        <% } else { %>
            <div class="table-responsive">
                <table class="pay-list-table">
                    <thead>
                        <tr>
                            <th><%= t('hr.payments.col_type') %></th>
                            <th><%= t('hr.payments.col_amount') %></th>
                            <th><%= t('hr.payments.col_target') %></th>
                            <th><%= t('hr.payments.col_reason') %></th>
                            <th><%= t('hr.payments.col_seq') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% components.forEach(function(c) { %>
                            <tr>
                                <td><%= t('hr.payments.type_' + (c.type === 'OVERTIME' ? 'overtime' : c.type === 'ADVANCE' ? 'advance' : c.type === 'ADDITIONAL' ? 'additional' : 'salary')) %></td>
                                <td class="pay-num" dir="ltr"><%= (Number(c.amount) / 100).toFixed(2) %></td>
                                <td dir="ltr"><%= c.target_month || (c.overtime_id ? 'OT#' + c.overtime_id : c.advance_id ? 'ADV#' + c.advance_id : '—') %></td>
                                <td>
                                    <% if (c.reason_code) { %>
                                        <details class="pay-tech"><summary><%= codeLabel(BL_T, c.reason_code) %></summary><span class="pay-key" dir="ltr"><%= c.reason_code %></span></details>
                                    <% } else { %>—<% } %>
                                </td>
                                <td dir="ltr"><%= c.seq %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="pay-sec">
        <div class="pay-label"><%= t('hr.payments.obligation_title') %></div>
        <% if (obligation) { %>
            <div class="pay-stat">
                <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(obligation.salary_earned) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.obl_earned') %></div></div>
                <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(obligation.salary_paid) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.obl_paid') %></div></div>
                <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(obligation.salary_remaining) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.obl_remaining') %></div></div>
                <div class="pay-stat-item"><div class="pay-stat-value"><%= obligation.status === 'PAID' ? t('hr.payments.st_paid') : obligation.status === 'PARTIAL' ? t('hr.payments.st_partial') : t('hr.payments.st_open') %></div><div class="pay-stat-label"><%= t('hr.payments.obl_status') %></div></div>
            </div>
        <% } else { %>
            <div class="pay-empty"><%= t('hr.payments.obl_none') %></div>
        <% } %>
    </div>

    <% if (payment.status === 'DRAFT') { %>
        <div class="pay-sec" id="wizFinalize">
            <div class="pay-label"><%= t('hr.payments.finalize_title') %></div>
            <% if (payment.earnings_total === 0) { %>
                <div class="pay-warning"><%= t('hr.payments.zero_required_hint') %></div>
            <% } %>
            <form method="POST" action="/admin/hr/payments/<%= payment.id %>/finalize" onsubmit="return confirm('<%= t('hr.payments.finalize_confirm') %>');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="pay-form-grid">
                    <div>
                        <label class="pay-label"><%= t('hr.payments.finalize_overpayment') %></label>
                        <input type="text" name="overpayment_amount" class="form-control" dir="ltr" inputmode="decimal" value="">
                        <div class="pay-note"><%= t('hr.payments.finalize_overpayment_hint') %></div>
                    </div>
                    <div>
                        <label class="pay-label"><%= t('hr.payments.zero_reason_label') %></label>
                        <select name="zero_reason_code" class="form-control">
                            <option value="">—</option>
                            <% [['NO_WORK_PERIOD','zr_no_work'],['ABSENCE_UNPAID','zr_absence'],['NEW_HIRE_NO_DUE','zr_new_hire'],['LEAVE_UNPAID','zr_leave'],['BANK_UNAVAILABLE','zr_bank'],['EMPLOYEE_ABSENT_PICKUP','zr_pickup'],['OTHER_APPROVED','zr_other']].forEach(function(r) { %>
                                <option value="<%= r[0] %>"><%= t('hr.payments.' + r[1]) %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div>
                        <label class="pay-label"><%= t('hr.payments.zero_reason_note') %></label>
                        <input type="text" name="zero_reason_note" class="form-control" maxlength="500">
                    </div>
                </div>
                <div class="pay-actions">
                    <button type="submit" class="btn btn-primary"><%= t('hr.payments.btn_finalize') %></button>
                    <a href="/admin/hr/payments/<%= payment.id %>/edit" class="btn btn-secondary" onclick="event.preventDefault();location.href='/admin/hr/payments/<%= payment.id %>';"><%= t('hr.payments.btn_cancel') %></a>
                </div>
            </form>
        </div>

        <div class="pay-sec pay-inline">
            <form method="POST" action="/admin/hr/payments/<%= payment.id %>/edit">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="payment_date" value="<%= payment.payment_date %>">
                <input type="hidden" name="mode" value="FIFO">
                <input type="hidden" name="requested_amount" value="<%= (Number(payment.entered_total) / 100).toFixed(2) %>">
                <button type="submit" class="btn btn-primary"><%= t('hr.payments.btn_edit') %></button>
            </form>
            <form method="POST" action="/admin/hr/payments/<%= payment.id %>/delete" onsubmit="return confirm('<%= t('hr.payments.delete_confirm') %>');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger"><%= t('hr.payments.btn_delete') %></button>
            </form>
        </div>
    <% } %>

    <% if (payment.status === 'FINALIZED') { %>
        <div class="pay-sec">
            <div class="pay-label"><%= t('hr.payments.recovery_title') %></div>
            <% if (recovery) { %>
                <div class="pay-stat">
                    <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(recovery.amount) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.recovery_amount') %></div></div>
                    <div class="pay-stat-item"><div class="pay-stat-value" dir="ltr"><%= (Number(recovery.remaining_balance) / 100).toFixed(2) %></div><div class="pay-stat-label"><%= t('hr.payments.recovery_balance') %></div></div>
                    <div class="pay-stat-item"><div class="pay-stat-value"><%= statusLabel(recovery.status) %></div><div class="pay-stat-label"><%= t('hr.payments.obl_status') %></div></div>
                </div>
            <% } else { %>
                <div class="pay-note"><%= t('hr.payments.recovery_none') %></div>
            <% } %>
            <% if (payment.zero_reason_code) { %>
                <div class="pay-warning">
                    <%= t('hr.payments.zero_reason_label') %>:
                    <%= t('hr.payments.' + ({'NO_WORK_PERIOD':'zr_no_work','ABSENCE_UNPAID':'zr_absence','NEW_HIRE_NO_DUE':'zr_new_hire','LEAVE_UNPAID':'zr_leave','BANK_UNAVAILABLE':'zr_bank','EMPLOYEE_ABSENT_PICKUP':'zr_pickup','OTHER_APPROVED':'zr_other'})[payment.zero_reason_code]) %>
                    <% if (payment.zero_reason_note) { %> — <%= payment.zero_reason_note %><% } %>
                </div>
            <% } %>
        </div>

        <div class="pay-sec">
            <div class="pay-label"><%= t('hr.correction.correction_title') %></div>
            <div class="pay-note"><%= t('hr.correction.correction_hint') %></div>
            <form method="POST" action="/admin/hr/payment-correction/<%= payment.id %>" onsubmit="return confirm('<%= t('hr.correction.correct_confirm') %>');">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div style="max-width:640px;margin-top:10px;">
                    <label class="pay-label"><%= t('hr.correction.reason_label') %> <span class="pay-req">*</span></label>
                    <textarea name="reason" class="form-control" rows="2" required minlength="5" maxlength="1000" placeholder="<%= t('hr.correction.reason_placeholder') %>"></textarea>
                </div>
                <div class="pay-actions">
                    <button type="submit" class="btn btn-danger"><%= t('hr.correction.btn_correct') %></button>
                </div>
            </form>
        </div>
    <% } %>

    <% if (payment.status === 'CORRECTED') { %>
        <div class="pay-sec">
            <div class="pay-warning">
                <%= t('hr.correction.corrected_note') %>
                <%= t('hr.correction.corrected_count_label') %>: <%= payment.corrected_count %>
            </div>
        </div>
    <% } %>

    <div class="pay-sec">
        <div class="pay-label"><%= t('hr.payments.audit_title') %></div>
        <% if (!audits || audits.length === 0) { %>
            <div class="pay-empty"><%= t('hr.payments.audit_empty') %></div>
        <% } else { %>
            <div class="table-responsive">
                <table class="pay-list-table">
                    <thead>
                        <tr>
                            <th><%= t('hr.payments.audit_action') %></th>
                            <th><%= t('hr.payments.audit_field') %></th>
                            <th><%= t('hr.payments.audit_change') %></th>
                            <th><%= t('hr.payments.audit_reason') %></th>
                            <th><%= t('hr.payments.audit_actor') %></th>
                            <th><%= t('hr.payments.audit_time') %></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% audits.forEach(function(a) { %>
                            <tr>
                                <td><details class="pay-tech"><summary><strong><%= (a.action && ACT_T[a.action]) ? t(ACT_T[a.action]) : t('hr.payws.act_generic') %></strong></summary><span class="pay-key" dir="ltr"><%= a.action %></span></details></td>
                                <td><%= a.field_name || '—' %></td>
                                <td dir="ltr"><%= (a.old_value || '—') + ' → ' + (a.new_value || '—') %></td>
                                <td style="font-size:11.5px;max-width:340px;word-break:break-word;"><%= a.reason || '—' %></td>
                                <td dir="ltr"><%= a.actor_id %></td>
                                <td dir="ltr" style="font-size:11px;"><%= a.created_at %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <div class="pay-sec">
        <div class="pay-label"><%= t('hr.payments.key_label') %></div>
        <span class="pay-key"><%= payment.idempotency_key || '—' %></span>
        <% if (payment.duplicate_confirmed) { %><span class="pay-badge pay-badge-amber" style="margin-inline-start:8px;"><%= t('hr.payments.dup_flag') %></span><% } %>
        <div class="pay-note"><%= t('hr.payments.hint_immutable') %></div>
    </div>
<% } %>
</div>

<%- include('../partials/footer') %>
