<%- include('../partials/header') %>

<style>
.dept-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.dept-hero-left{display:flex;align-items:center;gap:16px}
.dept-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
.dept-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.dept-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.dept-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.dept-hero-count{display:inline-block;background:rgba(255,111,0,.1);color:var(--primary);font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;margin-inline-start:8px}
.dept-hero-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.dept-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap}
.dept-hero-btn-primary{background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.dept-hero-btn-primary:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.dept-hero-btn-secondary{background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-color)}
.dept-hero-btn-secondary:hover{border-color:var(--primary);color:var(--primary)}
.dept-alert{padding:14px 18px;border-radius:10px;font-size:14px;font-weight:500;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.dept-alert-success{background:rgba(26,127,55,.1);color:var(--status-success);border:1px solid rgba(26,127,55,.2)}
.dept-alert-danger{background:rgba(207,34,46,.1);color:var(--status-error);border:1px solid rgba(207,34,46,.2)}
.dept-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px}
.dept-search-wrap{position:relative;flex:1;min-width:200px}
.dept-search-wrap svg{position:absolute;top:50%;left:12px;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;pointer-events:none}
.dept-search-wrap input{width:100%;padding:9px 12px 9px 36px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s}
.dept-search-wrap input:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.dept-search-wrap input::placeholder{color:var(--text-muted)}
.dept-count-badge{font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap}
.dept-section-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid var(--border-color)}
.dept-form-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;margin-bottom:24px;transition:box-shadow .18s}
.dept-form-card:hover{box-shadow:0 2px 10px rgba(0,0,0,.06)}
.dept-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px;margin-bottom:18px}
.dept-form-grid-full{grid-template-columns:1fr}
.dept-form-group{display:flex;flex-direction:column;gap:6px}
.dept-form-label{font-size:13px;font-weight:600;color:var(--text-main)}
.dept-form-label span{color:var(--status-error);margin-inline-start:2px}
.dept-form-input,.dept-form-textarea{width:100%;padding:10px 14px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s;font-family:inherit}
.dept-form-input:focus,.dept-form-textarea:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.dept-form-textarea{min-height:80px;resize:vertical}
.dept-form-actions{display:flex;gap:10px;align-items:center}
.dept-submit-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.dept-submit-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.dept-submit-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.dept-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.dept-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;transition:transform .18s,box-shadow .18s,border-color .18s;overflow:hidden;display:flex;flex-direction:column}
.dept-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1);border-color:var(--primary)}
.dept-card-header{padding:20px 20px 0;display:flex;align-items:flex-start;justify-content:space-between;gap:12px}
.dept-card-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:20px}
.dept-card-icon-active{background:rgba(26,127,55,.1)}
.dept-card-icon-inactive{background:var(--border-color)}
.dept-card-title-area{flex:1;min-width:0}
.dept-card-name{font-size:16px;font-weight:700;color:var(--text-main);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.dept-card-id{font-size:11px;color:var(--text-muted);font-family:monospace;margin-top:2px}
.dept-card-body{padding:14px 20px 0;flex:1}
.dept-card-desc{font-size:13px;color:var(--text-muted);line-height:1.5;margin:0;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.dept-card-desc-empty{color:var(--text-muted);font-style:italic;opacity:.7}
.dept-card-meta{display:flex;flex-wrap:wrap;gap:14px;padding:14px 20px 0;border-top:1px solid var(--border-color);margin-top:14px}
.dept-card-meta-item{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text-muted)}
.dept-card-meta-item svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0;opacity:.6}
.dept-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.3px;text-transform:uppercase}
.dept-badge-active{background:rgba(26,127,55,.1);color:var(--status-success)}
.dept-badge-inactive{background:var(--border-color);color:var(--text-muted)}
.dept-card-footer{padding:14px 20px;border-top:1px solid var(--border-color);margin-top:auto;display:flex;justify-content:flex-end}
.dept-delete-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:all .18s;border:1px solid transparent;background:transparent;color:var(--status-error);font-family:inherit}
.dept-delete-btn:hover{background:rgba(207,34,46,.08);border-color:rgba(207,34,46,.2)}
.dept-delete-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.dept-empty{text-align:center;padding:60px 20px;background:var(--card-bg);border:2px dashed var(--border-color);border-radius:14px}
.dept-empty-icon{font-size:48px;margin-bottom:16px;display:block;opacity:.5}
.dept-empty-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 8px}
.dept-empty-desc{font-size:14px;color:var(--text-muted);margin:0 0 20px;line-height:1.5}
.dept-empty-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3);text-decoration:none}
.dept-empty-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
@media(max-width:900px){.dept-hero{flex-direction:column;align-items:flex-start}.dept-grid{grid-template-columns:1fr}}
@media(max-width:640px){.dept-hero-btn{width:100%;justify-content:center}.dept-toolbar{flex-direction:column}.dept-form-grid{grid-template-columns:1fr}.dept-form-actions{flex-direction:column}.dept-submit-btn{width:100%;justify-content:center}.dept-card-header{flex-direction:column;align-items:flex-start;gap:10px}.dept-card-meta{flex-direction:column;gap:8px}}
[data-theme="dark"] .dept-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.3)}
[data-theme="dark"] .dept-card-desc-empty{opacity:.5}
</style>

<div class="dept-hero">
    <div class="dept-hero-left">
        <div class="dept-hero-icon">
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div>
            <h1 class="dept-hero-title">
                <%= t('hr.departments.title') %>
                <% if (departments && departments.length > 0) { %>
                    <span class="dept-hero-count"><%= departments.length %></span>
                <% } %>
            </h1>
            <p class="dept-hero-sub"><%= t('hr.departments.title_desc') %></p>
        </div>
    </div>
    <div class="dept-hero-actions">
        <a href="#dept-add-section" class="dept-hero-btn dept-hero-btn-primary">
            <svg viewBox="0 0 24 24" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <%= t('hr.departments.add_department') %>
        </a>
    </div>
</div>

<% if (message && message.type === 'success') { %>
    <div class="dept-alert dept-alert-success">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
        <%= message.text %>
    </div>
<% } %>
<% if (message && message.type === 'error') { %>
    <div class="dept-alert dept-alert-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <%= message.text %>
    </div>
<% } %>

<div id="dept-add-section">
    <h2 class="dept-section-title">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:var(--primary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;vertical-align:middle;margin-inline-end:8px"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.departments.add_department') %>
    </h2>
    <div class="dept-form-card">
        <form method="POST" action="/admin/hr/departments">
            <div class="dept-form-grid">
                <div class="dept-form-group">
                    <label class="dept-form-label" for="name"><%= t('hr.departments.name') %> <span>*</span></label>
                    <input type="text" name="name" class="dept-form-input" required dir="rtl" placeholder="<%= t('hr.departments.name') %>" id="name">
                </div>
            </div>
            <div class="dept-form-grid dept-form-grid-full">
                <div class="dept-form-group">
                    <label class="dept-form-label" for="description"><%= t('hr.departments.description') %></label>
                    <textarea name="description" class="dept-form-textarea" rows="3" dir="rtl" placeholder="<%= t('hr.departments.description') %>" id="description"></textarea>
                </div>
            </div>
            <div class="dept-form-actions">
                <button type="submit" class="dept-submit-btn">
                    <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    <%= t('hr.departments.add_department') %>
                </button>
            </div>
        </form>
    </div>
</div>

<h2 class="dept-section-title">
    <%= t('hr.departments.existing_departments') %>
</h2>

<div class="dept-toolbar">
    <div class="dept-search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="deptSearchInput" placeholder="<%= t('hr.departments.search_placeholder') %>" oninput="deptFilterDepartments()">
    </div>
    <span class="dept-count-badge" id="deptCountBadge">
        <% if (departments && departments.length > 0) { %>
            <%= departments.length %> <%= t('hr.departments.existing_departments') %>
        <% } %>
    </span>
</div>

<div class="dept-grid" id="deptGrid">
    <% if (departments && departments.length > 0) { %>
        <% departments.forEach(function(dept) { %>
            <div class="dept-card" data-dept-name="<%= (dept.name || '').toLowerCase() %>">
                <div class="dept-card-header">
                    <div class="dept-card-icon <%= dept.active === 1 ? 'dept-card-icon-active' : 'dept-card-icon-inactive' %>">
                        <% if (dept.active === 1) { %>
                            <svg viewBox="0 0 24 24" width="22" height="22" style="stroke:var(--status-success);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                        <% } else { %>
                            <svg viewBox="0 0 24 24" width="22" height="22" style="stroke:var(--text-muted);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                        <% } %>
                    </div>
                    <div class="dept-card-title-area">
                        <h3 class="dept-card-name"><%= dept.name %></h3>
                        <div class="dept-card-id">#<%= dept.id %></div>
                    </div>
                    <% if (dept.active === 1) { %>
                        <span class="dept-badge dept-badge-active"><%= t('hr.employees.active') %></span>
                    <% } else { %>
                        <span class="dept-badge dept-badge-inactive"><%= t('hr.employees.inactive') %></span>
                    <% } %>
                </div>
                <div class="dept-card-body">
                    <% if (dept.description) { %>
                        <p class="dept-card-desc"><%= dept.description %></p>
                    <% } else { %>
                        <p class="dept-card-desc dept-card-desc-empty"><%= t('hr.departments.description') %></p>
                    <% } %>
                </div>
                <div class="dept-card-meta">
                    <div class="dept-card-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <%= dept.created_at ? new Date(dept.created_at).toLocaleDateString() : '-' %>
                    </div>
                </div>
                <div class="dept-card-footer">
                    <form method="POST" action="/admin/hr/departments/<%= dept.id %>/delete" style="margin:0;" onsubmit='return confirm("<%= t('hr.departments.delete_confirm') %>");'>
                        <button type="submit" class="dept-delete-btn">
                            <svg viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
                            <%= t('forms.delete') %>
                        </button>
                    </form>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

<% if (!departments || departments.length === 0) { %>
    <div class="dept-empty">
        <span class="dept-empty-icon">🏢</span>
        <h3 class="dept-empty-title"><%= t('hr.departments.no_departments_found') %></h3>
        <p class="dept-empty-desc"><%= t('hr.departments.title_desc') %></p>
        <a href="#dept-add-section" class="dept-empty-btn">
            <svg viewBox="0 0 24 24" width="16" height="16" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <%= t('hr.departments.add_department') %>
        </a>
    </div>
<% } else { %>
    <div class="dept-empty" id="deptNoResults" style="display:none">
        <span class="dept-empty-icon">🔍</span>
        <h3 class="dept-empty-title"><%= t('hr.departments.no_departments_found') %></h3>
    </div>
<% } %>

<script>
function deptFilterDepartments() {
    var query = document.getElementById('deptSearchInput').value.toLowerCase().trim();
    var cards = document.querySelectorAll('.dept-card');
    var visibleCount = 0;
    cards.forEach(function(card) {
        var name = card.getAttribute('data-dept-name') || '';
        var match = !query || name.indexOf(query) !== -1;
        card.style.display = match ? '' : 'none';
        if (match) visibleCount++;
    });
    var badge = document.getElementById('deptCountBadge');
    var noResults = document.getElementById('deptNoResults');
    if (badge) {
        var total = cards.length;
        if (query && visibleCount < total) {
            badge.textContent = visibleCount + ' / ' + total;
        } else {
            badge.textContent = total + ' <%= t("hr.departments.existing_departments") %>';
        }
    }
    if (noResults) {
        noResults.style.display = visibleCount === 0 ? '' : 'none';
    }
    var grid = document.getElementById('deptGrid');
    if (grid) {
        grid.style.display = visibleCount === 0 ? 'none' : '';
    }
}
</script>

<%- include('../partials/footer') %>
