<%- include('../partials/header') %>

<style>
.lv-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.lv-hero-left{display:flex;align-items:center;gap:16px}
.lv-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
.lv-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.lv-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.lv-hero-count{display:inline-block;background:rgba(255,111,0,.1);color:var(--primary);font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;margin-inline-start:8px}
.lv-hero-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.lv-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.lv-hero-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.lv-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-hero-btn-outline{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:1px solid var(--border-color);text-decoration:none;white-space:nowrap;background:var(--card-bg);color:var(--text-main)}
.lv-hero-btn-outline:hover{background:var(--bg-color);border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
.lv-hero-btn-outline svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-context{background:var(--primary);color:#fff;padding:14px 20px;border-radius:10px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.lv-context-left{display:flex;align-items:center;gap:12px}
.lv-context-avatar{width:40px;height:40px;border-radius:8px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;overflow:hidden}
.lv-context-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.lv-context-name{font-size:16px;font-weight:600}
.lv-context-id{font-size:12px;opacity:.8;font-family:monospace}
.lv-context-label{font-size:13px;opacity:.9}
.lv-context-link{background:rgba(255,255,255,.2);color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:13px;transition:background .15s}
.lv-context-link:hover{background:rgba(255,255,255,.3)}
.lv-form-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;margin-bottom:24px}
.lv-section-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid var(--border-color);display:flex;align-items:center;gap:8px}
.lv-section-title svg{stroke:var(--primary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0}
.lv-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:16px}
.lv-form-group{display:flex;flex-direction:column;gap:6px}
.lv-form-label{font-size:13px;font-weight:600;color:var(--text-main)}
.lv-form-label span{color:var(--status-error);margin-inline-start:2px}
.lv-form-select,.lv-form-input,.lv-form-textarea{width:100%;padding:10px 14px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s;font-family:inherit}
.lv-form-select:focus,.lv-form-input:focus,.lv-form-textarea:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.lv-form-textarea{min-height:80px;resize:vertical}
.lv-submit-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.lv-submit-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.lv-submit-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px}
.lv-search-wrap{position:relative;flex:1;min-width:200px}
.lv-search-icon{position:absolute;inset-inline-start:12px;top:50%;transform:translateY(-50%);stroke:var(--text-muted);pointer-events:none}
.lv-search-input{width:100%;padding:9px 12px;padding-inline-start:36px;font-size:13px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s}
.lv-search-input:focus{border-color:var(--accent-blue);outline:none}
.lv-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.lv-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;overflow:hidden;transition:transform .18s,box-shadow .18s,border-color .18s}
.lv-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.08);border-color:var(--primary)}
.lv-card-header{padding:16px 18px;display:flex;align-items:center;gap:12px;border-bottom:1px solid var(--border-color)}
.lv-card-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#fff;flex-shrink:0;background:linear-gradient(135deg,var(--primary),var(--primary-dark));overflow:hidden}
.lv-card-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.lv-card-identity{flex:1;min-width:0}
.lv-card-name{font-size:15px;font-weight:700;color:var(--text-main);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.lv-card-id{font-size:11px;color:var(--text-muted);font-family:monospace;margin-top:1px}
.lv-card-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:12px;font-weight:600;white-space:nowrap}
.lv-badge-pending{background:rgba(212,167,44,.15);color:var(--safety-orange);border:1px solid rgba(212,167,44,.25)}
.lv-badge-approved{background:rgba(26,127,55,.1);color:var(--status-success);border:1px solid rgba(26,127,55,.2)}
.lv-badge-rejected{background:rgba(207,34,46,.1);color:var(--status-error);border:1px solid rgba(207,34,46,.2)}
.lv-card-type{padding:10px 18px 0;font-size:13px;font-weight:600;color:var(--primary);display:flex;align-items:center;gap:6px}
.lv-card-type svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-card-body{padding:10px 18px 14px;display:grid;grid-template-columns:1fr 1fr;gap:10px}
.lv-card-field{display:flex;flex-direction:column;gap:2px}
.lv-card-field-label{font-size:11px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.4px}
.lv-card-field-value{font-size:14px;font-weight:600;color:var(--text-main)}
.lv-card-field-value.days{font-weight:800;color:var(--primary)}
.lv-card-reason{padding:0 18px 14px;font-size:13px;color:var(--text-muted);font-style:italic}
.lv-card-actions{padding:12px 18px;border-top:1px solid var(--border-color);display:flex;gap:8px;flex-wrap:wrap}
.lv-btn-approve{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:all .18s;border:none;background:var(--status-success);color:#fff;box-shadow:0 2px 6px rgba(26,127,55,.2)}
.lv-btn-approve:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(26,127,55,.3)}
.lv-btn-reject{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:all .18s;border:none;background:var(--status-error);color:#fff;box-shadow:0 2px 6px rgba(207,34,46,.2)}
.lv-btn-reject:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(207,34,46,.3)}
.lv-btn-approve svg,.lv-btn-reject svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-empty{text-align:center;padding:60px 20px;background:var(--card-bg);border:2px dashed var(--border-color);border-radius:14px}
.lv-empty-icon{width:64px;height:64px;border-radius:16px;background:var(--bg-color);border:2px dashed var(--border-color);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
.lv-empty-icon svg{width:28px;height:28px;stroke:var(--text-muted);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;fill:none}
.lv-empty-title{font-size:16px;font-weight:600;color:var(--text-main);margin:0 0 4px}
.lv-empty-sub{font-size:13px;color:var(--text-muted);margin:0}
.lv-form-group-mb{margin-bottom:16px}
.lv-filter-select{width:auto;padding:7px 12px;font-size:13px}
@media(max-width:900px){.lv-grid{grid-template-columns:1fr}.lv-card-body{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.lv-hero{flex-direction:column;align-items:flex-start}.lv-hero-actions{width:100%}.lv-hero-btn,.lv-hero-btn-outline{width:100%;justify-content:center}.lv-toolbar{flex-direction:column}.lv-search-wrap{width:100%}.lv-form-grid{grid-template-columns:1fr}.lv-card-body{grid-template-columns:1fr}.lv-card-actions{flex-direction:column}.lv-btn-approve,.lv-btn-reject{width:100%;justify-content:center}}
</style>

<div class="card">
    <% if (contextEmployee) { %>
        <div class="lv-context">
            <div class="lv-context-left">
                <div class="lv-context-avatar"><% if (contextEmployee.photo_path) { %><img src="/<%= contextEmployee.photo_path %>" alt="<%= contextEmployee.full_name %>"><% } else { %><%= contextEmployee.full_name.charAt(0).toUpperCase() %><% } %></div>
                <div>
                    <div class="lv-context-label"><%= t('hr.employees.full_name') %></div>
                    <div class="lv-context-name"><%= contextEmployee.full_name %></div>
                    <div class="lv-context-id"><%= contextEmployee.employee_id || 'N/A' %></div>
                </div>
            </div>
            <a href="/admin/hr/employees/<%= contextEmployee.id %>" class="lv-context-link">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                <%= t('hr.employees.back_to_list') %>
            </a>
        </div>
    <% } %>

    <div class="lv-hero">
        <div class="lv-hero-left">
            <div class="lv-hero-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
            <div>
                <h1 class="lv-hero-title"><%= t('hr.leave.title') %><% if (leaveRequests && leaveRequests.length > 0) { %><span class="lv-hero-count"><%= leaveRequests.length %></span><% } %></h1>
                <p class="lv-hero-sub"><%= t('hr.leave.title_desc') %></p>
            </div>
        </div>
        <div class="lv-hero-actions">
            <a href="/admin/hr/leave-balances" class="lv-hero-btn-outline">
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                <%= t('hr.leave.view_leave_balance') %>
            </a>
            <a href="#lv-form" class="lv-hero-btn">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                <%= t('hr.leave.add_leave_request') %>
            </a>
        </div>
    </div>

    <div class="lv-form-card" id="lv-form">
        <h3 class="lv-section-title">
            <svg viewBox="0 0 24 24" width="20" height="20"><path d="M12 5v14M5 12h14"/></svg>
            <%= t('hr.leave.add_leave_request') %>
        </h3>
        <form method="POST" action="/admin/hr/leave">
            <% if (contextEmployee) { %>
                <input type="hidden" name="context_employee_id" value="<%= contextEmployee.id %>">
            <% } %>
            <div class="lv-form-grid">
                <div class="lv-form-group">
                    <label class="lv-form-label" for="employee_id"><%= t('hr.leave.employee') %> <span>*</span></label>
                    <select name="employee_id" class="lv-form-select" required id="employee_id">
                        <option value=""><%= t('hr.leave.select_employee') %></option>
                        <% if (employees && employees.length > 0) { %>
                            <% employees.forEach(function(emp) { %>
                                <option value="<%= emp.id %>" <%= contextEmployee && contextEmployee.id == emp.id ? 'selected' : '' %>><%= emp.full_name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="lv-form-group">
                    <label class="lv-form-label" for="leave_type_id"><%= t('hr.leave.type') %> <span>*</span></label>
                    <select name="leave_type_id" class="lv-form-select" required id="leave_type_id">
                        <option value=""><%= t('hr.leave.select_type') %></option>
                        <% if (leaveTypes && leaveTypes.length > 0) { %>
                            <% leaveTypes.forEach(function(lt) { %>
                                <option value="<%= lt.id %>"><%= lt.name %> (<%= lt.default_days %> <%= t('hr.leave.days') %>)</option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="lv-form-group">
                    <label class="lv-form-label" for="start_date"><%= t('hr.leave.start_date') %> <span>*</span></label>
                    <input type="text" name="start_date" class="lv-form-input" required data-datepicker="jalali" placeholder="مثلاً ۱۴۰۳/۰۱/۰۱" dir="ltr" id="start_date">
                </div>
                <div class="lv-form-group">
                    <label class="lv-form-label" for="end_date"><%= t('hr.leave.end_date') %> <span>*</span></label>
                    <input type="text" name="end_date" class="lv-form-input" required data-datepicker="jalali" placeholder="مثلاً ۱۴۰۳/۰۱/۰۵" dir="ltr" id="end_date">
                </div>
            </div>
            <div class="lv-form-group lv-form-group-mb">
                <label class="lv-form-label" for="reason"><%= t('hr.leave.reason') %></label>
                <textarea name="reason" class="lv-form-textarea" rows="2" dir="rtl" id="reason"></textarea>
            </div>
            <button type="submit" class="lv-submit-btn">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
                <%= t('hr.leave.add_leave_request') %>
            </button>
        </form>
    </div>

    <div class="lv-toolbar">
        <div class="lv-search-wrap">
            <svg class="lv-search-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="text" class="lv-search-input" id="lvSearchInput" placeholder="<%= t('hr.leave.request_leave') %>..." oninput="filterLeave()">
        </div>
        <select class="lv-form-select lv-filter-select" id="lvStatusFilter" onchange="filterLeave()">
            <option value=""><%= t('hr.leave.status') %></option>
            <option value="Pending"><%= t('hr.leave.pending') %></option>
            <option value="Approved"><%= t('hr.leave.approved') %></option>
            <option value="Rejected"><%= t('hr.leave.rejected') %></option>
        </select>
    </div>

    <div id="lvRecordsList">
        <% if (leaveRequests && leaveRequests.length > 0) { %>
            <div class="lv-grid">
                <% leaveRequests.forEach(function(leave) { %>
                    <div class="lv-card" data-search="<%= (leave.full_name + ' ' + (leave.employee_id || '') + ' ' + (leave.leave_type_name || '') + ' ' + (leave.reason || '')).toLowerCase() %>" data-status="<%= leave.status %>">
                        <div class="lv-card-header">
                            <div class="lv-card-avatar"><% if (leave.photo_path) { %><img src="/<%= leave.photo_path %>" alt="<%= leave.full_name %>"><% } else { %><%= leave.full_name.charAt(0).toUpperCase() %><% } %></div>
                            <div class="lv-card-identity">
                                <div class="lv-card-name"><%= leave.full_name %></div>
                                <div class="lv-card-id"><%= leave.employee_id || 'N/A' %></div>
                            </div>
                            <% if (leave.status === 'Approved') { %>
                                <span class="lv-card-badge lv-badge-approved"><%= t('hr.leave.approved') %></span>
                            <% } else if (leave.status === 'Rejected') { %>
                                <span class="lv-card-badge lv-badge-rejected"><%= t('hr.leave.rejected') %></span>
                            <% } else if (leave.status === 'Pending') { %>
                                <span class="lv-card-badge lv-badge-pending"><%= t('hr.leave.pending') %></span>
                            <% } else { %>
                                <span class="lv-card-badge"><%= leave.status %></span>
                            <% } %>
                        </div>
                        <div class="lv-card-type">
                            <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
                            <%= leave.leave_type_name %>
                        </div>
                        <div class="lv-card-body">
                            <div class="lv-card-field">
                                <span class="lv-card-field-label"><%= t('hr.leave.start_date') %></span>
                                <span class="lv-card-field-value"><%= leave.start_date %></span>
                            </div>
                            <div class="lv-card-field">
                                <span class="lv-card-field-label"><%= t('hr.leave.end_date') %></span>
                                <span class="lv-card-field-value"><%= leave.end_date %></span>
                            </div>
                            <div class="lv-card-field">
                                <span class="lv-card-field-label"><%= t('hr.leave.days') %></span>
                                <span class="lv-card-field-value days"><%= leave.days %></span>
                            </div>
                        </div>
                        <% if (leave.reason) { %>
                            <div class="lv-card-reason"><%= leave.reason %></div>
                        <% } %>
                        <% if (leave.status === 'Pending') { %>
                            <div class="lv-card-actions">
                                <form method="POST" action="/admin/hr/leave/<%= leave.id %>/approve" style="display:inline">
                                    <button type="submit" class="lv-btn-approve">
                                        <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                                        <%= t('hr.leave.approved') %>
                                    </button>
                                </form>
                                <form method="POST" action="/admin/hr/leave/<%= leave.id %>/reject" style="display:inline">
                                    <button type="submit" class="lv-btn-reject" onclick="return confirm('<%= t('hr.leave.rejected') %>?')">
                                        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                        <%= t('hr.leave.rejected') %>
                                    </button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="lv-empty">
                <div class="lv-empty-icon">
                    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </div>
                <p class="lv-empty-title"><%= t('hr.leave.no_requests_found') %></p>
                <p class="lv-empty-sub"><%= t('hr.leave.add_leave_request') %></p>
            </div>
        <% } %>
    </div>
</div>

<script>
function filterLeave() {
    var search = document.getElementById('lvSearchInput').value.toLowerCase();
    var status = document.getElementById('lvStatusFilter').value;
    var cards = document.querySelectorAll('.lv-card');
    cards.forEach(function(card) {
        var matchesSearch = !search || card.getAttribute('data-search').indexOf(search) !== -1;
        var matchesStatus = !status || card.getAttribute('data-status') === status;
        card.style.display = matchesSearch && matchesStatus ? '' : 'none';
    });
}
</script>
