<%- include('../partials/header') %>

<style>
.ea-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.ea-hero-left{display:flex;align-items:center;gap:16px}
.ea-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
.ea-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.ea-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.ea-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.ea-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:all .18s;border:1px solid var(--border-color);text-decoration:none;white-space:nowrap;background:var(--card-bg);color:var(--text-main)}
.ea-hero-btn:hover{background:var(--bg-color);border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
.ea-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.ea-form{display:flex;flex-direction:column;gap:24px}
.ea-section{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;transition:border-color .15s}
.ea-section:hover{border-color:rgba(255,111,0,.2)}
.ea-section-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 20px;padding-bottom:12px;border-bottom:2px solid var(--border-color);display:flex;align-items:center;gap:10px}
.ea-section-title svg{stroke:var(--primary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0}
.ea-photo-area{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.ea-photo-circle{width:100px;height:100px;border-radius:50%;background:var(--bg-color);border:2px dashed var(--border-color);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;transition:border-color .15s}
.ea-photo-circle:hover{border-color:var(--primary)}
.ea-photo-circle svg{width:32px;height:32px;stroke:var(--text-muted);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;fill:none}
.ea-photo-circle img{width:100%;height:100%;object-fit:cover;display:none}
.ea-photo-actions{display:flex;flex-direction:column;gap:6px}
.ea-photo-btn{display:inline-flex;align-items:center;gap:6px;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:all .18s;border:1px solid var(--border-color);background:var(--bg-color);color:var(--text-main)}
.ea-photo-btn:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
.ea-photo-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.ea-photo-hint{font-size:12px;color:var(--text-muted)}
.ea-photo-remove{background:none;border:none;color:var(--status-error);font-size:12px;cursor:pointer;padding:2px 0;font-weight:600;display:none;transition:opacity .15s}
.ea-photo-remove:hover{opacity:.8}
.ea-photo-input{display:none}
.ea-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.ea-grid-full{grid-template-columns:1fr}
.ea-field{display:flex;flex-direction:column;gap:6px}
.ea-label{font-size:13px;font-weight:600;color:var(--text-main)}
.ea-label span{color:var(--status-error);margin-inline-start:2px}
.ea-input,.ea-select,.ea-textarea{width:100%;padding:10px 14px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s;font-family:inherit}
.ea-input:focus,.ea-select:focus,.ea-textarea:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.ea-textarea{min-height:80px;resize:vertical}
.ea-hint{font-size:12px;color:var(--text-muted);margin-top:2px}
.ea-actions{display:flex;gap:12px;flex-wrap:wrap;padding-top:8px}
.ea-btn-submit{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:10px;font-size:15px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.ea-btn-submit:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.ea-btn-submit svg{width:18px;height:18px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.ea-btn-cancel{display:inline-flex;align-items:center;gap:8px;padding:12px 28px;border-radius:10px;font-size:15px;font-weight:600;cursor:pointer;transition:all .18s;border:1px solid var(--border-color);background:var(--card-bg);color:var(--text-main);text-decoration:none}
.ea-btn-cancel:hover{background:var(--bg-color);border-color:var(--status-error);color:var(--status-error);transform:translateY(-1px)}
@media(max-width:900px){.ea-grid{grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}}
@media(max-width:640px){.ea-hero{flex-direction:column;align-items:flex-start}.ea-hero-btn{width:100%;justify-content:center}.ea-grid{grid-template-columns:1fr}.ea-photo-area{flex-direction:column;align-items:flex-start}.ea-actions{flex-direction:column}.ea-btn-submit,.ea-btn-cancel{width:100%;justify-content:center}.ea-docs-grid{grid-template-columns:1fr!important}}
.ea-docs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
.ea-doc-field{display:flex;flex-direction:column;gap:6px}
.ea-doc-label{font-size:13px;font-weight:600;color:var(--text-main)}
.ea-doc-input{width:100%;padding:10px 14px;font-size:13px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);font-family:inherit}
.ea-doc-input:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.ea-doc-hint{font-size:11px;color:var(--text-muted);margin-top:2px}
.ea-doc-filename{font-size:12px;color:var(--primary);font-weight:600;margin-top:4px;display:none;word-break:break-all}
@media(max-width:640px){.ea-docs-grid{grid-template-columns:1fr}}
</style>

<div class="card">
    <div class="ea-hero">
        <div class="ea-hero-left">
            <div class="ea-hero-icon">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            </div>
            <div>
                <h1 class="ea-hero-title"><%= t('hr.employees.add_employee') %></h1>
                <p class="ea-hero-sub"><%= t('hr.employees.title_desc') %></p>
            </div>
        </div>
        <a href="/admin/hr/employees" class="ea-hero-btn">
            <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
            <%= t('hr.employees.back_to_list') %>
        </a>
    </div>

    <form method="POST" action="/admin/hr/employees/add" enctype="multipart/form-data" class="ea-form">

        <!-- Photo Upload -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <%= t('hr.employees.photo') %>
            </h3>
            <div class="ea-photo-area">
                <div class="ea-photo-circle" id="eaPhotoCircle">
                    <svg id="eaPhotoIcon" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                    <img id="eaPhotoImg" src="" alt="">
                </div>
                <div class="ea-photo-actions">
                    <input type="file" name="employee_photo" id="employeePhotoInput" class="ea-photo-input" accept="image/jpeg,image/png,image/webp" onchange="previewEmployeePhoto(this)">
                    <button type="button" onclick="document.getElementById('employeePhotoInput').click();" class="ea-photo-btn">
                        <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        <%= t('hr.employees.choose_photo') %>
                    </button>
                    <div class="ea-photo-hint"><%= t('hr.employees.photo_hint') %></div>
                    <button type="button" id="removePhotoBtn" class="ea-photo-remove" onclick="removeEmployeePhoto()">
                        <svg viewBox="0 0 24 24" width="12" height="12" style="display:inline;vertical-align:-1px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        <%= t('hr.employees.remove_photo') %>
                    </button>
                </div>
            </div>
        </div>

        <!-- Personal Information -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                <%= t('hr.employees.personal_info') %>
            </h3>
            <div class="ea-grid">
                <div class="ea-field">
                    <label class="ea-label" for="employee_id"><%= t('hr.employees.employee_id') %> (<%= t('forms.optional') %>)</label>
                    <input type="text" name="employee_id" class="ea-input" dir="ltr" placeholder="EMP-..." id="employee_id">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="full_name"><%= t('hr.employees.full_name') %> <span>*</span></label>
                    <input type="text" name="full_name" class="ea-input" required dir="rtl" id="full_name">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="father_name"><%= t('hr.employees.father_name') %></label>
                    <input type="text" name="father_name" class="ea-input" dir="rtl" id="father_name">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="date_of_birth"><%= t('hr.employees.date_of_birth') %></label>
                    <input type="text" id="date_of_birth" name="date_of_birth" class="ea-input" data-datepicker="jalali" data-datepicker-allow-manual="true" placeholder="YYYY/MM/DD" dir="ltr">
                    <span class="ea-hint"><%= t('hr.employees.date_hint') %></span>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="gender"><%= t('hr.employees.gender') %></label>
                    <select name="gender" class="ea-select" id="gender">
                        <option value=""><%= t('forms.select') %></option>
                        <option value="Male"><%= t('hr.employees.male') %></option>
                        <option value="Female"><%= t('hr.employees.female') %></option>
                    </select>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="phone"><%= t('hr.employees.phone') %> <span>*</span></label>
                    <input type="tel" name="phone" class="ea-input" required dir="ltr" id="phone">
                </div>
                <div class="ea-field ea-grid-full">
                    <label class="ea-label" for="address"><%= t('hr.employees.address') %></label>
                    <textarea name="address" class="ea-textarea" rows="2" dir="rtl" id="address"></textarea>
                </div>
            </div>
        </div>

        <!-- Emergency Contact -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <%= t('hr.employees.emergency_contact') %>
            </h3>
            <div class="ea-grid">
                <div class="ea-field">
                    <label class="ea-label" for="emergency_contact_name"><%= t('hr.employees.emergency_contact_name') %></label>
                    <input type="text" name="emergency_contact_name" class="ea-input" dir="rtl" id="emergency_contact_name">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="emergency_contact_phone"><%= t('hr.employees.emergency_contact_phone') %></label>
                    <input type="tel" name="emergency_contact_phone" class="ea-input" dir="ltr" id="emergency_contact_phone">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="emergency_contact_relationship"><%= t('hr.employees.emergency_contact_relationship') %></label>
                    <input type="text" name="emergency_contact_relationship" class="ea-input" dir="rtl" id="emergency_contact_relationship">
                </div>
            </div>
        </div>

        <!-- Employment Information -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                <%= t('hr.employees.employment_info') %>
            </h3>
            <div class="ea-grid">
                <div class="ea-field">
                    <label class="ea-label" for="department_id"><%= t('hr.employees.department') %></label>
                    <select name="department_id" class="ea-select" id="department_id">
                        <option value=""><%= t('forms.select') %></option>
                        <% if (departments && departments.length > 0) { %>
                            <% departments.forEach(function(dept) { %>
                                <option value="<%= dept.id %>"><%= dept.name %></option>
                            <% }); %>
                        <% } else { %>
                            <option value="" disabled><%= t('hr.departments.no_departments_found') %></option>
                        <% } %>
                    </select>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="position"><%= t('hr.employees.position') %></label>
                    <input type="text" name="position" class="ea-input" dir="rtl" id="position">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="work_schedule_id"><%= t('hr.employees.work_schedule') %> <span>*</span></label>
                    <select name="work_schedule_id" class="ea-select" required id="work_schedule_id">
                        <option value=""><%= t('forms.select') %></option>
                        <% if (workSchedules && workSchedules.length > 0) { %>
                            <% workSchedules.forEach(function(sch) { %>
                                <option value="<%= sch.id %>"><%= sch.name %> &mdash; <%= sch.expected_check_in %>&ndash;<%= sch.expected_check_out %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="hire_date"><%= t('hr.employees.hire_date') %></label>
                    <input type="text" id="hire_date" name="hire_date" class="ea-input" data-datepicker="jalali" data-datepicker-allow-manual="true" placeholder="YYYY/MM/DD" dir="ltr">
                    <span class="ea-hint"><%= t('hr.employees.date_hint') %></span>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="status"><%= t('hr.employees.status') %></label>
                    <select name="status" class="ea-select" id="status">
                        <option value=""><%= t('forms.select') %></option>
                        <option value="Active"><%= t('hr.employees.active') %></option>
                        <option value="Inactive"><%= t('hr.employees.inactive') %></option>
                    </select>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="work_location"><%= t('hr.employees.work_location') %></label>
                    <input type="text" name="work_location" class="ea-input" dir="rtl" placeholder="<%= t('hr.employees.work_location_placeholder') %>" id="work_location">
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="contract_type"><%= t('hr.employees.contract_type') %></label>
                    <select name="contract_type" class="ea-select" id="contract_type">
                        <option value=""><%= t('forms.select') %></option>
                        <option value="Permanent"><%= t('hr.employees.permanent') %></option>
                        <option value="Temporary"><%= t('hr.employees.temporary') %></option>
                        <option value="Contract"><%= t('hr.employees.contract') %></option>
                        <option value="Daily Worker"><%= t('hr.employees.daily_worker') %></option>
                    </select>
                </div>
                <div class="ea-field">
                    <label class="ea-label" for="payment_method"><%= t('hr.employees.payment_method') %></label>
                    <select name="payment_method" class="ea-select" id="payment_method">
                        <option value=""><%= t('forms.select') %></option>
                        <option value="Cash"><%= t('hr.employees.cash') %></option>
                        <option value="Bank Transfer"><%= t('hr.employees.bank_transfer') %></option>
                    </select>
                </div>
            </div>
        </div>

        <!-- Compensation -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                <%= t('hr.employees.compensation') %>
            </h3>
            <div class="ea-grid">
                <div class="ea-field">
                    <label class="ea-label" for="salary"><%= t('hr.employees.amount_of_salary') %></label>
                    <input type="number" name="salary" class="ea-input" placeholder="0" min="0" step="0.01" dir="ltr" id="salary">
                </div>
            </div>
        </div>

        <!-- Employee Documents (C4.2) -->
        <div class="ea-section">
            <h3 class="ea-section-title">
                <svg viewBox="0 0 24 24" width="20" height="20"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <%= t('hr.employees.documents') %>
            </h3>
            <div class="ea-docs-grid">
                <div class="ea-doc-field">
                    <label class="ea-doc-label" for="document_tazkira_passport"><%= t('hr.employees.doc_tazkira_passport') %></label>
                    <input type="file" name="document_tazkira_passport" class="ea-doc-input" accept=".pdf,application/pdf" onchange="previewDocName(this, 'doc_tazkira_name')" id="document_tazkira_passport">
                    <span class="ea-doc-hint"><%= t('hr.employees.doc_hint') %></span>
                    <span class="ea-doc-filename" id="doc_tazkira_name"></span>
                </div>
                <div class="ea-doc-field">
                    <label class="ea-doc-label" for="document_cv"><%= t('hr.employees.doc_cv') %></label>
                    <input type="file" name="document_cv" class="ea-doc-input" accept=".pdf,application/pdf" onchange="previewDocName(this, 'doc_cv_name')" id="document_cv">
                    <span class="ea-doc-hint"><%= t('hr.employees.doc_hint') %></span>
                    <span class="ea-doc-filename" id="doc_cv_name"></span>
                </div>
                <div class="ea-doc-field">
                    <label class="ea-doc-label" for="document_degrees_certificates"><%= t('hr.employees.doc_degrees_certificates') %></label>
                    <input type="file" name="document_degrees_certificates" class="ea-doc-input" accept=".pdf,application/pdf" onchange="previewDocName(this, 'doc_degrees_name')" id="document_degrees_certificates">
                    <span class="ea-doc-hint"><%= t('hr.employees.doc_hint') %></span>
                    <span class="ea-doc-filename" id="doc_degrees_name"></span>
                </div>
                <div class="ea-doc-field">
                    <label class="ea-doc-label" for="document_other"><%= t('hr.employees.doc_other') %></label>
                    <input type="file" name="document_other" class="ea-doc-input" accept=".pdf,application/pdf" onchange="previewDocName(this, 'doc_other_name')" id="document_other">
                    <span class="ea-doc-hint"><%= t('hr.employees.doc_hint') %></span>
                    <span class="ea-doc-filename" id="doc_other_name"></span>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="ea-actions">
            <button type="submit" class="ea-btn-submit">
                <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
                <%= t('hr.employees.add_employee') %>
            </button>
            <a href="/admin/hr/employees" class="ea-btn-cancel">
                <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <%= t('forms.cancel') %>
            </a>
        </div>
    </form>
</div>

<script>
function previewEmployeePhoto(input) {
    if (input.files && input.files[0]) {
        var file = input.files[0];
        if (file.size > 5 * 1024 * 1024) {
            alert('<%= t("hr.employees.photo_too_large") %>');
            input.value = '';
            return;
        }
        var reader = new FileReader();
        reader.onload = function(e) {
            var img = document.getElementById('eaPhotoImg');
            img.src = e.target.result;
            img.style.display = 'block';
            document.getElementById('eaPhotoIcon').style.display = 'none';
            document.getElementById('removePhotoBtn').style.display = 'inline-flex';
        };
        reader.readAsDataURL(file);
    }
}

function removeEmployeePhoto() {
    document.getElementById('employeePhotoInput').value = '';
    var img = document.getElementById('eaPhotoImg');
    img.src = '';
    img.style.display = 'none';
    document.getElementById('eaPhotoIcon').style.display = 'block';
    document.getElementById('removePhotoBtn').style.display = 'none';
}

function previewDocName(input, labelId) {
    var label = document.getElementById(labelId);
    if (input.files && input.files[0]) {
        var file = input.files[0];
        if (file.type !== 'application/pdf') {
            alert('<%= t("hr.employees.doc_invalid_type") %>');
            input.value = '';
            label.style.display = 'none';
            return;
        }
        if (file.size > 10 * 1024 * 1024) {
            alert('<%= t("hr.employees.doc_too_large") %>');
            input.value = '';
            label.style.display = 'none';
            return;
        }
        label.textContent = file.name;
        label.style.display = 'block';
    } else {
        label.style.display = 'none';
    }
}
</script>

