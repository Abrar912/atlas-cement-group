<%- include('../partials/header') %>

<style>
    .lte-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
    .lte-hero-left{display:flex;align-items:center;gap:16px}
    .lte-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
    .lte-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lte-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
    .lte-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
    .lte-hero-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .lte-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap;background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-color)}
    .lte-hero-btn:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
    .lte-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lte-form-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;max-width:600px}
    .lte-field{margin-bottom:20px}
    .lte-label{display:block;font-size:13px;font-weight:600;color:var(--text-main);margin-bottom:6px}
    .lte-input{width:100%;padding:10px 14px;border-radius:8px;border:1px solid var(--border-color);background:var(--bg-color);color:var(--text-main);font-size:14px;font-family:inherit;transition:border-color .15s,box-shadow .15s;box-sizing:border-box}
    .lte-input:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(255,111,0,.1)}
    .lte-textarea{min-height:80px;resize:vertical}
    .lte-check-row{display:flex;align-items:center;gap:10px}
    .lte-check{width:18px;height:18px;accent-color:var(--primary);cursor:pointer}
    .lte-check-label{font-size:14px;color:var(--text-main);cursor:pointer}
    .lte-actions{display:flex;gap:12px;margin-top:24px}
    .lte-save{padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;border:none;transition:all .18s;background:var(--primary);color:#fff}
    .lte-save:hover{opacity:.9;transform:translateY(-1px)}
    .lte-cancel{padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-color);text-decoration:none;display:inline-flex;align-items:center}
    .lte-cancel:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
    .lte-readonly{font-size:13px;color:var(--text-muted);margin-top:4px}
    @media(max-width:640px){.lte-hero{flex-direction:column;align-items:flex-start}.lte-hero-actions{width:100%}.lte-hero-btn{width:100%;justify-content:center}.lte-form-card{padding:16px}.lte-actions{flex-direction:column}.lte-actions a,.lte-actions button{width:100%;justify-content:center;text-align:center}}
</style>

<div class="card">
    <div class="lte-hero">
        <div class="lte-hero-left">
            <div class="lte-hero-icon">
                <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            </div>
            <div>
                <h1 class="lte-hero-title"><%= t('hr.leave.edit') %> — <%= leaveType.name %></h1>
                <p class="lte-hero-sub"><%= t('hr.leave.leave_type_management_desc') %></p>
            </div>
        </div>
        <div class="lte-hero-actions">
            <a href="/admin/hr/leave-types" class="lte-hero-btn">
                <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                <%= t('hr.leave.manage_leave_types') %>
            </a>
        </div>
    </div>

    <% if (session && session.message) { %>
        <div class="alert alert-<%= session.message.type %>" style="margin-bottom:16px">
            <%= session.message.text %>
        </div>
        <% session.message = null; %>
    <% } %>

    <div class="lte-form-card">
        <form method="POST" action="/admin/hr/leave-types/<%= leaveType.id %>/edit">
            <div class="lte-field">
                <label class="lte-label" for="name"><%= t('hr.leave.leave_type_name') %></label>
                <input class="lte-input" type="text" id="name" name="name" value="<%= leaveType.name %>" required>
            </div>

            <div class="lte-field">
                <label class="lte-label" for="description"><%= t('hr.leave.description') %></label>
                <textarea class="lte-input lte-textarea" id="description" name="description"><%= leaveType.description || '' %></textarea>
            </div>

            <div class="lte-field">
                <label class="lte-label" for="default_days"><%= t('hr.leave.default_days') %></label>
                <input class="lte-input" type="number" id="default_days" name="default_days" value="<%= leaveType.default_days %>" min="0" step="1" required>
                <p class="lte-readonly"><%= t('hr.leave.default_days') %> (<%= t('hr.leave.days') %>)</p>
            </div>

            <div class="lte-field">
                <div class="lte-check-row">
                    <input class="lte-check" type="checkbox" id="active" name="active" <%= leaveType.active ? 'checked' : '' %>>
                    <label class="lte-check-label" for="active"><%= t('hr.leave.active') %></label>
                </div>
            </div>

            <div class="lte-actions">
                <button type="submit" class="lte-save"><%= t('hr.leave.save_changes') %></button>
                <a href="/admin/hr/leave-types" class="lte-cancel"><%= t('hr.leave.cancel') %></a>
            </div>
        </form>
    </div>
</div>
