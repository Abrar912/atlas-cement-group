<%- include('../partials/header') %>

<style>
    .lt-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
    .lt-hero-left{display:flex;align-items:center;gap:16px}
    .lt-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
    .lt-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lt-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
    .lt-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
    .lt-hero-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .lt-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap;background:var(--card-bg);color:var(--text-main);border:1px solid var(--border-color)}
    .lt-hero-btn:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
    .lt-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lt-table-wrap{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;overflow:hidden}
    .lt-table{width:100%;border-collapse:collapse}
    .lt-table th{padding:14px 16px;text-align:left;font-size:12px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;background:var(--bg-color);border-bottom:2px solid var(--border-color);white-space:nowrap}
    .lt-table td{padding:14px 16px;font-size:14px;color:var(--text-main);border-bottom:1px solid var(--border-color);vertical-align:middle}
    .lt-table tr:last-child td{border-bottom:none}
    .lt-table tr:hover td{background:rgba(255,111,0,.02)}
    .lt-badge{display:inline-flex;align-items:center;gap:6px;padding:4px 12px;border-radius:20px;font-size:12px;font-weight:600}
    .lt-badge-active{background:rgba(16,185,129,.1);color:#10b981}
    .lt-badge-inactive{background:rgba(239,68,68,.1);color:#ef4444}
    .lt-badge-dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
    .lt-badge-active .lt-badge-dot{background:#10b981}
    .lt-badge-inactive .lt-badge-dot{background:#ef4444}
    .lt-days{font-size:16px;font-weight:700;color:var(--primary)}
    .lt-days-unit{font-size:12px;color:var(--text-muted);margin-inline-start:4px}
    .lt-edit-btn{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;transition:all .15s;border:1px solid var(--border-color);background:var(--card-bg);color:var(--text-main);text-decoration:none}
    .lt-edit-btn:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
    .lt-edit-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lt-empty{text-align:center;padding:60px 20px;background:var(--card-bg);border:2px dashed var(--border-color);border-radius:14px}
    .lt-empty-icon{width:64px;height:64px;border-radius:16px;background:var(--bg-color);border:2px dashed var(--border-color);display:flex;align-items:center;justify-content:center;margin:0 auto 16px}
    .lt-empty-icon svg{width:28px;height:28px;stroke:var(--text-muted);stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;fill:none}
    .lt-empty-title{font-size:16px;font-weight:600;color:var(--text-main);margin:0 0 4px}
    .lt-empty-sub{font-size:13px;color:var(--text-muted);margin:0}
    .lt-desc{font-size:13px;color:var(--text-muted)}
    @media(max-width:900px){.lt-table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch}}
    @media(max-width:640px){.lt-hero{flex-direction:column;align-items:flex-start}.lt-hero-actions{width:100%}.lt-hero-btn{width:100%;justify-content:center}.lt-table th,.lt-table td{padding:10px 12px;font-size:13px}}
</style>

<div class="card">
    <div class="lt-hero">
        <div class="lt-hero-left">
            <div class="lt-hero-icon">
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <div>
                <h1 class="lt-hero-title"><%= t('hr.leave.leave_type_management') %></h1>
                <p class="lt-hero-sub"><%= t('hr.leave.leave_type_management_desc') %></p>
            </div>
        </div>
        <div class="lt-hero-actions">
            <a href="/admin/hr/leave-balances" class="lt-hero-btn">
                <svg viewBox="0 0 24 24"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                <%= t('hr.leave.back_to_requests') %>
            </a>
        </div>
    </div>

    <% if (session && session.message) { %>
        <div class="alert alert-<%= session.message.type %>" style="margin-bottom:16px">
            <%= session.message.text %>
        </div>
        <% session.message = null; %>
    <% } %>

    <% if (leaveTypes && leaveTypes.length > 0) { %>
        <div class="lt-table-wrap">
            <table class="lt-table">
                <thead>
                    <tr>
                        <th><%= t('hr.leave.leave_type_name') %></th>
                        <th><%= t('hr.leave.description') %></th>
                        <th><%= t('hr.leave.default_days') %></th>
                        <th><%= t('hr.leave.status') %></th>
                        <th><%= t('hr.leave.action') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% leaveTypes.forEach(function(lt) { %>
                        <tr>
                            <td style="font-weight:700"><%= lt.name %></td>
                            <td class="lt-desc"><%= lt.description || '-' %></td>
                            <td>
                                <span class="lt-days"><%= lt.default_days %></span>
                                <span class="lt-days-unit"><%= t('hr.leave.days') %></span>
                            </td>
                            <td>
                                <% if (lt.active) { %>
                                    <span class="lt-badge lt-badge-active">
                                        <span class="lt-badge-dot"></span>
                                        <%= t('hr.leave.active') %>
                                    </span>
                                <% } else { %>
                                    <span class="lt-badge lt-badge-inactive">
                                        <span class="lt-badge-dot"></span>
                                        <%= t('hr.leave.inactive') %>
                                    </span>
                                <% } %>
                            </td>
                            <td>
                                <a href="/admin/hr/leave-types/<%= lt.id %>/edit" class="lt-edit-btn">
                                    <svg viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    <%= t('hr.leave.edit') %>
                                </a>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <div class="lt-empty">
            <div class="lt-empty-icon">
                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
            </div>
            <p class="lt-empty-title"><%= t('hr.leave.no_leave_types') %></p>
        </div>
    <% } %>
</div>
