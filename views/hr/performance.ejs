<%- include('../partials/header') %>

<style>
.perf-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.perf-hero-left{display:flex;align-items:center;gap:16px}
.perf-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
.perf-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.perf-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.perf-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.perf-hero-count{display:inline-block;background:rgba(255,111,0,.1);color:var(--primary);font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;margin-inline-start:8px}
.perf-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.perf-hero-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.perf-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.perf-context{background:var(--primary);color:#fff;padding:14px 20px;border-radius:10px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.perf-context-left{display:flex;align-items:center;gap:12px}
.perf-context-avatar{width:40px;height:40px;border-radius:8px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;overflow:hidden}
.perf-context-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.perf-context-name{font-size:16px;font-weight:600}
.perf-context-id{font-size:12px;opacity:.8;font-family:monospace}
.perf-context-label{font-size:13px;opacity:.9}
.perf-context-link{background:rgba(255,255,255,.2);color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:13px;transition:background .15s}
.perf-context-link:hover{background:rgba(255,255,255,.3)}
.perf-alert{padding:14px 18px;border-radius:10px;font-size:14px;font-weight:500;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.perf-alert-success{background:rgba(26,127,55,.1);color:var(--status-success);border:1px solid rgba(26,127,55,.2)}
.perf-alert-danger{background:rgba(207,34,46,.1);color:var(--status-error);border:1px solid rgba(207,34,46,.2)}
.perf-section-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid var(--border-color);display:flex;align-items:center;gap:8px}
.perf-section-title svg{stroke:var(--primary);stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0}
.perf-form-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;margin-bottom:24px}
.perf-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:16px}
.perf-form-grid-full{grid-template-columns:1fr}
.perf-form-group{display:flex;flex-direction:column;gap:6px}
.perf-form-label{font-size:13px;font-weight:600;color:var(--text-main)}
.perf-form-label span{color:var(--status-error);margin-inline-start:2px}
.perf-form-select,.perf-form-input,.perf-form-textarea{width:100%;padding:10px 14px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s;font-family:inherit}
.perf-form-select:focus,.perf-form-input:focus,.perf-form-textarea:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.perf-form-textarea{min-height:80px;resize:vertical}
.perf-ratings-title{font-size:14px;font-weight:700;color:var(--text-main);margin:0 0 12px;padding-top:8px;border-top:1px solid var(--border-color)}
.perf-rating-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:10px;padding:14px;display:flex;flex-direction:column;gap:8px;transition:border-color .15s}
.perf-rating-card:focus-within{border-color:var(--accent-blue)}
.perf-rating-label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px}
.perf-rating-input{display:flex;align-items:center;gap:8px}
.perf-rating-num{width:48px;padding:8px;font-size:16px;font-weight:700;text-align:center;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s}
.perf-rating-num:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.perf-rating-max{font-size:13px;color:var(--text-muted)}
.perf-rating-bar{height:6px;border-radius:3px;background:var(--border-color);overflow:hidden;flex:1}
.perf-rating-fill{height:100%;border-radius:3px;transition:width .3s}
.perf-submit-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.perf-submit-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.perf-submit-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.perf-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px}
.perf-search-wrap{position:relative;flex:1;min-width:200px}
.perf-search-wrap svg{position:absolute;top:50%;left:12px;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;pointer-events:none}
.perf-search-wrap input{width:100%;padding:9px 12px 9px 36px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s}
.perf-search-wrap input:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.perf-search-wrap input::placeholder{color:var(--text-muted)}
.perf-count-badge{font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap}
.perf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px}
.perf-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;overflow:hidden;transition:transform .18s,box-shadow .18s,border-color .18s}
.perf-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1);border-color:var(--primary)}
.perf-card-top{padding:18px 18px 0;display:flex;align-items:center;gap:12px}
.perf-card-avatar{width:42px;height:42px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden}
.perf-card-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.perf-card-identity{flex:1;min-width:0}
.perf-card-name{font-size:15px;font-weight:700;color:var(--text-main);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.perf-card-id{font-size:11px;color:var(--text-muted);font-family:monospace}
.perf-card-period{font-size:12px;font-weight:600;color:var(--primary);background:rgba(255,111,0,.08);padding:3px 10px;border-radius:20px;white-space:nowrap}
.perf-card-ratings{padding:14px 18px 0;display:grid;grid-template-columns:1fr 1fr;gap:8px}
.perf-card-rating{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:12px}
.perf-card-rating-label{color:var(--text-muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.perf-card-rating-value{font-weight:700;color:var(--text-main);white-space:nowrap}
.perf-card-rating-bar{flex:1;height:4px;border-radius:2px;background:var(--border-color);overflow:hidden;min-width:30px}
.perf-card-rating-fill{height:100%;border-radius:2px}
.perf-card-overall{padding:12px 18px;border-top:1px solid var(--border-color);display:flex;align-items:center;justify-content:space-between;gap:8px}
.perf-card-overall-label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px}
.perf-card-overall-score{font-size:20px;font-weight:800}
.perf-card-overall-bar{flex:1;height:8px;border-radius:4px;background:var(--border-color);overflow:hidden}
.perf-card-overall-fill{height:100%;border-radius:4px}
.perf-card-meta{padding:12px 18px;border-top:1px solid var(--border-color);display:flex;flex-wrap:wrap;gap:12px}
.perf-card-meta-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text-muted)}
.perf-card-meta-item svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0;opacity:.6}
.perf-card-comments{padding:12px 18px;border-top:1px solid var(--border-color);font-size:13px;color:var(--text-muted);line-height:1.5;font-style:italic}
.perf-empty{text-align:center;padding:60px 20px;background:var(--card-bg);border:2px dashed var(--border-color);border-radius:14px}
.perf-empty-icon{font-size:48px;margin-bottom:16px;display:block;opacity:.5}
.perf-empty-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 8px}
.perf-empty-desc{font-size:14px;color:var(--text-muted);margin:0 0 20px;line-height:1.5}
.perf-empty-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;box-shadow:0 2px 8px rgba(255,111,0,.3);text-decoration:none}
.perf-empty-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4)}
.perf-empty-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
@media(max-width:900px){.perf-hero{flex-direction:column;align-items:flex-start}.perf-grid{grid-template-columns:1fr}}
@media(max-width:640px){.perf-hero-btn{width:100%;justify-content:center}.perf-toolbar{flex-direction:column}.perf-form-grid{grid-template-columns:1fr}.perf-card-ratings{grid-template-columns:1fr}}
[data-theme="dark"] .perf-card:hover{box-shadow:0 8px 24px rgba(0,0,0,.3)}
</style>

<% if (contextEmployee) { %>
    <div class="perf-context">
        <div class="perf-context-left">
            <div class="perf-context-avatar"><% if (contextEmployee.photo_path) { %><img src="/<%= contextEmployee.photo_path %>" alt="<%= contextEmployee.full_name %>"><% } else { %><%= contextEmployee.full_name.charAt(0).toUpperCase() %><% } %></div>
            <div>
                <div class="perf-context-label"><%= t('hr.employees.full_name') %></div>
                <div class="perf-context-name"><%= contextEmployee.full_name %></div>
                <div class="perf-context-id"><%= contextEmployee.employee_id || 'N/A' %></div>
            </div>
        </div>
        <a href="/admin/hr/employees/<%= contextEmployee.id %>" class="perf-context-link">&larr; <%= t('hr.employees.back_to_list') %></a>
    </div>
<% } %>

<div class="perf-hero">
    <div class="perf-hero-left">
        <div class="perf-hero-icon">
            <svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        </div>
        <div>
            <h1 class="perf-hero-title">
                <%= t('hr.performance.title') %>
                <% if (performanceReviews && performanceReviews.length > 0) { %>
                    <span class="perf-hero-count"><%= performanceReviews.length %></span>
                <% } %>
            </h1>
            <p class="perf-hero-sub"><%= t('hr.performance.title_desc') %></p>
        </div>
    </div>
    <a href="#perf-add-section" class="perf-hero-btn">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.performance.add_review') %>
    </a>
</div>

<% if (typeof message !== 'undefined' && message && message.type === 'success') { %>
    <div class="perf-alert perf-alert-success">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
        <%= message.text %>
    </div>
<% } %>
<% if (typeof message !== 'undefined' && message && message.type === 'error') { %>
    <div class="perf-alert perf-alert-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <%= message.text %>
    </div>
<% } %>

<div id="perf-add-section">
    <h2 class="perf-section-title">
        <svg viewBox="0 0 24 24" width="18" height="18"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.performance.add_performance_review') %>
    </h2>
    <div class="perf-form-card">
        <form method="POST" action="/admin/hr/performance">
            <% if (contextEmployee) { %>
                <input type="hidden" name="context_employee_id" value="<%= contextEmployee.id %>">
            <% } %>
            <div class="perf-form-grid">
                <div class="perf-form-group">
                    <label class="perf-form-label" for="employee_id"><%= t('hr.performance.employee') %> <span>*</span></label>
                    <select name="employee_id" class="perf-form-select" required id="employee_id">
                        <option value=""><%= t('hr.leave.select_employee') %></option>
                        <% if (employees && employees.length > 0) { %>
                            <% employees.forEach(function(emp) { %>
                                <option value="<%= emp.id %>" <%= contextEmployee && contextEmployee.id == emp.id ? 'selected' : '' %>><%= emp.full_name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="perf-form-group">
                    <label class="perf-form-label" for="review_period"><%= t('hr.performance.review_period') %> <span>*</span></label>
                    <input type="text" name="review_period" class="perf-form-input" required data-datepicker="jalali" placeholder="1403/01" dir="ltr" id="review_period">
                </div>
                <div class="perf-form-group">
                    <label class="perf-form-label" for="reviewer_role"><%= t('hr.performance.reviewer') %></label>
                    <select name="reviewer_role" class="perf-form-select" id="reviewer_role">
                        <option value=""><%= t('hr.performance.select_reviewer') %></option>
                        <option value="QA Manager"><%= t('hr.performance.qa_manager') %></option>
                        <option value="General Manager"><%= t('hr.performance.general_manager') %></option>
                        <option value="HR Manager"><%= t('hr.performance.hr_manager') %></option>
                        <option value="Department Manager"><%= t('hr.performance.department_manager') %></option>
                        <option value="Direct Supervisor"><%= t('hr.performance.direct_supervisor') %></option>
                        <option value="Senior Manager"><%= t('hr.performance.senior_manager') %></option>
                        <option value="HR Officer"><%= t('hr.performance.hr_officer') %></option>
                        <option value="Team Leader"><%= t('hr.performance.team_leader') %></option>
                        <option value="Other"><%= t('hr.performance.other') %></option>
                    </select>
                </div>
            </div>
            <h4 class="perf-ratings-title"><%= t('hr.performance.rating_scale') %></h4>
            <div class="perf-form-grid">
                <div class="perf-rating-card">
                    <label class="perf-rating-label" for="attendance_rating"><%= t('hr.performance.attendance_rating') %> <span style="color:var(--status-error)">*</span></label>
                    <div class="perf-rating-input">
                        <input type="number" name="attendance_rating" class="perf-rating-num" required min="1" max="5" id="attendance_rating">
                        <span class="perf-rating-max">/ 5</span>
                        <div class="perf-rating-bar"><div class="perf-rating-fill" style="width:0%;background:var(--accent-blue)"></div></div>
                    </div>
                </div>
                <div class="perf-rating-card">
                    <label class="perf-rating-label" for="work_quality_rating"><%= t('hr.performance.work_quality_rating') %> <span style="color:var(--status-error)">*</span></label>
                    <div class="perf-rating-input">
                        <input type="number" name="work_quality_rating" class="perf-rating-num" required min="1" max="5" id="work_quality_rating">
                        <span class="perf-rating-max">/ 5</span>
                        <div class="perf-rating-bar"><div class="perf-rating-fill" style="width:0%;background:var(--status-success)"></div></div>
                    </div>
                </div>
                <div class="perf-rating-card">
                    <label class="perf-rating-label" for="discipline_rating"><%= t('hr.performance.discipline_rating') %> <span style="color:var(--status-error)">*</span></label>
                    <div class="perf-rating-input">
                        <input type="number" name="discipline_rating" class="perf-rating-num" required min="1" max="5" id="discipline_rating">
                        <span class="perf-rating-max">/ 5</span>
                        <div class="perf-rating-bar"><div class="perf-rating-fill" style="width:0%;background:var(--primary)"></div></div>
                    </div>
                </div>
                <div class="perf-rating-card">
                    <label class="perf-rating-label" for="teamwork_rating"><%= t('hr.performance.teamwork_rating') %> <span style="color:var(--status-error)">*</span></label>
                    <div class="perf-rating-input">
                        <input type="number" name="teamwork_rating" class="perf-rating-num" required min="1" max="5" id="teamwork_rating">
                        <span class="perf-rating-max">/ 5</span>
                        <div class="perf-rating-bar"><div class="perf-rating-fill" style="width:0%;background:var(--accent-blue)"></div></div>
                    </div>
                </div>
                <div class="perf-rating-card">
                    <label class="perf-rating-label" for="overall_rating"><%= t('hr.performance.overall_rating') %> <span style="color:var(--status-error)">*</span></label>
                    <div class="perf-rating-input">
                        <input type="number" name="overall_rating" class="perf-rating-num" required min="1" max="5" id="overall_rating">
                        <span class="perf-rating-max">/ 5</span>
                        <div class="perf-rating-bar"><div class="perf-rating-fill" style="width:0%;background:var(--primary)"></div></div>
                    </div>
                </div>
            </div>
            <div class="perf-form-grid perf-form-grid-full">
                <div class="perf-form-group">
                    <label class="perf-form-label" for="comments"><%= t('hr.performance.comments') %></label>
                    <textarea name="comments" class="perf-form-textarea" rows="3" placeholder="<%= t('hr.performance.detailed_feedback') %>" dir="rtl" id="comments"></textarea>
                </div>
            </div>
            <button type="submit" class="perf-submit-btn">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                <%= t('hr.performance.add_performance_review') %>
            </button>
        </form>
    </div>
</div>

<h2 class="perf-section-title">
    <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
    <%= t('hr.performance.performance_history') %>
</h2>

<div class="perf-toolbar">
    <div class="perf-search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="perfSearchInput" placeholder="<%= t('hr.performance.search_placeholder') %>" oninput="perfFilterReviews()">
    </div>
    <span class="perf-count-badge" id="perfCountBadge">
        <% if (performanceReviews && performanceReviews.length > 0) { %>
            <%= performanceReviews.length %> <%= t('hr.performance.performance_history') %>
        <% } %>
    </span>
</div>

<div class="perf-grid" id="perfGrid">
    <% if (performanceReviews && performanceReviews.length > 0) { %>
        <% performanceReviews.forEach(function(review) { %>
            <% var overall = review.overall_rating || 0; var barColor = overall >= 4 ? 'var(--status-success)' : overall >= 3 ? 'var(--accent-blue)' : overall >= 2 ? 'var(--primary)' : 'var(--status-error)'; %>
            <div class="perf-card" data-search="<%= (review.full_name || '').toLowerCase() %> <%= (review.review_period || '').toLowerCase() %> <%= (review.reviewer_role || '').toLowerCase() %>">
                <div class="perf-card-top">
                    <div class="perf-card-avatar" style="background:linear-gradient(135deg,<%= barColor %>,<%= barColor %>dd)"><% if (review.photo_path) { %><img src="/<%= review.photo_path %>" alt="<%= review.full_name %>"><% } else { %><%= review.full_name ? review.full_name.charAt(0).toUpperCase() : '?' %><% } %></div>
                    <div class="perf-card-identity">
                        <h3 class="perf-card-name"><%= review.full_name %></h3>
                        <div class="perf-card-id"><%= review.employee_id || 'N/A' %></div>
                    </div>
                    <span class="perf-card-period"><%= review.review_period %></span>
                </div>
                <div class="perf-card-ratings">
                    <div class="perf-card-rating">
                        <span class="perf-card-rating-label"><%= t('hr.performance.attendance_rating').replace(' (1-5)','').replace(' (۱-۵)','') %></span>
                        <div class="perf-card-rating-bar"><div class="perf-card-rating-fill" style="width:<%= (review.attendance_rating/5)*100 %>%;background:var(--accent-blue)"></div></div>
                        <span class="perf-card-rating-value"><%= review.attendance_rating %>/5</span>
                    </div>
                    <div class="perf-card-rating">
                        <span class="perf-card-rating-label"><%= t('hr.performance.work_quality_rating').replace(' (1-5)','').replace(' (۱-۵)','') %></span>
                        <div class="perf-card-rating-bar"><div class="perf-card-rating-fill" style="width:<%= (review.work_quality_rating/5)*100 %>%;background:var(--status-success)"></div></div>
                        <span class="perf-card-rating-value"><%= review.work_quality_rating %>/5</span>
                    </div>
                    <div class="perf-card-rating">
                        <span class="perf-card-rating-label"><%= t('hr.performance.discipline_rating').replace(' (1-5)','').replace(' (۱-۵)','') %></span>
                        <div class="perf-card-rating-bar"><div class="perf-card-rating-fill" style="width:<%= (review.discipline_rating/5)*100 %>%;background:var(--primary)"></div></div>
                        <span class="perf-card-rating-value"><%= review.discipline_rating %>/5</span>
                    </div>
                    <div class="perf-card-rating">
                        <span class="perf-card-rating-label"><%= t('hr.performance.teamwork_rating').replace(' (1-5)','').replace(' (۱-۵)','') %></span>
                        <div class="perf-card-rating-bar"><div class="perf-card-rating-fill" style="width:<%= (review.teamwork_rating/5)*100 %>%;background:var(--accent-blue)"></div></div>
                        <span class="perf-card-rating-value"><%= review.teamwork_rating %>/5</span>
                    </div>
                </div>
                <div class="perf-card-overall">
                    <span class="perf-card-overall-label"><%= t('hr.performance.overall') %></span>
                    <div class="perf-card-overall-bar"><div class="perf-card-overall-fill" style="width:<%= (overall/5)*100 %>%;background:<%= barColor %>"></div></div>
                    <span class="perf-card-overall-score" style="color:<%= barColor %>"><%= overall %>/5</span>
                </div>
                <div class="perf-card-meta">
                    <div class="perf-card-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <%= review.reviewer_role || '-' %>
                    </div>
                    <div class="perf-card-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <%= review.review_date %>
                    </div>
                </div>
                <% if (review.comments) { %>
                    <div class="perf-card-comments">"<%= review.comments %>"</div>
                <% } %>
            </div>
        <% }); %>
    <% } %>
</div>

<% if (!performanceReviews || performanceReviews.length === 0) { %>
    <div class="perf-empty">
        <span class="perf-empty-icon">&#11088;</span>
        <h3 class="perf-empty-title"><%= t('hr.performance.no_reviews_found') %></h3>
        <p class="perf-empty-desc"><%= t('hr.performance.title_desc') %></p>
        <a href="#perf-add-section" class="perf-empty-btn">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <%= t('hr.performance.add_review') %>
        </a>
    </div>
<% } else { %>
    <div class="perf-empty" id="perfNoResults" style="display:none">
        <span class="perf-empty-icon">&#128269;</span>
        <h3 class="perf-empty-title"><%= t('hr.performance.no_reviews_found') %></h3>
    </div>
<% } %>

<script>
function perfFilterReviews() {
    var q = document.getElementById('perfSearchInput').value.toLowerCase().trim();
    var cards = document.querySelectorAll('.perf-card');
    var vis = 0;
    cards.forEach(function(c) {
        var s = c.getAttribute('data-search') || '';
        var m = !q || s.indexOf(q) !== -1;
        c.style.display = m ? '' : 'none';
        if (m) vis++;
    });
    var badge = document.getElementById('perfCountBadge');
    var nr = document.getElementById('perfNoResults');
    if (badge) {
        var tot = cards.length;
        badge.textContent = (q && vis < tot ? vis + ' / ' + tot : tot + ' <%= t("hr.performance.performance_history") %>');
    }
    if (nr) nr.style.display = vis === 0 ? '' : 'none';
    var grid = document.getElementById('perfGrid');
    if (grid) grid.style.display = vis === 0 ? 'none' : '';
}

function perfUpdateFill(input) {
    var v = parseFloat(input.value);
    var pct = (v >= 1 && v <= 5) ? (v / 5) * 100 : 0;
    var fill = input.closest('.perf-rating-input').querySelector('.perf-rating-fill');
    if (fill) fill.style.width = pct + '%';
}

document.querySelectorAll('.perf-rating-num').forEach(function (i) {
    i.addEventListener('input', function () { perfUpdateFill(i); });
    i.addEventListener('change', function () { perfUpdateFill(i); });
});
</script>

<%- include('../partials/footer') %>
