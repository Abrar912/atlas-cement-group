<%- include('../partials/header') %>

<div class="card">
    <h2 style="margin-bottom: 20px; font-size: 24px;">Edit Schedule</h2>

    <div class="card" style="background-color: var(--bg-color); margin-bottom: 20px;">
        <form method="POST" action="/admin/hr/schedules/<%= schedule.id %>/edit">
            <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
                <div class="form-group">
                    <label for="name">Schedule Name *</label>
                    <input type="text" name="name" class="form-control" required value="<%= schedule.name %>" id="name">
                </div>
                <div class="form-group">
                    <label for="expected_check_in">Expected Check-In *</label>
                    <input type="time" name="expected_check_in" class="form-control" required value="<%= schedule.expected_check_in %>" id="expected_check_in">
                </div>
                <div class="form-group">
                    <label for="expected_check_out">Expected Check-Out *</label>
                    <input type="time" name="expected_check_out" class="form-control" required value="<%= schedule.expected_check_out %>" id="expected_check_out">
                </div>
                <div class="form-group">
                    <label for="grace_period_minutes"><%= t('hr.work_schedules.grace_period') %></label>
                    <input type="number" name="grace_period_minutes" class="form-control" value="<%= schedule.grace_period_minutes %>" min="0" max="120" id="grace_period_minutes">
                </div>
                <div class="form-group">
                    <label for="working_days">Working Days</label>
                    <input type="text" name="working_days" class="form-control" value="<%= schedule.working_days %>" id="working_days">
                    <small style="color: var(--text-muted); font-size: 11px;">1=Sat, 2=Sun, 3=Mon, 4=Tue, 5=Wed, 6=Thu, 7=Fri</small>
                </div>
            </div>
            <div style="margin-top: 10px; display: flex; gap: 10px;">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a href="/admin/hr/schedules" class="btn" style="background-color: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-main);">Cancel</a>
            </div>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
