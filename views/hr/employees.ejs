<%- include('../partials/header') %>

<style>
.emp-dir-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.emp-dir-hero-left{display:flex;align-items:center;gap:16px}
.emp-dir-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(255,111,0,.25)}
.emp-dir-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.emp-dir-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.emp-dir-hero-count{display:inline-block;background:rgba(255,111,0,.1);color:var(--primary);font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;margin-inline-start:8px}
.emp-dir-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;text-decoration:none;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.emp-dir-hero-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4);color:#fff}
.emp-dir-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:24px}
.emp-stat-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px;padding:18px 16px;text-align:center;transition:transform .15s,box-shadow .15s;position:relative;overflow:hidden}
.emp-stat-card:hover{transform:translateY(-2px);box-shadow:0 4px 14px rgba(0,0,0,.08)}
.emp-stat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.emp-stat-card-total::before{background:var(--accent-blue)}
.emp-stat-card-active::before{background:var(--status-success)}
.emp-stat-card-leave::before{background:var(--status-warning)}
.emp-stat-card-former::before{background:var(--text-muted)}
.emp-stat-icon{width:22px;height:22px;margin:0 auto 4px;display:block;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;opacity:.8}
.emp-stat-value{font-size:30px;font-weight:800;line-height:1.1}
.emp-stat-label{font-size:10px;text-transform:uppercase;letter-spacing:.8px;color:var(--text-muted);margin-top:4px;font-weight:600}
.emp-stat-card-total .emp-stat-value{color:var(--accent-blue)}
.emp-stat-card-active .emp-stat-value{color:var(--status-success)}
.emp-stat-card-leave .emp-stat-value{color:var(--status-warning)}
.emp-stat-card-former .emp-stat-value{color:var(--text-muted)}
[data-theme="dark"] .emp-stat-card-total .emp-stat-value{color:var(--accent-blue)}
[data-theme="dark"] .emp-stat-card-active .emp-stat-value{color:#3fb950}
[data-theme="dark"] .emp-stat-card-leave .emp-stat-value{color:#fb923c}
[data-theme="dark"] .emp-stat-card-former .emp-stat-value{color:#8b949e}
.emp-dir-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px}
.emp-dir-search-wrap{position:relative;flex:1;min-width:200px}
.emp-dir-search-wrap svg{position:absolute;top:50%;inset-inline-start:12px;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;pointer-events:none}
.emp-dir-search-wrap input{width:100%;padding:9px 12px;padding-inline-start:36px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s}
.emp-dir-search-wrap input:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.emp-dir-filter-select{padding:9px 12px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);min-width:160px;cursor:pointer;transition:border-color .15s}
.emp-dir-filter-select:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.emp-dir-clear-btn{padding:9px 14px;font-size:13px;font-weight:600;border:1px solid var(--border-color);border-radius:8px;background:var(--card-bg);color:var(--text-muted);cursor:pointer;display:none;align-items:center;gap:5px;transition:all .15s;white-space:nowrap}
.emp-dir-clear-btn:hover{border-color:var(--status-error);color:var(--status-error);background:rgba(207,34,46,.06)}
.emp-dir-clear-btn.visible{display:inline-flex}
.emp-dir-clear-btn svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
.emp-dir-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:0;transition:transform .18s,box-shadow .18s,border-color .18s;overflow:hidden;display:flex;flex-direction:column}
.emp-dir-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1);border-color:var(--primary)}
.emp-dir-card-top{padding:20px 20px 0;display:flex;align-items:center;gap:14px}
.emp-dir-avatar{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden;border:3px solid var(--card-bg);box-shadow:0 2px 8px rgba(0,0,0,.1);position:relative}
.emp-dir-avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.emp-dir-avatar-initials{width:100%;height:100%;display:flex;align-items:center;justify-content:center;border-radius:50%}
.emp-dir-card-identity{flex:1;min-width:0}
.emp-dir-card-name{font-size:15px;font-weight:700;color:var(--text-main);margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.emp-dir-card-id{font-size:11px;color:var(--text-muted);font-family:monospace}
.emp-dir-card-body{padding:12px 20px 0;flex:1}
.emp-dir-card-position{font-size:13px;font-weight:600;color:var(--text-main);margin-bottom:2px}
.emp-dir-card-dept{font-size:12px;color:var(--text-muted);margin-bottom:10px}
.emp-dir-status{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.emp-dir-status::before{content:'';width:6px;height:6px;border-radius:50%;flex-shrink:0}
.emp-dir-status-active{background:rgba(34,197,94,.12);color:#16a34a}
.emp-dir-status-active::before{background:#16a34a}
.emp-dir-status-former{background:rgba(107,114,128,.12);color:#6b7280}
.emp-dir-status-former::before{background:#6b7280}
.emp-dir-status-leave{background:rgba(249,115,22,.12);color:#ea580c}
.emp-dir-status-leave::before{background:#ea580c}
[data-theme="dark"] .emp-dir-status-active{background:rgba(34,197,94,.18);color:#3fb950}
[data-theme="dark"] .emp-dir-status-active::before{background:#3fb950}
[data-theme="dark"] .emp-dir-status-former{background:rgba(107,114,128,.18);color:#8b949e}
[data-theme="dark"] .emp-dir-status-former::before{background:#8b949e}
[data-theme="dark"] .emp-dir-status-leave{background:rgba(249,115,22,.18);color:#fb923c}
[data-theme="dark"] .emp-dir-status-leave::before{background:#fb923c}
.emp-dir-card-meta{display:flex;gap:14px;padding:10px 20px;font-size:12px;color:var(--text-muted);border-top:1px solid var(--border-color);margin-top:12px}
.emp-dir-card-meta-item{display:flex;align-items:center;gap:4px;min-width:0}
.emp-dir-card-meta-item svg{width:13px;height:13px;flex-shrink:0;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-card-meta-item span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.emp-dir-card-actions{display:flex;gap:8px;padding:12px 20px 16px;margin-top:auto}
.emp-dir-card-actions .btn{flex:1;padding:8px 12px;font-size:13px;text-align:center;border-radius:8px}
.emp-dir-btn-view{background:var(--primary);color:#fff;border:none}
.emp-dir-btn-view:hover{opacity:.9;color:#fff}
.emp-dir-btn-edit{background:var(--card-bg);border:1px solid var(--border-color);color:var(--text-main)}
.emp-dir-btn-edit:hover{border-color:var(--accent-blue);color:var(--accent-blue)}
.emp-dir-empty{text-align:center;padding:60px 24px;color:var(--text-muted)}
.emp-dir-empty-icon{width:72px;height:72px;margin:0 auto 16px;border-radius:50%;background:var(--bg-color);border:2px dashed var(--border-color);display:flex;align-items:center;justify-content:center}
.emp-dir-empty-icon svg{width:32px;height:32px;color:var(--text-muted);stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-empty-title{font-size:16px;font-weight:700;color:var(--text-main);margin-bottom:4px}
.emp-dir-empty-desc{font-size:13px;color:var(--text-muted);margin-bottom:16px}
.emp-dir-no-results{text-align:center;padding:48px 24px;color:var(--text-muted)}
.emp-dir-no-results-icon{width:56px;height:56px;margin:0 auto 14px;border-radius:50%;background:var(--bg-color);border:2px dashed var(--border-color);display:flex;align-items:center;justify-content:center}
.emp-dir-no-results-icon svg{width:24px;height:24px;color:var(--text-muted);stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.emp-dir-count-bar{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;font-size:13px;color:var(--text-muted)}
.emp-dir-count-bar strong{color:var(--text-main)}
.emp-dir-empty-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:all .18s;border:none;background:var(--primary);color:#fff;text-decoration:none;box-shadow:0 2px 8px rgba(255,111,0,.3)}
.emp-dir-empty-btn:hover{background:var(--primary-dark);transform:translateY(-1px);box-shadow:0 4px 14px rgba(255,111,0,.4);color:#fff}
.emp-dir-nr-btn{display:inline-flex;align-items:center;gap:6px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:600;cursor:pointer;transition:all .18s;border:1px solid var(--border-color);background:var(--card-bg);color:var(--text-main);text-decoration:none;margin-top:8px}
.emp-dir-nr-btn:hover{border-color:var(--primary);color:var(--primary);transform:translateY(-1px)}
@media(max-width:900px){.emp-dir-stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:640px){.emp-dir-hero{flex-direction:column;align-items:flex-start}.emp-dir-hero-btn{width:100%;justify-content:center}.emp-dir-stats{grid-template-columns:repeat(2,1fr);gap:10px}.emp-stat-card{padding:14px 10px}.emp-stat-value{font-size:24px}.emp-dir-toolbar{flex-direction:column;align-items:stretch}.emp-dir-search-wrap{min-width:0}.emp-dir-filter-select{min-width:0;width:100%}.emp-dir-clear-btn{width:100%;justify-content:center}.emp-dir-grid{grid-template-columns:1fr}}
</style>

<%
var totalEmployees = employees ? employees.length : 0;
var activeCount = 0;
var leaveCount = 0;
var formerCount = 0;
if (employees) {
    employees.forEach(function(emp) {
        if (emp.employment_status === 'Active') activeCount++;
        else if (emp.employment_status === 'On Leave') leaveCount++;
        else if (emp.employment_status === 'Former') formerCount++;
    });
}
var avatarColors = ['#3b82f6','#8b5cf6','#ec4899','#f97316','#10b981','#06b6d4','#f59e0b','#ef4444','#6366f1','#14b8a6'];
function getAvatarColor(name) {
    var hash = 0;
    for (var i = 0; i < (name || '').length; i++) { hash = name.charCodeAt(i) + ((hash << 5) - hash); }
    return avatarColors[Math.abs(hash) % avatarColors.length];
}
%>

<div class="emp-dir-hero">
    <div class="emp-dir-hero-left">
        <div class="emp-dir-hero-icon">
            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
            <h2 class="emp-dir-hero-title">
                <%= t('hr.employees.title') %>
                <span class="emp-dir-hero-count"><%= totalEmployees %></span>
            </h2>
            <p class="emp-dir-hero-sub"><%= t('hr.employees.title_desc') %></p>
        </div>
    </div>
    <a href="/admin/hr/employees/add" class="emp-dir-hero-btn">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.employees.add_employee') %>
    </a>
</div>

<div class="emp-dir-stats">
    <div class="emp-stat-card emp-stat-card-total">
        <svg class="emp-stat-icon" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <div class="emp-stat-value" id="statTotal"><%= totalEmployees %></div>
        <div class="emp-stat-label"><%= t('hr.employees.total_employees') %></div>
    </div>
    <div class="emp-stat-card emp-stat-card-active">
        <svg class="emp-stat-icon" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        <div class="emp-stat-value" id="statActive"><%= activeCount %></div>
        <div class="emp-stat-label"><%= t('hr.employees.active') %></div>
    </div>
    <div class="emp-stat-card emp-stat-card-leave">
        <svg class="emp-stat-icon" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <div class="emp-stat-value" id="statLeave"><%= leaveCount %></div>
        <div class="emp-stat-label"><%= t('hr.employees.on_leave') %></div>
    </div>
    <div class="emp-stat-card emp-stat-card-former">
        <svg class="emp-stat-icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <div class="emp-stat-value" id="statFormer"><%= formerCount %></div>
        <div class="emp-stat-label"><%= t('hr.employees.former') %></div>
    </div>
</div>

<div class="emp-dir-toolbar">
    <div class="emp-dir-search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="<%= t('hr.employees.search_placeholder') %>">
    </div>
    <select id="departmentFilter" class="emp-dir-filter-select">
        <option value=""><%= t('hr.employees.all_departments') %></option>
        <% if (departments && departments.length > 0) { %>
            <% departments.forEach(function(dept) { %>
                <option value="<%= dept.id %>"><%= dept.name %></option>
            <% }); %>
        <% } %>
    </select>
    <select id="statusFilter" class="emp-dir-filter-select">
        <option value=""><%= t('hr.employees.all_statuses') %></option>
        <option value="Active"><%= t('hr.employees.active') %></option>
        <option value="Former"><%= t('hr.employees.former') %></option>
        <option value="On Leave"><%= t('hr.employees.on_leave') %></option>
    </select>
    <button type="button" id="clearFiltersBtn" class="emp-dir-clear-btn" onclick="clearAllFilters()">
        <svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        <%= t('hr.employees.clear_filters') %>
    </button>
</div>

<% if (employees && employees.length > 0) { %>
<div class="emp-dir-count-bar">
    <span><%= t('hr.employees.showing') %> <strong id="visibleCount"><%= totalEmployees %></strong> <%= t('hr.employees.of') %> <strong><%= totalEmployees %></strong> <%= t('hr.employees.employees_lowercase') %></span>
</div>
<% } %>

<div class="emp-dir-grid" id="employeesContainer">
    <% if (employees && employees.length > 0) { %>
        <% employees.forEach(function(emp) { %>
            <div class="emp-dir-card" data-department="<%= emp.department_id || '' %>" data-status="<%= emp.employment_status || '' %>" data-name="<%= (emp.full_name || '').toLowerCase() %>">
                <div class="emp-dir-card-top">
                    <div class="emp-dir-avatar">
                        <% if (emp.photo_path) { %>
                            <img src="/<%= emp.photo_path %>" alt="<%= emp.full_name %>">
                        <% } else { %>
                            <div class="emp-dir-avatar-initials" style="background:<%= getAvatarColor(emp.full_name) %>">
                                <%= emp.full_name ? emp.full_name.charAt(0).toUpperCase() : '?' %>
                            </div>
                        <% } %>
                    </div>
                    <div class="emp-dir-card-identity">
                        <div class="emp-dir-card-name"><%= emp.full_name %></div>
                        <div class="emp-dir-card-id"><%= emp.employee_id || 'N/A' %></div>
                    </div>
                </div>
                <div class="emp-dir-card-body">
                    <div class="emp-dir-card-position"><%= emp.position || '-' %></div>
                    <div class="emp-dir-card-dept"><%= emp.department_name || '-' %></div>
                    <span class="emp-dir-status <%= emp.employment_status === 'Active' ? 'emp-dir-status-active' : emp.employment_status === 'Former' ? 'emp-dir-status-former' : 'emp-dir-status-leave' %>">
                        <%= emp.employment_status === 'Active' ? t('hr.employees.active') : emp.employment_status === 'Former' ? t('hr.employees.former') : emp.employment_status === 'On Leave' ? t('hr.employees.on_leave') : emp.employment_status %>
                    </span>
                </div>
                <div class="emp-dir-card-meta">
                    <% if (emp.phone) { %>
                    <div class="emp-dir-card-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        <span><%= emp.phone %></span>
                    </div>
                    <% } %>
                    <% if (emp.hire_date) { %>
                    <div class="emp-dir-card-meta-item">
                        <svg viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
                        <span><%= emp.hire_date %></span>
                    </div>
                    <% } %>
                </div>
                <div class="emp-dir-card-actions">
                    <a href="/admin/hr/employees/<%= emp.id %>" class="btn emp-dir-btn-view"><%= t('hr.employees.view') %></a>
                    <a href="/admin/hr/employees/<%= emp.id %>/edit" class="btn emp-dir-btn-edit"><%= t('hr.employees.edit') %></a>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div class="emp-dir-empty" style="grid-column:1/-1;">
            <div class="emp-dir-empty-icon">
                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <div class="emp-dir-empty-title"><%= t('hr.employees.no_employees_found') %></div>
            <div class="emp-dir-empty-desc"><%= t('hr.employees.add_first_employee') %></div>
            <a href="/admin/hr/employees/add" class="emp-dir-empty-btn"><%= t('hr.employees.add_employee') %></a>
        </div>
    <% } %>
    <div class="emp-dir-no-results" id="noResultsMessage" style="display:none;grid-column:1/-1;">
        <div class="emp-dir-no-results-icon">
            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
        </div>
        <div class="emp-dir-empty-title"><%= t('hr.employees.no_results_match') %></div>
        <div class="emp-dir-empty-desc"><%= t('hr.employees.try_different_filters') %></div>
        <button type="button" class="emp-dir-nr-btn" onclick="clearAllFilters()"><%= t('hr.employees.clear_filters') %></button>
    </div>
</div>

<script>
var searchInput = document.getElementById('searchInput');
var departmentFilter = document.getElementById('departmentFilter');
var statusFilter = document.getElementById('statusFilter');
var clearBtn = document.getElementById('clearFiltersBtn');
var noResults = document.getElementById('noResultsMessage');
var visibleCountEl = document.getElementById('visibleCount');
var hasBackendData = <%= (employees && employees.length > 0) ? 'true' : 'false' %>;

searchInput.addEventListener('input', filterEmployees);
departmentFilter.addEventListener('change', filterEmployees);
statusFilter.addEventListener('change', filterEmployees);

function filterEmployees() {
    var searchTerm = searchInput.value.toLowerCase();
    var deptVal = departmentFilter.value;
    var statusVal = statusFilter.value;
    var cards = document.querySelectorAll('.emp-dir-card');
    var visible = 0;
    var anyFilter = searchTerm !== '' || deptVal !== '' || statusVal !== '';
    
    cards.forEach(function(card) {
        var name = card.getAttribute('data-name') || '';
        var dept = card.getAttribute('data-department') || '';
        var status = card.getAttribute('data-status') || '';
        var matchSearch = name.indexOf(searchTerm) !== -1;
        var matchDept = deptVal === '' || dept === deptVal;
        var matchStatus = statusVal === '' || status === statusVal;
        if (matchSearch && matchDept && matchStatus) {
            card.style.display = '';
            visible++;
        } else {
            card.style.display = 'none';
        }
    });
    
    if (visibleCountEl) visibleCountEl.textContent = visible;
    
    if (hasBackendData && visible === 0 && anyFilter) {
        noResults.style.display = '';
    } else {
        noResults.style.display = 'none';
    }
    
    if (anyFilter) {
        clearBtn.classList.add('visible');
    } else {
        clearBtn.classList.remove('visible');
    }
}

function clearAllFilters() {
    searchInput.value = '';
    departmentFilter.value = '';
    statusFilter.value = '';
    filterEmployees();
}
</script>
