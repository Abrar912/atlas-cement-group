      <div class="prof-module-link"><%= t('hr.employees.records') %> &rarr;</div>
    </a>
    <a href="/admin/hr/documents?employee_id=<%= employee.id %>" class="prof-module-card">
      <div class="prof-module-name"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg><%= t('layout.documents') %></div>
      <div class="prof-module-count"><%= docCount %></div>
      <div class="prof-module-link"><%= t('hr.employees.records') %> &rarr;</div>
    </a>
    <a href="/admin/hr/performance?employee_id=<%= employee.id %>" class="prof-module-card">
      <div class="prof-module-name"><svg viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><%= t('layout.performance') %></div>
      <div class="prof-module-count"><%= perfCount %></div>
      <div class="prof-module-link"><%= t('hr.employees.records') %> &rarr;</div>
    </a>
    <a href="/admin/hr/disciplinary?employee_id=<%= employee.id %>" class="prof-module-card">
      <div class="prof-module-name"><svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><%= t('layout.disciplinary') %></div>
      <div class="prof-module-count"><%= discCount %></div>
      <div class="prof-module-link"><%= t('hr.employees.records') %> &rarr;</div>
    </a>
  </div>
</div>

<% if (leaveBalances && leaveBalances.length > 0) { %>
<div class="prof-section">
  <div class="prof-section-title">
    <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <%= t('hr.employees.leave_balances') %>
  </div>
  <div class="prof-leave-grid">
    <% leaveBalances.forEach(function(balance) { %>
      <% var allocated = balance.allocated_days || 0; var used = balance.used_days || 0; var remain = allocated - used; var pct = allocated > 0 ? Math.round((used / allocated) * 100) : 0; %>
      <div class="prof-leave-card">
        <div class="prof-leave-type"><%= balance.leave_type || '-' %></div>
        <div class="prof-leave-bar"><div class="prof-leave-bar-fill" style="width:<%= Math.min(pct, 100) %>%"></div></div>
        <div class="prof-leave-detail">
          <span><%= t('hr.employees.used') %>: <%= used %></span>
          <span><%= t('hr.employees.remaining') %>: <%= remain %></span>
        </div>
        <div class="prof-leave-detail prof-leave-detail-mt">
          <span><%= t('hr.employees.allocated') %>: <%= allocated %></span>
          <span><%= pct %>%</span>
        </div>
      </div>
    <% }); %>
  </div>
  <a href="/admin/hr/leave-balances?employee_id=<%= employee.id %>" class="prof-view-all"><%= t('hr.employees.view_all') %> &rarr;</a>
</div>
<% } %>

