<%- include('../partials/header') %>

<style>
.disc-hero{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:24px;flex-wrap:wrap}
.disc-hero-left{display:flex;align-items:center;gap:16px}
.disc-hero-icon{width:56px;height:56px;border-radius:16px;background:linear-gradient(135deg,var(--status-warning),#e65100);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 14px rgba(230,81,0,.25)}
.disc-hero-icon svg{width:28px;height:28px;color:#fff;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.disc-hero-title{font-size:24px;font-weight:800;color:var(--text-main);margin:0;letter-spacing:-.3px}
.disc-hero-sub{font-size:14px;color:var(--text-muted);margin:2px 0 0}
.disc-hero-count{display:inline-block;background:rgba(230,81,0,.1);color:#e65100;font-size:12px;font-weight:700;padding:2px 10px;border-radius:20px;margin-inline-start:8px}
.disc-hero-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;text-decoration:none;white-space:nowrap;background:var(--status-error);color:#fff;box-shadow:0 2px 8px rgba(207,34,46,.3)}
.disc-hero-btn:hover{background:#b91c1c;transform:translateY(-1px);box-shadow:0 4px 14px rgba(207,34,46,.4)}
.disc-hero-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.disc-context{background:var(--primary);color:#fff;padding:14px 20px;border-radius:10px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
.disc-context-left{display:flex;align-items:center;gap:12px}
.disc-context-avatar{width:40px;height:40px;border-radius:8px;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;flex-shrink:0;overflow:hidden}
.disc-context-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.disc-context-name{font-size:16px;font-weight:600}
.disc-context-id{font-size:12px;opacity:.8;font-family:monospace}
.disc-context-label{font-size:13px;opacity:.9}
.disc-context-link{background:rgba(255,255,255,.2);color:#fff;padding:8px 16px;border-radius:6px;text-decoration:none;font-size:13px;transition:background .15s}
.disc-context-link:hover{background:rgba(255,255,255,.3)}
.disc-alert{padding:14px 18px;border-radius:10px;font-size:14px;font-weight:500;margin-bottom:20px;display:flex;align-items:center;gap:10px}
.disc-alert-success{background:rgba(26,127,55,.1);color:var(--status-success);border:1px solid rgba(26,127,55,.2)}
.disc-alert-danger{background:rgba(207,34,46,.1);color:var(--status-error);border:1px solid rgba(207,34,46,.2)}
.disc-section-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 16px;padding-bottom:12px;border-bottom:2px solid var(--border-color);display:flex;align-items:center;gap:8px}
.disc-section-title svg{stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0}
.disc-form-card{background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:24px;margin-bottom:24px}
.disc-form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:16px}
.disc-form-grid-full{grid-template-columns:1fr}
.disc-form-group{display:flex;flex-direction:column;gap:6px}
.disc-form-label{font-size:13px;font-weight:600;color:var(--text-main)}
.disc-form-label span{color:var(--status-error);margin-inline-start:2px}
.disc-form-select,.disc-form-input,.disc-form-textarea{width:100%;padding:10px 14px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s;font-family:inherit}
.disc-form-select:focus,.disc-form-input:focus,.disc-form-textarea:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.disc-form-textarea{min-height:80px;resize:vertical}
.disc-submit-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--status-error);color:#fff;box-shadow:0 2px 8px rgba(207,34,46,.3)}
.disc-submit-btn:hover{background:#b91c1c;transform:translateY(-1px);box-shadow:0 4px 14px rgba(207,34,46,.4)}
.disc-submit-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
.disc-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:20px;padding:14px 16px;background:var(--card-bg);border:1px solid var(--border-color);border-radius:12px}
.disc-search-wrap{position:relative;flex:1;min-width:200px}
.disc-search-wrap svg{position:absolute;top:50%;left:12px;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;pointer-events:none}
.disc-search-wrap input{width:100%;padding:9px 12px 9px 36px;font-size:14px;border:1px solid var(--border-color);border-radius:8px;background:var(--input-bg);color:var(--text-main);transition:border-color .15s,box-shadow .15s}
.disc-search-wrap input:focus{border-color:var(--accent-blue);outline:none;box-shadow:0 0 0 3px rgba(9,105,218,.12)}
.disc-search-wrap input::placeholder{color:var(--text-muted)}
.disc-count-badge{font-size:12px;font-weight:600;color:var(--text-muted);white-space:nowrap}
.disc-timeline{position:relative;padding-inline-start:24px}
.disc-timeline::before{content:'';position:absolute;top:0;bottom:0;inset-inline-start:8px;width:2px;background:var(--border-color)}
.disc-card{position:relative;background:var(--card-bg);border:1px solid var(--border-color);border-radius:14px;padding:18px;margin-bottom:16px;transition:transform .18s,box-shadow .18s,border-color .18s}
.disc-card::before{content:'';position:absolute;top:22px;inset-inline-start:-20px;width:12px;height:12px;border-radius:50%;border:2px solid var(--border-color);background:var(--card-bg)}
.disc-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.08);border-color:var(--primary)}
.disc-card-top{display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.disc-card-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:15px;font-weight:800;color:#fff;flex-shrink:0;overflow:hidden}
.disc-card-avatar img{width:100%;height:100%;object-fit:cover;border-radius:inherit}
.disc-card-identity{flex:1;min-width:0}
.disc-card-name{font-size:15px;font-weight:700;color:var(--text-main);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.disc-card-id{font-size:11px;color:var(--text-muted);font-family:monospace}
.disc-card-type{display:inline-flex;align-items:center;gap:5px;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;letter-spacing:.3px;white-space:nowrap}
.disc-type-warning{background:rgba(234,179,8,.12);color:#b45309}
.disc-type-verbal{background:rgba(234,179,8,.08);color:#b45309}
.disc-type-written{background:rgba(245,158,11,.15);color:#d97706}
.disc-type-suspension{background:rgba(239,68,68,.1);color:var(--status-error)}
.disc-type-demotion{background:rgba(124,58,237,.1);color:#7c3aed}
.disc-type-termination{background:rgba(207,34,46,.12);color:var(--status-error)}
.disc-type-other{background:var(--border-color);color:var(--text-muted)}
.disc-card-body{margin-bottom:12px}
.disc-card-desc{font-size:13px;color:var(--text-main);line-height:1.6;margin:0}
.disc-card-section{margin-top:10px}
.disc-card-section-label{font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
.disc-card-section-value{font-size:13px;color:var(--text-main);line-height:1.5}
.disc-card-meta{display:flex;flex-wrap:wrap;gap:12px;padding-top:12px;border-top:1px solid var(--border-color)}
.disc-card-meta-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text-muted)}
.disc-card-meta-item svg{width:14px;height:14px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0;opacity:.6}
.disc-empty{text-align:center;padding:60px 20px;background:var(--card-bg);border:2px dashed var(--border-color);border-radius:14px}
.disc-empty-icon{font-size:48px;margin-bottom:16px;display:block;opacity:.5}
.disc-empty-title{font-size:18px;font-weight:700;color:var(--text-main);margin:0 0 8px}
.disc-empty-desc{font-size:14px;color:var(--text-muted);margin:0 0 20px;line-height:1.5}
.disc-empty-btn{display:inline-flex;align-items:center;gap:8px;padding:10px 24px;border-radius:10px;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s;border:none;background:var(--status-error);color:#fff;box-shadow:0 2px 8px rgba(207,34,46,.3);text-decoration:none}
.disc-empty-btn:hover{background:#b91c1c;transform:translateY(-1px);box-shadow:0 4px 14px rgba(207,34,46,.4)}
.disc-empty-btn svg{width:16px;height:16px;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none}
@media(max-width:900px){.disc-hero{flex-direction:column;align-items:flex-start}.disc-timeline{padding-inline-start:0}.disc-timeline::before{display:none}}
@media(max-width:640px){.disc-hero-btn{width:100%;justify-content:center}.disc-toolbar{flex-direction:column}.disc-form-grid{grid-template-columns:1fr}.disc-card-top{flex-direction:column;align-items:flex-start;gap:8px}}
[data-theme="dark"] .disc-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.3)}
[data-theme="dark"] .disc-type-warning,[data-theme="dark"] .disc-type-verbal{color:#fbbf24}
</style>

<% if (contextEmployee) { %>
    <div class="disc-context">
        <div class="disc-context-left">
            <div class="disc-context-avatar"><% if (contextEmployee.photo_path) { %><img src="/<%= contextEmployee.photo_path %>" alt="<%= contextEmployee.full_name %>"><% } else { %><%= contextEmployee.full_name.charAt(0).toUpperCase() %><% } %></div>
            <div>
                <div class="disc-context-label"><%= t('hr.employees.full_name') %></div>
                <div class="disc-context-name"><%= contextEmployee.full_name %></div>
                <div class="disc-context-id"><%= contextEmployee.employee_id || 'N/A' %></div>
            </div>
        </div>
        <a href="/admin/hr/employees/<%= contextEmployee.id %>" class="disc-context-link">&larr; <%= t('hr.employees.back_to_list') %></a>
    </div>
<% } %>

<div class="disc-hero">
    <div class="disc-hero-left">
        <div class="disc-hero-icon">
            <svg viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div>
            <h1 class="disc-hero-title">
                <%= t('hr.disciplinary.title') %>
                <% if (disciplinaryRecords && disciplinaryRecords.length > 0) { %>
                    <span class="disc-hero-count"><%= disciplinaryRecords.length %></span>
                <% } %>
            </h1>
            <p class="disc-hero-sub"><%= t('hr.disciplinary.title_desc') %></p>
        </div>
    </div>
    <a href="#disc-add-section" class="disc-hero-btn">
        <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.disciplinary.add_record') %>
    </a>
</div>

<% if (typeof message !== 'undefined' && message && message.type === 'success') { %>
    <div class="disc-alert disc-alert-success">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><polyline points="20 6 9 17 4 12"/></svg>
        <%= message.text %>
    </div>
<% } %>
<% if (typeof message !== 'undefined' && message && message.type === 'error') { %>
    <div class="disc-alert disc-alert-danger">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;fill:none;flex-shrink:0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <%= message.text %>
    </div>
<% } %>

<div id="disc-add-section">
    <h2 class="disc-section-title">
        <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:var(--status-error)"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        <%= t('hr.disciplinary.add_record') %>
    </h2>
    <div class="disc-form-card">
        <form method="POST" action="/admin/hr/disciplinary">
            <% if (contextEmployee) { %>
                <input type="hidden" name="context_employee_id" value="<%= contextEmployee.id %>">
            <% } %>
            <div class="disc-form-grid">
                <div class="disc-form-group">
                    <label class="disc-form-label" for="employee_id"><%= t('hr.disciplinary.employee') %> <span>*</span></label>
                    <select name="employee_id" class="disc-form-select" required id="employee_id">
                        <option value=""><%= t('hr.leave.select_employee') %></option>
                        <% if (employees && employees.length > 0) { %>
                            <% employees.forEach(function(emp) { %>
                                <option value="<%= emp.id %>" <%= contextEmployee && contextEmployee.id == emp.id ? 'selected' : '' %>><%= emp.full_name %></option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>
                <div class="disc-form-group">
                    <label class="disc-form-label" for="record_date"><%= t('hr.disciplinary.record_date') %> <span>*</span></label>
                    <input type="text" name="record_date" class="disc-form-input" required data-datepicker="jalali" placeholder="<%= t('hr.disciplinary.date_placeholder') %>" dir="ltr" id="record_date">
                </div>
                <div class="disc-form-group">
                    <label class="disc-form-label" for="type"><%= t('hr.disciplinary.type') %> <span>*</span></label>
                    <select name="type" class="disc-form-select" required id="type">
                        <option value=""><%= t('hr.leave.select_type') %></option>
                        <option value="Warning"><%= t('hr.disciplinary.warning') %></option>
                        <option value="Verbal Warning"><%= t('hr.disciplinary.verbal_warning') %></option>
                        <option value="Written Warning"><%= t('hr.disciplinary.written_warning') %></option>
                        <option value="Suspension"><%= t('hr.disciplinary.suspension') %></option>
                        <option value="Demotion"><%= t('hr.disciplinary.demotion') %></option>
                        <option value="Termination"><%= t('hr.disciplinary.termination') %></option>
                        <option value="Other"><%= t('hr.disciplinary.other') %></option>
                    </select>
                </div>
            </div>
            <div class="disc-form-grid disc-form-grid-full">
                <div class="disc-form-group">
                    <label class="disc-form-label" for="description"><%= t('hr.disciplinary.description') %> <span>*</span></label>
                    <textarea name="description" class="disc-form-textarea" rows="3" required placeholder="<%= t('hr.disciplinary.description_placeholder') %>" dir="rtl" id="description"></textarea>
                </div>
            </div>
            <div class="disc-form-grid">
                <div class="disc-form-group">
                    <label class="disc-form-label" for="action_taken"><%= t('hr.disciplinary.action') %></label>
                    <textarea name="action_taken" class="disc-form-textarea" rows="2" placeholder="<%= t('hr.disciplinary.action_placeholder') %>" dir="rtl" id="action_taken"></textarea>
                </div>
                <div class="disc-form-group">
                    <label class="disc-form-label" for="notes"><%= t('hr.disciplinary.notes') %></label>
                    <textarea name="notes" class="disc-form-textarea" rows="2" dir="rtl" id="notes"></textarea>
                </div>
            </div>
            <button type="submit" class="disc-submit-btn">
                <svg viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
                <%= t('hr.disciplinary.add_record') %>
            </button>
        </form>
    </div>
</div>

<h2 class="disc-section-title">
    <svg viewBox="0 0 24 24" width="18" height="18" style="stroke:var(--text-muted)"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <%= t('hr.disciplinary.disciplinary_history') %>
</h2>

<div class="disc-toolbar">
    <div class="disc-search-wrap">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="discSearchInput" placeholder="<%= t('hr.disciplinary.search_placeholder') %>" oninput="discFilterRecords()">
    </div>
    <span class="disc-count-badge" id="discCountBadge">
        <% if (disciplinaryRecords && disciplinaryRecords.length > 0) { %>
            <%= disciplinaryRecords.length %> <%= t('hr.disciplinary.disciplinary_history') %>
        <% } %>
    </span>
</div>

<div class="disc-timeline" id="discTimeline">
    <% if (disciplinaryRecords && disciplinaryRecords.length > 0) { %>
        <% var typeClasses = {'Warning':'disc-type-warning','Verbal Warning':'disc-type-verbal','Written Warning':'disc-type-written','Suspension':'disc-type-suspension','Demotion':'disc-type-demotion','Termination':'disc-type-termination','Other':'disc-type-other'}; %>
        <% var typeColors = {'Warning':'#b45309','Verbal Warning':'#d97706','Written Warning':'#ea580c','Suspension':'var(--status-error)','Demotion':'#7c3aed','Termination':'var(--status-error)','Other':'var(--text-muted)'}; %>
        <% disciplinaryRecords.forEach(function(record) { %>
            <% var tc = typeClasses[record.type] || 'disc-type-other'; %>
            <% var tcol = typeColors[record.type] || 'var(--text-muted)'; %>
            <div class="disc-card" data-search="<%= (record.full_name || '').toLowerCase() %> <%= (record.type || '').toLowerCase() %> <%= (record.description || '').toLowerCase() %>">
                <div class="disc-card-top">
                    <div class="disc-card-avatar" style="background:linear-gradient(135deg,<%= tcol %>,<%= tcol %>dd)"><% if (record.photo_path) { %><img src="/<%= record.photo_path %>" alt="<%= record.full_name %>"><% } else { %><%= record.full_name ? record.full_name.charAt(0).toUpperCase() : '?' %><% } %></div>
                    <div class="disc-card-identity">
                        <h3 class="disc-card-name"><%= record.full_name %></h3>
                        <div class="disc-card-id"><%= record.employee_id || 'N/A' %></div>
                    </div>
                    <span class="disc-card-type <%= tc %>"><%= record.type %></span>
                </div>
                <div class="disc-card-body">
                    <p class="disc-card-desc"><%= record.description %></p>
                    <% if (record.action_taken) { %>
                        <div class="disc-card-section">
                            <div class="disc-card-section-label"><%= t('hr.disciplinary.action') %></div>
                            <div class="disc-card-section-value"><%= record.action_taken %></div>
                        </div>
                    <% } %>
                    <% if (record.notes) { %>
                        <div class="disc-card-section">
                            <div class="disc-card-section-label"><%= t('hr.disciplinary.notes') %></div>
                            <div class="disc-card-section-value"><%= record.notes %></div>
                        </div>
                    <% } %>
                </div>
                <div class="disc-card-meta">
                    <div class="disc-card-meta-item">
                        <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        <%= record.record_date %>
                    </div>
                    <div class="disc-card-meta-item">
                        <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <%= record.issued_by %>
                    </div>
                </div>
            </div>
        <% }); %>
    <% } %>
</div>

<% if (!disciplinaryRecords || disciplinaryRecords.length === 0) { %>
    <div class="disc-empty">
        <span class="disc-empty-icon">&#9989;</span>
        <h3 class="disc-empty-title"><%= t('hr.disciplinary.no_records_found') %></h3>
        <p class="disc-empty-desc"><%= t('hr.disciplinary.title_desc') %></p>
        <a href="#disc-add-section" class="disc-empty-btn">
            <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            <%= t('hr.disciplinary.add_record') %>
        </a>
    </div>
<% } else { %>
    <div class="disc-empty" id="discNoResults" style="display:none">
        <span class="disc-empty-icon">&#128269;</span>
        <h3 class="disc-empty-title"><%= t('hr.disciplinary.no_records_found') %></h3>
    </div>
<% } %>

<script>
function discFilterRecords() {
    var q = document.getElementById('discSearchInput').value.toLowerCase().trim();
    var cards = document.querySelectorAll('.disc-card');
    var vis = 0;
    cards.forEach(function(c) {
        var s = c.getAttribute('data-search') || '';
        var m = !q || s.indexOf(q) !== -1;
        c.style.display = m ? '' : 'none';
        if (m) vis++;
    });
    var badge = document.getElementById('discCountBadge');
    var nr = document.getElementById('discNoResults');
    if (badge) {
        var tot = cards.length;
        badge.textContent = (q && vis < tot ? vis + ' / ' + tot : tot + ' <%= t("hr.disciplinary.disciplinary_history") %>');
    }
    if (nr) nr.style.display = vis === 0 ? '' : 'none';
    var tl = document.getElementById('discTimeline');
    if (tl) tl.style.display = vis === 0 ? 'none' : '';
}
</script>

<%- include('../partials/footer') %>
